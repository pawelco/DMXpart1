    private fun clearEntireProject() {
        // Wszystkie kanały DMX na 0
        for (i in 0..511) {
            Companion.baseDmxValues[i] = 0
            Companion.baseDmxTarget[i] = 0
            Companion.baseDmxStart[i] = 0
            Companion.baseDmxStartMain[i] = 0
            Companion.baseDmxStartAux[i] = 0
            Companion.dmxValues[i] = 0
            Companion.presetDmxValues[i] = 0
            Companion.effectManagedChannels[i] = false
            fanDmxOffsets[i] = 0
            Companion.posSmoothedValues[i] = -1f
            setDmxChannel(i, 0)
        }

        // Fixtury – wyczyść listę (zostaw jedną domyślną)
        Companion.fixturesList.clear()
        Companion.fixturesList.add(Companion.FixtureItem(
            id = 1, name = "New Fixture", groupIdx = 0, dmx = 1, channels = 1,
            paramMap = Array(512) { "" }, paramMin = IntArray(512) { 0 },
            paramMax = IntArray(512) { 255 }, cwCount = 1,
            cwDmx = IntArray(32), cwHalfDmx = IntArray(32), cwColors = IntArray(32)
        ))
        // Wyczyść routing SEQ
        for (g in 0..7) {
            Companion.seqRoutingOrder[g].clear()
            Companion.seqRoutingOn[g].clear()
            Companion.seqActivePattern[g] = -1
            Companion.seqRoutingMode[g] = 0
        }
        Companion.fixtureOriginalGroup.clear()
        Companion.fixturePatternSnapshot.clear()

        // Presety i EX-presety – puste
        for (i in memoryPresets.indices) memoryPresets[i] = PresetItem()
        for (i in memoryExPresets.indices) memoryExPresets[i] = PresetItem()
        for (i in 0..63) Companion.activeExPresets[i] = false
        activePresetIndex = -1; activeAuxPresetIndex = -1

        // LFO – wyłączone i wyzerowane
        for (li in 0..3) {
            lfoEnabled[li] = false
            memoryLfo[li] = LfoData()
            for (g in 0..7) lfoGroupActive[li][g] = false
        }

        // SEQ – wyłączone i wyzerowane
        for (si in 0..3) {
            seqEnabled[si] = false
            memorySeq[si] = SeqData()
            for (g in 0..7) seqGroupActive[si][g] = false
        }
        for (g in 0..7) {
            Companion.colorManualOverride[g] = false
            Companion.posPanOffset[g] = 0f
            Companion.posTiltOffset[g] = 0f
            Companion.posFadeActiveSinceReset[g] = false
        }

        // FX – wyzerowane
        for (fi in 0..3) {
            Companion.memoryFx[fi] = FxData()
        }

        // Performance – wyzerowane
        for (i in 0..7) {
            Companion.perfSettings[i] = PerfButtonSettings()
        }

        // Pozycje – wyczyszczone
        for (g in 0..7) {
            for (idx in 0..15) {
                Companion.positionMemories[g][idx] = Companion.PositionItem()
            }
        }

        Companion.isFadingMain = false; Companion.isFadingAux = false
        refreshDmxOutput()
        Companion.saveWorkspace(applicationContext.filesDir.absolutePath)
    }

