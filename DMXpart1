        hScroll.addView(columnsContainer)
        container.addView(hScroll)

        // ── W8: Zakładki grup (1u) ────────────────────────────────
        val tabsRow = LinearLayout(this@MainActivity).apply {
            orientation = LinearLayout.HORIZONTAL; weightSum = 8.0f
            layoutParams = LinearLayout.LayoutParams(-1, u)
            setBackgroundColor(Companion.COL_BG)  // kolor obszaru roboczego powyżej
        }
        val groupTabs = mutableListOf<TextView>()
        val tabR = u * 0.28f

        fun updateGroupTabBgs(activeIdx: Int) {
            groupTabs.forEachIndexed { idx, btn ->
                when (idx) {
                    activeIdx -> {
                        btn.background = android.graphics.drawable.LayerDrawable(arrayOf(
                            GradientDrawable().apply { setColor(Companion.COL_DARK) },
