            // DMX logic
            fun applyValue(p: Int) {
                val paramIndex = col
                val groupFixtures = Companion.fixturesList.filter { it.groupIdx == currentGroup }
                val activeFix = if (isFixtureMode) groupFixtures.getOrNull(currentFixture - 1) else groupFixtures.firstOrNull()
                if (activeFix == null) {
                    val addr = (groupStartChannel[currentGroup] - 1) + paramIndex
                    if (addr in 0..511) Companion.overrideChannel(addr, p)
                    return
                }
                if (paramIndex >= activeFix.channels) return
                val localParamName = activeFix.paramMap[paramIndex]
                if (localParamName == "Pan" || localParamName == "Tilt") {
                    val seqPosActive = (0..3).any { si -> seqEnabled[si] && seqGroupActive[si][currentGroup] && memorySeq[si].stepType[memorySeq[si].currentStep] == 3 }
                    if (seqPosActive) {
                        val readAddr = if (isFixtureMode) activeFix.dmx - 1 + paramIndex
                        else groupFixtures.firstOrNull()?.let { it.dmx - 1 + paramIndex } ?: -1
                        val curOutput = if (readAddr in 0..511) Companion.dmxValues[readAddr] else p
                        val delta = (p - curOutput).toFloat()
                        if (localParamName == "Pan") Companion.posPanOffset[currentGroup] += delta
                        else Companion.posTiltOffset[currentGroup] += delta
                        return
                    } else {
                        // LFO (nie SEQ) może kontrolować ten kanał – odblokuj go, żeby ręczny ruch wygrał.
                        val clearAddr = if (isFixtureMode) activeFix.dmx - 1 + paramIndex
                        else groupFixtures.firstOrNull()?.let { it.dmx - 1 + paramIndex } ?: -1
                        if (clearAddr in 0..511) Companion.effectManagedChannels[clearAddr] = false
                    }
                }
                val movParamsSet = setOf("Pan","Pan Fine","Tilt","Tilt Fine")
                if (localParamName.isNotEmpty() && localParamName != "Clear")
                    Companion.registerTouchedParam(if (isFixtureMode) activeFix.id else 1000 + currentGroup, Companion.paramList.indexOf(localParamName), p)
                if (localParamName in setOf("Zoom","Focus","Iris")) {
                    val addrToClear = if (isFixtureMode) activeFix.dmx - 1 + paramIndex
                    else groupFixtures.firstOrNull()?.let { it.dmx - 1 + paramIndex } ?: -1
                    if (addrToClear in 0..511) Companion.effectManagedChannels[addrToClear] = false
                }
                if (isFixtureMode) {
                    val actualCh = activeFix.dmx - 1 + paramIndex
                    if (actualCh in 0..511) { val mapped = activeFix.paramMin[paramIndex] + (p * (activeFix.paramMax[paramIndex] - activeFix.paramMin[paramIndex]) / 255); Companion.overrideChannel(actualCh, mapped) }
                } else {
                    var rgbChanged = false
                    if (localParamName.isEmpty() || localParamName == "Clear") {
                        groupFixtures.forEach { fix -> val actCh = fix.dmx-1+paramIndex; if (actCh in 0..511) Companion.overrideChannel(actCh, p) }
                    } else {
                        groupFixtures.forEach { fix -> for (ch in 0 until fix.channels) { if (fix.paramMap[ch] == localParamName) { val actCh = fix.dmx-1+ch; if (actCh in 0..511) { val mapped = fix.paramMin[ch]+(p*(fix.paramMax[ch]-fix.paramMin[ch])/255); Companion.overrideChannel(actCh, mapped) } } } }
                        if (localParamName in listOf("Red","Green","Blue","Beam 1R","Beam 1G","Beam 1B")) rgbChanged = true
                    }
                    if (rgbChanged) {
                        var cR=0;var cG=0;var cB=0
                        for (ch in 0 until activeFix.channels){val actCh=activeFix.dmx-1+ch;if(actCh in 0..511){val v=Companion.baseDmxValues[actCh];val range=activeFix.paramMax[ch]-activeFix.paramMin[ch];val rawP=if(range==0)0 else((v-activeFix.paramMin[ch])*255)/range;when(activeFix.paramMap[ch]){"Red","Beam 1R"->cR=rawP;"Green","Beam 1G"->cG=rawP;"Blue","Beam 1B"->cB=rawP}}}
                        groupFixtures.forEach{fix->if(fix.paramMap.contains("Col. wheel")&&!fix.paramMap.contains("Red")&&!fix.paramMap.contains("Beam 1R")){val cwDmx=getClosestWheelDmx(fix,cR,cG,cB);val cwIdx=fix.paramMap.indexOf("Col. wheel");val actCh=fix.dmx-1+cwIdx;if(actCh in 0..511){val mapped=fix.paramMin[cwIdx]+(cwDmx*(fix.paramMax[cwIdx]-fix.paramMin[cwIdx])/255);Companion.overrideChannel(actCh,mapped)}}}
                    }
                }
            }

            sb.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
