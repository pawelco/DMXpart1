    fun findMidiTargetAt(root: ViewGroup, x: Int, y: Int): String? {
        val loc = IntArray(2)
        for (i in root.childCount - 1 downTo 0) {
            val child = root.getChildAt(i) ?: continue
            if (child.visibility != View.VISIBLE) continue
            child.getLocationOnScreen(loc)
            if (x < loc[0] || x > loc[0]+child.width || y < loc[1] || y > loc[1]+child.height) continue
            val tag = child.tag
            if (tag is String && tag.startsWith("MIDI:")) return tag.substring(5)
            if (child is ViewGroup) { val found = findMidiTargetAt(child, x, y); if (found != null) return found }
        }
        return null
    }

