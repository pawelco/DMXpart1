        fun updateAuxProtectedChannels() {
            auxProtectedChannels.fill(false)
            // Znajdź aktywny preset AUX
            val auxIdx = (0 until 64).firstOrNull {
                memoryPresets[it].isSaved && memoryPresets[it].presetTarget == 1
            } ?: return
            val auxPreset = memoryPresets[auxIdx]
            // Oznacz kanały grup AUX jako chronione
            fixturesList.forEach { fix ->
                val isAuxGroup = !auxPreset.groupMask[fix.groupIdx]
                if (isAuxGroup) {
                    for (ch in 0 until fix.channels) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) auxProtectedChannels[addr] = true
                    }
                }
            }
        }

