        fun getPaletteDmxValues(i: Int): IntArray {
            var r=0; var g=0; var b=0; var w=0; var a=0; var uv=0
            when {
                i == 63 -> { /* czarny – zaślepka, wszystko 0 */ }
                i == 0 -> { w = 255 }
                i == 31 -> { r=255; g=255; b=255; w=255; a=255 }
                i in 1..30 -> { val c=corePaletteColors[i]; r=Color.red(c); g=Color.green(c); b=Color.blue(c) }
                i in 32..47 -> { val c=corePaletteColors[i]; r=Color.red(c); g=Color.green(c); b=Color.blue(c); w=120 }
                i in 48..62 -> {
                    val col=i-48; val ratio=col/15.0f
                    val rr=(255+(200-255)*ratio).toInt(); val gg=(160+(220-160)*ratio).toInt(); val bb=(80+(255-80)*ratio).toInt()
                    w=(255*(1.0f-Math.abs(col-7.5f)/7.5f)).toInt().coerceIn(0,255)
                    val blend=w/255.0f
                    r=(rr+(255-rr)*blend).toInt().coerceIn(0,255); g=(gg+(255-gg)*blend).toInt().coerceIn(0,255); b=(bb+(255-bb)*blend).toInt().coerceIn(0,255)
                }
            }
            return intArrayOf(r, g, b, w, a, uv)
        }

        fun rgbwaToUiColor(r:Int,g:Int,b:Int,w:Int,a:Int,uv:Int): Int {
            val br = (r + w/2 + a).coerceAtMost(255)
            val bg = (g + w/2 + a/2).coerceAtMost(255)
            val bb = (b + w/2 + uv).coerceAtMost(255)
            val mx = maxOf(br, bg, bb)
            if (mx == 0) return Color.BLACK
            return Color.rgb((br*255/mx).coerceAtMost(255), (bg*255/mx).coerceAtMost(255), (bb*255/mx).coerceAtMost(255))
        }

