    private fun handleTapTempo() {
        val now = System.currentTimeMillis()
        Companion.tapTimestamps.add(now)
        // Usuń stare uderzenia (ponad 2s ciszy resetuje sekwencję)
        while (Companion.tapTimestamps.size > 1 && now - Companion.tapTimestamps[Companion.tapTimestamps.size - 2] > 2000L) {
            Companion.tapTimestamps.removeAt(0)
        }
        if (Companion.tapTimestamps.size > 8) Companion.tapTimestamps.removeAt(0)
        if (Companion.tapTimestamps.size >= 2) {
            val intervals = Companion.tapTimestamps.zipWithNext { a, b -> b - a }
            val avgMs = intervals.average()
            if (avgMs > 0) {
                val bpm = (60000.0 / avgMs).toFloat().coerceIn(30f, 300f)
                Companion.masterBpm = bpm
            }
        }
    }

    private fun resyncAllSynced() {
        for (i in 0..3) { Companion.lfoBeatAccum[i] = 0.0; Companion.seqBeatAccum[i] = 0.0 }
        for (li in 0..3) {
            if (memoryLfo[li].isSync) memoryLfo[li].phase = 0f
        }
        for (si in 0..3) {
            val sq = memorySeq[si]
            if (sq.isSync) {
                sq.currentStep = 0; sq.prevStep = 0; sq.stepTimer = 0f; sq.justReset = true
            } else {
                for (s in 0 until sq.totalSteps) {
                    if (sq.stepIsSync[s] && sq.currentStep == s) {
                        sq.stepTimer = 0f
                    }
                }
            }
        }
        Toast.makeText(this, "Resync!", Toast.LENGTH_SHORT).show()
    }

