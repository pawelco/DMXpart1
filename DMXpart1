                    // Zabezpieczenie mechaniki lamp: Gobo, Kolory, Pryzmaty i Shutter robia twardy SNAP!
                    if (p.contains("Gobo") || p.contains("Col. wheel") || p.contains("Prizm") || p.contains("Macro") || p.contains("FX") || p == "Shutter" || p == "PT speed" || p == "Other") {
