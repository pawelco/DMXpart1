    fun onMidiNote(ch: Int, note: Int, velocity: Int) {
        if (Companion.midiLearnActive) {
            if (velocity == 0) return  // ignoruj note off podczas learn
            val savedTarget = Companion.midiLearnTarget
            Companion.midiMappings.add(Companion.MidiMapping(
                type = Companion.MIDI_NOTE, channel = ch, number = note,
                target = savedTarget
            ))
            Companion.midiLearnActive = false
            Companion.midiLearnTarget = ""
            runOnUiThread {
                val midiSubmenuTags = setOf("MIDI_GLOBAL_VIEW","MIDI_VIEW","MIDI_CHANNEL_VIEW","MIDI_DEVICE_VIEW","MIDI_PRESET_VIEW","MIDI_PERFORMANCE_VIEW","MIDI_SYSTEM_VIEW")
                if (activeViewContainer.getChildAt(0)?.tag in midiSubmenuTags) {
                    midiMenuRebuildCallback?.invoke()
                } else {
                    showMidiMappedOverlay(midiTargetLabel(savedTarget), "CC $note  CH${ch+1}")
                }
            }

            return
        }
        // przepuść zarówno note on (velocity>0) jak i note off (velocity=0)
        // filtrowanie odbywa się w applyMidiMapping
        Companion.midiMappings.filter {
            it.channel == ch && it.number == note && it.type == Companion.MIDI_NOTE
        }.forEach { applyMidiMapping(it, velocity) }
    }

