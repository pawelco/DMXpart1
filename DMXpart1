            }
        }

        // Polling — aktualizuj aktywny slot na podstawie wartości DMX
        lifecycleScope.launch {
            while (isActive) {
                delay(100)
                if (activeViewContainer.getChildAt(0) !== container) break
                var changed = false
                for (param in listOf("Gobo", "Gobo2")) {
                    val activeSlots = if (param == "Gobo") Companion.goboActiveSlot1 else Companion.goboActiveSlot2
                    val fix = getGoboFix(currentGroup, param) ?: continue
                    val ch = (0 until fix.channels).firstOrNull {
                        fix.paramMap[it] == param || fix.paramMap[it] == "${param} rot"
                    } ?: continue
                    val addr = fix.dmx - 1 + ch
                    if (addr !in 0..511) continue
                    val current = Companion.baseDmxValues[addr]
                    // Znajdź najbliższy slot
                    var best = -1; var bestDist = Int.MAX_VALUE
                    for (i in 0 until fix.gbCount) {
                        val mapped = fix.paramMin[ch] + (fix.gbDmx[i] * (fix.paramMax[ch] - fix.paramMin[ch]) / 255)
                        val dist = Math.abs(current - mapped)
                        if (dist < bestDist) { bestDist = dist; best = i }
                    }
                    if (best != activeSlots[currentGroup]) {
                        activeSlots[currentGroup] = best
                        changed = true
                    }
                }
                if (changed) content.post {
                    content.removeAllViews()
                    content.addView(buildRow(currentGroup))
                }
            }
        }

        return container
    }

