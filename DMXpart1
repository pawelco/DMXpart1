                        text="– DEL"; gravity=Gravity.CENTER; setTextColor(Color.WHITE); background=getSaveBtnStyle()
                        layoutParams=LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(5,5,5,5)}
