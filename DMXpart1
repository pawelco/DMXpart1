    private fun createPerformView(): View {
        val j = exactRowHeight
        val m = 2
        val perfColors = listOf(
            Color.parseColor("#888888"), Color.parseColor("#6666CC"),
            Color.parseColor("#CC6600"), Color.parseColor("#CC2222"),
            Color.parseColor("#2222CC"), Color.parseColor("#883300"),
            Companion.COL_BTN_DARK, Color.parseColor("#0088CC")
        )
        val fastLabels = listOf("2×","3×","4×","6×","8×")
        val fastMults  = listOf(2f, 3f, 4f, 6f, 8f)
        val slowLabels = listOf("1/8","1/6","1/4","1/3","1/2")
        val slowMults  = listOf(0.125f, 0.1667f, 0.25f, 0.333f, 0.5f)
        val groupLetters = listOf("A","B","C","D","E","F","G","H")
        val noValueRows = setOf(5, 6) // STOP SEQ, BLACKOUT
        val noFadeRows = setOf(5)     // STOP SEQ – fade in/out nie mają sensu

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            weightSum = 8f
            layoutParams = FrameLayout.LayoutParams(-1,-1)
            setBackgroundColor(Companion.COL_BG)
        }

        // logika on/off jest teraz globalna: triggerPerfOn / triggerPerfOff

        for (i in 0..7) {
            val ps = Companion.perfSettings[i]
            val rowColor = perfColors[i]
            val isNoValue = i in noValueRows
            val isNoFade = i in noFadeRows

            val row = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                weightSum = 13f
                layoutParams = LinearLayout.LayoutParams(-1, 0, 1f).apply { setMargins(0,1,0,1) }
                setBackgroundColor(Color.parseColor("#DDDDDD"))
            }

            val toggleBg = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                setColor(if (ps.isToggleMode) Color.parseColor("#007700") else Companion.COL_BTN)
            }
            val toggleTv = TextView(this).apply {
                text = "toggle"; gravity = Gravity.CENTER; textSize = 11f
                setTextColor(Color.WHITE)
                background = toggleBg
                layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                setOnClickListener {
                    ps.isToggleMode = !ps.isToggleMode
                    toggleBg.setColor(if (ps.isToggleMode) Color.parseColor("#007700") else Companion.COL_BTN)
                }
            }

            row.addView(toggleTv)

            // Value / Color / Multiplier – brak dla STOP SEQ i BLACKOUT
            when {
                isNoValue -> {
                    row.addView(View(this).apply {
                        layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                        setBackgroundColor(Color.parseColor("#CCCCCC"))
                    })
                }
                i == 2 -> {
                    val previewCol = Companion.corePaletteColors[ps.value.coerceIn(0,63)]
                    row.addView(FrameLayout(this).apply {
                        layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                        setBackgroundColor(previewCol)
                        setOnClickListener {
                            showInternalPaletteMenu { c ->
                                ps.value = c
                                activeViewContainer.removeAllViews(); activeViewContainer.addView(createPerformView())
                            }
                        }
                    })
                }
                i == 3 -> {
                    row.addView(TextView(this).apply {
                        text = fastLabels.getOrElse(ps.value){"2×"}
                        gravity = Gravity.CENTER; textSize = 18f; setTextColor(Color.BLACK)
                        background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#BBBBBB")); cornerRadius=4f }
                        layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                        setOnClickListener {
                            ps.value = (ps.value + 1) % fastLabels.size
                            text = fastLabels.getOrElse(ps.value){"2×"}
                            if (ps.isActive) Companion.perfTempoMultiplier = fastMults.getOrElse(ps.value){2f}
                        }
                    })
                }
                i == 4 -> {
                    row.addView(TextView(this).apply {
                        text = slowLabels.getOrElse(ps.value){"1/2"}
                        gravity = Gravity.CENTER; textSize = 18f; setTextColor(Color.BLACK)
                        background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#BBBBBB")); cornerRadius=4f }
                        layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                        setOnClickListener {
                            ps.value = (ps.value + 1) % slowLabels.size
                            text = slowLabels.getOrElse(ps.value){"1/2"}
                            if (ps.isActive) Companion.perfTempoMultiplier = slowMults.getOrElse(ps.value){0.5f}
                        }
                    })
                }
                else -> {
                    row.addView(TextView(this).apply {
                        text = "${ps.value}"; gravity = Gravity.CENTER; textSize = 18f; setTextColor(Color.BLACK)
                        background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#BBBBBB")); cornerRadius=4f }
                        layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                        setOnClickListener {
                            showInternalNumpad(ps.value.toString()) { s ->
                                ps.value = s.toIntOrNull()?.coerceIn(0,255) ?: ps.value
                                activeViewContainer.removeAllViews(); activeViewContainer.addView(createPerformView())
                            }
                        }
                    })
                }
            }

            // Fade In
            if (isNoFade) {
                row.addView(View(this).apply {
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(m,m,m,m)}
                    setBackgroundColor(Color.parseColor("#CCCCCC"))
                })
            } else {
                row.addView(TextView(this).apply {
                    text = if (ps.fadeIn == 0f) "0.0s" else String.format("%.1fs", ps.fadeIn)
                    gravity = Gravity.CENTER; textSize = 16f
                    setTextColor(Color.BLACK)
                    background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#EEEEEE")); setStroke(2, Color.BLACK); cornerRadius=4f }
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(m,m,m,m)}
                    setOnClickListener {
                        showInternalNumpad((ps.fadeIn * 10).toInt().toString()) { s ->
                            val raw = s.toIntOrNull()?.coerceIn(0, 100) ?: (ps.fadeIn * 10).toInt()
                            ps.fadeIn = raw / 10f
                            // Zabezpieczenie: jeśli efekt jest właśnie aktywny i fade-in się już zakończył,
                            // wymuszamy timer na nową wartość, żeby zmiana w trakcie nie spowodowała
                            // ponownego, niechcianego "doświetlania" od zera.
                            if (ps.isActive && ps.fadeTimer > ps.fadeIn) ps.fadeTimer = ps.fadeIn
                            activeViewContainer.removeAllViews(); activeViewContainer.addView(createPerformView())
                        }
                    }
                })
            }

            // Fade Out
            if (isNoFade) {
                row.addView(View(this).apply {
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(m,m,m,m)}
                    setBackgroundColor(Color.parseColor("#CCCCCC"))
                })
            } else {
                row.addView(TextView(this).apply {
                    text = if (ps.fadeOut == 0f) "0.0s" else String.format("%.1fs", ps.fadeOut)
                    gravity = Gravity.CENTER; textSize = 16f
                    setTextColor(Color.BLACK)
                    background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#EEEEEE")); setStroke(2, Color.BLACK); cornerRadius=4f }
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(m,m,m,m)}
                    setOnClickListener {
                        showInternalNumpad((ps.fadeOut * 10).toInt().toString()) { s ->
                            val raw = s.toIntOrNull()?.coerceIn(0, 100) ?: (ps.fadeOut * 10).toInt()
                            ps.fadeOut = raw / 10f
                            // Zabezpieczenie przed "wskrzeszeniem" efektu: jeśli efekt jest wyłączony
                            // i jego poprzedni fade-out już się zakończył (fadeTimer >= stary fadeOut),
                            // zwiększenie fadeOut nie może ponownie "odpalić" częściowo wygasłego efektu.
                            if (!ps.isActive) ps.fadeTimer = ps.fadeOut
                            activeViewContainer.removeAllViews(); activeViewContainer.addView(createPerformView())
                        }
                    }
                })
            }

            // 8 grup
            val activeColorForRow: () -> Int = {
                when (i) {
                    0,1 -> Color.WHITE
                    2 -> Companion.corePaletteColors[ps.value.coerceIn(0,63)]
                    3 -> Color.parseColor("#FFDD00")
                    4 -> Color.parseColor("#2266FF")
                    5 -> Color.parseColor("#CC2222")
                    6 -> Color.BLACK
                    7 -> Companion.COL_BG
                    else -> rowColor
                }
            }
            for (g in 0..7) {
                val cellTextColor = if (i == 6) Color.WHITE else Color.BLACK
                val cellBg = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                    setColor(if (ps.groupMask[g]) activeColorForRow() else Companion.COL_DARK)
                }
                row.addView(TextView(this).apply {
                    text = groupLetters[g]; gravity = Gravity.CENTER; textSize = 14f
                    typeface = android.graphics.Typeface.DEFAULT_BOLD
                    setTextColor(if (ps.groupMask[g]) cellTextColor else Color.WHITE)
                    background = cellBg
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(m,m,m,m)}
                    setOnClickListener {
                        ps.groupMask[g] = !ps.groupMask[g]
                        cellBg.setColor(if (ps.groupMask[g]) activeColorForRow() else Companion.COL_DARK)
                        setTextColor(if (ps.groupMask[g]) cellTextColor else Color.WHITE)
                    }
                })
            }

            root.addView(row)
        }

        return root
    }


