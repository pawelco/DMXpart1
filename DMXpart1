    private fun createInternalPaletteMenu(): FrameLayout {
        val overlay = FrameLayout(this).apply {
            layoutParams = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT)
            setBackgroundColor(Color.parseColor("#AA000000")); visibility = View.GONE; setOnClickListener { visibility = View.GONE }
        }
        val menuBox = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setBackgroundColor(Companion.COL_BTN_DARK); layoutParams = FrameLayout.LayoutParams(400, 850, Gravity.CENTER); setPadding(10, 10, 10, 10) }

        val scrollView = ScrollView(this).apply {
            layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.MATCH_PARENT)
            isScrollbarFadingEnabled = false
        }
        val listLayout = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; layoutParams = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT) }

        for (i in 0 until 64) {
            val cRow = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 120).apply { setMargins(5, 5, 5, 5) }
                background = GradientDrawable().apply { shape = GradientDrawable.RECTANGLE; setColor(corePaletteColors[i]); setStroke(2, Color.BLACK); cornerRadius = 4f }

                val txt = TextView(this@MainActivity).apply {
                    text = if(i==0) "Warm White" else if(i==31) "Full White" else "C${i+1}"
                    val lum = Color.red(corePaletteColors[i])*0.299 + Color.green(corePaletteColors[i])*0.587 + Color.blue(corePaletteColors[i])*0.114
                    setTextColor(if (lum > 160) Color.BLACK else Color.WHITE)
                    textSize = 22f
                    gravity = Gravity.CENTER
                    layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.MATCH_PARENT)
                }
                addView(txt)

                setOnClickListener { overlay.visibility = View.GONE; onPaletteResult?.invoke(i) }
            }
            listLayout.addView(cRow)
        }

        scrollView.addView(listLayout); menuBox.addView(scrollView); overlay.addView(menuBox)
        return overlay
    }

