                            setCornerRadii(floatArrayOf(0f,0f,0f,0f,tabR,tabR,tabR,tabR))
                        }
                    ))
                    activeIdx - 1 -> android.graphics.drawable.LayerDrawable(arrayOf(
                        GradientDrawable().apply { setColor(Companion.COL_BG) },
                        GradientDrawable().apply {
                            shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                            setCornerRadii(floatArrayOf(0f,0f,tabR,tabR,0f,0f,0f,0f))
