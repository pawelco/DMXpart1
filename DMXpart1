                        }
                        layoutParams = FrameLayout.LayoutParams(posDotSz, posDotSz).apply {
                            gravity = seqCorners[si]; setMargins(4, 4, 4, 4)
                        }
                        alpha = if (isActiveDot) 1f else 0f
                    })
                }
