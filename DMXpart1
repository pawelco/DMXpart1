                    }
                }

                if (root.has("memoryFx")) {
                    val arr = root.getJSONArray("memoryFx")
                    for (i in 0 until minOf(arr.length(), 4)) {
                        val o = arr.getJSONObject(i)
                        val fx = memoryFx[i]
                        fx.shapeIdx = o.optInt("shapeIdx", 0)
                        fx.speed = o.optDouble("speed", 0.5).toFloat()
                        fx.spread = o.optInt("spread", 4)
                        fx.amt = o.optInt("amt", 100)
                        fx.phs = o.optInt("phs", 0)
                        fx.groupIdx = o.optInt("groupIdx", 0)
                        fx.destIdx = o.optInt("destIdx", -1)
                        fx.playState = o.optInt("playState", 0)
                        fx.isEnabled = o.optBoolean("isEnabled", false)
                        fx.isSync    = o.optBoolean("isSync", false)
                        fx.syncIdx   = o.optInt("syncIdx", 6)
                        fxBaseSpeeds[i] = fx.speed
                        fxBaseAmts[i] = fx.amt
                        fxBasePhss[i] = fx.phs
                    }
                }

                if (root.has("seqRoutingMode")) {
                    val a = root.getJSONArray("seqRoutingMode")
                    for (i in 0 until minOf(a.length(), 8)) Companion.seqRoutingMode[i] = a.getInt(i)
                }

                if (root.has("seqPatternMemories")) {
                    val patMemArr = root.getJSONArray("seqPatternMemories")
                    for (g in 0 until minOf(patMemArr.length(), 8)) {
                        val grpArr = patMemArr.getJSONArray(g)
                        for (pi in 0 until minOf(grpArr.length(), 6)) {
                            val pObj = grpArr.getJSONObject(pi)
                            val pat = Companion.seqPatternMemories[g][pi]
                            pat.isSaved = pObj.getBoolean("isSaved")
                            pat.name = pObj.getString("name")
                            pat.order.clear()
                            val ordArr = pObj.getJSONArray("order")
                            for (i in 0 until ordArr.length()) pat.order.add(ordArr.getInt(i))
                            pat.onList.clear()
                            val onArr = pObj.getJSONArray("onList")
                            for (i in 0 until onArr.length()) pat.onList.add(onArr.getBoolean(i))
                        }
                    }
                }

                if (root.has("perfSettings")) {
                    val arr = root.getJSONArray("perfSettings")
                    for (i in 0 until minOf(arr.length(), 8)) {
                        val o = arr.getJSONObject(i)
                        val ps = perfSettings[i]
                        ps.isToggleMode = o.optBoolean("isToggleMode", false)
                        ps.value = o.optInt("value", 255)
                        ps.fadeIn = o.optDouble("fadeIn", 0.0).toFloat()
                        ps.fadeOut = o.optDouble("fadeOut", 0.0).toFloat()
                        if (o.has("groupMask")) {
                            val gArr = o.getJSONArray("groupMask")
                            for (j in 0 until minOf(gArr.length(), 8)) ps.groupMask[j] = gArr.getBoolean(j)
                        }
                    }
                }
            } catch (e: Exception) { e.printStackTrace() }
        }
