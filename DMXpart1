    private fun showGyroSettings() {
        val overlay = gyroSettingsOverlay
        val box = overlay.findViewWithTag<LinearLayout>("GYRO_BOX") ?: return
        box.removeAllViews()
        box.orientation = LinearLayout.HORIZONTAL

        var activeSlot = -1
        var sliderRef: SeekBar? = null
        val liveTvs = HashMap<Int, TextView>()
        val allValueBtns = HashMap<Int, TextView>()

        fun slotMax(s: Int) = if (s % 2 == 0) 510 else 100
        fun slotProgress(s: Int) = when(s) {
            0 -> gyroXOffset + 255; 1 -> gyroXRange
            2 -> gyroYOffset + 255; 3 -> gyroYRange; else -> 0
        }
        fun applySlot(s: Int, p: Int) = when(s) {
            0 -> { gyroXOffset = p - 255; liveTvs[0]?.text = "${gyroXOffset}" }
            1 -> { gyroXRange  = p;       liveTvs[1]?.text = "$p %" }
            2 -> { gyroYOffset = p - 255; liveTvs[2]?.text = "${gyroYOffset}" }
            3 -> { gyroYRange  = p;       liveTvs[3]?.text = "$p %" }
            else -> {}
        }
        fun selectSlot(s: Int) {
            activeSlot = s
            allValueBtns.forEach { (k, v) ->
                (v.background as? GradientDrawable)?.setColor(
                    if (k == s) Color.parseColor("#0055AA") else Companion.COL_SEP
                )
            }
            sliderRef?.max = slotMax(s)
            sliderRef?.progress = slotProgress(s)
        }

        fun makeRow(rowLabel: String, isX: Boolean, offSlot: Int, rngSlot: Int): LinearLayout {
            return LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL; weightSum = 14f
                layoutParams = LinearLayout.LayoutParams(-1, exactRowHeight + 16).apply { setMargins(6,6,6,6) }

                addView(TextView(this@MainActivity).apply {
                    text = rowLabel; gravity = Gravity.CENTER; textSize = 17f; setTextColor(Color.WHITE)
                    background = getBtnStyle().apply { setColor(Companion.COL_PANEL) }
                    layoutParams = LinearLayout.LayoutParams(0,-1,2.2f).apply{setMargins(4,4,4,4)}
                })

                val axisVal = if (isX) gyroXAxis else gyroYAxis
                addView(TextView(this@MainActivity).apply {
                    text = if (axisVal == 0) "PAN" else "TILT"
                    gravity = Gravity.CENTER; textSize = 17f; setTextColor(Color.BLACK)
                    background = getBtnStyle().apply { setColor(if (axisVal==0) Color.YELLOW else Color.CYAN) }
                    layoutParams = LinearLayout.LayoutParams(0,-1,2f).apply{setMargins(4,4,4,4)}
                    setOnClickListener {
                        if (isX) gyroXAxis = if (gyroXAxis==0) 1 else 0
                        else gyroYAxis = if (gyroYAxis==0) 1 else 0
                        showGyroSettings()
                    }
                })

                val inv = if (isX) gyroXInverted else gyroYInverted
                addView(TextView(this@MainActivity).apply {
                    text = if (inv) "INV ON" else "INV OFF"
                    gravity = Gravity.CENTER; textSize = 16f; setTextColor(Color.WHITE)
                    background = getBtnStyle().apply { setColor(if (inv) Color.parseColor("#CC4400") else Companion.COL_BTN) }
                    layoutParams = LinearLayout.LayoutParams(0,-1,2f).apply{setMargins(4,4,4,4)}
                    setOnClickListener {
                        if (isX) gyroXInverted = !gyroXInverted
                        else gyroYInverted = !gyroYInverted
                        showGyroSettings()
                    }
                })

                addView(TextView(this@MainActivity).apply {
                    text = "Offset"; gravity = Gravity.CENTER; textSize = 16f; setTextColor(Color.WHITE)
                    layoutParams = LinearLayout.LayoutParams(0,-1,1.4f)
                })
                val offTv = TextView(this@MainActivity).apply {
                    val cur = if (isX) gyroXOffset else gyroYOffset
                    text = "$cur"; gravity = Gravity.CENTER; textSize = 17f; setTextColor(Color.WHITE)
                    background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Companion.COL_SEP); cornerRadius=4f }
                    layoutParams = LinearLayout.LayoutParams(0,-1,2f).apply{setMargins(4,4,4,4)}
                    setOnClickListener { selectSlot(offSlot) }
                }
                liveTvs[offSlot] = offTv; allValueBtns[offSlot] = offTv; addView(offTv)

                addView(TextView(this@MainActivity).apply {
                    text = "Range"; gravity = Gravity.CENTER; textSize = 16f; setTextColor(Color.WHITE)
                    layoutParams = LinearLayout.LayoutParams(0,-1,1.4f)
                })
                val rngTv = TextView(this@MainActivity).apply {
                    val cur = if (isX) gyroXRange else gyroYRange
                    text = "$cur %"; gravity = Gravity.CENTER; textSize = 17f; setTextColor(Color.WHITE)
                    background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Companion.COL_SEP); cornerRadius=4f }
                    layoutParams = LinearLayout.LayoutParams(0,-1,2f).apply{setMargins(4,4,4,4)}
                    setOnClickListener { selectSlot(rngSlot) }
                }
                liveTvs[rngSlot] = rngTv; allValueBtns[rngSlot] = rngTv; addView(rngTv)
            }
        }

        // Lewa część – tytuł + wiersze
        val leftPart = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
        }
        leftPart.addView(TextView(this).apply {
            text = "GYRO SETTINGS  –  tap outside to close"
            gravity = Gravity.CENTER; textSize = 17f; setTextColor(Color.WHITE)
            layoutParams = LinearLayout.LayoutParams(-1, exactRowHeight)
        })
        leftPart.addView(makeRow("X axis", true,  0, 1))
        leftPart.addView(makeRow("Y axis", false, 2, 3))
        leftPart.addView(View(this).apply {
            layoutParams = LinearLayout.LayoutParams(-1, 4)
            setBackgroundColor(Companion.COL_BTN)
        })
        box.addView(leftPart)

        // Prawy – unified slider
        val (gyroSliderWidget, gyroSeekBar) = createDataSlider(
            slotMax(0), slotProgress(0)
        ) { p ->
            if (activeSlot >= 0) applySlot(activeSlot, p)
        }
        sliderRef = gyroSeekBar
        gyroSliderWidget.layoutParams = LinearLayout.LayoutParams(exactRowHeight * 2, -1)
        box.addView(gyroSliderWidget)

        overlay.visibility = View.VISIBLE
    }

    private fun showInternalLoadMenu(onResult: (FixtureProfile) -> Unit) {
        onLoadResult = onResult
        loadMenuListLayout.removeAllViews()

        if (savedProfiles.isEmpty()) {
            loadMenuListLayout.addView(TextView(this).apply { text="No saved profiles"; setTextColor(Color.WHITE); textSize=20f; setPadding(40,30,40,30) })
        } else {
            savedProfiles.forEach { profile ->
                loadMenuListLayout.addView(TextView(this).apply {
                    text = "${profile.name} (${profile.channels}CH)"
                    textSize = 22f; setTextColor(Color.WHITE); setPadding(40, 30, 40, 30)
                    setOnClickListener { loadMenuOverlay.visibility = View.GONE; onLoadResult?.invoke(profile) }
                })
            }
        }
        loadMenuOverlay.visibility = View.VISIBLE
    }
