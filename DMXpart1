    private fun updateSlidersViewUI() {
        if (sliderContainers.isEmpty()) return
        val groupFixtures = fixturesList.filter { it.groupIdx == currentGroup }
        val activeFix = if (isFixtureMode) groupFixtures.getOrNull(currentFixture - 1) else groupFixtures.firstOrNull()
        val activeChCount = activeFix?.channels ?: groupVirtualChannelCount[currentGroup]
        for (i in 0 until sliderContainers.size) {
            val column = sliderContainers[i].parent as? LinearLayout
            if (i < activeChCount) {
                column?.visibility = View.VISIBLE; sliderContainers[i].visibility = View.VISIBLE
                if (i < sliderLabels.size) {
                    sliderLabels[i].visibility = View.VISIBLE
                    val sm = activeFix?.paramMap?.get(i) ?: groupVirtualParamNames[currentGroup].getOrElse(i){""}
                    sliderLabels[i].text = if (sm.isNotEmpty()) sm else "CH ${i+1}"
                }
                if (activeFix != null && i < sliderSeekBars.size) {
                    val actCh = activeFix.dmx - 1 + i
                    if (actCh in 0..511) {
                        val paramAtI = activeFix.paramMap.getOrNull(i) ?: ""
                        // Uchwyt suwaka pokazuje wartość bazową + trwały offset (czyli to co Ty
                        // ustawiłeś przez dotyk/enkoder) – NIE żywe wyjście SEQ. Ruch samego SEQ
                        // jest już widoczny przez osobny, kolorowy słupek SEQ; uchwyt ma się zmieniać
                        // tylko wtedy, gdy Ty rzeczywiście poruszysz suwakiem/enkoderem.
                        val offsetHere = when (paramAtI) {
                            "Pan" -> Companion.posPanOffset[currentGroup]
                            "Tilt" -> Companion.posTiltOffset[currentGroup]
                            else -> 0f
                        }
                        val cdmx = (Companion.baseDmxValues[actCh] + offsetHere).toInt().coerceIn(0, 255)
                        val min = activeFix.paramMin[i]; val max = activeFix.paramMax[i]; val range = max - min
                        val newProgress = (if(range==0)0 else((cdmx-min)*255)/range).coerceIn(0,255)
                        if (sliderSeekBars[i].progress != newProgress)
                            sliderSeekBars[i].progress = newProgress
                    }
                    else sliderSeekBars[i].progress = 0
                } else if (i < sliderSeekBars.size) {
                    val addr = (groupStartChannel[currentGroup] - 1) + i
                    sliderSeekBars[i].progress = if (addr in 0..511) Companion.baseDmxValues[addr] else 0
                }
                val paramName2 = activeFix?.paramMap?.getOrNull(i) ?: ""
                if (paramName2.isNotEmpty() && paramName2 != "Clear") {
                    (sliderContainers[i].parent as? LinearLayout)?.tag = "MIDI:SLIDER_${currentGroup}_${paramName2}"
                }
            } else {
                column?.visibility = View.GONE; sliderContainers[i].visibility = View.GONE
                if (i < sliderLabels.size) sliderLabels[i].visibility = View.GONE
            }
        }
    }








