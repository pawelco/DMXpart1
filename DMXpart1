            fun doRecall() {
                if (pm.isSaved) {
                    posActiveMemory[posCurrentGroup] = idx
                    val targets = if (posIsFixtureMode) listOfNotNull(groupFixes.getOrNull(posCurrentFixture-1)) else groupFixes
                    targets.forEach { fix ->
                        for (ch in 0 until fix.channels) if (fix.paramMap[ch] in posMovParamSet) {
                            val addr = fix.dmx - 1 + ch
                            if (addr in 0..511) { Companion.overrideChannel(addr, pm.dmxSnapshot[addr]); setDmxChannel(addr, pm.dmxSnapshot[addr]) }
                        }
                    }
                    rebuild()
                }
            }
            fun doQuickSave() {
                touchState = 1
                val snap = IntArray(512)
                groupFixes.forEach { fix -> for (ch in 0 until fix.channels) if (fix.paramMap[ch] in posMovParamSet) {
                    val a = fix.dmx - 1 + ch; if (a in 0..511) snap[a] = Companion.baseDmxValues[a]
                }}
                val name = if (pm.isSaved) pm.name else "${idx+1}"
                Companion.positionMemories[posCurrentGroup][idx] = Companion.PositionItem(true, name, snap)
                posActiveMemory[posCurrentGroup] = idx
                rebuild()
            }
            fun doRename() {
                touchState = 2
                val curName = if (pm.isSaved) pm.name else "${idx+1}"
                showInternalKeyboard(curName) { newName ->
                    val curPm = Companion.positionMemories[posCurrentGroup][idx]
                    if (!curPm.isSaved) {
                        val snap = IntArray(512)
                        groupFixes.forEach { fix -> for (ch in 0 until fix.channels) if (fix.paramMap[ch] in posMovParamSet) {
                            val a = fix.dmx - 1 + ch; if (a in 0..511) snap[a] = Companion.baseDmxValues[a]
                        }}
                        Companion.positionMemories[posCurrentGroup][idx] = Companion.PositionItem(true, newName, snap)
                    } else { curPm.name = newName }
                    posActiveMemory[posCurrentGroup] = idx; rebuild()
                }
            }

            cell.setOnTouchListener { v, event ->
                when (event.action) {
                    android.view.MotionEvent.ACTION_DOWN -> {
                        touchState = 0
                        when {
                            posClearMode -> {
                                if (posClearPendingIndex == idx) {
                                    // drugi tap – faktyczne kasowanie
                                    Companion.positionMemories[posCurrentGroup][idx] = Companion.PositionItem()
                                    if (posActiveMemory[posCurrentGroup] == idx) posActiveMemory[posCurrentGroup] = -1
                                    posClearMode = false; posClearPendingIndex = -1; rebuild()
                                } else {
                                    // pierwszy tap – zaznaczenie
                                    posClearPendingIndex = idx; rebuild()
                                }
                            }
                            posIsCopyMode -> {
                                if (posCopySourceIndex == -1) { if (pm.isSaved) { posCopySourceIndex = idx; rebuild() } }
                                else {
                                    if (posCopySourceIndex != idx) {
                                        val src = Companion.positionMemories[posCurrentGroup][posCopySourceIndex]
                                        Companion.positionMemories[posCurrentGroup][idx] = Companion.PositionItem(true, src.name, src.dmxSnapshot.clone())
                                    }
                                    posIsCopyMode = false; posCopySourceIndex = -1; rebuild()
                                }
                            }
                            else -> {
                                // 700ms = quick save, 2500ms = rename
                                longHandler.postDelayed({ if (touchState == 0) doQuickSave() }, 700)
                                longHandler.postDelayed({ if (touchState == 1) doRename() }, 2500)
                            }
                        }
                        true
                    }
                    android.view.MotionEvent.ACTION_UP -> {
                        if (touchState == 0 && !posClearMode && !posIsCopyMode) {
                            longHandler.removeCallbacksAndMessages(null)
                            doRecall()
                        }
                        true
                    }
                    android.view.MotionEvent.ACTION_CANCEL -> { longHandler.removeCallbacksAndMessages(null); true }
                    else -> false
                }
            }
            memoriesRow.addView(cell)
            positionsRefreshCallback = {
                for (idx2 in 0..15) {
                    val cell2 = memoriesRow.getChildAt(idx2) as? FrameLayout ?: continue
                    val pm2 = Companion.positionMemories[posCurrentGroup][idx2]
                    val isActive2 = posActiveMemory[posCurrentGroup] == idx2
                    (cell2.background as? GradientDrawable)?.apply {
                        setColor(when { isActive2 -> Color.parseColor("#227722"); pm2.isSaved -> Color.parseColor("#44AA44"); else -> Companion.COL_PANEL })
                        setStroke(if (isActive2) 3 else 1, if (isActive2) Color.YELLOW else Companion.COL_SEP)
                    }
                }
            }
        }
        container.addView(memoriesRow)

        // ── Positions group tabs ──────────────────────────────────
// (do wklejenia w createPositionsView zamiast istniejącego bloku GROUP TABS)
        val tabR2 = exactRowHeight * 0.28f
        val posTabsList = mutableListOf<TextView>()
        val tabsRowPos = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL; weightSum = 8.0f
            layoutParams = LinearLayout.LayoutParams(-1, exactRowHeight)
            setBackgroundColor(Companion.COL_BG)
        }

        fun updatePosGroupTabBgs(activeIdx: Int) {
            posTabsList.forEachIndexed { idx, btn ->
                when (idx) {
                    activeIdx -> {
                        btn.background = android.graphics.drawable.LayerDrawable(arrayOf(
                            GradientDrawable().apply { setColor(Companion.COL_DARK) },
                            GradientDrawable().apply {
                                shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_BG)
                                setCornerRadii(floatArrayOf(0f,0f, 0f,0f, tabR2,tabR2, tabR2,tabR2))
                            }
                        ))
                        btn.setTextColor(Color.BLACK)
                    }
                    activeIdx - 1 -> {
                        btn.background = android.graphics.drawable.LayerDrawable(arrayOf(
                            GradientDrawable().apply { setColor(Companion.COL_BG) },
                            GradientDrawable().apply {
                                shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                                setCornerRadii(floatArrayOf(0f,0f, tabR2,tabR2, 0f,0f, 0f,0f))
                            }
                        ))
                        btn.setTextColor(Color.WHITE)
                    }
                    activeIdx + 1 -> {
                        btn.background = android.graphics.drawable.LayerDrawable(arrayOf(
                            GradientDrawable().apply { setColor(Companion.COL_BG) },
                            GradientDrawable().apply {
                                shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                                setCornerRadii(floatArrayOf(tabR2,tabR2, 0f,0f, 0f,0f, 0f,0f))
                            }
                        ))
                        btn.setTextColor(Color.WHITE)
                    }
                    else -> {
                        btn.background = GradientDrawable().apply {
                            shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                        }
                        btn.setTextColor(Color.WHITE)
                    }
                }
            }
        }

        for (i in 0..7) {
            posTabsList.add(TextView(this).apply {
                text = "GRP ${'A' + i}"; gravity = Gravity.CENTER; textSize = 14f
                tag = "MIDI:GROUP_SELECT_$i"
                layoutParams = LinearLayout.LayoutParams(0, -1, 1.0f)
                setOnClickListener {
                    posCurrentGroup = i; posCurrentFixture = 1; posIsFixtureMode = false
                    posClearPendingIndex = -1
                    updatePosGroupTabBgs(i)
                    rebuild()
                }
            })
            tabsRowPos.addView(posTabsList.last())
        }
        updatePosGroupTabBgs(posCurrentGroup)
        container.addView(tabsRowPos)


        // ── LIVE ANIMATION ────────────────────────────────────
        lifecycleScope.launchWhenResumed {
            while (isActive) {
                delay(50)
                if (activeViewContainer.getChildAt(0) !== container) break
                container.post {
                    val pv = getParam("Pan"); val tv = getParam("Tilt")
                    val screenX = if (posPanInverted) 255 - pv else pv
                    val screenY = if (posTiltInverted) tv else 255 - tv
                    moveCrosshair(screenX, screenY)
                    panTiltLabelRef?.text = "PAN ${String.format("%03d",pv)}\nTILT ${String.format("%03d",tv)}"
                    pfTfLabelRef?.text = "PF ${String.format("%03d",getParam("Pan Fine"))}\nTF ${String.format("%03d",getParam("Tilt Fine"))}"
                    movParamNames.forEachIndexed { idx, pName ->
                        container.findViewWithTag<TextView>("POS_LP_$idx")?.text = String.format("%03d", getParam(pName))
                    }
                    if (posSelectedParam in listOf(5, 6, 7, 8)) {
                        val sv = getSliderValue()
                        rightSliderRef?.let { if (kotlin.math.abs(it.progress - sv) > 2) it.progress = sv }
                    }
                    // Odśwież kropki SEQ na padach
                    val memoriesRowView = container.getChildAt(2) as? LinearLayout
                    val dotPosList = listOf(
                        Gravity.TOP or Gravity.START, Gravity.TOP or Gravity.END,
                        Gravity.BOTTOM or Gravity.START, Gravity.BOTTOM or Gravity.END
                    )
                    memoriesRowView?.let { row ->
                        for (idx in 0..15) {
                            val cell = row.getChildAt(idx) as? FrameLayout ?: continue
                            for (si in 0..3) {
                                val dotView = cell.findViewWithTag<View>("POS_DOT_${idx}_${si}") ?: continue
                                val isActive = seqEnabled[si] && seqGroupActive[si][posCurrentGroup] &&
                                        memorySeq[si].stepType[memorySeq[si].currentStep] == 3 &&
                                        memorySeq[si].stepValue[memorySeq[si].currentStep] == idx
                                dotView.alpha = if (isActive) 1f else 0f
                            }
                        }
                    }
                }
            }
        }

        return container
    }


    private fun createPresetsView(isExView: Boolean = false): View {
        isExPresetView = isExView
        presetsRefreshCallback = null
        val j = exactRowHeight
        val padCell = j * 2          // każdy pad: 2j × 2j (kwadratowy)
        val padsFixedW = padCell * 4 // padsPanel stała szerokość = 8j

        val container = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Companion.COL_BG)
            setPadding(3, 3, 3, 3)
        }

        fun thinBtn() = GradientDrawable().apply {
            shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_BG)
            setStroke(2, Color.BLACK); cornerRadius = 4f
        }
        fun colorBtn(col: Int) = GradientDrawable().apply {
            shape = GradientDrawable.RECTANGLE; setColor(col)
            setStroke(2, Color.BLACK); cornerRadius = 4f
        }

        // ── LEWY PANEL 1: Przyciski funkcyjne (stała szerokość 2j) ──────
        val funcPanel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = LinearLayout.LayoutParams(j * 2, -1).apply { setMargins(0, 0, 3, 0) }
        }
        val btnList = listOf("EDIT", "COPY", "CLEAR", "UNDO")
        btnList.forEach { txt ->
            val isActiveMode = when (txt) {
                "EDIT"  -> isPresetEditMode
                "COPY"  -> isPresetCopyMode
                "CLEAR" -> isPresetClearMode
                else    -> false
            }
            val bgCol = when {
                txt == "EDIT"  && isActiveMode  -> Color.YELLOW
                txt == "EDIT"                   -> Color.parseColor("#665500")
                txt == "COPY"  && isActiveMode  -> Color.WHITE
                txt == "COPY"                   -> Companion.COL_BTN
                txt == "CLEAR" && isActiveMode  -> Color.RED
                txt == "CLEAR"                  -> Color.parseColor("#660000")
                else                            -> Companion.COL_BTN
            }
            funcPanel.addView(TextView(this).apply {
                text = txt; gravity = Gravity.CENTER; textSize = 15f
                setTextColor(if (isActiveMode) Color.BLACK else Color.WHITE)
                layoutParams = LinearLayout.LayoutParams(-1, 0, 1.0f).apply { setMargins(0, 3, 0, 3) }
                background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; cornerRadius=4f; setColor(bgCol); setStroke(4, Color.BLACK) }
                setOnClickListener {
                    when (txt) {
                        "EDIT"  -> { isPresetEditMode  = !isPresetEditMode;  if (isPresetEditMode)  { isPresetCopyMode=false; isPresetClearMode=false; presetCopySourceIndex=-1 }; activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView)) }
                        "COPY"  -> { isPresetCopyMode  = !isPresetCopyMode;  if (isPresetCopyMode)  { isPresetEditMode=false; isPresetClearMode=false } else { presetCopySourceIndex=-1 }; activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView)) }
                        "CLEAR" -> { isPresetClearMode = !isPresetClearMode; if (isPresetClearMode) { isPresetEditMode=false; isPresetCopyMode=false; presetCopySourceIndex=-1 }; activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView)) }
                        "UNDO"  -> {
                            if (undoBuffer != null && undoBufferIndex != -1) {
                                val targetMem = if (isExPresetView) memoryExPresets else memoryPresets
                                targetMem[undoBufferIndex] = deepCopyPreset(undoBuffer!!)
                                undoBuffer = null; undoBufferIndex = -1
                                Toast.makeText(this@MainActivity, "undo complete!", Toast.LENGTH_SHORT).show()
                                activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView))
                                saveWorkspace(applicationContext.filesDir.absolutePath)
                            } else Toast.makeText(this@MainActivity, "No changes to undo!", Toast.LENGTH_SHORT).show()
                        }
                    }
                }
            })
        }
        container.addView(funcPanel)

        // ── LEWY PANEL 2: Banki (elastyczna szerokość – wypełnia resztę) ─
        val banksPanel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = LinearLayout.LayoutParams(0, -1, 1.0f).apply { setMargins(0, 0, 3, 0) }
        }
        val activeBank = if (isExPresetView) activeExPresetBank else activePresetBank
        for (bankIdx in 0..3) {
            val isActive = activeBank == bankIdx
            val bankName  = if (isExPresetView) Companion.exBankNames[bankIdx]  else Companion.presetBankNames[bankIdx]
            val bankColor = if (isExPresetView) Companion.exBankColors[bankIdx] else Companion.presetBankColors[bankIdx]
            val bankBg = GradientDrawable().apply {
                shape=GradientDrawable.RECTANGLE; cornerRadius=4f
                setColor(if (isActive) bankColor.let {
                    // rozjaśnij aktywny bank
                    val hsv = FloatArray(3)
                    Color.colorToHSV(it, hsv)
                    hsv[2] = (hsv[2] + 0.35f).coerceAtMost(1f)
                    Color.HSVToColor(hsv)
                } else bankColor)
                setStroke(if (isActive) 6 else 2, if (isActive) Color.WHITE else Color.BLACK)
            }
            val bankContainer = FrameLayout(this).apply {
                layoutParams = LinearLayout.LayoutParams(-1, 0, 1.0f).apply { setMargins(0, 3, 0, 3) }
                background = bankBg
            }
            val bankLum = Color.red(bankColor)*0.299 + Color.green(bankColor)*0.587 + Color.blue(bankColor)*0.114
            bankContainer.addView(TextView(this).apply {
                text = bankName; gravity = Gravity.CENTER; textSize = 15f
                setTextColor(if (bankLum > 100 || isActive) Color.BLACK else Color.WHITE)
                layoutParams = FrameLayout.LayoutParams(-1, -1)
            })
            bankContainer.setOnClickListener {
                if (isPresetEditMode) {
                    // EDIT + tap → zmień nazwę banku
                    isPresetEditMode = false
                    showInternalKeyboard(bankName) { newName ->
                        if (isExPresetView) Companion.exBankNames[bankIdx] = newName
                        else Companion.presetBankNames[bankIdx] = newName
                        activeViewContainer.removeAllViews()
                        activeViewContainer.addView(createPresetsView(isExPresetView))
                    }
                } else {
                    if (isExPresetView) activeExPresetBank = bankIdx else activePresetBank = bankIdx
                    activeViewContainer.removeAllViews()
                    activeViewContainer.addView(createPresetsView(isExPresetView))
                }
            }
            bankContainer.setOnLongClickListener {
                // Długie przytrzymanie → paleta kolorów banku
                showInternalPaletteMenu { c ->
                    if (isExPresetView) Companion.exBankColors[bankIdx] = corePaletteColors[c]
                    else Companion.presetBankColors[bankIdx] = corePaletteColors[c]
                    activeViewContainer.removeAllViews()
                    activeViewContainer.addView(createPresetsView(isExPresetView))
                }
                true
            }
            banksPanel.addView(bankContainer)
        }
        container.addView(banksPanel)

        // ── PRAWY PANEL: Pady 4×4 (stała szerokość 8j – nie skalują się) ─
        val padsPanel = GridLayout(this).apply {
            columnCount = 4; rowCount = 4
            layoutParams = LinearLayout.LayoutParams(padsFixedW, -1)
        }
        val targetMem = if (isExPresetView) memoryExPresets else memoryPresets

        fun updateAllPadsVisuals() {
            for (i in 0 until padsPanel.childCount) {
                val pad = padsPanel.getChildAt(i) as FrameLayout
                val absoluteIndex = (activeBank * 16) + i
                val preset = targetMem[absoluteIndex]
                val txtPad = pad.getChildAt(0) as TextView
                val bg = pad.background as GradientDrawable

                if (preset.isSaved) {
                    val c = Companion.corePaletteColors[preset.colorIdx]; bg.setColor(c)
                    val luminance = Color.red(c)*0.299 + Color.green(c)*0.587 + Color.blue(c)*0.114
                    txtPad.setTextColor(if (luminance > 128) Color.BLACK else Color.WHITE)
                    txtPad.text = preset.name
                } else {
                    bg.setColor(Companion.COL_PANEL)
                    txtPad.setTextColor(Color.WHITE)
                    txtPad.text = "Empty"
                }

                val glParams = pad.layoutParams as GridLayout.LayoutParams
                when {
                    isPresetCopyMode && presetCopySourceIndex == absoluteIndex -> { bg.setStroke(6, Color.WHITE); glParams.setMargins(2,2,2,2) }
                    !isExPresetView && absoluteIndex == activeAuxPresetIndex && activeAuxPresetIndex >= 0 -> { bg.setStroke(6, Color.CYAN); glParams.setMargins(2,2,2,2) }
                    !isExPresetView && absoluteIndex == activePresetIndex && activePresetIndex >= 0 -> { bg.setStroke(6, Color.YELLOW); glParams.setMargins(2,2,2,2) }
                    isExPresetView && Companion.activeExPresets[absoluteIndex] -> { bg.setStroke(6, Color.MAGENTA); glParams.setMargins(2,2,2,2) }
                    else -> { bg.setStroke(4, Color.BLACK); glParams.setMargins(4,4,4,4) }
                }
                pad.layoutParams = glParams; pad.background = bg

                // Kropka EX-memory
                val exDotTag = "ex_mem_dot"
                var exDot = pad.findViewWithTag<View>(exDotTag)
                if (exDot == null) {
                    exDot = View(this).apply {
                        tag = exDotTag
                        background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; cornerRadius=4f; setColor(Color.MAGENTA); setStroke(2,Color.BLACK) }
                        layoutParams = FrameLayout.LayoutParams(20, 20).apply { gravity=Gravity.TOP or Gravity.START; setMargins(6,6,0,0) }
                    }; pad.addView(exDot)
                }
                exDot.visibility = if (!isExPresetView && preset.isSaved && preset.useExMemory) View.VISIBLE else View.GONE

                if (isExPresetView) {
                    val seqDotTag = "seq_ctrl_dot"
                    var seqDot = pad.findViewWithTag<View>(seqDotTag)
                    if (seqDot == null) {
                        seqDot = View(this).apply {
                            tag = seqDotTag
                            background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; cornerRadius=3f; setColor(Color.TRANSPARENT); setStroke(2,Color.BLACK) }
                            layoutParams = FrameLayout.LayoutParams(20, 20).apply { gravity=Gravity.TOP or Gravity.END; setMargins(0,6,6,0) }
                        }; pad.addView(seqDot)
                    }
                    val controllingSeq = (0..3).firstOrNull { si -> seqEnabled[si] && memorySeq[si].stepType[memorySeq[si].currentStep]==4 && memorySeq[si].stepValue[memorySeq[si].currentStep]==absoluteIndex }
                    val seqDotDrawable = seqDot.background as GradientDrawable
                    if (controllingSeq != null) { seqDotDrawable.setColor(seqColors[controllingSeq]); seqDot.visibility=View.VISIBLE }
                    else { seqDotDrawable.setColor(Color.TRANSPARENT); seqDot.visibility=View.INVISIBLE }
                }
            }
        }

        for (row in 0..3) {
            for (col in 0..3) {
                val padIndex = row * 4 + col
                val padContainer = FrameLayout(this).apply {
                    layoutParams = GridLayout.LayoutParams().apply {
                        width=0; height=0
                        columnSpec=GridLayout.spec(col,1,1f); rowSpec=GridLayout.spec(row,1,1f)
                        setMargins(3,3,3,3)
                    }
                    background = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Companion.COL_PANEL); setStroke(4,Color.BLACK); cornerRadius=4f }
                }
                padContainer.tag = if (isExView) "MIDI:EXPRESET_${(activeBank * 16) + padIndex}"
                else "MIDI:PRESET_${(activeBank * 16) + padIndex}"
                padContainer.addView(TextView(this).apply { gravity=Gravity.CENTER; textSize=20f; layoutParams=FrameLayout.LayoutParams(-1,-1) })

                var lastClick = 0L
                padContainer.setOnClickListener {
                    val now = System.currentTimeMillis()
                    if (now - lastClick < 150L) return@setOnClickListener
                    lastClick = now
                    val absIdx = (activeBank * 16) + padIndex
                    val prst = targetMem[absIdx]
                    if (isPresetEditMode) {
                        isPresetEditMode = false
                        if (prst.isSaved) { editingPresetAbsoluteIndex=absIdx; activeExValIndex=4; activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetEditView(isExPresetView)) }
                        else { Toast.makeText(this@MainActivity,"Slot pusty!",Toast.LENGTH_SHORT).show(); activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView)) }
                    } else if (isPresetClearMode) {
                        undoBufferIndex=absIdx; undoBuffer=deepCopyPreset(prst); targetMem[absIdx]=PresetItem(); isPresetClearMode=false
                        if (!isExPresetView && activePresetIndex==absIdx) activePresetIndex=-1
                        if (isExPresetView) Companion.activeExPresets[absIdx]=false
                        Toast.makeText(this@MainActivity,"Wyczyszczono!",Toast.LENGTH_SHORT).show()
                        activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView))
                        Companion.saveWorkspace(applicationContext.filesDir.absolutePath)
                    } else if (isPresetCopyMode) {
                        if (presetCopySourceIndex==-1) {
                            if (prst.isSaved) { presetCopySourceIndex=absIdx; updateAllPadsVisuals() } else Toast.makeText(this@MainActivity,"No source!",Toast.LENGTH_SHORT).show()
                        } else {
                            if (presetCopySourceIndex!=absIdx) { targetMem[absIdx]=deepCopyPreset(targetMem[presetCopySourceIndex]).apply{name=if(isExPresetView)"EX ${absIdx+1}" else "PRST ${absIdx+1}"}; Toast.makeText(this@MainActivity,"Skopiowano!",Toast.LENGTH_SHORT).show(); Companion.saveWorkspace(applicationContext.filesDir.absolutePath) }
                            isPresetCopyMode=false; presetCopySourceIndex=-1
                            activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView))
                        }
                    } else {
                        if (prst.isSaved) {
                            if (!isExPresetView) {
                                synchronized(Companion.presetRecallLock) {
                                    if (prst.presetTarget==1) activeAuxPresetIndex=absIdx else activePresetIndex=absIdx
                                    val fTime=prst.fadeTime/10.0f
                                // KOLEJNOŚĆ KRYTYCZNA: ustaw isFadingMain/Aux i wyzeruj timer PRZED
                                // nadpisaniem baseDmxValues – inaczej silnik (inny wątek) mógłby w wąskiej
                                // szczelinie zobaczyć już nowy, surowy kolor bazowy, ale jeszcze isFading=false,
                                // co na jeden tick całkowicie wyłącza pomost fade (widoczne jako "błysk",
                                // zwłaszcza silny gdy LFO dokłada swoją pełną amplitudę na ten skok).
                                if (prst.presetTarget==0) { if(fTime>0f){Companion.currentFadeTimeMain=fTime;Companion.currentFadeTimerMain=0f;Companion.isFadingMain=true} else Companion.isFadingMain=false }
                                else { if(fTime>0f){Companion.currentFadeTimeAux=fTime;Companion.currentFadeTimerAux=0f;Companion.isFadingAux=true} else Companion.isFadingAux=false }
                                Companion.fixturesList.forEach { fix ->
                                    val isMyGroup=(Companion.groupRouting[fix.groupIdx]==prst.presetTarget)
                                    if (isMyGroup) { for (ch in 0 until fix.channels) { val addr=fix.dmx-1+ch; if (addr in 0..511) {
                                        val managedByFx = Companion.memoryFx.any { fx ->
                                            fx.isEnabled && fx.destIdx != -1 &&
                                                    Companion.paramList.getOrNull(fx.destIdx) == fix.paramMap[ch] &&
                                                    fx.groupIdx == fix.groupIdx
                                        }
                                        val startVal = if (managedByFx) Companion.baseDmxValues[addr] else Companion.dmxValues[addr]
                                        if(prst.presetTarget==0) Companion.baseDmxStartMain[addr]=startVal else Companion.baseDmxStartAux[addr]=startVal
                                        Companion.baseDmxValues[addr]=prst.dmxSnapshot[addr]
                                    } } }
                                }
                                Companion.updateFadeMask()
                                if (prst.useExMemory) System.arraycopy(prst.exMask,0,Companion.activeExPresets,0,64)
                                    if (prst.useFxMemory) {
                                        val fxFadeTime = prst.fadeTime / 10.0f
                                        for (fi in 0..3) {
                                            val fx = Companion.memoryFx[fi]
                                            if (Companion.groupRouting[fx.groupIdx] != prst.presetTarget) continue
                                            val wasEnabled = fx.isEnabled
                                            val willBeEnabled = prst.fxEnabled[fi]
                                            val oldAmt = fx.amt

                                        // Kopiuj parametry presetu
                                        fx.playState = prst.fxPlayState[fi]
                                        fx.shapeIdx  = prst.fxShapeIdx[fi]
                                        fx.speed     = prst.fxSpeed[fi]
                                        fx.isSync    = prst.fxIsSync[fi]
                                        fx.syncIdx   = prst.fxSyncIdx[fi]
                                        fx.spread    = prst.fxSpread[fi]
                                        fx.amt       = prst.fxAmt[fi]
                                        fx.phs       = prst.fxPhs[fi]
                                        fx.groupIdx  = prst.fxGroupIdx[fi]
                                        fx.destIdx   = prst.fxDestIdx[fi]
                                        Companion.fxFadeTimer[fi] = 0f
                                        Companion.fxFadeTime[fi] = fxFadeTime

                                        // Fade – odwrotność fade-in
                                        fx.playState = prst.fxPlayState[fi]
                                        fx.shapeIdx  = prst.fxShapeIdx[fi]
                                        fx.speed     = prst.fxSpeed[fi]
                                        fx.isSync    = prst.fxIsSync[fi]
                                        fx.syncIdx   = prst.fxSyncIdx[fi]
                                        fx.spread    = prst.fxSpread[fi]
                                        fx.phs       = prst.fxPhs[fi]
                                        fx.groupIdx  = prst.fxGroupIdx[fi]
                                        fx.destIdx   = prst.fxDestIdx[fi]
                                        if (!willBeEnabled && wasEnabled && fxFadeTime > 0f) {
                                            Companion.fxAmtStart[fi] = oldAmt
                                            fx.amt = 0
                                            fx.isEnabled = true
                                            Companion.fxDisableDelay[fi] = fxFadeTime
                                            Companion.fxFadeTimer[fi] = 0f
                                            Companion.fxFadeTime[fi] = fxFadeTime
                                        } else if (willBeEnabled) {
                                            Companion.fxAmtStart[fi] = if (wasEnabled) oldAmt else 0
                                            fx.amt = prst.fxAmt[fi]
                                            fx.isEnabled = true
                                            Companion.fxDisableDelay[fi] = 0f
                                            Companion.fxFadeTimer[fi] = 0f
                                            Companion.fxFadeTime[fi] = fxFadeTime
                                        } else {
                                            // FX wyłączony – nie interpoluj, ustaw timer na koniec żeby silnik nie ruszał kanałów
                                            Companion.fxAmtStart[fi] = 0
                                            fx.amt = 0
                                            fx.isEnabled = false
                                            Companion.fxDisableDelay[fi] = 0f
                                            Companion.fxFadeTimer[fi] = fxFadeTime
                                            Companion.fxFadeTime[fi] = fxFadeTime
                                        }
                                    }
                                }
                                Companion.extColorPaletteIdx=prst.extColorPaletteIdx
                                if (Companion.extColorRouting==0) { val dmx=Companion.getPaletteDmxValues(prst.extColorPaletteIdx); System.arraycopy(dmx,0,Companion.extColorDmxValues,0,6) }
                                val affectedGroups=(0..7).filter{g->Companion.groupRouting[g]==prst.presetTarget}.toSet()
                                for (i in 0..3) {
                                    val lfo=memoryLfo[i]
                                    if (Companion.lfoTarget[i]==prst.presetTarget) {
                                        // Zwolnij STARE kanały LFO przed zmianą destynacji.
                                        // Bez tego effectManagedChannels[addr] zostaje true dla starych
                                        // kanałów (np. Tilt), refreshDmxOutput je pomija i fade nigdy
                                        // nie dociera do tych kanałów — widoczne jako "duch" po LFO.
                                        for (d in 0..3) {
                                            val oldFix = lfo.fix[d]; val oldDest = lfo.dest[d]
                                            if (oldFix == -1 || oldDest == -1) continue
                                            val oldParam = Companion.paramList.getOrNull(oldDest) ?: continue
                                            val oldFixes = if (oldFix in 1000..1007)
                                                Companion.fixturesList.filter { it.groupIdx == oldFix - 1000 }
                                            else listOfNotNull(Companion.fixturesList.find { it.id == oldFix })
                                            oldFixes.forEach { fix ->
                                                if (Companion.groupRouting[fix.groupIdx] != prst.presetTarget) return@forEach
                                                for (ch in 0 until fix.channels) {
                                                    if (fix.paramMap[ch] == oldParam) {
                                                        val addr = fix.dmx - 1 + ch
                                                        if (addr in 0..511) Companion.effectManagedChannels[addr] = false
                                                    }
                                                }
                                            }
                                        }
                                        lfoEnabled[i]=prst.lfoEnabledMask[i]; lfo.shapeIdx=prst.lfoShapes[i]; lfo.rate=prst.lfoRates[i]; lfo.isSync=prst.lfoSyncs[i]; lfo.syncIdx=prst.lfoSyncIdxs[i]; lfo.pwm=prst.lfoPwms[i]; for(d in 0..3){lfo.fix[d]=prst.lfoFix[i][d];lfo.dest[d]=prst.lfoDest[i][d];lfo.amt[d]=prst.lfoAmt[i][d];lfo.fad[d]=prst.lfoFad[i][d];lfo.off[d]=prst.lfoOff[i][d];lfo.phs[d]=prst.lfoPhs[i][d]}; for(d in 0..3){lfo.destSmoothed[d]=0f;for(fi in lfo.fixSmoothed[d].indices) lfo.fixSmoothed[d][fi]=0f}
                                    }
                                    val seqWasEnabled = seqEnabled[i]
                                    if (Companion.seqTarget[i]==prst.presetTarget) {
                                        val willDisable = !prst.seqEnabledMask[i]
                                        if (seqWasEnabled) {
                                            releaseSeqChannels(i, prst.presetTarget)
                                        }
                                        if (willDisable) {
                                            seqEnabled[i] = false
                                        }
                                    }
                                    // NIE dotykaj SEQ które należą do innego targetu
                                    for (g in 0..7){
                                        // Tylko grupy należące do tego presetu
                                        if (Companion.groupRouting[g] != prst.presetTarget) continue
                                        val wasOnSeq = seqGroupActive[i][g]
                                        val newSeqVal = if (g in affectedGroups) prst.seqMatrix[i][g] else false
                                        if (g in affectedGroups) lfoGroupActive[i][g]=prst.lfoMatrix[i][g]
                                        seqGroupActive[i][g]=newSeqVal
                                        if (newSeqVal) {
                                            Companion.colorManualOverride[g] = false
                                            Companion.posPanOffset[g] = 0f
                                            Companion.posTiltOffset[g] = 0f
                                            Companion.posFadeActiveSinceReset[g] = true
                                        }
                                        if (wasOnSeq && !newSeqVal && Companion.groupRouting[g] == prst.presetTarget) {
                                            Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                                                for (ch in 0 until fix.channels) {
                                                    val addr = fix.dmx - 1 + ch
                                                    if (addr in 0..511) {
                                                        Companion.effectManagedChannels[addr] = false
                                                        dmxPersist[addr] = Companion.baseDmxValues[addr].toFloat()
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if (Companion.seqTarget[i]==prst.presetTarget) { seqEnabled[i]=prst.seqEnabledMask[i]; val sq=memorySeq[i]; sq.totalSteps=prst.seqTotalSteps[i];sq.globalTime=prst.seqGlobalTimes[i];sq.isSync=prst.seqIsSyncs[i];sq.syncIdx=prst.seqSyncIdxs[i];sq.globalFade=prst.seqGlobalFades[i];sq.globalPhase=prst.seqGlobalPhases[i]; for(s in 0..15){sq.stepType[s]=prst.seqStepTypes[i][s];sq.stepValue[s]=prst.seqStepValues[i][s];sq.stepTime[s]=prst.seqStepTimes[i][s];sq.stepFade[s]=prst.seqStepFades[i][s];sq.stepIsSync[s]=prst.seqStepIsSyncs[i][s];sq.stepSyncIdx[s]=prst.seqStepSyncIdxs[i][s]}; sq.currentStep=0; sq.prevStep=0; sq.stepTimer=0f; sq.justReset=true }

                                    // Resync: po recall presetu, LFO/SEQ w trybie SYNC muszą zawsze zaczynać
                                    // od fazy 0 – identycznie jak przy zaprogramowaniu i jak po długim TAP.
                                    // Bez tego, akumulatory beatu (lfoBeatAccum/seqBeatAccum) kontynuowałyby
                                    // z poprzedniego, niezsynchronizowanego momentu, powodując rozjazd
                                    // pomiędzy efektami mimo identycznego SYNC.
                                    if (Companion.lfoTarget[i]==prst.presetTarget && lfo.isSync) {
                                        Companion.lfoBeatAccum[i] = 0.0
                                        lfo.phase = 0f
                                    }
                                    if (Companion.seqTarget[i]==prst.presetTarget && memorySeq[i].isSync) {
                                        Companion.seqBeatAccum[i] = 0.0
                                    }
                                    if (Companion.seqTarget[i]==prst.presetTarget) {
                                        Companion.seqPingPongPos[i] = 0L
                                        Companion.seqPingPongDirection[i] = 1
                                    }
                                }
                                // Reset posSmoothedValues
                                // Bez tego stara wartość z poprzedniego SEQ pozycji "dogania" nowy preset
                                // przez cały czas fade (posFadeActiveSinceReset=true + stara smoothed value).
                                val affectedGroupsFinal = (0..7).filter { g -> Companion.groupRouting[g] == prst.presetTarget }
                                    // Przywróć FAN
                                    System.arraycopy(prst.fanOffsets, 0, fanDmxOffsets, 0, 512)

                                    for (g in affectedGroupsFinal) {
                                        Companion.seqRoutingMode[g] = prst.seqRoutingModes[g]
                                    val patIdx = prst.seqActivePatterns[g]
                                    if (patIdx in 0..5) {
                                        val pat = Companion.seqPatternMemories[g][patIdx]
                                        if (pat.isSaved) {
                                            Companion.seqRoutingOrder[g].clear()
                                            Companion.seqRoutingOrder[g].addAll(pat.order)
                                            Companion.seqRoutingOn[g].clear()
                                            Companion.seqRoutingOn[g].addAll(pat.onList)
                                            Companion.seqActivePattern[g] = patIdx
                                        }
                                    } else {
                                        Companion.seqActivePattern[g] = -1
                                    }
                                    Companion.posPanOffset[g] = 0f
                                    Companion.posTiltOffset[g] = 0f
                                    Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                                        for (ch in 0 until fix.channels) {
                                            val p = fix.paramMap[ch]
                                            if (p == "Pan" || p == "Pan Fine" || p == "Tilt" || p == "Tilt Fine") {
                                                val addr = fix.dmx - 1 + ch
                                                if (addr in 0..511) {
                                                    // Inicjuj z aktualnej pozycji żeby uniknąć szarpnięcia
                                                    Companion.posSmoothedValues[addr] = Companion.dmxValues[addr].toFloat()
                                                }
                                            }
                                        }
                                    }
                                }
                                    // refreshDmxOutput() usunięte – silnik odświeży na najbliższym ticku (≤25ms),
                                    // bez ryzyka konkurencyjnego zapisu z wątkiem UI.
                                } // synchronized
                            } else {
                                Companion.activeExPresets[absIdx]=!Companion.activeExPresets[absIdx]
                                updateAllPadsVisuals()
                            }
                            updateAllPadsVisuals()
                        } else Toast.makeText(this@MainActivity,"Empty slot!",Toast.LENGTH_SHORT).show()
                    }
                }

                padContainer.setOnLongClickListener {
                    if (isPresetEditMode||isPresetCopyMode||isPresetClearMode) return@setOnLongClickListener true
                    val absIdx=(activeBank*16)+padIndex; val prst=targetMem[absIdx]
                    undoBufferIndex=absIdx; undoBuffer=deepCopyPreset(prst)
                    if (!prst.isSaved) prst.name=if(isExPresetView)"EX ${absIdx+1}" else "PRST ${absIdx+1}"
                    prst.isSaved=true
                    if (!isExPresetView) {
                        val snapDmx=Companion.baseDmxValues.clone(); for(addr in 0..511) prst.dmxSnapshot[addr]=0
                        Companion.fixturesList.forEach{fix->val isMyGroup=(Companion.groupRouting[fix.groupIdx]==prst.presetTarget);for(ch in 0 until fix.channels){val addr=fix.dmx-1+ch;if(addr in 0..511) prst.dmxSnapshot[addr]=if(isMyGroup) snapDmx[addr] else 0}}
                        System.arraycopy(Companion.activeExPresets,0,prst.exMask,0,64)
                        if (prst.useFxMemory) {
                            for (fi in 0..3) {
                                val fx = Companion.memoryFx[fi]
                                prst.fxEnabled[fi]   = fx.isEnabled
                                prst.fxPlayState[fi] = fx.playState
                                prst.fxShapeIdx[fi]  = fx.shapeIdx
                                prst.fxSpeed[fi]     = fx.speed
                                prst.fxIsSync[fi]    = fx.isSync
                                prst.fxSyncIdx[fi]   = fx.syncIdx
                                prst.fxSpread[fi]    = fx.spread
                                prst.fxAmt[fi]       = fx.amt
                                prst.fxPhs[fi]       = fx.phs
                                prst.fxGroupIdx[fi]  = fx.groupIdx
                                prst.fxDestIdx[fi]   = fx.destIdx
                            }
                        }
                        prst.extColorPaletteIdx=Companion.extColorPaletteIdx; prst.extColorRouting=Companion.extColorRouting
                        for (i in 0..3) {
                            if (Companion.lfoTarget[i]==prst.presetTarget) { prst.lfoEnabledMask[i]=lfoEnabled[i]; val lfo=memoryLfo[i]; prst.lfoShapes[i]=lfo.shapeIdx;prst.lfoRates[i]=lfo.rate;prst.lfoSyncs[i]=lfo.isSync;prst.lfoSyncIdxs[i]=lfo.syncIdx;prst.lfoPwms[i]=lfo.pwm; for(d in 0..3){prst.lfoFix[i][d]=lfo.fix[d];prst.lfoDest[i][d]=lfo.dest[d];prst.lfoAmt[i][d]=lfo.amt[d];prst.lfoFad[i][d]=lfo.fad[d];prst.lfoOff[i][d]=lfo.off[d];prst.lfoPhs[i][d]=lfo.phs[d]}; for(g in 0..7){val own=Companion.groupRouting[g]==prst.presetTarget;prst.lfoMatrix[i][g]=if(own) lfoGroupActive[i][g] else false} }
                            if (Companion.seqTarget[i]==prst.presetTarget) { prst.seqEnabledMask[i]=seqEnabled[i]; val sq=memorySeq[i]; prst.seqTotalSteps[i]=sq.totalSteps;prst.seqGlobalTimes[i]=sq.globalTime;prst.seqIsSyncs[i]=sq.isSync;prst.seqSyncIdxs[i]=sq.syncIdx;prst.seqGlobalFades[i]=sq.globalFade;prst.seqGlobalPhases[i]=sq.globalPhase; for(s in 0..15){prst.seqStepTypes[i][s]=sq.stepType[s];prst.seqStepValues[i][s]=sq.stepValue[s];prst.seqStepTimes[i][s]=sq.stepTime[s];prst.seqStepFades[i][s]=sq.stepFade[s];prst.seqStepIsSyncs[i][s]=sq.stepIsSync[s];prst.seqStepSyncIdxs[i][s]=sq.stepSyncIdx[s]}; for(g in 0..7){val own=Companion.groupRouting[g]==prst.presetTarget;prst.seqMatrix[i][g]=if(own) seqGroupActive[i][g] else false} }
                        }
                        for (g in 0..7) {
                            prst.seqActivePatterns[g] = Companion.seqActivePattern[g]
                            prst.seqRoutingModes[g] = Companion.seqRoutingMode[g]
                        }
                        System.arraycopy(fanDmxOffsets, 0, prst.fanOffsets, 0, 512)
                        if (prst.presetTarget==1) activeAuxPresetIndex=absIdx else activePresetIndex=absIdx
                    }
                    activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isExPresetView))
                    Toast.makeText(this@MainActivity,"Saved!",Toast.LENGTH_SHORT).show()
                    Companion.saveWorkspace(applicationContext.filesDir.absolutePath); true
                }
                padsPanel.addView(padContainer)
            }
        }
        updateAllPadsVisuals()
        if (isExView) exPresetsRefreshCallback = { updateAllPadsVisuals() }
        else presetsRefreshCallback = { updateAllPadsVisuals() }
        container.addView(padsPanel)

        if (isExPresetView) {
            lifecycleScope.launchWhenResumed {
                while (isActive) {
                    delay(100)
                    if (activeViewContainer.getChildAt(0)!==container) break
                    container.post { updateAllPadsVisuals() }
                }
            }
        }
        return container
    }


    private fun createPresetEditView(isEx: Boolean): View {
        val targetMem = if (isEx) memoryExPresets else memoryPresets
        val preset = targetMem[editingPresetAbsoluteIndex]
        val totalHeight = resources.displayMetrics.heightPixels - exactRowHeight
        val singleRowHeight = (totalHeight / 8.0).toInt()

        val rootContainer = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            weightSum = 10.0f
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Companion.COL_BG)
        }

        val btnStyle = getBtnStyle()
        val exValTextViews = arrayOfNulls<TextView>(4)
        val exPreviewBoxes = arrayOfNulls<LinearLayout>(4)
        var fadeBtnRef: TextView? = null

        fun fireExParamDmx(index: Int, vVal: Int) {
            val fId = preset.exFix[index]
            val dIdx = preset.exDest[index]
            if (fId == -1 || dIdx == -1) return
            val paramName = paramList.getOrNull(dIdx) ?: return

            if (fId in 1000..1007) {
                val grpIdx = fId - 1000
                fixturesList.filter { it.groupIdx == grpIdx }.forEach { fix ->
                    val chIdx = fix.paramMap.indexOf(paramName)
                    if (chIdx != -1) {
                        val actCh = fix.dmx - 1 + chIdx
                        if (actCh in 0..511) {
                            val mapped = fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                            dmxValues[actCh] = mapped; setDmxChannel(actCh, mapped)
                        }
                    }
                }
            } else {
                val fix = fixturesList.find { it.id == fId } ?: return
                val chIdx = fix.paramMap.indexOf(paramName)
                if (chIdx != -1) {
                    val actCh = fix.dmx - 1 + chIdx
                    if (actCh in 0..511) {
                        val mapped = fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                        dmxValues[actCh] = mapped; setDmxChannel(actCh, mapped)
                    }
                }
            }
        }

        val syncNames = listOf("1/64","1/32","1/16","1/8","1/6","1/4","1/3","1/2","1","2","3","4")

        fun itemLabelFor(fId: Int): String = when {
            fId == -1 -> "---"
            fId in 1000..1007 -> "Group ${'A'+(fId-1000)}"
            fId in 3000..3003 -> "LFO ${fId-2999}"
            fId in 4000..4003 -> "SEQ ${fId-3999}"
            fId in 5000..5003 -> "FX ${fId-4999}"
            fId == 6000 -> "EXT Color"
            fId in 0..999 -> fixturesList.find { it.id == fId }?.name ?: "Fix $fId"
            else -> "---"
        }

        fun parseItemSelection(selection: String): Int = when {
            selection == "---" -> -1
            selection.startsWith("Group") -> 1000 + (selection.last() - 'A')
            selection.startsWith("Fix") -> selection.substringAfter("Fix ").substringBefore(":").toIntOrNull() ?: -1
            selection.startsWith("LFO ") -> 2999 + selection.substringAfter("LFO ").trim().toInt()
            selection.startsWith("SEQ ") -> 3999 + selection.substringAfter("SEQ ").trim().toInt()
            selection.startsWith("FX ")  -> 4999 + selection.substringAfter("FX ").trim().toInt()
            selection == "EXT Color" -> 6000
            else -> -1
        }

        fun destOptionsForBase(fId: Int): List<String> = when {
            fId in 1000..1007 -> {
                val groupFix = fixturesList.firstOrNull { it.groupIdx == (fId-1000) }
                listOf("---") + (groupFix?.paramMap?.filter { it.isNotEmpty() && it != "Clear" }?.distinct() ?: emptyList())
            }
            fId in 0..999 -> {
                val fix = fixturesList.find { it.id == fId }
                listOf("---") + (fix?.paramMap?.filter { it.isNotEmpty() && it != "Clear" }?.distinct() ?: emptyList())
            }
            fId in 3000..3003 -> listOf("---","Status","Rate","PWM")
            fId in 4000..4003 -> listOf("---","Status","Time","Length","Phase")
            fId in 5000..5003 -> listOf("---","Status","Direction","Spread","AMT","PHS")
            fId == 6000 -> listOf("---","Routing","Color")
            else -> listOf("---")
        }

        fun destCodeFor(fId: Int, label: String): Int {
            if (label == "---") return -1
            return when {
                fId in 1000..1007 || fId in 0..999 -> paramList.indexOf(label)
                fId in 3000..3003 -> when(label){"Status"->9000;"Rate"->9001;"PWM"->9002; else->-1}
                fId in 4000..4003 -> when(label){"Status"->9010;"Time"->9011;"Length"->9012;"Phase"->9013; else->-1}
                fId in 5000..5003 -> when(label){"Status"->9020;"Direction"->9021;"Spread"->9022;"AMT"->9023;"PHS"->9024; else->-1}
                fId == 6000 -> when(label){"Routing"->9030;"Color"->9031; else->-1}
                else -> -1
            }
        }

        fun destLabelFor(fId: Int, dIdx: Int): String {
            if (dIdx == -1) return "---"
            return when {
                fId in 1000..1007 || fId in 0..999 -> paramList.getOrElse(dIdx){"---"}
                fId in 3000..3003 -> when(dIdx){9000->"Status";9001->"Rate";9002->"PWM"; else->"---"}
                fId in 4000..4003 -> when(dIdx){9010->"Status";9011->"Time";9012->"Length";9013->"Phase"; else->"---"}
                fId in 5000..5003 -> when(dIdx){9020->"Status";9021->"Direction";9022->"Spread";9023->"AMT";9024->"PHS"; else->"---"}
                fId == 6000 -> when(dIdx){9030->"Routing";9031->"Color"; else->"---"}
                else -> "---"
            }
        }

        fun destOptionsFor(fId: Int, slotIdx: Int): List<String> {
            val base = destOptionsForBase(fId)
            if (fId == -1) return base
            val usedLabels = (0..3).filter { it != slotIdx && preset.exFix[it] == fId && preset.exDest[it] != -1 }
                .map { destLabelFor(fId, preset.exDest[it]) }
            return listOf(base.first()) + base.drop(1).filterNot { it in usedLabels }
        }

        fun refreshValUI(i: Int, vVal: Int) {
            val fId = preset.exFix[i]
            val dIdx = preset.exDest[i]
            var valTextStr = vVal.toString()
            var colorPreviewFound = false
            var c1 = Color.BLACK; var c2 = Color.BLACK
            var isHalfPreview = false

            when {
                fId in 1000..1007 || fId in 0..999 -> {
                    val destStr = if (dIdx == -1) "---" else paramList.getOrElse(dIdx) { "---" }
                    if (destStr == "Col. wheel") {
                        val fixItem = if (fId in 1000..1007) fixturesList.find { it.groupIdx == (fId - 1000) && it.paramMap.contains("Col. wheel") } else fixturesList.find { it.id == fId }
                        if (fixItem != null && fixItem.cwCount > 0) {
                            data class CwPoint(val dmx: Int, val isHalf: Boolean, val slotIdx: Int)
                            val points = mutableListOf<CwPoint>()
                            for(s in 0 until fixItem.cwCount) {
                                points.add(CwPoint(fixItem.cwDmx[s], false, s))
                                points.add(CwPoint(fixItem.cwHalfDmx[s], true, s))
                            }
                            points.sortBy { it.dmx }
                            val match = points.lastOrNull { it.dmx <= vVal } ?: points.firstOrNull()
                            if (match != null) {
                                val s = match.slotIdx
                                if (match.isHalf) {
                                    c1 = corePaletteColors[fixItem.cwColors[s]]
                                    c2 = corePaletteColors[fixItem.cwColors[(s + 1) % fixItem.cwCount]]
                                    isHalfPreview = true
                                    valTextStr = "S ${s + 1}.5"
                                } else {
                                    c1 = corePaletteColors[fixItem.cwColors[s]]
                                    valTextStr = "S ${s + 1}"
                                }
                                colorPreviewFound = true
                            }
                        }
                    } else if (destStr == "Gobo" || destStr == "Gobo2") {
                        valTextStr = "$vVal (Gobo)"
                    }
                }
                fId in 3000..3003 -> {
                    val lfo = memoryLfo[fId - 3000]
                    when (dIdx) {
                        9000 -> valTextStr = if (vVal >= 128) "ON" else "OFF"
                        9001 -> valTextStr = if (lfo.isSync) syncNames.getOrElse(vVal.coerceIn(0,12)){"1"} else "${String.format("%.3f", vVal*0.125f)} Hz"
                        9002 -> valTextStr = "$vVal %"
                    }
                }
                fId in 4000..4003 -> {
                    val sq = memorySeq[fId - 4000]
                    when (dIdx) {
                        9010 -> valTextStr = if (vVal >= 128) "ON" else "OFF"
                        9011 -> valTextStr = if (sq.isSync) syncNames.getOrElse(vVal.coerceIn(0,12)){"1"} else timeToDisplay(sliderToTime(vVal))
                        9012 -> valTextStr = "${vVal+1} steps"
                        9013 -> valTextStr = "Phase ${vVal.coerceAtMost((sq.totalSteps-1).coerceAtLeast(0))}"
                    }
                }
                fId in 5000..5003 -> {
                    when (dIdx) {
                        9020 -> valTextStr = if (vVal >= 128) "ON" else "OFF"
                        9021 -> valTextStr = if (vVal >= 128) "▶" else "◀"
                        9022 -> valTextStr = "$vVal"
                        9023 -> valTextStr = "${vVal-255}"
                        9024 -> valTextStr = "$vVal°"
                    }
                }
                fId == 6000 -> {
                    when (dIdx) {
                        9030 -> { val rIdx=vVal.coerceIn(0,4); valTextStr = listOf("EXT","SEQ 1","SEQ 2","SEQ 3","SEQ 4")[rIdx] }
                        9031 -> { colorPreviewFound = true; c1 = corePaletteColors[vVal.coerceIn(0,63)]; valTextStr = "" }
                    }
                }
            }

            exValTextViews[i]?.text = valTextStr
            exValTextViews[i]?.layoutParams = LinearLayout.LayoutParams(0, -1, if (colorPreviewFound) 1.0f else 2.0f)

            exPreviewBoxes[i]?.removeAllViews()
            if (colorPreviewFound) {
                if (isHalfPreview) {
                    exPreviewBoxes[i]?.addView(View(this@MainActivity).apply { layoutParams = LinearLayout.LayoutParams(0, -1, 1.0f); setBackgroundColor(c1) })
                    exPreviewBoxes[i]?.addView(View(this@MainActivity).apply { layoutParams = LinearLayout.LayoutParams(0, -1, 1.0f); setBackgroundColor(c2) })
                } else {
                    exPreviewBoxes[i]?.addView(View(this@MainActivity).apply { layoutParams = LinearLayout.LayoutParams(-1, -1); setBackgroundColor(c1) })
                }
            }
        }

        // --- GLOWNA CZESC LEWA ---
        val leftPanel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL; weightSum = 8.0f
            layoutParams = LinearLayout.LayoutParams(0, -1, 8.5f) // LEWY PANEL ZAWSZE 8.5!
        }

        val rBack = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL; layoutParams = LinearLayout.LayoutParams(-1, 0, 1.0f) }
        val backBtn = TextView(this).apply { text="< BACK"; gravity=Gravity.CENTER; setTextColor(Color.WHITE); background=btnStyle; layoutParams=LinearLayout.LayoutParams(0,-1, 2.0f).apply{setMargins(5,5,5,5)}; setOnClickListener{ activeExValIndex = -1; activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetsView(isEx)); saveWorkspace(applicationContext.filesDir.absolutePath) } }
        rBack.addView(backBtn)

        if (isEx) {
            val fetchBtn = TextView(this).apply {
                text="FETCH LAST"; gravity=Gravity.CENTER; setTextColor(Color.WHITE); background=getBtnStyle().apply{setColor(Color.parseColor("#0055AA"))}; layoutParams=LinearLayout.LayoutParams(0,-1, 2.0f).apply{setMargins(5,5,5,5)}
                setOnClickListener{
                    for(i in 0..3) { preset.exFix[i] = lastTouchedParams[i].fixId; preset.exDest[i] = lastTouchedParams[i].destIdx; preset.exVal[i] = lastTouchedParams[i].lastVal }
                    activeExValIndex = -1
                    Toast.makeText(this@MainActivity, "Pobrano z pamieci!", Toast.LENGTH_SHORT).show()
                    activeViewContainer.removeAllViews(); activeViewContainer.addView(createPresetEditView(isEx))
