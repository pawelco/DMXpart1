                    }
                    activeIdx + 1 -> {
                        btn.background = android.graphics.drawable.LayerDrawable(arrayOf(
                            GradientDrawable().apply { setColor(Companion.COL_BG) },
                            GradientDrawable().apply {
                                shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                                setCornerRadii(floatArrayOf(tabR,tabR, 0f,0f, 0f,0f, 0f,0f))
                            }
                        ))
                        btn.setTextColor(Color.WHITE)
                    }
                    else -> {
                        btn.background = GradientDrawable().apply {
                            shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                        }
                        btn.setTextColor(Color.WHITE)
                    }
                }
            }
        }

        for (i in 0..7) {
            val btn = TextView(this@MainActivity).apply {
                text = "GRP ${'A'+i}"; gravity = Gravity.CENTER; textSize = 14f
                tag = "MIDI:GROUP_SELECT_$i"
                layoutParams = LinearLayout.LayoutParams(0, -1, 1.0f)
                setOnClickListener {
                    currentGroup = i; currentSliderPage = 0; isFixtureMode = false; currentFixture = 1
                    if (posEditMode) { posCurrentGroup = i; posIsFixtureMode = false }
                    updateGroupTabBgs(i)
                    for (c2 in 0 until maxSliders) {
                        val c = sliderContainers.getOrNull(c2) ?: continue
                        for (si in 0..3) c.findViewWithTag<View>("SEQ_COL_${c2}_$si")?.alpha = 0f
                        for (li in 0..3) c.findViewWithTag<View>("LFO_LINE_${c2}_$li")?.alpha = 0f
                    }
                    updateSlidersHeaderUI(); updateSlidersViewUI()
                }
            }
            groupTabs.add(btn); tabsRow.addView(btn)
        }
        updateGroupTabBgs(currentGroup)
        container.addView(tabsRow)


        // ── COROUTINE: animacja THUMB_VAL, LFO, SEQ ──────────────
        lifecycleScope.launchWhenResumed {
            while (isActive) {
                delay(25)
                if (activeViewContainer.getChildAt(0) !== container) break
                if (sliderSeekBars.isEmpty()) continue

                val groupFixes = Companion.fixturesList.filter { it.groupIdx == currentGroup }
                val activeFix = if (isFixtureMode) groupFixes.getOrNull(currentFixture-1) else groupFixes.firstOrNull()

                for (col in 0 until sliderContainers.size) {
                    val cont = sliderContainers.getOrNull(col) ?: continue
                    if (cont.visibility != View.VISIBLE) {
                        for (li in 0..3) cont.findViewWithTag<View>("LFO_LINE_${col}_$li")?.alpha = 0f
                        for (si in 0..3) cont.findViewWithTag<View>("SEQ_COL_${col}_$si")?.alpha = 0f
                        continue
                    }
                    val paramName = activeFix?.paramMap?.getOrNull(col) ?: ""
                    val seekBar = sliderSeekBars.getOrNull(col) ?: continue
                    val contH = cont.height.toFloat(); val contW = cont.width
                    if (contH <= 0f) continue

                    // THUMB_VAL – seekBar.progress (pozycja suwaka, nie DMX wyjście)
                    // createDataSlider: seekBar width=trackLen=4u, padding=seekPad
                    // zakres ruchu uchwytu = trackLen - 2*seekPad
                    val thumbLbl = cont.findViewWithTag<TextView>("THUMB_VAL_$col")
                    if (thumbLbl != null) {
                        val normT = seekBar.progress / 255f
                        val seekRange = trackLen.toFloat() - 2f * seekPad
                        // seekbar jest wyśrodkowany w contH (sliderBox)
                        // dolna krawędź toru = contH/2 + trackLen/2 - seekPad
                        // górna krawędź toru = contH/2 - trackLen/2 + seekPad
                        val trackBottom = contH / 2f + trackLen / 2f - seekPad
                        val thumbCY = trackBottom - normT * seekRange
                        val lp = thumbLbl.layoutParams as FrameLayout.LayoutParams
                        lp.gravity = Gravity.NO_GRAVITY
                        val tlH = thumbLbl.height.takeIf { it > 0 } ?: (u * 0.55).toInt()
                        val tlW = thumbLbl.width.takeIf { it > 0 } ?: (u * 1.1).toInt()
                        lp.topMargin = (thumbCY - tlH / 2f).toInt().coerceIn(0, (contH - tlH).toInt().coerceAtLeast(0))
                        lp.leftMargin = if (contW > 0) ((contW - tlW) / 2).coerceAtLeast(0) else 0
                        thumbLbl.layoutParams = lp
                        thumbLbl.text = String.format("%03d", seekBar.progress)
                        thumbLbl.bringToFront(); thumbLbl.requestLayout()
                    }

                    // LFO kreseczki
                    for (li in 0..3) {
                        val lv = cont.findViewWithTag<View>("LFO_LINE_${col}_$li") ?: continue
                        if (!lfoEnabled[li] || paramName.isEmpty()) { lv.alpha = 0f; continue }
                        val lfo = memoryLfo[li]; var found = false
                        for (d in 0..3) { val fId=lfo.fix[d];val dIdx=lfo.dest[d];if(fId==-1||dIdx==-1) continue;val lp2=Companion.paramList.getOrNull(dIdx)?:continue;if(lp2!=paramName) continue;val lg=when{fId in 1000..1007->fId-1000;else->Companion.fixturesList.find{it.id==fId}?.groupIdx?:-1};if(lg!=currentGroup||!lfoGroupActive[li][lg]) continue;found=true;break }
                        if (!found) { lv.alpha = 0f; continue }
                        lv.alpha = 0.9f
                        var actualDmxNorm = seekBar.progress.toFloat() / 255f
                        if (activeFix != null && paramName.isNotEmpty()) { for (ch in 0 until activeFix.channels) { if (activeFix.paramMap[ch] == paramName) { val actCh2=activeFix.dmx-1+ch;if(actCh2 in 0..511){val raw2=Companion.lfoOutputValues[actCh2];val min2=activeFix.paramMin[ch];val max2=activeFix.paramMax[ch];val range2=max2-min2;actualDmxNorm=if(range2==0)0f else((raw2-min2).toFloat()/range2).coerceIn(0f,1f)};break} } }
                        val trackBottom2 = contH / 2f + trackLen / 2f - seekPad
                        val topM = (trackBottom2 - actualDmxNorm * (trackLen - 2f * seekPad) - 6f).toInt().coerceIn(0, contH.toInt() - 12)
                        (lv.layoutParams as FrameLayout.LayoutParams).topMargin = topM; lv.requestLayout()
                    }

                    // SEQ słupki
                    val colorP = setOf("Red","Green","Blue","White","Amber","UV","Beam 1R","Beam 1G","Beam 1B","Beam 1W","Beam 1A","Col. wheel")
                    val movP = setOf("Pan","Pan Fine","Tilt","Tilt Fine","Zoom","Focus","Iris","PT speed")
                    val lfoStealableParams = setOf("Zoom","Focus","Iris")
                    val isCP = paramName in colorP; val isMP = paramName in movP
                    val stolenByLfo = paramName in lfoStealableParams && (0..3).any { li ->
                        lfoEnabled[li] && lfoGroupActive[li][currentGroup] &&
                                (0..3).any { d ->
                                    val fIdL = memoryLfo[li].fix[d]; val dIdxL = memoryLfo[li].dest[d]
                                    if (fIdL == -1 || dIdxL == -1) return@any false
                                    val pNameL = Companion.paramList.getOrNull(dIdxL) ?: return@any false
                                    if (pNameL != paramName) return@any false
                                    val gL = when { fIdL in 1000..1007 -> fIdL - 1000; else -> Companion.fixturesList.find { it.id == fIdL }?.groupIdx ?: -1 }
                                    gL == currentGroup
                                }
                    }
                    for (si in 0..3) {
                        val sv = cont.findViewWithTag<View>("SEQ_COL_${col}_$si") ?: continue
                        if (stolenByLfo) { sv.alpha = 0f; continue }
                        val sq = memorySeq[si]; val cs = sq.stepType[sq.currentStep]==1; val ps = sq.stepType[sq.currentStep]==3
                        val show = seqEnabled[si] && seqGroupActive[si][currentGroup] && ((isCP && cs)||(isMP && ps))
                        if (!show) { sv.alpha = 0f; continue }
                        var dmxVal = 0; var barVisible = false
                        val gFix = Companion.fixturesList.firstOrNull { it.groupIdx == currentGroup }
                        if (gFix != null) { for (ch in 0 until gFix.channels) { if (gFix.paramMap[ch] == paramName) { val actCh = gFix.dmx-1+ch; if (actCh in 0..511) { if (isMP && !Companion.effectManagedChannels[actCh]) { sv.alpha = 0f; barVisible = false } else { val raw=Companion.seqOutputValues[actCh];val mn=gFix.paramMin[ch];val mx=gFix.paramMax[ch];val rng=mx-mn;dmxVal=if(rng==0)0 else((raw-mn)*255/rng).coerceIn(0,255);barVisible=true } }; break } } }
                        if (!barVisible) continue
                        sv.alpha = 0.85f
                        val tLen = trackVisW.toFloat(); val tTop = (contH - trackLen) / 2f
                        val fillH = (dmxVal / 255f * trackLen).toInt().coerceIn(1, trackLen)
                        val tl = (contW - trackVisW) / 2
                        val lp = sv.layoutParams as FrameLayout.LayoutParams
                        lp.height = fillH; lp.topMargin = ((contH - trackLen) / 2f + trackLen - fillH).toInt(); lp.leftMargin = tl + si * (trackVisW / 4)
                        sv.layoutParams = lp; sv.requestLayout()
                    }
                }
            }
        }

        updateSlidersHeaderUI(); updateSlidersViewUI()
        return container
    }

