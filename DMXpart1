                val listCont=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.VERTICAL}
                var activeSlotTv:TextView?=null
                var gbSliderRef:SeekBar?=null
                var activeShakeTv:TextView?=null

                fun updateShakeHighlight(tv: TextView?) {
                    activeShakeTv?.background = getBtnStyle()
                    activeShakeTv = tv
                    tv?.background = getBtnStyle().apply { setColor(Color.parseColor("#005588")) }
