    private val gyroListener = object : android.hardware.SensorEventListener {
        override fun onSensorChanged(event: android.hardware.SensorEvent) {
            if (!Companion.gyroEnabled) return
            val rot = FloatArray(9)
            android.hardware.SensorManager.getRotationMatrixFromVector(rot, event.values)
            val orient = FloatArray(3)
            android.hardware.SensorManager.getOrientation(rot, orient)
            val azimuth = Math.toDegrees(orient[0].toDouble()).toFloat()  // pan
            val pitch   = Math.toDegrees(orient[1].toDouble()).toFloat()  // tilt

            val dAz = ((azimuth - gyroBaseAzimuth + 540) % 360 - 180)
            val dPi = ((pitch   - gyroBasePitch   + 540) % 360 - 180)

            val panSens  = 1.5f * gyroXRange / 100f
            val tiltSens = 1.5f * gyroYRange / 100f
            val rawPan  = (gyroBasePan  + dAz * panSens  + gyroXOffset).toInt().coerceIn(0, 255)
            val rawTilt = (gyroBaseTilt + dPi * tiltSens + gyroYOffset).toInt().coerceIn(0, 255)
            val panRaw  = if (gyroXAxis == 0) rawPan  else rawTilt
            val tiltRaw = if (gyroYAxis == 1) rawTilt else rawPan
            val newPan  = if (gyroXInverted) 255 - panRaw  else panRaw
            val newTilt = if (gyroYInverted) 255 - tiltRaw else tiltRaw

            val fixes = fixturesList.filter { it.groupIdx == posCurrentGroup }
            val targets = if (posIsFixtureMode) listOfNotNull(fixes.getOrNull(posCurrentFixture - 1)) else fixes
            targets.forEach { fix ->
                for (ch in 0 until fix.channels) {
                    when (fix.paramMap[ch]) {
                        "Pan"  -> { val a = fix.dmx-1+ch; if (a in 0..511) { val m = fix.paramMin[ch] + (newPan  * (fix.paramMax[ch]-fix.paramMin[ch])/255); Companion.overrideChannel(a,m); setDmxChannel(a,m) } }
                        "Tilt" -> { val a = fix.dmx-1+ch; if (a in 0..511) { val m = fix.paramMin[ch] + (newTilt * (fix.paramMax[ch]-fix.paramMin[ch])/255); Companion.overrideChannel(a,m); setDmxChannel(a,m) } }
                    }
                }
            }
        }
        override fun onAccuracyChanged(s: android.hardware.Sensor?, a: Int) {}
    }

    private fun generateGoboBitmaps() {
        if (Companion.goboBitmapsReady) return
        val size = 128
        val cx = size / 2f
        val cy = size / 2f
        val r = size / 2f - 4f

        fun newBmp(): android.graphics.Bitmap {
            val b = android.graphics.Bitmap.createBitmap(size, size, android.graphics.Bitmap.Config.ARGB_8888)
            android.graphics.Canvas(b).drawColor(android.graphics.Color.BLACK)
            return b
        }
        fun whitePaint(fill: Boolean = true) = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
            color = android.graphics.Color.WHITE
            style = if (fill) android.graphics.Paint.Style.FILL else android.graphics.Paint.Style.STROKE
            strokeWidth = 3f
        }
        fun starPath(cx: Float, cy: Float, r1: Float, r2: Float, points: Int): android.graphics.Path {
            val path = android.graphics.Path()
            val step = Math.PI / points
            for (i in 0 until points * 2) {
                val angle = i * step - Math.PI / 2
                val rad = if (i % 2 == 0) r1 else r2
                val x = cx + (rad * Math.cos(angle)).toFloat()
                val y = cy + (rad * Math.sin(angle)).toFloat()
                if (i == 0) path.moveTo(x, y) else path.lineTo(x, y)
            }
            path.close(); return path
        }

        // 0: OPEN — puste (biały okrąg)
        newBmp().also { b -> android.graphics.Canvas(b).drawCircle(cx, cy, r, whitePaint()); Companion.goboBitmaps[0] = b }
        // 1: CIRCLE — wypełnione koło
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=3f}
            for (i in 0..7) { val a = i * Math.PI / 4; c.drawLine(cx+(r*0.2f*Math.cos(a)).toFloat(), cy+(r*0.2f*Math.sin(a)).toFloat(), (cx+r*Math.cos(a)).toFloat(), (cy+r*Math.sin(a)).toFloat(), p) }
            Companion.goboBitmaps[1] = b
        }
        // 2: RING — pierścień
        newBmp().also { b ->
            val c = android.graphics.Canvas(b)
            c.drawCircle(cx, cy, r, whitePaint())
            c.drawCircle(cx, cy, r * 0.6f, android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply { color = android.graphics.Color.BLACK; style = android.graphics.Paint.Style.FILL })
            Companion.goboBitmaps[2] = b
        }
        // 3: DOT3
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(); val dr = r * 0.25f
            for (i in 0..2) { val a = i * 2 * Math.PI / 3 - Math.PI/2; c.drawCircle(cx+(r*0.5f*Math.cos(a)).toFloat(), cy+(r*0.5f*Math.sin(a)).toFloat(), dr, p) }
            Companion.goboBitmaps[3] = b
        }
        // 4: DOT5
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(); val dr = r * 0.2f
            for (i in 0..4) { val a = i * 2 * Math.PI / 5 - Math.PI/2; c.drawCircle(cx+(r*0.55f*Math.cos(a)).toFloat(), cy+(r*0.55f*Math.sin(a)).toFloat(), dr, p) }
            Companion.goboBitmaps[4] = b
        }
        // 5: DOT7
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(); val dr = r * 0.15f
            c.drawCircle(cx, cy, dr, p)
            for (i in 0..5) { val a = i * 2 * Math.PI / 6 - Math.PI/2; c.drawCircle(cx+(r*0.6f*Math.cos(a)).toFloat(), cy+(r*0.6f*Math.sin(a)).toFloat(), dr, p) }
            Companion.goboBitmaps[5] = b
        }
        // 6: STAR3
        newBmp().also { b -> val c = android.graphics.Canvas(b); c.drawPath(starPath(cx,cy,r,r*0.4f,3), whitePaint()); Companion.goboBitmaps[6] = b }
        // 7: STAR4
        newBmp().also { b -> val c = android.graphics.Canvas(b); c.drawPath(starPath(cx,cy,r,r*0.4f,4), whitePaint()); Companion.goboBitmaps[7] = b }
        // 8: STAR5
        newBmp().also { b -> val c = android.graphics.Canvas(b); c.drawPath(starPath(cx,cy,r,r*0.4f,5), whitePaint()); Companion.goboBitmaps[8] = b }
        // 9: STAR6
        newBmp().also { b -> val c = android.graphics.Canvas(b); c.drawPath(starPath(cx,cy,r,r*0.4f,6), whitePaint()); Companion.goboBitmaps[9] = b }
        // 10: STAR8
        newBmp().also { b -> val c = android.graphics.Canvas(b); c.drawPath(starPath(cx,cy,r,r*0.4f,8), whitePaint()); Companion.goboBitmaps[10] = b }
        // 11: TRI
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val path = android.graphics.Path()
            for (i in 0..2) { val a = i * 2 * Math.PI / 3 - Math.PI/2; val x=(cx+r*Math.cos(a)).toFloat(); val y=(cy+r*Math.sin(a)).toFloat(); if(i==0) path.moveTo(x,y) else path.lineTo(x,y) }
            path.close(); c.drawPath(path, whitePaint()); Companion.goboBitmaps[11] = b
        }
        // 12: SQUARE
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val s = r * 0.75f
            c.drawRect(cx-s, cy-s, cx+s, cy+s, whitePaint()); Companion.goboBitmaps[12] = b
        }
        // 13: PENT
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val path = android.graphics.Path()
            for (i in 0..4) { val a = i * 2 * Math.PI / 5 - Math.PI/2; val x=(cx+r*Math.cos(a)).toFloat(); val y=(cy+r*Math.sin(a)).toFloat(); if(i==0) path.moveTo(x,y) else path.lineTo(x,y) }
            path.close(); c.drawPath(path, whitePaint()); Companion.goboBitmaps[13] = b
        }
        // 14: FLOWER
        newBmp().also { b ->
            val c = android.graphics.Canvas(b)
            for (i in 0..5) {
                val a = i * Math.PI / 3; val path = android.graphics.Path()
                val px=(cx+r*0.8f*Math.cos(a)).toFloat(); val py=(cy+r*0.8f*Math.sin(a)).toFloat()
                path.moveTo(cx,cy)
                path.quadTo((cx+r*0.8f*Math.cos(a+0.6)).toFloat(),(cy+r*0.8f*Math.sin(a+0.6)).toFloat(),px,py)
                path.quadTo((cx+r*0.8f*Math.cos(a-0.6)).toFloat(),(cy+r*0.8f*Math.sin(a-0.6)).toFloat(),cx,cy)
                c.drawPath(path, whitePaint())
            }
            c.drawCircle(cx,cy,r*0.15f,whitePaint())
            Companion.goboBitmaps[14] = b
        }
        // 15: CROSS
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=r*0.4f}
            c.drawLine(cx, cy-r, cx, cy+r, p); c.drawLine(cx-r, cy, cx+r, cy, p); Companion.goboBitmaps[15] = b
        }
        // 16: ARROW
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val path = android.graphics.Path()
            path.moveTo(cx, cy-r); path.lineTo(cx+r*0.7f, cy+r*0.3f); path.lineTo(cx+r*0.25f, cy+r*0.3f)
            path.lineTo(cx+r*0.25f, cy+r); path.lineTo(cx-r*0.25f, cy+r); path.lineTo(cx-r*0.25f, cy+r*0.3f)
            path.lineTo(cx-r*0.7f, cy+r*0.3f); path.close(); c.drawPath(path, whitePaint()); Companion.goboBitmaps[16] = b
        }
        // 17: LINES
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=r*0.25f}
            c.drawLine(cx, cy-r, cx, cy+r, p)
            c.drawLine(cx-r*0.45f, cy-r, cx-r*0.45f, cy+r, p)
            c.drawLine(cx+r*0.45f, cy-r, cx+r*0.45f, cy+r, p)
            Companion.goboBitmaps[17] = b
        }
        // 18: PALM — 3 liście
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint()
            for (i in 0..2) {
                val a = (i * 120 - 90) * Math.PI / 180
                val path = android.graphics.Path()
                val tx=(cx+r*Math.cos(a)).toFloat(); val ty=(cy+r*Math.sin(a)).toFloat()
                path.moveTo(cx, cy); path.quadTo(cx+(r*0.8f*Math.cos(a+0.5)).toFloat(), cy+(r*0.8f*Math.sin(a+0.5)).toFloat(), tx, ty)
                path.quadTo(cx+(r*0.8f*Math.cos(a-0.5)).toFloat(), cy+(r*0.8f*Math.sin(a-0.5)).toFloat(), cx, cy)
                c.drawPath(path, p)
            }
            Companion.goboBitmaps[18] = b
        }
        // 19: ROSE — 4-płatkowa
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val path = android.graphics.Path()
            for (deg in 0..360 step 2) {
                val angle = deg * Math.PI / 180
                val rad = (r * Math.cos(2 * angle)).toFloat()
                val x = cx + rad * Math.cos(angle).toFloat()
                val y = cy + rad * Math.sin(angle).toFloat()
                if (deg == 0) path.moveTo(x, y) else path.lineTo(x, y)
            }
            c.drawPath(path, whitePaint()); Companion.goboBitmaps[19] = b
        }
        // 20: SNOWFLAKE
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=3f}
            for (i in 0..5) {
                val a = i * Math.PI / 3
                c.drawLine(cx, cy, (cx+r*Math.cos(a)).toFloat(), (cy+r*Math.sin(a)).toFloat(), p)
                val mx=(cx+r*0.5f*Math.cos(a)).toFloat(); val my=(cy+r*0.5f*Math.sin(a)).toFloat()
                c.drawLine(mx, my, (mx+r*0.25f*Math.cos(a+Math.PI/2)).toFloat(), (my+r*0.25f*Math.sin(a+Math.PI/2)).toFloat(), p)
                c.drawLine(mx, my, (mx+r*0.25f*Math.cos(a-Math.PI/2)).toFloat(), (my+r*0.25f*Math.sin(a-Math.PI/2)).toFloat(), p)
            }
            Companion.goboBitmaps[20] = b
        }
        // 21: SPIRAL
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val path = android.graphics.Path()
            var first = true
            for (i in 0..360*3) {
                val angle = i * Math.PI / 180
                val rad = r * i / (360*3)
                val x = cx + (rad * Math.cos(angle)).toFloat()
                val y = cy + (rad * Math.sin(angle)).toFloat()
                if (first) { path.moveTo(x,y); first=false } else path.lineTo(x,y)
            }
            c.drawPath(path, whitePaint(false).apply{strokeWidth=2f}); Companion.goboBitmaps[21] = b
        }
        // 22: BEAM — linie równoległe
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=4f}
            for (i in -2..2) c.drawLine(cx+i*r*0.35f, cy-r, cx+i*r*0.35f, cy+r, p)
            Companion.goboBitmaps[22] = b
        }
        // 23: GRID
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=2f}
            for (i in -2..2) { c.drawLine(cx+i*r*0.4f, cy-r, cx+i*r*0.4f, cy+r, p); c.drawLine(cx-r, cy+i*r*0.4f, cx+r, cy+i*r*0.4f, p) }
            Companion.goboBitmaps[23] = b
        }
        // 24: WAVES
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=3f}
            for (row in -2..2) {
                val path = android.graphics.Path(); path.moveTo(cx-r, cy+row*r*0.4f)
                for (x in -20..20) { val xf=cx+x*r*0.1f; path.lineTo(xf, cy+row*r*0.4f+(r*0.15f*Math.sin(x*0.8)).toFloat()) }
                c.drawPath(path, p)
            }
            Companion.goboBitmaps[24] = b
        }
        // 25: PRISM — trójkąt z liniami
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val path = android.graphics.Path()
            val p1x=cx; val p1y=cy-r; val p2x=cx+r*0.87f; val p2y=cy+r*0.5f; val p3x=cx-r*0.87f; val p3y=cy+r*0.5f
            path.moveTo(p1x,p1y.toFloat()); path.lineTo(p2x.toFloat(),p2y.toFloat()); path.lineTo(p3x.toFloat(),p3y.toFloat()); path.close()
            c.drawPath(path, whitePaint(false).apply{strokeWidth=3f})
            val p2 = whitePaint(false).apply{strokeWidth=2f}
            for(i in 1..3){ val t=i*0.25f; c.drawLine(p1x+(p2x-p1x).toFloat()*t, (p1y+(p2y-p1y)*t).toFloat(), p1x+(p3x-p1x).toFloat()*t, (p1y+(p3y-p1y)*t).toFloat(), p2) }
            Companion.goboBitmaps[25] = b
        }
        // 26: SPOT — mały punkt
        newBmp().also { b -> android.graphics.Canvas(b).drawCircle(cx, cy, r*0.2f, whitePaint()); Companion.goboBitmaps[26] = b }
        // 27: CRESCENT — sierp
        newBmp().also { b ->
            val c = android.graphics.Canvas(b)
            c.drawCircle(cx, cy, r, whitePaint())
            c.drawCircle(cx+r*0.35f, cy, r*0.85f, android.graphics.Paint().apply{color=android.graphics.Color.BLACK;style=android.graphics.Paint.Style.FILL})
            Companion.goboBitmaps[27] = b
        }
        // 28: SATURN — koło z pierścieniem
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=3f}
            c.drawCircle(cx, cy, r*0.45f, whitePaint())
            c.drawOval(android.graphics.RectF(cx-r, cy-r*0.25f, cx+r, cy+r*0.25f), p)
            Companion.goboBitmaps[28] = b
        }
        // 29: IRIS — koncentryczne okręgi
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint(false).apply{strokeWidth=2f}
            for(i in 1..4) c.drawCircle(cx, cy, r*i*0.25f, p)
            Companion.goboBitmaps[29] = b
        }
        // 30: DOTS7 — elipsy jak na zdjęciu
        newBmp().also { b ->
            val c = android.graphics.Canvas(b); val p = whitePaint()
            val elipsy = listOf(
                floatArrayOf(0.55f, 0.25f, 0.11f, 0.07f, -20f),
                floatArrayOf(0.72f, 0.20f, 0.09f, 0.06f, 10f),
                floatArrayOf(0.35f, 0.40f, 0.05f, 0.09f, -15f),
                floatArrayOf(0.50f, 0.48f, 0.05f, 0.09f, -10f),
                floatArrayOf(0.70f, 0.50f, 0.10f, 0.07f, 5f),
                floatArrayOf(0.28f, 0.60f, 0.11f, 0.06f, -25f),
                floatArrayOf(0.58f, 0.75f, 0.14f, 0.08f, -15f)
            )
            elipsy.forEach { e ->
                c.save()
                val ex = e[0] * size; val ey = e[1] * size
                c.rotate(e[4], ex, ey)
                c.drawOval(android.graphics.RectF(ex - e[2]*size, ey - e[3]*size, ex + e[2]*size, ey + e[3]*size), p)
                c.restore()
            }
            Companion.goboBitmaps[30] = b
        }



        // 31: CUSTOM — znak zapytania
        newBmp().also { b ->
            val c = android.graphics.Canvas(b)
            val outer = starPath(cx,cy,r,r*0.4f,5)
            val inner = starPath(cx,cy,r*0.55f,r*0.22f,5)
            val path = android.graphics.Path()
            path.addPath(outer); path.addPath(inner)
            path.fillType = android.graphics.Path.FillType.EVEN_ODD
            c.drawPath(path, whitePaint())
            Companion.goboBitmaps[31] = b
        }

        Companion.goboBitmapsReady = true
    }

