    private fun createInternalKeyboard(): LinearLayout {
        var shiftActive = false
        var altGrActive = false

        val polishMap = mapOf(
            'a' to 'ą', 'e' to 'ę', 'o' to 'ó', 's' to 'ś',
            'z' to 'ź', 'x' to 'ż', 'c' to 'ć', 'n' to 'ń', 'l' to 'ł'
        )

        var shiftBtn: TextView? = null
        var altGrBtn: TextView? = null
        val letterButtons = mutableMapOf<Char, TextView>()

        fun getChar(base: Char): String {
            val lo = base.lowercaseChar()
            return if (altGrActive && polishMap.containsKey(lo)) {
                val pl = polishMap[lo]!!
                if (shiftActive) pl.uppercaseChar().toString() else pl.toString()
            } else {
                if (shiftActive) lo.uppercaseChar().toString() else lo.toString()
            }
        }

        fun updateMods() {
            val shiftCol = if (shiftActive) Color.parseColor("#007700") else Companion.COL_SEP
            val altCol   = if (altGrActive) Color.parseColor("#006699") else Companion.COL_SEP
            (shiftBtn?.background as? GradientDrawable)?.setColor(shiftCol)
            (altGrBtn?.background as? GradientDrawable)?.setColor(altCol)
            letterButtons.forEach { (base, btn) -> btn.text = getChar(base) }
        }

        fun typeChar(ch: String) {
            keyboardDisplay.text = "${keyboardDisplay.text}$ch"
            shiftActive = false; altGrActive = false
            updateMods()
        }

        val keyBg: () -> GradientDrawable = {
            GradientDrawable().apply { shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_SEP); setStroke(2, Color.BLACK); cornerRadius = 4f }
        }

        fun makeBtn(label: String, weight: Float = 1f, bgColor: Int = Companion.COL_SEP, onClick: () -> Unit): TextView {
            return TextView(this@MainActivity).apply {
                text = label; textSize = 20f; setTextColor(Color.WHITE); gravity = Gravity.CENTER
                background = GradientDrawable().apply { shape = GradientDrawable.RECTANGLE; setColor(bgColor); setStroke(2, Color.BLACK); cornerRadius = 4f }
                layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.MATCH_PARENT, weight).apply { setMargins(2, 2, 2, 2) }
                setOnClickListener { onClick() }
            }
        }

        return LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL; weightSum = 10.0f
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            visibility = View.GONE; setBackgroundColor(Color.parseColor("#DD000000"))

            val topArea = LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.VERTICAL; layoutParams = LinearLayout.LayoutParams(-1, 0, 4.0f)
                gravity = Gravity.BOTTOM; setOnClickListener { keyboardOverlay.visibility = View.GONE }
            }
            keyboardDisplay = TextView(this@MainActivity).apply {
                textSize = 26f; setTextColor(Color.WHITE); setBackgroundColor(Companion.COL_PANEL)
                gravity = Gravity.CENTER_VERTICAL or Gravity.START
                setPadding(20, 8, 20, 8); includeFontPadding = false
                layoutParams = LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT).apply { setMargins(40, 0, 40, 16) }
            }
            topArea.addView(keyboardDisplay); addView(topArea)

            val kbBox = LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.VERTICAL; layoutParams = LinearLayout.LayoutParams(-1, 0, 6.0f)
                setBackgroundColor(Color.BLACK); weightSum = 5f
            }

            fun row(w: Float = 1f, block: LinearLayout.() -> Unit) = LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = LinearLayout.LayoutParams(-1, 0, w)
                block()
            }

            // Rząd 1: cyfry
            kbBox.addView(row {
                "1234567890".forEach { c ->
                    addView(makeBtn(c.toString()) { typeChar(c.toString()) })
                }
            })
            // Rząd 2: qwertyuiop
            kbBox.addView(row {
                "qwertyuiop".forEach { c ->
                    val b = makeBtn(getChar(c)) { typeChar(getChar(c)) }
                    letterButtons[c] = b; addView(b)
                }
            })
            // Rząd 3: asdfghjkl
            kbBox.addView(row {
                "asdfghjkl".forEach { c ->
                    val b = makeBtn(getChar(c)) { typeChar(getChar(c)) }
                    letterButtons[c] = b; addView(b)
                }
            })
            // Rząd 4: SHIFT + zxcvbnm + DEL
            kbBox.addView(row {
                val sb = makeBtn("⇧", 1.4f, Companion.COL_SEP) {
                    shiftActive = !shiftActive; altGrActive = false; updateMods()
                }
                shiftBtn = sb; addView(sb)
                "zxcvbnm".forEach { c ->
                    val b = makeBtn(getChar(c)) { typeChar(getChar(c)) }
                    letterButtons[c] = b; addView(b)
                }
                addView(makeBtn("⌫", 1.4f) {
                    val t = keyboardDisplay.text
                    if (t.isNotEmpty()) keyboardDisplay.text = t.substring(0, t.length - 1)
                })
            })
            // Rząd 5: ALT_GR / CANCEL / - / _ / SPACE / . / OK
            kbBox.addView(row {
                val ab = makeBtn("ALT", 1.4f, Companion.COL_SEP) {
                    altGrActive = !altGrActive; shiftActive = false; updateMods()
                }
                altGrBtn = ab; addView(ab)
                addView(makeBtn("✕", 1.4f, Color.parseColor("#660000")) { keyboardOverlay.visibility = View.GONE })
                addView(makeBtn("-") { typeChar("-") })
                addView(makeBtn("_") { typeChar("_") })
                addView(makeBtn("SPACJA", 3f) { typeChar(" ") })
                addView(makeBtn(".") { typeChar(".") })
                addView(makeBtn("OK", 1.4f, Color.parseColor("#006600")) {
                    keyboardOverlay.visibility = View.GONE
                    onKeyboardResult?.invoke(keyboardDisplay.text.toString())
                })
            })

            addView(kbBox)
        }
    }

