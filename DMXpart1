                        val restore = fixtureEditSnapshot?.get(actCh) ?: Companion.presetDmxValues[actCh]
                        Companion.baseDmxValues[actCh] = restore
                        Companion.dmxValues[actCh] = restore
                        setDmxChannel(actCh, restore)
                    }}
                }

                val outerRow = LinearLayout(this@MainActivity).apply {
                    orientation=LinearLayout.HORIZONTAL; layoutParams=LinearLayout.LayoutParams(-1,-1)
                }
                val leftCol = LinearLayout(this@MainActivity).apply {
                    orientation=LinearLayout.VERTICAL; layoutParams=LinearLayout.LayoutParams(0,-1,1f)
                }

                leftCol.addView(LinearLayout(this@MainActivity).apply {
                    orientation=LinearLayout.HORIZONTAL; weightSum=3.0f
                    layoutParams=LinearLayout.LayoutParams(-1,j)
                    addView(TextView(this@MainActivity).apply {
                        text="< BACK"; gravity=Gravity.CENTER; setTextColor(Color.WHITE); background=getBtnStyle()
