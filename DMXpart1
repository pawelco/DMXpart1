            val cell = FrameLayout(this).apply {
                layoutParams = GridLayout.LayoutParams().apply {
                    width = cellSize; height = cellSize
                    setMargins(4, 4, 4, 4)
                }
                background = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                    setColor(if (isSelected) Color.parseColor("#005588") else Color.BLACK)
                    setStroke(if (isSelected) 3 else 1, if (isSelected) Color.WHITE else Color.parseColor("#444444"))
                }
                if (bmp != null) {
                    addView(android.widget.ImageView(this@MainActivity).apply {
                        setImageBitmap(bmp)
                        scaleType = android.widget.ImageView.ScaleType.FIT_CENTER
                        layoutParams = FrameLayout.LayoutParams(-1, -1).apply { setMargins(4, 4, 4, 4) }
                    })
                } else {
                    addView(TextView(this@MainActivity).apply {
                        text = Companion.goboShapes.getOrElse(idx) { "?" }
                        gravity = Gravity.CENTER; textSize = 9f; setTextColor(Color.WHITE)
                        layoutParams = FrameLayout.LayoutParams(-1, -1)
                    })
                }
                setOnClickListener {
                    (overlay.parent as? android.view.ViewGroup)?.removeView(overlay)
                    onResult(idx)
                }
            }
            grid.addView(cell)
        }
        val panel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(Color.parseColor("#222222"))
            layoutParams = FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.WRAP_CONTENT,
                FrameLayout.LayoutParams.WRAP_CONTENT
            ).apply { gravity = Gravity.CENTER }
            addView(TextView(this@MainActivity).apply {
                text = "SELECT GOBO"; gravity = Gravity.CENTER; textSize = 14f
                setTextColor(Color.WHITE); setPadding(0, 12, 0, 8)
                layoutParams = LinearLayout.LayoutParams(-1, exactRowHeight)
                setOnClickListener { (overlay.parent as? android.view.ViewGroup)?.removeView(overlay) }
            })
            addView(grid)
        }
        overlay.addView(panel)
        overlay.setOnClickListener { (overlay.parent as? android.view.ViewGroup)?.removeView(overlay) }
        midiRootFrame.addView(overlay)
    }

    private fun createFixturesView(): View {
        val rootContainer = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Companion.COL_BG)
        }

        // Osobny kontener na treść – renderFixturesDispatch operuje tylko na nim,
        // dzięki czemu zakładki grup (dodane na dole rootContainer) przeżywają rebuild.
        val contentContainer = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
            setBackgroundColor(Companion.COL_BG)
        }
        rootContainer.addView(contentContainer)

        fun getSaveBtnStyle() = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#990000")); setStroke(2,Color.BLACK); cornerRadius=4f }
        fun getLoadBtnStyle() = GradientDrawable().apply { shape=GradientDrawable.RECTANGLE; setColor(Color.parseColor("#007700")); setStroke(2,Color.BLACK); cornerRadius=4f }

        fun renumberFixtures() { fixturesList.forEachIndexed { index, item -> item.id = index + 1 } }

        fun moveFixture(oldIndex: Int, newId: Int) {
            val targetIndex = (newId - 1).coerceIn(0, fixturesList.size - 1)
            if (oldIndex != targetIndex) {
                val itemToMove = fixturesList.removeAt(oldIndex)
                fixturesList.add(targetIndex, itemToMove)
                renumberFixtures()
            }
        }

        fun checkFixtureParam(fix: FixtureItem, paramTarget: String): Boolean {
            for (i in 0 until fix.channels) {
                val p = fix.paramMap[i]
                if (paramTarget == "Color" && p == "Col. wheel") return true
                if (paramTarget == "Gobo 1" && (p == "Gobo" || p == "Gobo rot" || p == "Gobo shake")) return true
                if (paramTarget == "Gobo 2" && (p == "Gobo2" || p == "Gobo2 rot" || p == "Gobo2 shake")) return true
            }
            return false
        }

        var isRendering = false
        var groupTabsRowRef: LinearLayout? = null
        fun renderFixturesDispatch() {
            if (isRendering) return
            isRendering = true
            // Zwolnij kanały CW/Gobo gdy wychodzimy z setup
            val editFix = fixturesList.getOrNull(editingFixtureIndex)
            if (editFix != null) {
                for (ch in 0 until editFix.channels) {
                    val addr = editFix.dmx - 1 + ch
                    if (addr in 0..511) Companion.effectManagedChannels[addr] = false
                }
            }
            activeDataSlider = null; activeDataSliderCallback = null
            val oldScroll = contentContainer.findViewWithTag<ScrollView>("MAIN_SCROLL")
            val oldLeftScroll = contentContainer.findViewWithTag<ScrollView>("LEFT_SCROLL")
            if (oldLeftScroll != null) savedScrollY = oldLeftScroll.scrollY
            else if (oldScroll != null) savedScrollY = oldScroll.scrollY
            contentContainer.removeAllViews()

            val sliderW = exactRowHeight * 2
            val j = exactRowHeight

            // ── STATE 0 & 1 ────────────────────────────────────────────────
            if (fixturesViewState in 0..1) {
                val scrollView = ScrollView(this@MainActivity).apply {
                    layoutParams = LinearLayout.LayoutParams(-1, -1)
                    isVerticalScrollBarEnabled = false; tag = "MAIN_SCROLL"
                }
                fixturesContainer = LinearLayout(this@MainActivity).apply {
                    orientation = LinearLayout.VERTICAL
                    layoutParams = FrameLayout.LayoutParams(-1, FrameLayout.LayoutParams.WRAP_CONTENT)
                }
                scrollView.addView(fixturesContainer)
                contentContainer.addView(scrollView)
                scrollView.post { scrollView.scrollTo(0, savedScrollY) }

                if (fixturesViewState == 0) {
                    renumberFixtures()
                    val filteredList = if (fixturesGroupFilter == -1) fixturesList
                    else fixturesList.filter { it.groupIdx == fixturesGroupFilter }
                    filteredList.forEachIndexed { index, item ->
                        val globalIndex = fixturesList.indexOf(item)
                        val row = LinearLayout(this@MainActivity).apply {
                            orientation=LinearLayout.HORIZONTAL; weightSum=10.0f
                            layoutParams=LinearLayout.LayoutParams(-1, j)
                        }
                        row.addView(TextView(this@MainActivity).apply {
                            text="${item.id}"; gravity=Gravity.CENTER; textSize=18f; setTextColor(Color.WHITE); background=getBtnStyle()
                            layoutParams=LinearLayout.LayoutParams(0,-1,0.6f).apply{setMargins(5,5,5,5)}
                            setOnLongClickListener{showInternalNumpad(item.id.toString()){s->val n=s.toIntOrNull();if(n!=null&&n>0){moveFixture(index,n);renderFixturesDispatch()}};true}
                        })
                        row.addView(TextView(this@MainActivity).apply {
                            text="+ / -"; gravity=Gravity.CENTER; textSize=16f; setTextColor(Color.WHITE); background=getBtnStyle()
                            layoutParams=LinearLayout.LayoutParams(0,-1,0.8f).apply{setMargins(5,5,5,5)}
                            setOnClickListener {
                                if (globalIndex > fixturesList.size) return@setOnClickListener
                                val newGroup = if (fixturesGroupFilter >= 0) fixturesGroupFilter else item.groupIdx
                                fixturesList.add((globalIndex + 1).coerceAtMost(fixturesList.size), FixtureItem(0,"New Fixture",newGroup,item.dmx+item.channels,item.channels,Array(512){""},IntArray(512){0},IntArray(512){255},1,IntArray(32){0},IntArray(32){0},IntArray(32){0}))
                                Companion.seqRoutingOrder[newGroup].clear()
                                Companion.seqRoutingOn[newGroup].clear()
                                renderFixturesDispatch()
                            }
                            setOnLongClickListener {
                                if (globalIndex >= fixturesList.size) return@setOnLongClickListener true
                                if (fixturesList.size > 1) {
                                    val removedGroup = fixturesList[globalIndex].groupIdx
                                    val removedId = fixturesList[globalIndex].id
                                    fixturesList.removeAt(globalIndex)
                                    val realGroup = Companion.fixtureOriginalGroup[removedId] ?: removedGroup
                                    val pos = Companion.seqRoutingOrder[realGroup].indexOf(removedId)
                                    if (pos >= 0) {
                                        Companion.seqRoutingOrder[realGroup].removeAt(pos)
                                        if (pos < Companion.seqRoutingOn[realGroup].size)
                                            Companion.seqRoutingOn[realGroup].removeAt(pos)
                                    }
                                    Companion.fixtureOriginalGroup.remove(removedId)
                                    renderFixturesDispatch()
                                } else Toast.makeText(this@MainActivity,"Cannot delete last fixture",Toast.LENGTH_SHORT).show()
                                true
                            }
                        })
                        row.addView(TextView(this@MainActivity).apply {
                            text=item.name; gravity=Gravity.CENTER; textSize=16f; setTextColor(Color.WHITE); background=getBtnStyle()
                            layoutParams=LinearLayout.LayoutParams(0,-1,2.6f).apply{setMargins(5,5,5,5)}
                            setOnLongClickListener{showInternalLoadMenu{p->item.name=p.name;item.channels=p.channels;item.paramMap=p.paramMap.clone();item.paramMin=p.paramMin.clone();item.paramMax=p.paramMax.clone();item.cwCount=p.cwCount;item.cwDmx=p.cwDmx.clone();item.cwHalfDmx=p.cwHalfDmx.clone();item.cwColors=p.cwColors.clone();item.gbCount=p.gbCount;item.gbDmx=p.gbDmx.clone();item.gbShapes=p.gbShapes.clone();renderFixturesDispatch()};true}
                        })
                        row.addView(TextView(this@MainActivity).apply {
                            text="EDIT"; gravity=Gravity.CENTER; textSize=16f; setTextColor(Color.WHITE); background=getBtnStyle()
                            layoutParams=LinearLayout.LayoutParams(0,-1,1.0f).apply{setMargins(5,5,5,5)}
                            setOnClickListener{editingFixtureIndex=globalIndex;fixturesViewState=1;savedScrollY=0;renderFixturesDispatch()}
                        })
                        val grpLayout=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=2.0f;layoutParams=LinearLayout.LayoutParams(0,-1,2.5f)}
                        val grpPrev=TextView(this@MainActivity).apply{text="<";gravity=Gravity.CENTER;textSize=18f;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.4f).apply{setMargins(5,5,5,5)}}
                        val grpTxt =TextView(this@MainActivity).apply{text="Grp ${'A'+item.groupIdx}";gravity=Gravity.CENTER;textSize=16f;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.2f).apply{setMargins(5,5,5,5)}}
                        val grpNext=TextView(this@MainActivity).apply{text=">";gravity=Gravity.CENTER;textSize=18f;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.4f).apply{setMargins(5,5,5,5)}}
                        // Strzałki grup aktywne tylko w zakładce All
                        val grpArrowsActive = (fixturesGroupFilter == -1)
                        grpPrev.alpha = if (grpArrowsActive) 1f else 0.3f
                        grpNext.alpha = if (grpArrowsActive) 1f else 0.3f
                        grpPrev.setOnClickListener { if (grpArrowsActive && item.groupIdx > 0) { item.groupIdx--; renderFixturesDispatch() } }
                        grpNext.setOnClickListener { if (grpArrowsActive && item.groupIdx < 7) { item.groupIdx++; renderFixturesDispatch() } }
                        grpLayout.addView(grpPrev);grpLayout.addView(grpTxt);grpLayout.addView(grpNext)
                        val dmxLayout=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=2.0f;layoutParams=LinearLayout.LayoutParams(0,-1,2.5f)}
                        val dmxPrev=TextView(this@MainActivity).apply{text="<";gravity=Gravity.CENTER;textSize=18f;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.4f).apply{setMargins(5,5,5,5)}}
                        val dmxTxt =TextView(this@MainActivity).apply{text="DMX ${item.dmx}";gravity=Gravity.CENTER;textSize=16f;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.2f).apply{setMargins(5,5,5,5)}}
                        val dmxNext=TextView(this@MainActivity).apply{text=">";gravity=Gravity.CENTER;textSize=18f;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.4f).apply{setMargins(5,5,5,5)}}
                        dmxPrev.setOnClickListener{if(item.dmx>1){item.dmx--;renderFixturesDispatch()}}
                        dmxNext.setOnClickListener{if(item.dmx<512){item.dmx++;renderFixturesDispatch()}}
                        dmxTxt.setOnLongClickListener{showInternalNumpad(item.dmx.toString()){s->val v=s.toIntOrNull()?:item.dmx;item.dmx=v.coerceIn(1,512);renderFixturesDispatch()};true}
                        dmxLayout.addView(dmxPrev);dmxLayout.addView(dmxTxt);dmxLayout.addView(dmxNext)
                        row.addView(grpLayout);row.addView(dmxLayout)
                        fixturesContainer.addView(row)
                    }
                } else {
                    // ── fixturesViewState == 1: edit fixture ───────────────
                    val fix = fixturesList.getOrNull(editingFixtureIndex) ?: return

                    // weightSum=10f, LOAD=1.5f SAVE=1.5f → łącznie 3.0f
                    // Wiersz 1: BACK(1.5) | label(1.5) | name(4.0) | LOAD(1.5) | SAVE(1.5) = 10f
                    val r1=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=10.0f;layoutParams=LinearLayout.LayoutParams(-1,j)}
                    r1.addView(TextView(this@MainActivity).apply{text="< BACK";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(5,5,5,5)};setOnClickListener{
                        // Zwolnij wszystkie kanały edytowanego fixture
                        val f = fixturesList.getOrNull(editingFixtureIndex)
                        if (f != null) {
                            val snap = Companion.presetDmxValues
                            for (ch in 0 until f.channels) {
                                val addr = f.dmx - 1 + ch
                                if (addr in 0..511) {
                                    Companion.effectManagedChannels[addr] = false
                                    Companion.baseDmxValues[addr] = snap[addr]
                                    Companion.dmxValues[addr] = snap[addr]
                                    setDmxChannel(addr, snap[addr])
                                }
                            }
                        }
                        fixturesViewState=0;savedScrollY=0;renderFixturesDispatch()
                    }})
                    r1.addView(TextView(this@MainActivity).apply{text="Fixture";gravity=Gravity.CENTER;setTextColor(Color.BLACK);textSize=18f;layoutParams=LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(5,5,5,5)}})
                    r1.addView(TextView(this@MainActivity).apply{text=fix.name;gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,4.0f).apply{setMargins(5,5,5,5)};setOnLongClickListener{showInternalKeyboard(fix.name){n->fix.name=if(n.length>16)n.substring(0,16) else n;renderFixturesDispatch()};true}})
                    r1.addView(TextView(this@MainActivity).apply{text="LOAD";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getLoadBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(5,5,5,5)};setOnClickListener{showInternalLoadMenu{p->fix.name=p.name;fix.channels=p.channels;fix.paramMap=p.paramMap.clone();fix.paramMin=p.paramMin.clone();fix.paramMax=p.paramMax.clone();fix.cwCount=p.cwCount;fix.cwDmx=p.cwDmx.clone();fix.cwHalfDmx=p.cwHalfDmx.clone();fix.cwColors=p.cwColors.clone();fix.gbCount=p.gbCount;fix.gbDmx=p.gbDmx.clone();fix.gbShapes=p.gbShapes.clone();renderFixturesDispatch()}}})
                    r1.addView(TextView(this@MainActivity).apply{text="SAVE";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getSaveBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(5,5,5,5)};setOnClickListener{val np=FixtureProfile(fix.name,fix.channels,fix.paramMap.clone(),fix.paramMin.clone(),fix.paramMax.clone(),fix.cwCount,fix.cwDmx.clone(),fix.cwHalfDmx.clone(),fix.cwColors.clone(),fix.gbCount,fix.gbDmx.clone(),fix.gbShapes.clone());val ei=savedProfiles.indexOfFirst{it.name==fix.name};if(ei>=0) savedProfiles[ei]=np else savedProfiles.add(np);saveProfilesToDisk(applicationContext.filesDir.absolutePath);Toast.makeText(this@MainActivity,"Profile Saved!",Toast.LENGTH_SHORT).show()}})
                    fixturesContainer.addView(r1)

                    // Wiersz 2: label(7.0) | <(0.6) | count(1.8) | >(0.6) = 10f → łącznie 3.0f
                    val r2=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=10.0f;layoutParams=LinearLayout.LayoutParams(-1,j)}
                    r2.addView(TextView(this@MainActivity).apply{text="Channels amount";gravity=Gravity.CENTER_VERTICAL;setPadding(20,0,0,0);setTextColor(Color.BLACK);textSize=18f;layoutParams=LinearLayout.LayoutParams(0,-1,7.0f).apply{setMargins(5,5,5,5)}})
                    r2.addView(TextView(this@MainActivity).apply{text="<";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.6f).apply{setMargins(5,5,5,5)};setOnClickListener{if(fix.channels>1){fix.channels--;renderFixturesDispatch()}}})
                    r2.addView(TextView(this@MainActivity).apply{text=fix.channels.toString();gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.8f).apply{setMargins(5,5,5,5)};setOnLongClickListener{showInternalNumpad(fix.channels.toString()){c->val v=c.toIntOrNull()?:fix.channels;fix.channels=v.coerceIn(1,512);renderFixturesDispatch()};true}})
                    r2.addView(TextView(this@MainActivity).apply{text=">";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.6f).apply{setMargins(5,5,5,5)};setOnClickListener{if(fix.channels<512){fix.channels++;renderFixturesDispatch()}}})
                    fixturesContainer.addView(r2)

                    // Wiersz 3: label(7.0) | ASSIGN(3.0) = 10f
                    val r3=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=10.0f;layoutParams=LinearLayout.LayoutParams(-1,j)}
                    r3.addView(TextView(this@MainActivity).apply{text="Channels assign";gravity=Gravity.CENTER_VERTICAL;setPadding(20,0,0,0);setTextColor(Color.BLACK);textSize=18f;layoutParams=LinearLayout.LayoutParams(0,-1,7.0f).apply{setMargins(5,5,5,5)}})
                    r3.addView(TextView(this@MainActivity).apply{text="ASSIGN";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,3.0f).apply{setMargins(5,5,5,5)};setOnClickListener{fixturesViewState=2;savedScrollY=0;renderFixturesDispatch()}})
                    fixturesContainer.addView(r3)

                    // Wiersz 4: label(7.0) | SETUP(3.0) = 10f (Color wheel)
                    if(checkFixtureParam(fix,"Color")){
                        val rC=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=10.0f;layoutParams=LinearLayout.LayoutParams(-1,j)}
                        rC.addView(TextView(this@MainActivity).apply{text="Color wheel setup";gravity=Gravity.CENTER_VERTICAL;setPadding(20,0,0,0);setTextColor(Color.BLACK);textSize=18f;layoutParams=LinearLayout.LayoutParams(0,-1,7.0f).apply{setMargins(5,5,5,5)}})
                        rC.addView(TextView(this@MainActivity).apply{text="SETUP";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,3.0f).apply{setMargins(5,5,5,5)};setOnClickListener{
                            // Snapshot baseDmxValues przed edycją
                            fixtureEditSnapshot = Companion.baseDmxValues.clone()
                            fixturesViewState=3;activeCwSlot=0;savedScrollY=0;renderFixturesDispatch()
                        }})
                        fixturesContainer.addView(rC)
                    }
                    // Wiersz 5: label(7.0) | SETUP(3.0) = 10f (Gobo 1)
                    if(checkFixtureParam(fix,"Gobo 1")){
                        val rG1=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=10.0f;layoutParams=LinearLayout.LayoutParams(-1,j)}
                        rG1.addView(TextView(this@MainActivity).apply{text="Gobo 1 wheel setup";gravity=Gravity.CENTER_VERTICAL;setPadding(20,0,0,0);setTextColor(Color.BLACK);textSize=18f;layoutParams=LinearLayout.LayoutParams(0,-1,7.0f).apply{setMargins(5,5,5,5)}})
                        rG1.addView(TextView(this@MainActivity).apply{text="SETUP";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,3.0f).apply{setMargins(5,5,5,5)};setOnClickListener{
                            fixtureEditSnapshot = Companion.baseDmxValues.clone()
                            isGobo2Setup = false
                            fixturesViewState=4;activeGoboSlot=0;savedScrollY=0;renderFixturesDispatch()
                        }})
                        fixturesContainer.addView(rG1)
                    }
                    // Wiersz 6: label(7.0) | SETUP(3.0) = 10f (Gobo 2)
                    if(checkFixtureParam(fix,"Gobo 2")){
                        val rG2=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=10.0f;layoutParams=LinearLayout.LayoutParams(-1,j)}
                        rG2.addView(TextView(this@MainActivity).apply{text="Gobo 2 wheel setup";gravity=Gravity.CENTER_VERTICAL;setPadding(20,0,0,0);setTextColor(Color.BLACK);textSize=18f;layoutParams=LinearLayout.LayoutParams(0,-1,7.0f).apply{setMargins(5,5,5,5)}})
                        rG2.addView(TextView(this@MainActivity).apply{text="SETUP";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,3.0f).apply{setMargins(5,5,5,5)};setOnClickListener{
                            fixtureEditSnapshot = Companion.baseDmxValues.clone()
                            isGobo2Setup = true
                            fixturesViewState=4;activeGoboSlot=0;savedScrollY=0;renderFixturesDispatch()
                        }})
                        fixturesContainer.addView(rG2)
                    }
                }

                // ── STATE 2: CHANNEL ASSIGN ────────────────────────────────────
            } else if (fixturesViewState == 2) {
                val fix = fixturesList.getOrNull(editingFixtureIndex) ?: return

                val outerRow = LinearLayout(this@MainActivity).apply {
                    orientation = LinearLayout.HORIZONTAL
                    layoutParams = LinearLayout.LayoutParams(-1, -1)
                }

                // Lewa kolumna: nagłówek + scrollowalna tabela
                val leftCol = LinearLayout(this@MainActivity).apply {
                    orientation = LinearLayout.VERTICAL
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
                }

                // Wiersz 1 – nagłówek
                leftCol.addView(LinearLayout(this@MainActivity).apply {
                    orientation=LinearLayout.HORIZONTAL
                    layoutParams=LinearLayout.LayoutParams(-1, j)
                    addView(TextView(this@MainActivity).apply {
                        text="< BACK"; gravity=Gravity.CENTER; setTextColor(Color.WHITE); background=getBtnStyle()
                        layoutParams=LinearLayout.LayoutParams(sliderW,-1).apply{setMargins(5,5,5,5)}
                        setOnClickListener{fixturesViewState=1;savedScrollY=0;renderFixturesDispatch()}
                    })
                    addView(TextView(this@MainActivity).apply {
                        text="CHANNELS ASSIGN – ${fix.name}"; gravity=Gravity.CENTER_VERTICAL
                        setPadding(16,0,0,0); setTextColor(Color.BLACK); textSize=18f
                        layoutParams=LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(5,5,5,5)}
                    })
                })

                // Wiersze 2-8 – scrollowalna tabela
                val chListScroll = ScrollView(this@MainActivity).apply {
                    layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
                    isVerticalScrollBarEnabled = false; tag = "MAIN_SCROLL"
                }
                val chList = LinearLayout(this@MainActivity).apply { orientation = LinearLayout.VERTICAL }

                var chSliderRef: SeekBar? = null
                var chSliderIsMin = true
                var chSliderFixIdx = 0

                fun refreshHighlight() {
                    for (r in 0 until chList.childCount) {
                        val row = chList.getChildAt(r) as? LinearLayout ?: continue
                        (row.getChildAt(2) as? TextView)?.background = getBtnStyle().apply { setColor(if(chSliderIsMin&&chSliderFixIdx==r) Color.parseColor("#0055AA") else Companion.COL_DARK) }
                        (row.getChildAt(3) as? TextView)?.background = getBtnStyle().apply { setColor(if(!chSliderIsMin&&chSliderFixIdx==r) Color.parseColor("#0055AA") else Companion.COL_DARK) }
                    }
                }

                for (i in 0 until fix.channels) {
                    val rCh = LinearLayout(this@MainActivity).apply {
                        orientation=LinearLayout.HORIZONTAL; weightSum=12.0f
                        layoutParams=LinearLayout.LayoutParams(-1, j)
                    }
                    rCh.addView(TextView(this@MainActivity).apply {
                        text="${i+1}"; gravity=Gravity.CENTER; textSize=14f; setTextColor(Color.WHITE)
                        background=getBtnStyle().apply{setColor(Companion.COL_PANEL)}
                        layoutParams=LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(4,4,4,4)}
                    })
                    val currentPrm = fix.paramMap[i]
                    rCh.addView(TextView(this@MainActivity).apply {
                        text=if(currentPrm.isEmpty()) "---" else currentPrm
