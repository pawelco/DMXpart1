    private fun computeWave(shapeIdx: Int, phase: Float, pwm: Int): Float {
        return when (shapeIdx) {
            0 -> Math.sin(phase * 2.0 * Math.PI).toFloat()
            1 -> if (phase < 0.5f) phase * 4f - 1f else 3f - phase * 4f
            2 -> phase * 2f - 1f
            3 -> if (phase < pwm / 100f) 1f else -1f
            else -> 0f
        }
    }


    private fun sliderToTime(p: Int): Float = when {
        p == 0 -> -1f
        p == 1 -> 0f
        p <= 401 -> (p - 1) * 0.025f
        else -> 10f + (p - 401).toFloat()
    }

    private fun timeToSlider(t: Float): Int = when {
        t == -1f -> 0
        t == 0f -> 1
        t <= 10f -> ((t / 0.025f).toInt() + 1).coerceIn(2, 401)
        else -> (401 + (t - 10f).toInt()).coerceIn(402, 421)
    }

    private fun timeToDisplay(t: Float): String = when {
        t == -1f -> "STATIC"
        t == 0f -> "GLB"
        t < 10f -> "${String.format("%.3f", t)}s"
        else -> "${t.toInt()}s"
    }

