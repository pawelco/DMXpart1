        }

        dmxScope.launch {
            while (isActive) {
                delay(50)
                if (activeViewContainer.getChildAt(0) !== container) break
                container.post {
                    // Wartości lewego panelu – z dmxValues (rzeczywiste wyjście)


                    val groupFixes = fixturesList.filter { it.groupIdx == colorSelectedGroup }
                    val beamRParams = (1..10).map { "Beam ${it}R" }.toSet()

                    // Wszystkie 8 okienek podglądu grup – animowane z dmxValues
                    for (i in 0..7) {
                        groupPreviewBoxes[i]?.setBackgroundColor(getGroupPreviewColor(i))
                    }

                    // EXT box live
                    val extDmx = Companion.extColorDmxValues
                    extBg.setColor(Color.rgb((extDmx[0]+extDmx[3]).coerceAtMost(255),(extDmx[1]+extDmx[3]).coerceAtMost(255),(extDmx[2]+extDmx[3]).coerceAtMost(255)))
                    val extNowLocked = (0 until 64).any { exIdx ->
                        Companion.activeExPresets[exIdx] &&
                                Companion.memoryExPresets[exIdx].let { ep ->
                                    (0..3).any { j -> ep.exFix[j] == 6000 && ep.exDest[j] in listOf(9030, 9031) }
                                }
                    }
                    extBg.setStroke(if (extNowLocked) 6 else if (extColorSelected) 6 else 1,
                        if (extNowLocked) Color.MAGENTA else if (extColorSelected) Color.WHITE else Companion.COL_SEP)
                }
            }
        }

        colorViewRefreshCallback = {
            runOnUiThread {
                for (gi in 0..7) {
                    val sb = dimmersRow.findViewWithTag<SeekBar>("MIDI:SLIDER_${gi}_Dimmer") ?: continue
                    val fix = fixturesList.filter { it.groupIdx == gi }.firstOrNull() ?: continue
                    for (ch in 0 until fix.channels) {
                        if (fix.paramMap[ch] != "Dimmer") continue
                        val addr = fix.dmx-1+ch; if (addr !in 0..511) continue
                        val raw = Companion.baseDmxValues[addr]
                        val range = (fix.paramMax[ch]-fix.paramMin[ch]).coerceAtLeast(1)
                        sb.progress = ((raw-fix.paramMin[ch])*255/range).coerceIn(0,255)
                        break
                    }
                }
            }
        }

        return container
    }





    private fun createLfoEditView(lfoIndex: Int): View {
