        val goboShakeVal1 = IntArray(8) { 0 }
        val goboShakeVal2 = IntArray(8) { 0 }

        fun sendGoboShake(g: Int, param: String, shakeNorm: Float) {
            val fix = getGoboFix(g, param) ?: return
            val slotIdx = if (param == "Gobo2") Companion.goboActiveSlot2[g] else Companion.goboActiveSlot1[g]
            val shakeMin = if (param == "Gobo2") fix.gb2ShakeMin.getOrElse(slotIdx){0} else fix.gbShakeMin.getOrElse(slotIdx){0}
            val shakeMax = if (param == "Gobo2") fix.gb2ShakeMax.getOrElse(slotIdx){0} else fix.gbShakeMax.getOrElse(slotIdx){0}
            val baseDmx = if (param == "Gobo2") fix.gb2Dmx.getOrElse(slotIdx){0} else fix.gbDmx.getOrElse(slotIdx){0}
            val dmxVal = if (shakeNorm <= 0f || shakeMin == 0 && shakeMax == 0) baseDmx
            else (shakeMin + shakeNorm * (shakeMax - shakeMin)).toInt().coerceIn(0, 255)
            sendGobo(g, param, dmxVal)
        }

