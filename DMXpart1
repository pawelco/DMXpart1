            val beamAParams = (1..10).map { "Beam ${it}A" }.toSet()
            groupFixes.forEach { fix ->
                for (ch in 0 until fix.channels) {
                    val param = fix.paramMap[ch]; val actCh = fix.dmx-1+ch
                    if (actCh in 0..511) {
                        var v = -1
                        when {
                            param == "Red" || param in beamRParams -> v = dmxVals[0]
                            param == "Green" || param in beamGParams -> v = dmxVals[1]
                            param == "Blue" || param in beamBParams -> v = dmxVals[2]
                            param == "White" || param in beamWParams -> v = dmxVals[3]
                            param == "Amber" || param in beamAParams -> v = dmxVals[4]
                            param == "UV" -> v = dmxVals[5]
                            param == "Col. wheel" -> {
                                val hasRgb = fix.paramMap.contains("Red") || fix.paramMap.any { it in beamRParams }
                                if (!hasRgb) v = getClosestWheelDmx(fix,dmxVals[0],dmxVals[1],dmxVals[2])
                            }
                        }
                        if (v != -1) {
                            val mapped=fix.paramMin[ch]+(v*(fix.paramMax[ch]-fix.paramMin[ch])/255)
                            val order = Companion.seqRoutingOrder[colorSelectedGroup]
                            val onList = Companion.seqRoutingOn[colorSelectedGroup]
                            val posInRouting = order.indexOf(fix.id)
                            val isOnInSeq = Companion.seqRoutingMode[colorSelectedGroup] == 0 &&
                                    posInRouting >= 0 && onList.getOrElse(posInRouting) { true }
                            val isOffInPatt = Companion.seqRoutingMode[colorSelectedGroup] == 1 &&
                                    posInRouting >= 0 && !onList.getOrElse(posInRouting) { true }
                            // Zawsze zapisz do baseDmxValues (tło)
                            Companion.overrideChannel(actCh, mapped)
                            // setDmxChannel tylko dla fixture które NIE są aktywne w SEQ i NIE są OFF w PATT
                            if (!isOnInSeq && !isOffInPatt) setDmxChannel(actCh, mapped)
                        }
                    }
                }
            }
        }

        for (i in 0 until 64) {
            val mBtn = FrameLayout(this@MainActivity).apply {
                layoutParams = GridLayout.LayoutParams().apply {
                    width=0;height=0; columnSpec=GridLayout.spec(i%16,1,1f); rowSpec=GridLayout.spec(i/16,1,1f); setMargins(2,2,2,2)
                }
                background = GradientDrawable().apply {
                    shape=GradientDrawable.RECTANGLE; setColor(matrixColorsUI[i])
                    setStroke(if(groupColorIndices[colorSelectedGroup]==i) 8 else 0, Color.BLACK)
                }
            }
            matrixButtons.add(mBtn); matrixPanel.addView(mBtn)
        }

        for (i in 0..7) {
            val grpTab = LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.HORIZONTAL; weightSum = 2.0f
                tag = "MIDI:GROUP_SELECT_$i"
                layoutParams = GridLayout.LayoutParams().apply {
                    width=0;height=0; columnSpec=GridLayout.spec(i*2,2,1f); rowSpec=GridLayout.spec(4,1,1f)
                }
                val tGrp = TextView(this@MainActivity).apply {
                    text="${'A'+i}"; gravity=Gravity.CENTER; textSize=20f
                    layoutParams=LinearLayout.LayoutParams(0,LinearLayout.LayoutParams.MATCH_PARENT,1.0f)
                }
                val colPreviewBox = FrameLayout(this@MainActivity).apply {
                    layoutParams=LinearLayout.LayoutParams(0,LinearLayout.LayoutParams.MATCH_PARENT,1.0f).apply{setMargins(6,6,6,6)}
                    setBackgroundColor(getGroupPreviewColor(i))
                }
                groupPreviewBoxes[i] = colPreviewBox
                addView(tGrp); addView(colPreviewBox)
                setOnClickListener {
                    extColorSelected = false
                    extBg.setStroke(1, Companion.COL_SEP)
                    currentGroup = i
                    midiCcLastValues.keys.filter { it.contains("GLOBAL_") }.toList()
                        .forEach { midiCcLastValues.remove(it) }
                    midiPickupTargets.keys.filter { it.contains("GLOBAL_") }.toList()
                        .forEach { midiPickupTargets.remove(it) }
                    midiPickedUp.removeAll { it.contains("GLOBAL_") }
                    updateGroupUI(i)
                }
            }
            groupTabsList.add(grpTab); matrixPanel.addView(grpTab)
        }

        matrixPanel.setOnTouchListener { view, event ->
            val action = event.actionMasked
            if (action==android.view.MotionEvent.ACTION_DOWN||action==android.view.MotionEvent.ACTION_MOVE) {
                val w=view.width.toFloat(); val h=view.height.toFloat()
                if (w>0&&h>0) {
                    var col=(event.x/(w/16)).toInt(); var row=(event.y/(h/5)).toInt()
                    col=col.coerceIn(0,15); row=row.coerceIn(0,4)
                    if (row<4) applyColorToDmx(row*16+col)
                }; true
            } else false
        }

        val dimmersRow = LinearLayout(this@MainActivity).apply {
            orientation = LinearLayout.HORIZONTAL; weightSum = 8.0f
            layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 3f).apply { topMargin = -(j / 8) }
            setPadding(6, 0, 6, 0)
        }

        for (i in 0..7) {
            val dimSliderBox = FrameLayout(this@MainActivity).apply {
                layoutParams=LinearLayout.LayoutParams(0,LinearLayout.LayoutParams.MATCH_PARENT,1.0f)
                var initialDim=0
                val groupFixes=fixturesList.filter{it.groupIdx==i}
                if (groupFixes.isNotEmpty()) {
                    val fix=groupFixes[0]; for (ch in 0 until fix.channels) {
                        if (fix.paramMap[ch]=="Dimmer") { val actCh=fix.dmx-1+ch; if(actCh in 0..511){initialDim=dmxValues[actCh];break} }
                    }
                }
                val seekBar=SeekBar(this@MainActivity).apply {
                    max=255; rotation=270f; setPadding(80,0,80,0); progress=initialDim
                    tag = "MIDI:SLIDER_${i}_Dimmer"
                    val sliderLen=(j*3.3).toInt()
                    layoutParams=FrameLayout.LayoutParams(sliderLen,FrameLayout.LayoutParams.WRAP_CONTENT,Gravity.CENTER)
                    thumb=GradientDrawable().apply{shape=GradientDrawable.RECTANGLE;setSize(70,120);setColor(Companion.COL_DARK);setStroke(2,Color.BLACK);cornerRadius=4f}
                    setOnSeekBarChangeListener(object:SeekBar.OnSeekBarChangeListener{
                        override fun onProgressChanged(s:SeekBar?,p:Int,fromUser:Boolean) {
                            if (!fromUser) return
                            fixturesList.filter{it.groupIdx==i}.forEach{fix->
                                for (ch in 0 until fix.channels) {
                                    if (fix.paramMap[ch]=="Dimmer") {
                                        val actCh=fix.dmx-1+ch; if(actCh in 0..511){
                                            val pMin=fix.paramMin[ch];val pMax=fix.paramMax[ch]
                                            val mapped=pMin+(p*(pMax-pMin)/255)
                                            Companion.overrideChannel(actCh, mapped)
                                        }
                                    }
                                }
                            }
                        }
                        override fun onStartTrackingTouch(s:SeekBar?){}; override fun onStopTrackingTouch(s:SeekBar?){}
