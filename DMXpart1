    private fun showThemeEditor() {
        val j = exactRowHeight
        val m = 6

        val themeItems = listOf(
            "BG"         to { Companion.COL_BG },
            "Dark"       to { Companion.COL_DARK },
            "Panel"      to { Companion.COL_PANEL },
            "Panel Dark" to { Companion.COL_PANEL_DARK },
            "Button"     to { Companion.COL_BTN },
            "Btn Dark"   to { Companion.COL_BTN_DARK },
            "Row ON"     to { Companion.COL_ROW_ON },
            "Row OFF"    to { Companion.COL_ROW_OFF },
            "Text"       to { Companion.COL_TEXT },
            "Text Dim"   to { Companion.COL_TEXT_DIM },
            "Accent"     to { Companion.COL_ACCENT },
            "Separator"  to { Companion.COL_SEP }
        )

        // Szarości 16 poziomów
        val grays = (0..15).map { i ->
            val v = (i * 17).coerceIn(0, 255)
            Color.rgb(v, v, v)
        }

        val overlay = FrameLayout(this).apply {
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Color.parseColor("#DD000000"))
        }

        val panel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT
            ).apply { setMargins(j, j/2, j, j/2) }
            setBackgroundColor(Companion.COL_PANEL)
        }

        // Nagłówek
        panel.addView(LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            layoutParams = LinearLayout.LayoutParams(-1, j)
            setBackgroundColor(Companion.COL_PANEL_DARK)
            addView(TextView(this@MainActivity).apply {
                text = "THEME EDITOR"; gravity = Gravity.CENTER_VERTICAL
                textSize = 16f; setTextColor(Color.WHITE)
                typeface = android.graphics.Typeface.DEFAULT_BOLD
                setPadding(20, 0, 0, 0)
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
            })
            addView(TextView(this@MainActivity).apply {
                text = "✕"; gravity = Gravity.CENTER; textSize = 18f
                setTextColor(Color.WHITE)
                layoutParams = LinearLayout.LayoutParams(j, -1)
                setOnClickListener {
                    (overlay.parent as? FrameLayout)?.removeView(overlay)
                }
            })
        })

        // Nagłówek kolumn
        panel.addView(LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            layoutParams = LinearLayout.LayoutParams(-1, (j * 0.6f).toInt())
            setBackgroundColor(Companion.COL_BTN_DARK)
            addView(TextView(this@MainActivity).apply {
                text = "NAME"; gravity = Gravity.CENTER; textSize = 12f
                setTextColor(Companion.COL_TEXT_DIM)
                layoutParams = LinearLayout.LayoutParams(0, -1, 2f)
            })
            addView(TextView(this@MainActivity).apply {
                text = "MODE"; gravity = Gravity.CENTER; textSize = 12f
                setTextColor(Companion.COL_TEXT_DIM)
                layoutParams = LinearLayout.LayoutParams(0, -1, 1.5f)
            })
            addView(TextView(this@MainActivity).apply {
                text = "COLOR"; gravity = Gravity.CENTER; textSize = 12f
                setTextColor(Companion.COL_TEXT_DIM)
                layoutParams = LinearLayout.LayoutParams(0, -1, 4f)
            })
        })

        // Lista itemów
        val scroll = ScrollView(this).apply {
            layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
        }
        val list = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }

        // Tryby per pozycja (0=gray, 1=color)
        val modes = IntArray(themeItems.size) { 0 }

        fun buildRows() {
            list.removeAllViews()
            themeItems.forEachIndexed { idx, (label, getColor) ->
                val currentColor = getColor()
                val isGray = modes[idx] == 0

                val row = LinearLayout(this).apply {
                    orientation = LinearLayout.HORIZONTAL
                    layoutParams = LinearLayout.LayoutParams(-1, j).apply { setMargins(0, 1, 0, 1) }
                    setBackgroundColor(if (idx % 2 == 0) Companion.COL_ROW_ON else Companion.COL_ROW_OFF)
                }

                // Nazwa
                row.addView(TextView(this).apply {
                    text = label; gravity = Gravity.CENTER_VERTICAL
                    textSize = 14f; setTextColor(Color.WHITE)
                    setPadding(m*2, 0, 0, 0)
                    layoutParams = LinearLayout.LayoutParams(0, -1, 2f)
                })

                // Tryb Gray/Color
                val modeBg = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                    setColor(if (isGray) Color.parseColor("#555555") else Color.parseColor("#005588"))
                }
                row.addView(TextView(this).apply {
                    text = if (isGray) "GRAY" else "COLOR"
                    gravity = Gravity.CENTER; textSize = 12f; setTextColor(Color.WHITE)
                    background = modeBg
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1.5f).apply { setMargins(m, m, m, m) }
                    setOnClickListener {
                        modes[idx] = if (modes[idx] == 0) 1 else 0
                        buildRows()
                    }
                })

                // Paleta kolorów
                val colorPanel = LinearLayout(this).apply {
                    orientation = LinearLayout.HORIZONTAL
                    layoutParams = LinearLayout.LayoutParams(0, -1, 4f).apply { setMargins(0, m, m, m) }
                }

                val palette = if (isGray) grays else corePaletteColors.toList()
                val cols = 16
                val cellSize = (j * 0.7f).toInt()
                val paletteContainer = LinearLayout(this).apply {
                    orientation = LinearLayout.VERTICAL
                    layoutParams = LinearLayout.LayoutParams(-1, -1)
                }

                val rows = (palette.size + cols - 1) / cols
                for (r in 0 until rows) {
                    val rowLayout = LinearLayout(this).apply {
                        orientation = LinearLayout.HORIZONTAL
                        layoutParams = LinearLayout.LayoutParams(-1, cellSize)
                    }
                    for (c in 0 until cols) {
                        val ci = r * cols + c
                        if (ci >= palette.size) {
                            rowLayout.addView(View(this).apply {
                                layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
                            })
                            continue
                        }
                        val col = palette[ci]
                        val isSelected = col == currentColor
                        rowLayout.addView(FrameLayout(this).apply {
                            layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(2, 2, 2, 2) }
                            background = GradientDrawable().apply {
                                shape = GradientDrawable.RECTANGLE; cornerRadius = 2f
                                setColor(col)
                                setStroke(if (isSelected) 3 else 0, Color.WHITE)
                            }
                            setOnClickListener {
                                setThemeColor(idx, col)
                                buildRows()
                            }
                        })
                    }
                    paletteContainer.addView(rowLayout)
                }

                colorPanel.addView(paletteContainer)
                row.addView(colorPanel)
                list.addView(row)
            }
        }

        buildRows()
        scroll.addView(list)
        panel.addView(scroll)
        overlay.addView(panel)
        (activeViewContainer.parent as? FrameLayout)?.addView(overlay)
            ?: midiRootFrame.addView(overlay)
    }

    private fun setThemeColor(idx: Int, color: Int) {
        when (idx) {
            0  -> Companion.COL_BG = color
            1  -> Companion.COL_DARK = color
            2  -> Companion.COL_PANEL = color
            3  -> Companion.COL_PANEL_DARK = color
            4  -> Companion.COL_BTN = color
            5  -> Companion.COL_BTN_DARK = color
            6  -> Companion.COL_ROW_ON = color
            7  -> Companion.COL_ROW_OFF = color
            8  -> Companion.COL_TEXT = color
            9  -> Companion.COL_TEXT_DIM = color
            10 -> Companion.COL_ACCENT = color
            11 -> Companion.COL_SEP = color
        }
    }

    private fun createGoboView(): View {
        val j = exactRowHeight
        val m = 4
        var currentGroup = 0
        val tabR = j * 0.28f

        fun hasGobo(g: Int, param: String) = Companion.fixturesList.any { fix ->
            fix.groupIdx == g && (0 until fix.channels).any {
                fix.paramMap[it] == param || fix.paramMap[it] == "${param} rot" || fix.paramMap[it] == "${param} shake"
            }
        }

        fun getGoboFix(g: Int, param: String) = Companion.fixturesList.firstOrNull { fix ->
            fix.groupIdx == g && (0 until fix.channels).any {
                fix.paramMap[it] == param || fix.paramMap[it] == "${param} rot"
            }
        }

        fun sendGobo(g: Int, param: String, dmxVal: Int) {
            Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                val ch = (0 until fix.channels).firstOrNull {
                    fix.paramMap[it] == param || fix.paramMap[it] == "${param} rot"
                } ?: return@forEach
                val addr = fix.dmx - 1 + ch
                if (addr in 0..511) {
                    val mapped = fix.paramMin[ch] + (dmxVal * (fix.paramMax[ch] - fix.paramMin[ch]) / 255)
                    Companion.baseDmxValues[addr] = mapped
                    Companion.dmxValues[addr] = mapped
                    setDmxChannel(addr, mapped)
                }
            }
        }

        val container = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Companion.COL_BG)
        }

        val content = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
        }
        container.weightSum = 1f
        container.addView(content)

        var buildRow: ((Int) -> LinearLayout) = { LinearLayout(this) }

        fun buildGrid(g: Int, param: String, activeSlots: IntArray): LinearLayout {
            val fix = getGoboFix(g, param)
            val panel = LinearLayout(this).apply {
                orientation = LinearLayout.VERTICAL
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
            }

            // Nagłówek GOBO 1 / GOBO 2
            panel.addView(TextView(this).apply {
                text = if (param == "Gobo") "GOBO 1" else "GOBO 2"
                gravity = Gravity.CENTER; textSize = 13f
                setTextColor(Companion.COL_TEXT_DIM)
                layoutParams = LinearLayout.LayoutParams(-1, (j * 0.5f).toInt())
                setBackgroundColor(Companion.COL_PANEL)
            })

            if (fix == null) {
                panel.addView(TextView(this).apply {
                    text = "—"; gravity = Gravity.CENTER; textSize = 20f
                    setTextColor(Companion.COL_TEXT_DIM)
                    layoutParams = LinearLayout.LayoutParams(-1, -1)
                })
                return panel
            }

            val slots = (if (param == "Gobo2") fix.gb2Count else fix.gbCount).coerceAtMost(16)
            val cellSize = (j * 1.35f).toInt()

            // Kontener wycentrowany
            val gridWrap = LinearLayout(this).apply {
                orientation = LinearLayout.VERTICAL
                layoutParams = LinearLayout.LayoutParams(-1, -1)
                gravity = Gravity.CENTER
            }
            val grid = GridLayout(this).apply {
                columnCount = 4
                layoutParams = LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT
                )
            }

            for (i in 0 until 16) {
                val isActive = activeSlots[g] == i
                val hasSlot = i < slots

                val outerFrame = FrameLayout(this).apply {
                    layoutParams = GridLayout.LayoutParams().apply {
                        width = cellSize + 2 * m
                        height = cellSize + 2 * m
                        setMargins(m, m, m, m)
                    }
                    // Ramka zewnętrzna — czerwona gdy aktywny
                    background = GradientDrawable().apply {
                        shape = GradientDrawable.RECTANGLE; cornerRadius = 7f
                        setColor(Color.TRANSPARENT)
                        setStroke(if (isActive && hasSlot) 8 else 0, Color.RED)
                    }
                }

                val cell = FrameLayout(this).apply {
