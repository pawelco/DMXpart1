    private fun fireExPresetDmx(preset: PresetItem) {
        for (i in 0..3) {
            val fId = preset.exFix[i]; val dIdx = preset.exDest[i]; val vVal = preset.exVal[i]
            if (fId == -1 || dIdx == -1) continue
            val paramName = paramList.getOrNull(dIdx) ?: continue

            if (fId in 1000..1007) {
                fixturesList.filter { it.groupIdx == (fId - 1000) }.forEach { fix ->
                    val chIdx = fix.paramMap.indexOf(paramName)
                    if (chIdx != -1) {
                        val actCh = fix.dmx - 1 + chIdx
                        if (actCh in 0..511) {
                            val mapped = fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                            dmxValues[actCh] = mapped; setDmxChannel(actCh, mapped)
                        }
                    }
                }
            } else {
                val fix = fixturesList.find { it.id == fId } ?: continue
                val chIdx = fix.paramMap.indexOf(paramName)
                if (chIdx != -1) {
                    val actCh = fix.dmx - 1 + chIdx
                    if (actCh in 0..511) {
                        val mapped = fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                        dmxValues[actCh] = mapped; setDmxChannel(actCh, mapped)
                    }
                }
            }
        }
    }

    private fun activatePresetForGroups(prst: PresetItem, forceGroups: Set<Int>) {
        // 1. Suwaki – wymuś snapshot dla wskazanych grup
        Companion.fixturesList.forEach { fix ->
            if (fix.groupIdx in forceGroups) {
                for (ch in 0 until fix.channels) {
                    val dmxAddress = fix.dmx - 1 + ch
                    if (dmxAddress in 0..511) {
                        Companion.baseDmxValues[dmxAddress] = prst.dmxSnapshot[dmxAddress]
                        Companion.baseDmxTarget[dmxAddress] = prst.dmxSnapshot[dmxAddress]
                        Companion.baseDmxStart[dmxAddress] = prst.dmxSnapshot[dmxAddress]
                        setDmxChannel(dmxAddress, prst.dmxSnapshot[dmxAddress])
                    }
                }
            }
        }

        // 2. LFO/SEQ – aktywuj efekty dla wskazanych grup
        for (i in 0..3) {
            val lfo = memoryLfo[i]

            // Grupy adresowane przez zapisany LFO presetu
            val savedLfoGroups = mutableSetOf<Int>()
            for (d in 0..3) {
                val fId = prst.lfoFix[i][d]
                when {
                    fId in 1000..1007 -> savedLfoGroups.add(fId - 1000)
                    fId != -1 -> Companion.fixturesList.find { it.id == fId }?.groupIdx?.let { savedLfoGroups.add(it) }
                }
            }

            val lfoTouchesForced = savedLfoGroups.any { it in forceGroups }

            if (lfoTouchesForced) {
                val isAuxLoad = prst.presetTarget == 1
                if (lfoTarget[i] == (if (isAuxLoad) 1 else 0))
                    lfoEnabled[i] = prst.lfoEnabledMask[i]
                if (seqTarget[i] == (if (isAuxLoad) 1 else 0))
                    seqEnabled[i] = prst.seqEnabledMask[i]
                lfo.shapeIdx = prst.lfoShapes[i]
                lfo.rate = prst.lfoRates[i]
                lfo.isSync = prst.lfoSyncs[i]
                lfo.syncIdx = prst.lfoSyncIdxs[i]
                lfo.pwm = prst.lfoPwms[i]
                for (d in 0..3) {
                    lfo.fix[d] = prst.lfoFix[i][d]
                    lfo.dest[d] = prst.lfoDest[i][d]
                    lfo.amt[d] = prst.lfoAmt[i][d]
                    lfo.fad[d] = prst.lfoFad[i][d]
                    lfo.off[d] = prst.lfoOff[i][d]
                    lfo.phs[d] = prst.lfoPhs[i][d]
                }
                // Zresetuj smoothing dla świeżego startu
                for (d in 0..3) {
                    lfo.destSmoothed[d] = 0f
                    for (fi in lfo.fixSmoothed[d].indices) lfo.fixSmoothed[d][fi] = 0f
                }
            }

            // Kafelki matrycy dla wymuszonych grup
            for (g in forceGroups) {
                lfoGroupActive[i][g] = prst.lfoMatrix[i][g]
                seqGroupActive[i][g] = prst.seqMatrix[i][g]
            }

            // SEQ parametry
            if (lfoTouchesForced) {
                val sq = memorySeq[i]
                sq.totalSteps = prst.seqTotalSteps[i]
                sq.globalTime = prst.seqGlobalTimes[i]
                sq.isSync = prst.seqIsSyncs[i]
                sq.syncIdx = prst.seqSyncIdxs[i]
                sq.globalFade = prst.seqGlobalFades[i]
                sq.globalPhase = prst.seqGlobalPhases[i]
                for (s in 0..15) {
                    sq.stepType[s] = prst.seqStepTypes[i][s]
                    sq.stepValue[s] = prst.seqStepValues[i][s]
                    sq.stepTime[s] = prst.seqStepTimes[i][s]
                    sq.stepFade[s] = prst.seqStepFades[i][s]
                    sq.stepIsSync[s] = prst.seqStepIsSyncs[i][s]
                    sq.stepSyncIdx[s] = prst.seqStepSyncIdxs[i][s]
                }
                sq.currentStep = 0
                sq.stepTimer = 0f
            }
        }
    }

    private fun createPositionsView(): View {
        val movParamNames = listOf("Zoom", "Focus", "Iris", "PT speed")
