                val jsonStr = file.readText()
                val root = JSONObject(jsonStr)

                if (root.has("fixtures")) {
                    val fixArray = root.getJSONArray("fixtures")
                    fixturesList.clear()
                    for (i in 0 until fixArray.length()) {
                        val obj = fixArray.getJSONObject(i)
                        val name = obj.getString("name")
                        val channels = obj.getInt("channels")
                        val dmx = obj.getInt("dmx")
                        val id = obj.getInt("id")
                        val groupIdx = obj.getInt("groupIdx")

                        val pMapArr = obj.getJSONArray("paramMap")
                        val paramMap = Array(512) { "" }
                        for (j in 0 until pMapArr.length()) paramMap[j] = pMapArr.getString(j)

