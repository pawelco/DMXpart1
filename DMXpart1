    private fun getClosestWheelDmx(fix: FixtureItem, tr: Int, tg: Int, tb: Int): Int {
        if (fix.cwCount == 0) return 0
        if (tr == 0 && tg == 0 && tb == 0) return fix.cwDmx[0]
        var bestDmx = 0
        var minDist = 999999999L
        for (i in 0 until fix.cwCount) {
            val c = corePaletteColors[fix.cwColors[i]]
            val sr = Color.red(c)
            val sg = Color.green(c)
            val sb = Color.blue(c)
            val dr = (tr - sr).toLong()
            val dg = (tg - sg).toLong()
            val db = (tb - sb).toLong()
            val dist = dr * dr + dg * dg + db * db
            if (dist < minDist) {
                minDist = dist
                bestDmx = fix.cwDmx[i]
            }
        }
        return bestDmx
    }

    private fun refreshDmxOutput() {
        val out = Companion.baseDmxValues.clone()

        // Fade MAIN – tylko grupy z groupRouting == 0
        if (Companion.isFadingMain && Companion.currentFadeTimeMain > 0f) {
            val ratio = (Companion.currentFadeTimerMain / Companion.currentFadeTimeMain).coerceIn(0f, 1f)
            Companion.fixturesList.forEach { fix ->
                if (Companion.groupRouting[fix.groupIdx] == 0) {
                    for (ch in 0 until fix.channels) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) {
                            out[addr] = if (Companion.channelCanFade[addr]) {
                                (Companion.baseDmxStartMain[addr] + (out[addr] - Companion.baseDmxStartMain[addr]) * ratio).toInt()
                            } else {
                                if (ratio >= 0.5f) out[addr] else Companion.baseDmxStartMain[addr]
                            }
                        }
                    }
                }
            }
        }

        // Fade AUX – tylko grupy z groupRouting == 1
        if (Companion.isFadingAux && Companion.currentFadeTimeAux > 0f) {
            val ratio = (Companion.currentFadeTimerAux / Companion.currentFadeTimeAux).coerceIn(0f, 1f)
            Companion.fixturesList.forEach { fix ->
                if (Companion.groupRouting[fix.groupIdx] == 1) {
                    for (ch in 0 until fix.channels) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) {
                            out[addr] = if (Companion.channelCanFade[addr]) {
                                (Companion.baseDmxStartAux[addr] + (out[addr] - Companion.baseDmxStartAux[addr]) * ratio).toInt()
                            } else {
                                if (ratio >= 0.5f) out[addr] else Companion.baseDmxStartAux[addr]
                            }
                        }
                    }
                }
            }
        }

        // EX-presety zawsze
        for (i in 0 until 64) {
            if (Companion.activeExPresets[i]) {
                val preset = Companion.memoryExPresets[i]
                for (j in 0..3) {
                    val fId = preset.exFix[j]; val dIdx = preset.exDest[j]; val vVal = preset.exVal[j]
                    if (fId != -1 && dIdx != -1) {
                        val paramName = Companion.paramList.getOrNull(dIdx) ?: continue
                        val fixes = if (fId in 1000..1007) Companion.fixturesList.filter { it.groupIdx == (fId - 1000) }
                        else listOfNotNull(Companion.fixturesList.find { it.id == fId })
                        fixes.forEach { fix ->
                            val chIdx = fix.paramMap.indexOf(paramName)
                            if (chIdx != -1 && (fix.dmx - 1 + chIdx) in 0..511)
                                out[fix.dmx - 1 + chIdx] = fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                        }
                    }
                }
            }
        }

        System.arraycopy(out, 0, Companion.presetDmxValues, 0, 512)

        // PATT mode: zeruj wyłączone fixture na podstawie seqRoutingOn
        for (g in 0..7) {
            if (Companion.seqRoutingMode[g] != 1) continue
            val order = Companion.seqRoutingOrder[g]
            val onList = Companion.seqRoutingOn[g]
            order.forEachIndexed { pos, fixId ->
                if (onList.getOrElse(pos) { true }) return@forEachIndexed
                val fix = Companion.fixturesList.find { it.id == fixId } ?: return@forEachIndexed
                for (ch in 0 until fix.channels) {
                    val addr = fix.dmx - 1 + ch
                    if (addr in 0..511) out[addr] = 0
                }
            }
        }

        for (i in 0 until 512) {
            val isEffectManaged = synchronized(Companion.effectFlagsLock) { Companion.effectManagedChannels[i] }
            if (isEffectManaged) continue
            val posOffset = fanDmxOffsets[i]
            val skipFan = posOffset != 0 && Companion.fixturesList.any { fix ->
                val localCh = i - (fix.dmx - 1)
                localCh in 0 until fix.channels && fix.paramMap[localCh] == "Pan" &&
                        (0..3).any { si -> seqEnabled[si] && seqGroupActive[si][fix.groupIdx] &&
                                (memorySeq[si].stepType.any { it == 3 }) }
            }
            val withFan = if (skipFan) out[i].coerceIn(0,255) else (out[i] + posOffset).coerceIn(0, 255)
            if (Companion.dmxValues[i] != withFan) {
                Companion.dmxValues[i] = withFan
                setDmxChannel(i, withFan)
            }
        }
    }
    private fun applyFan(fanV: Int) {
        posFanValues[posCurrentGroup] = fanV
        if (posIsFixtureMode) return
        val fixes = Companion.fixturesList.filter { it.groupIdx == posCurrentGroup }
            .filter { fix -> (0 until fix.channels).any { fix.paramMap[it] == "Pan" } }
        val n = fixes.size
        fixes.forEach { fix ->
            for (ch in 0 until fix.channels) {
                val actCh = fix.dmx - 1 + ch; if (actCh in 0..511) fanDmxOffsets[actCh] = 0
            }
        }
        if (n < 2) { return }
        val spread = fanV - 128
        fixes.forEachIndexed { i, fix ->
            for (ch in 0 until fix.channels) {
                if (fix.paramMap[ch] == "Pan") {
                    val actCh = fix.dmx - 1 + ch
                    if (actCh in 0..511) {
                        val pMin = fix.paramMin[ch]; val pMax = fix.paramMax[ch]
                        val range = pMax - pMin
                        val baseNorm = if (range == 0) 0 else
                            ((Companion.baseDmxValues[actCh] - pMin) * 255 / range).coerceIn(0, 255)
                        val offset = (spread * (1f - 2f * i / (n - 1).toFloat())).toInt()
                        val outNorm = (baseNorm + offset).coerceIn(0, 255)
                        val outMapped = pMin + (outNorm * range / 255)
                        fanDmxOffsets[actCh] = outMapped - Companion.baseDmxValues[actCh]
                    }
                }
            }
        }
    }

    /**
     * Unified data entry slider.
     * Total size: 2u wide × 5u tall.
     * SeekBar area: 4u. Buttons row: 1u (bottom).
     * Handle: 1.5u wide × 0.75u tall. Track: 0.5u wide.
     *
     * @param max        SeekBar max value
     * @param initVal    Initial progress
     * @param onValue    Called with new value whenever it changes
     * Returns a LinearLayout sized 2u × 5u.
     */
    private fun createDataSlider(
        max: Int,
        initVal: Int,
        onValue: (Int) -> Unit
    ): Pair<LinearLayout, SeekBar> {
        val u = exactRowHeight
        val handleVisW = (1.5f * u).toInt()   // visual width after rotation
        val handleVisH = (0.75f * u).toInt()   // visual height after rotation
        val trackVisW  = (0.5f  * u).toInt()   // visual width of track
        val trackLen   = 4 * u                 // visual length of track (= height of seekbar area)

        var seekBarRef: SeekBar? = null

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            weightSum = 5f
            layoutParams = LinearLayout.LayoutParams(2 * u, 5 * u)
            clipChildren = false; clipToPadding = false
        }

        // ── 4 rows: SeekBar area ─────────────────────────────
        val sliderBox = FrameLayout(this).apply {
            layoutParams = LinearLayout.LayoutParams(-1, 0, 4f)
            clipChildren = false; clipToPadding = false
        }

        // Track background (szpara 0.5u)
        sliderBox.addView(View(this).apply {
            background = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE
                setColor(Color.WHITE); cornerRadius = 4f
            }
            layoutParams = FrameLayout.LayoutParams(trackVisW, trackLen, Gravity.CENTER)
        })

        val seekBar = SeekBar(this).apply {
            this.max = max
            rotation = 270f
            progress = initVal
            // padding = half handle height so thumb stays within track area
            val pad = handleVisH / 2
            setPadding(pad, 0, pad, 0)
            // Before rotation: width=trackLen, height=2u (becomes visual height=trackLen, width=2u)
            layoutParams = FrameLayout.LayoutParams(trackLen, 2 * u, Gravity.CENTER)
            minimumWidth = trackLen
            // setSize(drawW, drawH): after rotation=270 → visW=drawH, visH=drawW
            thumb = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE
                setSize(handleVisH, handleVisW)
                setColor(Companion.COL_DARK); setStroke(3, Color.BLACK); cornerRadius = 8f
            }
            progressDrawable = android.graphics.drawable.ColorDrawable(Color.TRANSPARENT)
            setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                override fun onProgressChanged(s: SeekBar?, p: Int, fromUser: Boolean) {
                    if (fromUser) onValue(p)
                    // MIDI Data Entry/Plus/Minus używa activeDataSliderCallback
                    // które jest wywoływane bezpośrednio, bez fromUser
                }
                override fun onStartTrackingTouch(s: SeekBar?) {}
                override fun onStopTrackingTouch(s: SeekBar?) {}
            })
            // Zapamiętaj callback dla MIDI – wywoływany przez SYSTEM_DATA_ENTRY/PLUS/MINUS
            tag?.let { } // tag nieużywany
            activeDataSliderCallback = { p -> onValue(p) }
        }
        seekBarRef = seekBar
        sliderBox.addView(seekBar)
        root.addView(sliderBox)

        // ── 1 row: + / - buttons ────────────────────────────
        val btnRow = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL; weightSum = 2f
            layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
        }
        btnRow.addView(TextView(this).apply {
            text = "−"; gravity = Gravity.CENTER; textSize = 24f; setTextColor(Color.WHITE)
            background = getBtnStyle()
            layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(2, 2, 1, 2) }
            setOnClickListener {
                val nv = (seekBar.progress - 1).coerceAtLeast(0)
                seekBar.progress = nv; onValue(nv)
            }
        })
        btnRow.addView(TextView(this).apply {
            text = "+"; gravity = Gravity.CENTER; textSize = 24f; setTextColor(Color.WHITE)
            background = getBtnStyle()
            layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(1, 2, 2, 2) }
            setOnClickListener {
                val nv = (seekBar.progress + 1).coerceAtMost(max)
                seekBar.progress = nv; onValue(nv)
            }
        })
        root.addView(btnRow)

        return Pair(root, seekBarRef!!)
    }

