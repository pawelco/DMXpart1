                outerRow.addView(rightCol)
                contentContainer.addView(outerRow)
            } else if (fixturesViewState == 4) {
                val fix = fixturesList.getOrNull(editingFixtureIndex) ?: return

                val goboParam = if (isGobo2Setup) "Gobo2" else "Gobo"
                val goboRot = if (isGobo2Setup) "Gobo2 rot" else "Gobo rot"

                fun outputGoboDmx(v: Int) {
                    val idx = fix.paramMap.indexOfFirst { it == goboParam || it == goboRot }
                    if (idx != -1) { val actCh = fix.dmx-1+idx; if (actCh in 0..511) {
                        val mapped = fix.paramMin[idx]+(v*(fix.paramMax[idx]-fix.paramMin[idx])/255)
                        Companion.baseDmxValues[actCh]=mapped; Companion.dmxValues[actCh]=mapped
                        Companion.effectManagedChannels[actCh]=true; setDmxChannel(actCh,mapped)
                    }}
