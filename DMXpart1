                setOnClickListener { activeLfoSlot = 100; rebuild() }
            }
            rateTv.tag = "MIDI:LFO_${lfoIndex}_RATE"
            rateTvRef = rateTv; addView(rateTv)
            addView(TextView(this@MainActivity).apply {
                text = "SYNC"; gravity = Gravity.CENTER; textSize = 14f; setTextColor(Color.WHITE)
                background = getBtnStyle().apply { setColor(if (lfo.isSync) Color.parseColor("#00AA00") else Companion.COL_BTN) }
