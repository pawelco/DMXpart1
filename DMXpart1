    private fun releaseSeqChannels(seqIdx: Int, targetRouting: Int = -1) {

            val isFading = Companion.isFadingMain || Companion.isFadingAux
            val seq = memorySeq[seqIdx]
            val hasPos = (0 until seq.totalSteps).any { seq.stepType[it] == 3 }
            val posParams = setOf("Pan","Pan Fine","Tilt","Tilt Fine")
            for (g in 0..7) {
                if (!seqGroupActive[seqIdx][g]) continue
                // Jeśli podano targetRouting, zwalniaj tylko grupy należące do tego routingu
                if (targetRouting >= 0 && Companion.groupRouting[g] != targetRouting) continue
                Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                for (ch in 0 until fix.channels) {
                    val paramHere = fix.paramMap[ch]
                    if (paramHere in posParams && !hasPos) continue
                    val actCh = fix.dmx - 1 + ch
                    if (actCh in 0..511) {
                        Companion.effectManagedChannels[actCh] = false
                        // Dla Pan/Tilt: zachowaj aktualną pozycję żeby uniknąć szarpnięcia
                        val isPos = paramHere in posParams
                        val currentVal = Companion.dmxValues[actCh]
                        dmxPersist[actCh] = if (isPos) currentVal.toFloat()
                        else Companion.baseDmxValues[actCh].toFloat()
                        if (!isFading) {
                            val base = Companion.baseDmxValues[actCh]
                            Companion.dmxValues[actCh] = base
                            setDmxChannel(actCh, base)
                        } else if (isPos) {
                            // Podczas fade: zaktualizuj start fade dla pozycji
                            if (Companion.groupRouting[g] == 1) {
                                Companion.baseDmxStartAux[actCh] = currentVal
                            } else {
                                Companion.baseDmxStartMain[actCh] = currentVal
                            }
                        }
                    }
                }
            }
        }
    }

    private fun isLfoLockedByEx(li: Int): Boolean {
        for (exIdx in 0 until 64) {
            if (!Companion.activeExPresets[exIdx]) continue
            val ep = Companion.memoryExPresets[exIdx]
            for (j in 0..3) {
                if (ep.exFix[j] == 3000 + li && ep.exDest[j] == 9000) return true
            }
        }
        return false
    }

    private fun isSeqLockedByEx(si: Int): Boolean {
        for (exIdx in 0 until 64) {
            if (!Companion.activeExPresets[exIdx]) continue
            val ep = Companion.memoryExPresets[exIdx]
            for (j in 0..3) {
                if (ep.exFix[j] == 4000 + si && ep.exDest[j] == 9010) return true
            }
        }
        return false
    }

    private fun createSequenceView(): View {
        val j = exactRowHeight
