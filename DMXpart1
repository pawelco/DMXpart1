    @androidx.annotation.RequiresApi(23)
    private fun setupMidi() {
        val mm = midiManager ?: return
        mm.registerDeviceCallback(object : android.media.midi.MidiManager.DeviceCallback() {
            override fun onDeviceAdded(info: android.media.midi.MidiDeviceInfo) {
                android.util.Log.d("MIDI_BLE", "onDeviceAdded: type=${info.type} name=${info.properties.getString(android.media.midi.MidiDeviceInfo.PROPERTY_NAME)}")
                runOnUiThread {
                    val name = info.properties.getString(
                        android.media.midi.MidiDeviceInfo.PROPERTY_NAME) ?: "MIDI Device"
                    Companion.midiDeviceNames.add(name)
                    openMidiDevice(info)
                    Toast.makeText(this@MainActivity, "MIDI: $name", Toast.LENGTH_SHORT).show()
                }
            }
            override fun onDeviceRemoved(info: android.media.midi.MidiDeviceInfo) {
                runOnUiThread {
                    Toast.makeText(this@MainActivity, "MIDI odłączono", Toast.LENGTH_SHORT).show()
                }
            }
        }, android.os.Handler(android.os.Looper.getMainLooper()))

        // Podłączone już urządzenia (w tym BLE przez MIDI+BLE)
        mm.devices.forEach { info ->
            val name = info.properties.getString(
                android.media.midi.MidiDeviceInfo.PROPERTY_NAME) ?: "MIDI Device"
            Companion.midiDeviceNames.add(name)
            openMidiDevice(info)
        }
    }

    @androidx.annotation.RequiresApi(23)
    private fun openMidiDevice(info: android.media.midi.MidiDeviceInfo, retryCount: Int = 0) {
        val handler = android.os.Handler(android.os.Looper.getMainLooper())
        midiManager?.openDevice(info, { device ->
            if (device == null) {
                if (retryCount < 5) handler.postDelayed({ openMidiDevice(info, retryCount + 1) }, 500)
                return@openDevice
            }
            var connected = false
            info.ports.forEach { portInfo ->
                android.util.Log.d("MIDI_BLE", "Trying port type=${portInfo.type} num=${portInfo.portNumber}")
                if (portInfo.type == android.media.midi.MidiDeviceInfo.PortInfo.TYPE_OUTPUT) {
                    device.openOutputPort(portInfo.portNumber)?.let { port ->
                        port.connect(MidiInputReceiver())
                        connected = true
                        android.util.Log.d("MIDI_BLE", "Connected OUTPUT port ${portInfo.portNumber}")
                    }
                }
            }
            if (!connected && retryCount < 5) {
                handler.postDelayed({ openMidiDevice(info, retryCount + 1) }, 1000)
            }
        }, handler)
    }

    inner class MidiInputReceiver : android.media.midi.MidiReceiver() {
        override fun onSend(data: ByteArray, offset: Int, count: Int, timestamp: Long) {
            android.util.Log.d("MIDI_IN", "onSend count=$count bytes=${data.take(3).map{it.toInt() and 0xFF}}")
            if (count < 2) return
            val status  = data[offset].toInt() and 0xFF
            val type    = status and 0xF0
            val channel = status and 0x0F
            val byte1   = if (count > 1) data[offset + 1].toInt() and 0x7F else 0
            val byte2   = if (count > 2) data[offset + 2].toInt() and 0x7F else 0
            runOnUiThread {
                when (type) {
                    0xB0 -> onMidiCC(channel, byte1, byte2)
                    0x90 -> onMidiNote(channel, byte1, byte2)
                    0x80 -> onMidiNote(channel, byte1, 0)
                    0xC0 -> onMidiPC(channel, byte1)
                }
            }
        }
    }

