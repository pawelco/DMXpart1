        fun sliderMaxForExSlot(i: Int): Int {
            val fId = preset.exFix[i]; val dIdx = preset.exDest[i]
            return when {
                fId in 3000..3003 && dIdx == 9001 -> 160
                fId in 3000..3003 && dIdx == 9002 -> 100
                fId in 4000..4003 && dIdx == 9011 -> 421
                fId in 5000..5003 && dIdx == 9022 -> 128
                fId in 5000..5003 && dIdx == 9023 -> 510
                fId in 5000..5003 && dIdx == 9024 -> 360
                else -> 255
            }
        }

        // --- PRAWY PANEL SUWAKA (Jasne tło, brak błędów!) ---
