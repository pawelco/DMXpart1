                        override fun onProgressChanged(s: SeekBar?, p: Int, fromUser: Boolean) {
                            if (!fromUser) return
                            shakeVals[g] = p
                            sendGoboShake(g, param, p / 255f)
                        }
                        override fun onStartTrackingTouch(s: SeekBar?) {}
                        override fun onStopTrackingTouch(s: SeekBar?) {}
                    })
                }
                sl.addView(seekBar)
                return sl
            }

            shakeRow.addView(addShakeSlider("Gobo", goboShakeVal1))
            if (hasGobo(g, "Gobo2")) {
                shakeRow.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(1, -1); setBackgroundColor(Companion.COL_SEP) })
