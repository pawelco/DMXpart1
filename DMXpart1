        fun sliderMaxFor(slot: Int): Int = when {
            slot == 200 && seq.isSync -> 12
            slot == 200 -> 421
            slot == 201 -> 50
            slot == 202 -> seq.totalSteps - 1
            slot % 10 == 1 && slot / 10 < 16 && seq.stepIsSync[slot / 10] -> 12
            slot % 10 == 1 -> 421
            slot % 10 == 2 -> 51
            else -> 0
        }
        fun sliderProgressFor(slot: Int): Int = when {
            slot == 200 && seq.isSync -> seq.syncIdx
            slot == 200 -> timeToSlider(seq.globalTime)
            slot == 201 -> seq.globalFade
            slot == 202 -> seq.globalPhase
            else -> {
                val si = slot / 10; val field = slot % 10
                when {
                    field == 1 && seq.stepIsSync[si] -> seq.stepSyncIdx[si]
                    field == 1 -> timeToSlider(seq.stepTime[si])
                    field == 2 -> if (seq.stepFade[si] == -1) 51 else seq.stepFade[si]
                    else -> 0
                }
            }
        }
        fun applySliderValue(slot: Int, p: Int) {
            when {
                slot == 200 && seq.isSync -> { seq.syncIdx = p.coerceIn(0,12); liveTvs[200]?.text = syncNames[seq.syncIdx] }
                slot == 200 -> { seq.globalTime = sliderToTime(p); liveTvs[200]?.text = timeToDisplay(seq.globalTime) }
                slot == 201 -> { seq.globalFade = p; liveTvs[201]?.text = p.toString() }
                slot == 202 -> { seq.globalPhase = p.coerceAtMost(seq.totalSteps - 1); liveTvs[202]?.text = "PHASE ${seq.globalPhase}" }
                slot % 10 == 1 -> {
                    val si = slot / 10
                    if (seq.stepIsSync[si]) { seq.stepSyncIdx[si] = p.coerceIn(0,12); liveTvs[slot]?.text = syncNames[seq.stepSyncIdx[si]] }
                    else { seq.stepTime[si] = sliderToTime(p); liveTvs[slot]?.text = timeToDisplay(seq.stepTime[si]) }
                }
                slot % 10 == 2 -> {
                    val si = slot / 10
                    seq.stepFade[si] = if (p == 51) -1 else p
                    liveTvs[slot]?.text = fadeText(seq.stepFade[si])
                }
            }
