                    activeViewContainer.removeAllViews()
                    activeViewContainer.addView(createMatrixView())
                }
            })
            addView(TextView(this@MainActivity).apply {
                text = "EDIT LFO ${lfoIndex+1}"; gravity = Gravity.CENTER; textSize = 18f
                setTextColor(rowColor); typeface = android.graphics.Typeface.DEFAULT_BOLD; cw(7f)
            })
