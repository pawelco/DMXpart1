        data class TouchedParam(var fixId: Int = -1, var destIdx: Int = -1, var lastVal: Int = 0)
        val lastTouchedParams = Array(4) { TouchedParam() }

        fun registerTouchedParam(fixId: Int, destIdx: Int, value: Int) {
            if (fixId == -1 || destIdx == -1) return
            val existingIdx = lastTouchedParams.indexOfFirst { it.fixId == fixId && it.destIdx == destIdx }
            if (existingIdx != -1) {
                val item = lastTouchedParams[existingIdx]
                item.lastVal = value
                for (i in existingIdx downTo 1) lastTouchedParams[i] = lastTouchedParams[i-1]
                lastTouchedParams[0] = item
            } else {
                for (i in 3 downTo 1) lastTouchedParams[i] = lastTouchedParams[i-1]
                lastTouchedParams[0] = TouchedParam(fixId, destIdx, value)
            }
        }

