        if (!Companion.engineRunning) {
            Companion.engineRunning = true
            Companion.dmxScope.launch {
                var lastTickNanos = System.nanoTime()
                while (isActive) {
                    val nowNanos = System.nanoTime()
                    val dt = ((nowNanos - lastTickNanos) / 1_000_000_000.0).coerceIn(0.001, 0.1)
                    lastTickNanos = nowNanos
                    tickEngine(dt)

                    // ── SILNIK LFO ──────────────────────────────────────
                    val syncBeats = listOf(
                        99999f,
                        0.0625f,
                        0.125f,
                        0.25f,
                        0.5f,
                        4f / 6f,
                        1f,
                        4f / 3f,
                        2f,
                        4f,
                        8f,
                        12f,
                        16f
                    )
                    val masterBpm = Companion.masterBpm
                    val baseBeatIncrement = dt * (masterBpm / 60.0)  // 1 "beat" = 60/masterBpm sekund

                    // Przelicz per-grupowy mnożnik tempa na podstawie FAST/SLOW/STOP
                    for (g in 0..7) Companion.perfGroupTempoMult[g] = 1f
                    if (Companion.perfSettings[3].isActive) {
                        val mult = listOf(2f,3f,4f,6f,8f).getOrElse(Companion.perfSettings[3].value){2f}
                        for (g in 0..7) if (Companion.perfSettings[3].groupMask[g]) Companion.perfGroupTempoMult[g] = mult
                    }
                    if (Companion.perfSettings[4].isActive) {
                        val mult = listOf(0.125f,0.1667f,0.25f,0.333f,0.5f).getOrElse(Companion.perfSettings[4].value){0.5f}
                        for (g in 0..7) if (Companion.perfSettings[4].groupMask[g]) Companion.perfGroupTempoMult[g] = mult
                    }
                    if (Companion.perfSettings[5].isActive) {
                        for (g in 0..7) if (Companion.perfSettings[5].groupMask[g]) Companion.perfGroupTempoMult[g] = 0f
                    }

                    refreshDmxOutput()  // zawsze odśwież presetDmxValues PRZED LFO
                    System.arraycopy(Companion.presetDmxValues, 0, Companion.lfoOutputValues, 0, 512)

                    val lfoFadeParams = setOf("Pan","Tilt","Zoom","Red","Green","Blue","White","Amber","UV","Beam 1R","Beam 1G","Beam 1B","Beam 1W","Beam 1A","Dimmer")
                    val lfoAccum = FloatArray(512) { 0f }
                    val lfoTouched = BooleanArray(512) { false }

                    for (li in 0..3) {
                        if (!lfoEnabled[li]) {
                            // Zwolnij wszystkie kanały tego LFO
                            val lfo = memoryLfo[li]
                            for (d in 0..3) {
                                val fId0 = lfo.fix[d];
                                val dIdx0 = lfo.dest[d]
                                if (fId0 == -1 || dIdx0 == -1) continue
                                val pName0 = Companion.paramList.getOrNull(dIdx0) ?: continue
                                val fixes0 = if (fId0 in 1000..1007)
                                    Companion.fixturesList.filter { it.groupIdx == fId0 - 1000 }
                                else listOfNotNull(Companion.fixturesList.find { it.id == fId0 })
                                fixes0.forEach { fix ->
                                    for (ch in 0 until fix.channels) {
                                        if (fix.paramMap[ch] == pName0) {
                                            val actCh = fix.dmx - 1 + ch
                                            if (actCh in 0..511) Companion.effectManagedChannels[actCh] =
                                                false
                                        }
                                    }
                                }
                            }
                            continue
                        }

                        val lfo = memoryLfo[li]

                        val lfoActiveGroups = (0..7).filter { lfoGroupActive[li][it] }
                        // Jeśli KTÓRAKOLWIEK grupa sterowana przez to LFO ma STOP (mult=0),
                        // całe LFO zamiera w miejscu — tak jak w oryginalnym silniku.
                        val lfoGroupMult = if (lfoActiveGroups.isNotEmpty()) {
                            if (lfoActiveGroups.any { Companion.perfGroupTempoMult[it] == 0f }) 0f
                            else lfoActiveGroups.map { Companion.perfGroupTempoMult[it] }.average().toFloat()
                        } else 1f
                        if (lfo.isSync) {
                            Companion.lfoBeatAccum[li] += baseBeatIncrement * lfoGroupMult
                            val beats = syncBeats.getOrElse(lfo.syncIdx) { 1f }
                            val cycleLenBeats = (beats * 2.0).coerceAtLeast(0.001)
                            val cyclesElapsed = Companion.lfoBeatAccum[li] / cycleLenBeats
                            lfo.phase = ((cyclesElapsed % 1.0) + 1.0).toFloat() % 1f
                        } else {
                            val actualFreq = lfo.rate * lfoGroupMult
                            lfo.phase += actualFreq * dt.toFloat()
                            while (lfo.phase >= 1f) lfo.phase -= 1f
                            while (lfo.phase < 0f) lfo.phase += 1f
                        }

                        lfo.currentValue = computeWave(lfo.shapeIdx, lfo.phase, lfo.pwm)

                        for (d in 0..3) {
                            val fId = lfo.fix[d];
                            val dIdx = lfo.dest[d]
                            if (fId == -1 || dIdx == -1) continue
                            val paramName = Companion.paramList.getOrNull(dIdx) ?: continue
                            // FX target (fId 2000-2003)
                            if (fId in 2000..2003) {
                                val fxIdx = fId - 2000
                                val fxT = Companion.memoryFx[fxIdx]
                                var fp2 = lfo.phase + lfo.phs[d] / 100f
                                while (fp2 >= 1f) fp2 -= 1f
                                while (fp2 < 0f)  fp2 += 1f
                                val lfoVal = computeWave(lfo.shapeIdx, fp2, lfo.pwm) * lfo.amt[d].toFloat()
                                when (paramName) {
                                    "FX_SPD" -> fxT.speed = (Companion.fxBaseSpeeds[fxIdx] + lfoVal * 0.025f).coerceAtLeast(0f)
                                    "FX_AMT" -> fxT.amt   = (Companion.fxBaseAmts[fxIdx]   + lfoVal.toInt()).coerceIn(-255, 255)
                                    "FX_PHS" -> fxT.phs   = ((Companion.fxBasePhss[fxIdx]  + lfoVal.toInt()) % 360 + 360) % 360
                                }
                                continue
                            }

                            val groupIdx = when {
                                fId in 1000..1007 -> fId - 1000
                                else -> Companion.fixturesList.find { it.id == fId }?.groupIdx ?: -1
                            }
                            if (groupIdx < 0) continue

                            // Jeśli grupa nieaktywna – zwolnij kanały i pomiń
                            if (!lfoGroupActive[li][groupIdx]) {
                                val fixesOff = if (fId in 1000..1007)
                                    Companion.fixturesList.filter { it.groupIdx == fId - 1000 }
                                else listOfNotNull(Companion.fixturesList.find { it.id == fId })
                                fixesOff.forEach { fix ->
                                    for (ch in 0 until fix.channels) {
                                        if (fix.paramMap[ch] == paramName) {
                                            val actCh = fix.dmx - 1 + ch
                                            if (actCh in 0..511) Companion.effectManagedChannels[actCh] =
                                                false
                                        }
                                    }
                                }
                                continue
                            }

                            val targetAmt = lfo.amt[d].toFloat()



                            val presetTouchesThisGroup = groupIdx in 0..7 &&
                                    Companion.groupRouting[groupIdx] == (if (lfoTarget[li] == 1) 1 else 0)
                            val isFadingForThisLfo = if (lfoTarget[li] == 1) Companion.isFadingAux else Companion.isFadingMain
                            val fadeTimeForThisLfo = if (lfoTarget[li] == 1) Companion.currentFadeTimeAux else Companion.currentFadeTimeMain
                            val fadeTimerForThisLfo = if (lfoTarget[li] == 1) Companion.currentFadeTimerAux else Companion.currentFadeTimerMain

                            if (paramName in lfoFadeParams && isFadingForThisLfo && presetTouchesThisGroup) {
                                val progress = if (fadeTimeForThisLfo > 0f)
                                    (fadeTimerForThisLfo / fadeTimeForThisLfo).coerceIn(0f, 1f)
                                else 1f
                                lfo.destSmoothed[d] = targetAmt * progress
                            } else {
                                lfo.destSmoothed[d] = targetAmt
                            }
                            val amtMult = lfo.destSmoothed[d]
                            val phsVal = lfo.phs[d]

                            val fixes = if (fId in 1000..1007)
                                Companion.fixturesList.filter { it.groupIdx == fId - 1000 }
                            else
                                listOfNotNull(Companion.fixturesList.find { it.id == fId })

                            val fixCount = fixes.size

                            fixes.forEachIndexed { fixIdx, fix ->
                                var fp = lfo.phase + when {
                                    phsVal >= 0 -> phsVal / 100f
                                    fixCount > 0 -> -(-phsVal / 100f) * fixIdx.toFloat() / fixCount
                                    else -> 0f
                                }
                                while (fp >= 1f) fp -= 1f
                                while (fp < 0f) fp += 1f

                                var fixVal = computeWave(lfo.shapeIdx, fp, lfo.pwm)

                                if (lfo.fad[d] > 0 && (lfo.shapeIdx == 2 || lfo.shapeIdx == 3)) {
                                    val fadeTime = lfo.fad[d] * 0.05f
                                    val maxDelta = dt.toFloat() / fadeTime
                                    val cur = lfo.fixSmoothed[d][fixIdx]
                                    lfo.fixSmoothed[d][fixIdx] = when {
                                        fixVal > cur -> (cur + maxDelta).coerceAtMost(fixVal)
                                        fixVal < cur -> (cur - maxDelta).coerceAtLeast(fixVal)
                                        else -> fixVal
                                    }
                                    fixVal = lfo.fixSmoothed[d][fixIdx]
                                } else {
                                    lfo.fixSmoothed[d][fixIdx] = fixVal
                                }

                                val modVal = lfo.off[d] + (fixVal * amtMult).toInt()

                                for (ch in 0 until fix.channels) {
                                    if (fix.paramMap[ch] == paramName) {
                                        val actCh = fix.dmx - 1 + ch
                                        if (actCh in 0..511) {
                                            lfoAccum[actCh] += modVal
                                            lfoTouched[actCh] = true
                                            synchronized(Companion.effectFlagsLock) { Companion.effectManagedChannels[actCh] = true }
                                            Companion.lfoCurrentPhases[li] = lfo.phase
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── APLIKACJA SUMY WSZYSTKICH LFO (addytywnie) ───────
                    for (ch in 0..511) {
                        if (!lfoTouched[ch]) continue
                        val isDimmer = Companion.fixturesList.any { fix ->
                            val lc = ch - (fix.dmx - 1)
                            lc in 0 until fix.channels && fix.paramMap[lc] == "Dimmer"
                        }
                        val fv = if (isDimmer) {
                            // Suwak dimmera = master scale: LFO 0..255 skalowane przez baseDmxValues.
                            // Suwak na 0 → ciemno zawsze. Suwak na 255 → pełna amplituda LFO.
                            val lfoOut = lfoAccum[ch].toInt().coerceIn(0, 255)
                            (lfoOut * Companion.baseDmxValues[ch] / 255.0f).toInt().coerceIn(0, 255)
                        } else {
                            val base = Companion.presetDmxValues[ch]
                            (base + lfoAccum[ch]).toInt().coerceIn(0, 255)
                        }
                        Companion.lfoOutputValues[ch] = fv
                        Companion.dmxValues[ch] = fv
                        setDmxChannel(ch, fv)
                    }
// Zwolnij kanały które LFO przestało dotykać (np. po usunięciu dest)
                    for (ch in 0..511) {
                        if (lfoTouched[ch]) continue
                        if (!Companion.effectManagedChannels[ch]) continue
                        // Zostaw jeśli SEQ zarządza tym kanałem
                        val seqManages = Companion.fixturesList.any { fix ->
                            val lc = ch - (fix.dmx - 1)
                            if (lc !in 0 until fix.channels) return@any false
                            (0..3).any { si -> seqEnabled[si] && seqGroupActive[si][fix.groupIdx] }
                        }
                        if (!seqManages) Companion.effectManagedChannels[ch] = false
                    }
                    // ── KONIEC SILNIKA LFO ───────────────────────────────// ── KONIEC SILNIKA LFO ───────────────────────────────

                    // ── EXT color routing ────────────────────────────────
                    if (Companion.extColorRouting in 1..4) {
                        val srcIdx = Companion.extColorRouting - 1
                        if (seqEnabled[srcIdx]) {
                            val sq = memorySeq[srcIdx]
                            val curType = sq.stepType[sq.currentStep]
                            val prevType = sq.stepType[sq.prevStep]
                            if (curType == 1 || prevType == 1) {
                                // Oblicz crossfadeMix tak samo jak w silniku SEQ
                                val fadeVal = if (sq.stepFade[sq.currentStep] >= 0) sq.stepFade[sq.currentStep] else sq.globalFade
                                val stepDur = if (sq.stepTime[sq.currentStep] > 0f) sq.stepTime[sq.currentStep].toDouble() else sq.globalTime.toDouble()
                                val crossfadeMix: Float = if (fadeVal in 1..25) {
                                    val fadeTime = (stepDur * fadeVal / 25.0).toFloat().coerceAtLeast(0.01f)
                                    (sq.stepTimer / fadeTime).coerceIn(0f, 1f)
                                } else 1f

                                val curDmx = if (curType == 1)
                                    Companion.getPaletteDmxValues(sq.stepValue[sq.currentStep])
                                else IntArray(6) { 0 }

                                val prevDmx = if (prevType == 1)
                                    Companion.getPaletteDmxValues(sq.stepValue[sq.prevStep])
                                else Companion.extColorDmxValues.clone()

                                for (c in 0 until 6) {
                                    Companion.extColorDmxValues[c] = (prevDmx[c] + (curDmx[c] - prevDmx[c]) * crossfadeMix).toInt().coerceIn(0, 255)
                                }
                            }
                        }
                    }




                    // ── SILNIK SEQ ──────────────────────────────────────
                    val seqColorParams = setOf(
                        "Red","Green","Blue","White","Amber","UV","Col. wheel",
                        "Beam 1R","Beam 1G","Beam 1B","Beam 1W","Beam 1A",
                        "Beam 2R","Beam 2G","Beam 2B","Beam 2W","Beam 2A",
                        "Beam 3R","Beam 3G","Beam 3B","Beam 3W","Beam 3A",
                        "Beam 4R","Beam 4G","Beam 4B","Beam 4W","Beam 4A",
                        "Beam 5R","Beam 5G","Beam 5B","Beam 5W","Beam 5A",
                        "Beam 6R","Beam 6G","Beam 6B","Beam 6W","Beam 6A",
                        "Beam 7R","Beam 7G","Beam 7B","Beam 7W","Beam 7A",
                        "Beam 8R","Beam 8G","Beam 8B","Beam 8W","Beam 8A",
                        "Beam 9R","Beam 9G","Beam 9B","Beam 9W","Beam 9A",
                        "Beam 10R","Beam 10G","Beam 10B","Beam 10W","Beam 10A"
                    )
                    val lfoControlledMovParams = setOf("Zoom", "Focus", "Iris")
                    val lfoControlledGroupParams = HashSet<String>()
                    for (li in 0..3) {
                        if (!lfoEnabled[li]) continue
                        val lfoC = memoryLfo[li]
                        for (d in 0..3) {
                            val fIdC = lfoC.fix[d]; val dIdxC = lfoC.dest[d]
                            if (fIdC == -1 || dIdxC == -1) continue
                            val pNameC = Companion.paramList.getOrNull(dIdxC) ?: continue
                            if (pNameC !in lfoControlledMovParams) continue
                            val gIdxC = when {
                                fIdC in 1000..1007 -> fIdC - 1000
                                else -> Companion.fixturesList.find { it.id == fIdC }?.groupIdx ?: -1
                            }
                            if (gIdxC < 0) continue
                            if (!lfoGroupActive[li][gIdxC]) continue
                            lfoControlledGroupParams.add("${gIdxC}_$pNameC")
                        }
                    }
                    for (si in 0..3) {
                        if (!seqEnabled[si]) continue
                        val seq = memorySeq[si]
                        if (seq.totalSteps == 0) continue
                        val seqHasPositionSteps = (0 until seq.totalSteps).any { seq.stepType[it] == 3 }
                        // 1. Czas trwania bieżącego kroku
                        val rawTime = seq.stepTime[seq.currentStep]
                        val stepDurRaw: Float = when {
                            rawTime == -1f -> 99999f  // STATIC – krok nie przechodzi
                            seq.stepIsSync[seq.currentStep] -> {
                                val beats =
                                    syncBeats.getOrElse(seq.stepSyncIdx[seq.currentStep]) { 1f }
                                beats * (60f / masterBpm)
                            }
                            rawTime > 0f -> rawTime
                            seq.isSync -> {
                                val beats = syncBeats.getOrElse(seq.syncIdx) { 1f }
                                beats * (60f / masterBpm)
                            }
                            else -> if (seq.globalTime == -1f) 99999f else seq.globalTime.coerceAtLeast(0.025f)
                        }.coerceAtLeast(0.025f)
                        val seqActiveGroups = (0..7).filter { seqGroupActive[si][it] }
                        // SEQ sterujący EXT color (Companion.extColorRouting wskazuje na ten slot)
                        // nie ma żadnych aktywnych kafelków grup, więc nie jest objęty STOP per-grupowym.
                        // Domyślnie ma się zatrzymywać razem z globalnym STOP (Performance index 5),
                        // gdy ten jest aktywny na DOWOLNEJ grupie (traktujemy STOP jako uniwersalny).
                        val isExtControllerForThisSeq = (Companion.extColorRouting - 1) == si
                        val stopActiveAnywhere = Companion.perfSettings[5].isActive
                        val seqStopped = seqActiveGroups.any { Companion.perfGroupTempoMult[it] == 0f } ||
                                (isExtControllerForThisSeq && stopActiveAnywhere)
                        val seqGroupMult = if (seqActiveGroups.isNotEmpty())
                            seqActiveGroups.map { Companion.perfGroupTempoMult[it] }.average().toFloat()
                        else 1f
                        val stepDur: Float = if (seqStopped || stepDurRaw >= 99999f) 99999f
                        else (stepDurRaw / seqGroupMult).coerceAtLeast(0.025f)

                        // Fade-out timer
                        if (Companion.seqFadeOutActive[si]) {
                            Companion.seqFadeOutTimer[si] += dt.toFloat()
                            if (Companion.seqFadeOutTimer[si] >= Companion.seqFadeOutDuration[si]) {
                                // Koniec fade-out – teraz naprawdę wyłącz
                                Companion.seqFadeOutActive[si] = false
                                seqEnabled[si] = false
                                releaseSeqChannels(si)
                            }
                        }

                        val seqFOMult = if (Companion.seqFadeOutActive[si] && Companion.seqFadeOutDuration[si] > 0f)
                            1f - (Companion.seqFadeOutTimer[si] / Companion.seqFadeOutDuration[si]).coerceIn(0f, 1f)
                        else 1f

                        // Sekwencer ma tikować zawsze, gdy główny wyłącznik (seqEnabled) jest aktywny –
                        // niezależnie od tego, czy steruje jakąkolwiek grupą przez kafelki matrycy.
                        // To jest istotne dla EXT color routing, który czyta stan sekwencera (krok,
                        // fade, timer) niezależnie od matrycy grup. STOP w Performance wciąż zamraża
                        // krok, ale tylko dla grup faktycznie nim sterowanych (seqStopped poniżej).
                        val hasActiveGroup = (0..7).any { seqGroupActive[si][it] }

                        // 2. Tick timera i przejście do następnego kroku
                        if (seq.isSync && seq.totalSteps > 0) {
                            if (!seqStopped) Companion.seqBeatAccum[si] += baseBeatIncrement * seqGroupMult
                            val beats = syncBeats.getOrElse(seq.syncIdx) { 1f }
                            val stepLenBeats = beats.toDouble().coerceAtLeast(0.001)
                            val stepsElapsed = Companion.seqBeatAccum[si] / stepLenBeats
                            val newStepCount = stepsElapsed.toLong()
                            val lastStepCount = Companion.seqPingPongPos[si]

                            if (newStepCount > lastStepCount) {
                                val advances = (newStepCount - lastStepCount).toInt().coerceAtMost(seq.totalSteps * 2)
                                Companion.seqPingPongPos[si] = newStepCount
                                repeat(advances) {
                                    seq.prevStep = seq.currentStep
                                    seq.justReset = false
                                    if (seq.globalPhase == seq.totalSteps && seq.totalSteps > 1) {
                                        val next = seq.currentStep + Companion.seqPingPongDirection[si]
                                        when {
                                            next >= seq.totalSteps -> {
                                                Companion.seqPingPongDirection[si] = -1
                                                seq.currentStep = seq.totalSteps - 2
                                            }
                                            next < 0 -> {
                                                Companion.seqPingPongDirection[si] = 1
                                                seq.currentStep = 1.coerceAtMost(seq.totalSteps - 1)
                                            }
                                            else -> seq.currentStep = next
                                        }
                                    } else {
                                        seq.currentStep = (seq.currentStep + 1) % seq.totalSteps
                                    }
                                }
                            }
                            seq.stepTimer = ((stepsElapsed % 1.0) * stepDur).toFloat()

                        } else if (!seqStopped) {
                            seq.stepTimer += dt.toFloat()
                            if (seq.stepTimer >= stepDur) {
                                seq.prevStep = seq.currentStep
                                seq.stepTimer = 0.0f
                                seq.justReset = false
                                if (seq.globalPhase == seq.totalSteps && seq.totalSteps > 1) {
                                    val next = seq.currentStep + Companion.seqPingPongDirection[si]
                                    when {
                                        next >= seq.totalSteps -> {
                                            Companion.seqPingPongDirection[si] = -1
                                            seq.currentStep = seq.totalSteps - 2
                                        }
                                        next < 0 -> {
                                            Companion.seqPingPongDirection[si] = 1
                                            seq.currentStep = 1.coerceAtMost(seq.totalSteps - 1)
                                        }
                                        else -> seq.currentStep = next
                                    }
                                } else {
                                    seq.currentStep = (seq.currentStep + 1) % seq.totalSteps
                                }
                            }
                        }

                        val curStep = seq.currentStep
                        val prevStep = seq.prevStep

                        // 3. Crossfade mix
                        val fadeVal =
                            if (seq.stepFade[curStep] == -1) seq.globalFade else seq.stepFade[curStep]
                        val crossfadeMix: Float = if (fadeVal in 1..25 && !Companion.seqPingPongJustBounced[si]) {
                            val fadeTime = (stepDur * fadeVal / 25f).coerceAtLeast(0.01f)
                            (seq.stepTimer / fadeTime).coerceIn(0f, 1f)
                        } else {
                            Companion.seqPingPongJustBounced[si] = false
                            1f
                        }

                        // 4. Kolor kroku → [R,G,B,W,A,UV] lub null (transparent)
                        fun stepRgbwa(stepIdx: Int): IntArray? {
                            if (stepIdx < 0 || stepIdx >= seq.totalSteps) return null
                            return when (seq.stepType[stepIdx]) {
                                1 -> Companion.getPaletteDmxValues(seq.stepValue[stepIdx])
                                2 -> Companion.extColorDmxValues.clone()
                                else -> null
                            }
                        }

                        // 5. Aplikacja per-fixture z phase offsetem
                        var globalFixIdx = 0
                        for (g in 0..7) {
                            // Buduj listę fixture zgodnie z seqRoutingOrder (kolejność + filtr ON/OFF)
                            val allGroupFixes = Companion.fixturesList.filter { it.groupIdx == g }
                            val order = Companion.seqRoutingOrder[g]
                            val onList = Companion.seqRoutingOn[g]
                            val groupFixes = if (order.isEmpty() || Companion.seqRoutingMode[g] != 0) {
                                allGroupFixes
                            } else {
                                // SEQ mode: zachowaj kolejność z routingu, pomiń wyłączone
                                val result = mutableListOf<Companion.FixtureItem>()
                                order.forEachIndexed { pos, fixId ->
                                    val isOn = onList.getOrElse(pos) { true }
                                    if (isOn) {
                                        allGroupFixes.find { it.id == fixId }?.let { result.add(it) }
                                    }
                                }
                                // Dodaj fixture których nie ma w routingu (nowe, nieznane)
                                allGroupFixes.forEach { fix ->
                                    if (order.indexOf(fix.id) == -1) result.add(fix)
                                }
                                result
                            }
                            if (!seqGroupActive[si][g]) {
                                globalFixIdx += groupFixes.size
                                continue
                            }
                            groupFixes.forEach { fix ->
                                val effectivePhase = if (seq.globalPhase == seq.totalSteps) 1 else seq.globalPhase
                                val phaseOff = if (seq.totalSteps > 0) (globalFixIdx * effectivePhase) % seq.totalSteps else 0
                                val myStep = (curStep + phaseOff) % seq.totalSteps
                                val myPrev = if (seq.justReset) -1 else (prevStep + phaseOff) % seq.totalSteps

                                val cCol = stepRgbwa(myStep)
                                val pCol = if (myPrev >= 0) stepRgbwa(myPrev) else null


                                if (cCol != null && !Companion.colorManualOverride[g]) {
                                    val target = cCol ?: intArrayOf(0, 0, 0, 0, 0, 0)
                                    // Przy justReset (świeży recall presetu) nie ma realnego "poprzedniego
                                    // kroku" – myPrev=-1, więc base byłby czarny, a crossfadeMix sekwencera
                                    // (jego WŁASNY, zwykle krótki czas) rampowałby kolor od czerni w swoim
                                    // tempie, niezależnie od dłuższego fade presetu. To dawało widoczny
                                    // błysk/skok przez czerń. Celujemy więc prosto w docelowy kolor kroku
                                    // i pozwalamy mechanizmowi pomostu (fadeStartVal/fadeRatio) obsłużyć
                                    // płynne wejście w tempie fade presetu.
                                    val mixed = if (seq.justReset) {
                                        IntArray(6) { i -> target[i].coerceIn(0, 255) }
                                    } else {
                                        val base = pCol ?: intArrayOf(0, 0, 0, 0, 0, 0)
                                        IntArray(6) { i ->
                                            (base[i] + (target[i] - base[i]) * crossfadeMix).toInt()
                                                .coerceIn(0, 255)
                                        }
                                    }

                                    for (ch in 0 until fix.channels) {
                                        val param = fix.paramMap[ch]
                                        val actCh = fix.dmx - 1 + ch
                                        if (actCh !in 0..511) continue
                                        val v = when (param) {
                                            "Red", "Beam 1R" -> mixed[0]
                                            "Green", "Beam 1G" -> mixed[1]
                                            "Blue", "Beam 1B" -> mixed[2]
                                            "White", "Beam 1W" -> mixed[3]
                                            "Amber", "Beam 1A" -> mixed[4]
                                            "UV" -> mixed[5]
                                            "Col. wheel" -> {
                                                val hasRgb =
                                                    fix.paramMap.contains("Red") || fix.paramMap.contains(
                                                        "Beam 1R"
                                                    )
                                                if (!hasRgb) getClosestWheelDmx(
                                                    fix,
                                                    mixed[0],
                                                    mixed[1],
                                                    mixed[2]
                                                ) else -1
                                            }

                                            else -> -1
                                        }
                                        if (v >= 0) {
                                            val mapped =
                                                fix.paramMin[ch] + (v * (fix.paramMax[ch] - fix.paramMin[ch]) / 255)
                                            val baseV = Companion.baseDmxValues[actCh]
                                            var fadedMapped = (baseV + (mapped - baseV) * seqFOMult).toInt().coerceIn(0, 255)
                                            // Pomost fade presetu: świeży recall (justReset) z aktywnym fade –
                                            // jedź liniowo od koloru SPRZED recall do docelowego koloru kroku,
                                            // w tempie zgodnym z czasem fade presetu. Bierzemy MAIN albo AUX
                                            // zależnie od tego, którą szynę steruje ten SEQ (Companion.seqTarget).
                                            val isFadingForThisSeq = if (Companion.seqTarget[si] == 1) Companion.isFadingAux else Companion.isFadingMain
                                            val fadeTimeForThisSeq = if (Companion.seqTarget[si] == 1) Companion.currentFadeTimeAux else Companion.currentFadeTimeMain
                                            val fadeTimerForThisSeq = if (Companion.seqTarget[si] == 1) Companion.currentFadeTimerAux else Companion.currentFadeTimerMain
                                            val fadeStartArrForThisSeq = if (Companion.seqTarget[si] == 1) Companion.baseDmxStartAux else Companion.baseDmxStartMain
                                            if (isFadingForThisSeq && fadeTimeForThisSeq > 0f) {
                                                val fadeRatio = (fadeTimerForThisSeq / fadeTimeForThisSeq).coerceIn(0f, 1f)
                                                val fadeStartVal = fadeStartArrForThisSeq[actCh]
                                                fadedMapped = (fadeStartVal + (fadedMapped - fadeStartVal) * fadeRatio).toInt().coerceIn(0, 255)
                                            }
                                            Companion.dmxValues[actCh] = fadedMapped
                                            Companion.seqOutputValues[actCh] = fadedMapped
                                            synchronized(Companion.effectFlagsLock) { Companion.effectManagedChannels[actCh] = true }
                                            setDmxChannel(actCh, fadedMapped)
                                        }
                                    }
                                } else {
                                    // Pusty krok – zwolnij kanały kolorów (przezroczystość)
                                    for (ch in 0 until fix.channels) {
                                        if (fix.paramMap[ch] in seqColorParams) {
                                            val actCh2 = fix.dmx - 1 + ch
                                            if (actCh2 in 0..511) Companion.effectManagedChannels[actCh2] =
                                                false
                                        }
                                    }
                                }

                                // ── Position step (type 3) – SEQ steruje na żywo tylko Pan/Tilt ──
                                val posMovSet = setOf(
                                    "Pan",
                                    "Pan Fine",
                                    "Tilt",
                                    "Tilt Fine"
                                )
                                val curPosStep = seq.stepType[myStep] == 3
                                val prevPosStep = myPrev >= 0 && seq.stepType[myPrev] == 3
                                val presetFadeRatio = if (seq.justReset && Companion.isFadingMain && Companion.currentFadeTimeMain > 0f)
                                    (Companion.currentFadeTimerMain / Companion.currentFadeTimeMain).coerceIn(0f,1f)
                                else 1f

                                if (seqHasPositionSteps && !curPosStep && !prevPosStep) {
                                    for (ch in 0 until fix.channels) {
                                        val pn0 = fix.paramMap[ch]
                                        if (pn0 in posMovSet) {
                                            if (pn0 in lfoControlledMovParams && lfoControlledGroupParams.contains("${g}_$pn0")) continue
                                            val actCh2 = fix.dmx - 1 + ch
                                            if (actCh2 in 0..511) {
                                                Companion.effectManagedChannels[actCh2] = false
                                                Companion.posSmoothedValues[actCh2] = -1f
                                            }
                                        }
                                    }
                                }
                                if (seqHasPositionSteps && (curPosStep || prevPosStep) && seqStopped) {
                                    // Zamrożenie: utrzymaj kontrolę nad kanałem i wymuś jawnie zamrożoną wartość,
                                    // nadpisując to co LFO (które biegnie wcześniej w tym samym ticku) już zapisało.
                                    for (ch in 0 until fix.channels) {
                                        val pn0 = fix.paramMap[ch]
                                        if (pn0 !in posMovSet) continue
                                        val actCh0 = fix.dmx - 1 + ch
                                        if (actCh0 !in 0..511) continue
                                        Companion.effectManagedChannels[actCh0] = true
                                        val frozenVal = if (Companion.posSmoothedValues[actCh0] >= 0f)
                                            Companion.posSmoothedValues[actCh0].toInt().coerceIn(0, 255)
                                        else Companion.baseDmxValues[actCh0]
                                        Companion.dmxValues[actCh0] = frozenVal
                                        Companion.seqOutputValues[actCh0] = frozenVal
                                        setDmxChannel(actCh0, frozenVal)
                                    }
                                }
                                if (seqHasPositionSteps && (curPosStep || prevPosStep) && !seqStopped) {
                                    val curPos =
                                        if (curPosStep) Companion.positionMemories[g].getOrNull(seq.stepValue[myStep]) else null
                                    val prevPos =
                                        if (prevPosStep) Companion.positionMemories[g].getOrNull(seq.stepValue[myPrev]) else null
                                    if (curPos?.isSaved == true || prevPos?.isSaved == true) {
                                        val inertia = (12f * dt.toFloat()).coerceAtMost(1f)
                                        for (ch in 0 until fix.channels) {
                                            val pn = fix.paramMap[ch]
                                            if (pn !in posMovSet) continue
                                            if (pn in lfoControlledMovParams && lfoControlledGroupParams.contains("${g}_$pn")) continue
                                            val actCh = fix.dmx - 1 + ch
                                            if (actCh !in 0..511) continue
                                            val curVal =
                                                if (curPos?.isSaved == true) curPos.dmxSnapshot[actCh] else Companion.baseDmxValues[actCh]
                                            // Cel = interpolacja crossfade między krokami (jak w oryginale C)
                                            val rawTargetVal: Float = if (crossfadeMix < 1f && !seq.justReset) {
                                                val prevVal =
                                                    if (prevPos?.isSaved == true) prevPos.dmxSnapshot[actCh] else Companion.baseDmxValues[actCh]
                                                prevVal + (curVal - prevVal) * crossfadeMix
                                            } else curVal.toFloat()
                                            // Suwak/touchpad dopisuje trwały offset do każdego kroku sekwencera.
                                            // Zabezpieczenie: offset nie może przekroczyć +-255 (cały zakres DMX),
                                            // inaczej błędny, jednorazowy skok mógłby "zamrozić" cel na stałe na 0 lub 255.
                                            val offsetForParam = when (pn) {
                                                "Pan" -> Companion.posPanOffset[g].coerceIn(-255f, 255f)
                                                "Tilt" -> Companion.posTiltOffset[g].coerceIn(-255f, 255f)
                                                else -> 0f
                                            }
                                            // LFO na Pan/Tilt dodaje swoją oscylację na wierzch pozycji z sekwencera (sumowanie, nie nadpisanie)
                                            val lfoAdd = if ((pn == "Pan" || pn == "Tilt") && lfoTouched[actCh]) lfoAccum[actCh] else 0f
                                            val targetVal = (rawTargetVal + offsetForParam + lfoAdd).coerceIn(0f, 255f)
                                            if (Companion.posSmoothedValues[actCh] < 0f) {
                                                Companion.posSmoothedValues[actCh] = Companion.baseDmxValues[actCh].toFloat()
                                            }
                                            if (Companion.isFadingMain && Companion.currentFadeTimeMain > 0f) {
                                                // Trwa fade presetu, a pozycja jeszcze nie dogoniła – jedź liniowo od stanu
                                                // PRZED recall do AKTUALNEGO celu (krok porusza się naturalnie, niezależnie),
                                                // z progresem opartym na czasie fade presetu. Krok i kolor idą swoim tempem,
                                                // pozycja po prostu interpoluje szybciej/wolniej żeby zdążyć na czas.
                                                val fadeRatio = (Companion.currentFadeTimerMain / Companion.currentFadeTimeMain).coerceIn(0f, 1f)
                                                val fadeStartVal = Companion.baseDmxStartMain[actCh].toFloat()
                                                Companion.posSmoothedValues[actCh] = fadeStartVal + (targetVal - fadeStartVal) * fadeRatio
                                                if (fadeRatio >= 1f) Companion.posFadeActiveSinceReset[g] = false
                                            } else {
                                                // Inercja ciągła dogania cel — niezależnie od tego co go zmienia (preset, krok)
                                                Companion.posSmoothedValues[actCh] += (targetVal - Companion.posSmoothedValues[actCh]) * inertia
                                            }
                                            val outVal = Companion.posSmoothedValues[actCh].toInt().coerceIn(0, 255)
                                            Companion.dmxValues[actCh] = outVal
                                            Companion.seqOutputValues[actCh] = outVal
                                            Companion.effectManagedChannels[actCh] = true
                                            setDmxChannel(actCh, outVal)
                                        }
                                    }
                                }
                                // ── koniec Position step ─────────────────────────

                                globalFixIdx++
                            }
                        }

                        // 6. EX-preset krok – aktywuj bieżący
                        // Najpierw wyłącz wszystkie EX sterowane przez ten SEQ slot
                        for (stepIdx in 0 until seq.totalSteps) {
                            if (seq.stepType[stepIdx] == 4 && stepIdx != curStep) {
                                val exIdx = seq.stepValue[stepIdx]
                                if (exIdx in 0..63) {
                                    val neededByOther = (0..3).any { os ->
                                        os != si && seqEnabled[os] &&
                                                memorySeq[os].stepType[memorySeq[os].currentStep] == 4 &&
                                                memorySeq[os].stepValue[memorySeq[os].currentStep] == exIdx
                                    }
                                    if (!neededByOther) Companion.activeExPresets[exIdx] = false
                                }
                            }
                        }
                        // Krok PATT – ustaw routing grupy zgodnie z zapisanym patternem
                        if (seq.stepType[curStep] == 5) {
                            val patG  = seq.stepValue[curStep] / 6
                            val patPi = seq.stepValue[curStep] % 6
                            val pat = Companion.seqPatternMemories.getOrNull(patG)?.getOrNull(patPi)
                            if (pat != null && pat.isSaved) {
                                // Zastosuj tylko jeśli zmienił się krok (nie co tick)
                                val prevType = seq.stepType[prevStep]
                                val prevVal  = seq.stepValue[prevStep]
                                if (prevType != 5 || prevVal != seq.stepValue[curStep]) {
                                    Companion.seqRoutingOrder[patG].clear()
                                    Companion.seqRoutingOrder[patG].addAll(pat.order)
                                    Companion.seqRoutingOn[patG].clear()
                                    Companion.seqRoutingOn[patG].addAll(pat.onList)
                                    Companion.seqActivePattern[patG] = patPi
                                }
                            }
                        }

                        if (seq.stepType[curStep] == 4) {
                            val exIdx = seq.stepValue[curStep]
                            if (exIdx in 0..63 && Companion.memoryExPresets[exIdx].isSaved) {
                                val ep = Companion.memoryExPresets[exIdx]
                                val anyGroupMatch = (0..3).any { j ->
                                    val fId = ep.exFix[j]
                                    if (fId == -1) return@any false
                                    if (fId >= 3000) return@any true  // SEQ/LFO/specjalne – zawsze aktywuj
                                    val groupIdx = if (fId in 1000..1007) fId - 1000
                                    else Companion.fixturesList.find { it.id == fId }?.groupIdx ?: return@any false
                                    seqGroupActive[si][groupIdx]
                                }
                                if (anyGroupMatch) Companion.activeExPresets[exIdx] = true
                            }
                        }
                    }
                    // ── KONIEC SILNIKA SEQ ───────────────────────────────

                    // ── COMET ENGINE ─────────────────────────────────────
                    val cometColorParams = setOf(
                        "Red", "Green", "Blue", "White", "Amber", "UV", "Dimmer",
                        "Beam 1R", "Beam 1G", "Beam 1B", "Beam 1W", "Beam 1A",
                        "Beam 2R", "Beam 2G", "Beam 2B", "Beam 2W", "Beam 2A",
                        "Beam 3R", "Beam 3G", "Beam 3B", "Beam 3W", "Beam 3A",
                        "Beam 4R", "Beam 4G", "Beam 4B", "Beam 4W", "Beam 4A"
                    )
                    Companion.fixturesList.forEach { fix ->
                        val g = fix.groupIdx
                        val activeSeqIdx = (0..3).firstOrNull { si -> seqEnabled[si] && seqGroupActive[si][g] }
                        val currentFVal = if (activeSeqIdx != null) {
                            val sq = memorySeq[activeSeqIdx]
                            if (sq.stepFade[sq.currentStep] == -1) sq.globalFade else sq.stepFade[sq.currentStep]
                        } else 0

                        for (ch in 0 until fix.channels) {
                            val param = fix.paramMap[ch]
                            if (param !in cometColorParams) continue
                            val actCh = fix.dmx - 1 + ch
                            if (actCh !in 0..511) continue
                            val targetVal = Companion.dmxValues[actCh].toFloat()

                            // Floor: gdy SEQ zarządza kanałem = trzymaj targetVal,
                            // gdy nie zarządza = zanikaj do tła (presetDmxValues)
                            val floor = if (Companion.effectManagedChannels[actCh])
                                targetVal
                            else
                                Companion.presetDmxValues[actCh].toFloat()

                            when {
                                currentFVal == 0 -> {
                                    // Brak ogona – natychmiastowe przejście do floor
                                    dmxPersist[actCh] = floor
                                }
                                currentFVal in 1..25 && dmxPersist[actCh] > floor -> {
                                    val sq2 = if (activeSeqIdx != null) memorySeq[activeSeqIdx] else null
                                    val stepDurC2 = if (sq2 != null) {
                                        val rT = sq2.stepTime[sq2.currentStep]
                                        when {
                                            sq2.stepIsSync[sq2.currentStep] -> syncBeats.getOrElse(sq2.stepSyncIdx[sq2.currentStep]) { 1f } * (60f / masterBpm)
                                            rT == -1f -> 99999f
                                            rT > 0f -> rT
                                            sq2.isSync -> syncBeats.getOrElse(sq2.syncIdx) { 1f } * (60f / masterBpm)
                                            sq2.globalTime == -1f -> 99999f
                                            else -> sq2.globalTime.coerceAtLeast(0.025f)
                                        }
                                    } else 0.5f
                                    val tailTime = (stepDurC2 * currentFVal / 12.5f).coerceAtLeast(0.025f)
                                    val fallSpeed = 255f / tailTime
                                    dmxPersist[actCh] -= fallSpeed * dt.toFloat()
                                    if (dmxPersist[actCh] < floor) dmxPersist[actCh] = floor
                                }
                                currentFVal > 25 && dmxPersist[actCh] > floor -> {
                                    val sq = if (activeSeqIdx != null) memorySeq[activeSeqIdx] else null
                                    val totalSteps = sq?.totalSteps?.coerceAtLeast(1) ?: 1
                                    val stepDurC = if (sq != null) {
                                        val rT = sq.stepTime[sq.currentStep]
                                        when {
                                            sq.stepIsSync[sq.currentStep] -> syncBeats.getOrElse(sq.stepSyncIdx[sq.currentStep]) { 1f } * (60f / masterBpm)
                                            rT == -1f -> 99999f
                                            rT > 0f -> rT
                                            sq.isSync -> syncBeats.getOrElse(sq.syncIdx) { 1f } * (60f / masterBpm)
                                            sq.globalTime == -1f -> 99999f
                                            else -> sq.globalTime.coerceAtLeast(0.025f)
                                        }
                                    } else 0.5f
                                    val cycleDur = (totalSteps * stepDurC).coerceAtLeast(0.025f)
                                    val ratio = (currentFVal - 26) / 74f
                                    val tailTime = cycleDur * (0.15f + ratio * 2.85f)
                                    val fallSpeed = 255f / tailTime
                                    dmxPersist[actCh] -= fallSpeed * dt.toFloat()
                                    if (dmxPersist[actCh] < floor) dmxPersist[actCh] = floor
                                }
                                else -> {
                                    // dmxPersist <= floor: ustaw na floor
                                    dmxPersist[actCh] = floor
                                }
                            }

                            val out = dmxPersist[actCh].toInt().coerceIn(0, 255)
                            Companion.dmxValues[actCh] = out
                            setDmxChannel(actCh, out)
                        }
                    }
                    // ── KONIEC COMET ENGINE ───────────────────────────────
                    // ── FX ENGINE ──────────────────────────────────────
                    fun lfoMod(idx: Int): Float {
                        if (idx < 0) return 0f
                        val lfo = memoryLfo[idx]
                        return computeWave(lfo.shapeIdx, Companion.lfoCurrentPhases[idx], 50)
                    }

                    // Inkrementuj timery fade FX raz na tick (poza pętlą fi – inaczej 4x za szybko)
                    val dtF = dt.toFloat()
                    for (fi in 0..3) {
                        if (Companion.fxFadeTimer[fi] < Companion.fxFadeTime[fi]) {
                            Companion.fxFadeTimer[fi] = (Companion.fxFadeTimer[fi] + dtF).coerceAtMost(Companion.fxFadeTime[fi])
                        }
                        if (Companion.fxDisableDelay[fi] > 0f) {
                            Companion.fxDisableDelay[fi] -= dtF
                            if (Companion.fxDisableDelay[fi] <= 0f) {
                                Companion.fxDisableDelay[fi] = 0f
                                Companion.memoryFx[fi].isEnabled = false
                                Companion.memoryFx[fi].amt = 0
                            }
                        }
                    }
                    for (fi in 0..3) {
                        val fx = Companion.memoryFx[fi]

                        // Ghost fix: zwolnij stare kanały gdy dest/group się zmieniły
                        if (fx.prevDestIdx != fx.destIdx || fx.prevGroupIdx != fx.groupIdx) {
                            if (fx.prevDestIdx != -1) {
                                val oldParam = Companion.paramList.getOrNull(fx.prevDestIdx)
                                Companion.fixturesList.filter { it.groupIdx == fx.prevGroupIdx }.forEach { fix ->
                                    for (ch in 0 until fix.channels) if (fix.paramMap[ch] == oldParam) {
                                        val actCh = fix.dmx - 1 + ch
                                        if (actCh in 0..511) Companion.effectManagedChannels[actCh] = false
                                    }
                                }
                            }
                            fx.prevDestIdx  = fx.destIdx
                            fx.prevGroupIdx = fx.groupIdx
                        }

                        val fxFadingOut = !fx.isEnabled && fx.destIdx != -1 &&
                                Companion.fxFadeTime[fi] > 0f && Companion.fxFadeTimer[fi] < Companion.fxFadeTime[fi]
                        if (!fxFadingOut && (!fx.isEnabled || fx.destIdx == -1)) {
                            val p = Companion.paramList.getOrNull(fx.destIdx) ?: continue
                            Companion.fixturesList.filter { it.groupIdx == fx.groupIdx }.forEach { fix ->
                                for (ch in 0 until fix.channels) if (fix.paramMap[ch] == p) {
                                    val actCh = fix.dmx - 1 + ch
                                    if (actCh in 0..511) Companion.effectManagedChannels[actCh] = false
                                }
                            }
                            continue
                        }

                        val paramName = Companion.paramList.getOrNull(fx.destIdx) ?: continue
                        val groupFixes = Companion.fixturesList.filter { it.groupIdx == fx.groupIdx }
                        if (groupFixes.isEmpty()) continue

                        // Parametry z modulacją LFO + fade AMT przy zmianie presetu

                        val noteLengths = listOf(0f, 0.0625f, 0.125f, 0.25f, 0.5f, 4f/6f, 1f, 4f/3f, 2f, 4f, 8f, 12f, 16f)
                        val effSpeed = if (fx.isSync) {
                            val beatLen = noteLengths.getOrElse(fx.syncIdx) { 1f }
                            if (beatLen <= 0f) 0f else (Companion.masterBpm / 60f) / beatLen
                        } else fx.speed
                        val effAmt = if (Companion.fxFadeTime[fi] > 0f && Companion.fxFadeTimer[fi] < Companion.fxFadeTime[fi]) {
                            val ratio = (Companion.fxFadeTimer[fi] / Companion.fxFadeTime[fi]).coerceIn(0f, 1f)
                            (Companion.fxAmtStart[fi] + (fx.amt - Companion.fxAmtStart[fi]) * ratio).toInt()
                        } else fx.amt
                        val effPhs   = fx.phs.toFloat()

                        // Przesuń fazę
                        if (fx.playState != 0) {
                            val dir = if (fx.playState == 2) -1f else 1f
                            fx.phase += dir * effSpeed * dt.toFloat()
                            while (fx.phase >= 1f) fx.phase -= 1f
                            while (fx.phase < 0f)  fx.phase += 1f
                        }

                        val spread = fx.spread.coerceAtLeast(1).toFloat()
                        val phsOff = effPhs / 360f

                        groupFixes.forEachIndexed { idx, fix ->
                            var fixPhase = fx.phase + idx / spread + phsOff
                            while (fixPhase >= 1f) fixPhase -= 1f
                            while (fixPhase < 0f)  fixPhase += 1f
                            val waveVal      = computeWave(fx.shapeIdx, fixPhase, 50)
                            val contribution = (waveVal * effAmt).toInt()
                            for (ch in 0 until fix.channels) {
                                if (fix.paramMap[ch] != paramName) continue
                                val actCh = fix.dmx - 1 + ch
                                if (actCh !in 0..511) continue
                                // Podczas fade-out FX: base powinien być 0 (efekt gaśnie do zera),
                                // nie wartość nowego presetu — inaczej contribution jest dodawane
                                // na wierzch już zmienionego koloru.
                                val base  = if (fxFadingOut) 0 else Companion.presetDmxValues[actCh]
                                val lfoContribution = if (lfoTouched[actCh]) lfoAccum[actCh] else 0f
                                val fxOut = (base + lfoContribution + contribution).toInt().coerceIn(0, 255)
                                Companion.lfoOutputValues[actCh] = fxOut
                                Companion.dmxValues[actCh] = fxOut
                                // Podczas fade-out też trzymaj kanał – inaczej refreshDmxOutput
                                // nadpisze go wartością nowego presetu zanim fade się skończy.
                                Companion.effectManagedChannels[actCh] = true
                                setDmxChannel(actCh, fxOut)
                            }
                        }
                    }
                    // ── KONIEC FX ENGINE ─────────────────────────────────


                    // ── EX-presety ZAWSZE NA WIERZCHU (po SEQ) ─────────────


                    val exFadeParams = setOf(
                        "Pan", "Pan Fine", "Tilt", "Tilt Fine", "Zoom", "Focus", "Iris", "PT speed",
                        "Red", "Green", "Blue", "White", "Amber", "UV", "Dimmer",
                        "Beam 1R", "Beam 1G", "Beam 1B", "Beam 1W", "Beam 1A",
                        "Beam 2R", "Beam 2G", "Beam 2B", "Beam 2W", "Beam 2A",
                        "Beam 3R", "Beam 3G", "Beam 3B", "Beam 3W", "Beam 3A",
                        "Beam 4R", "Beam 4G", "Beam 4B", "Beam 4W", "Beam 4A"
                    )
                    // ── EX-presety ZAWSZE NA WIERZCHU (po SEQ) ─────────────
                    for (exIdx in 0 until 64) {
                        val nowActive = Companion.activeExPresets[exIdx]
                        val wasActive = exPrevActive[exIdx]
                        val ep = Companion.memoryExPresets[exIdx]
                        val fadeTimeSec = if (ep.fadeTime == 0) 0.1f else ep.fadeTime / 10f

                        fun collectCurrentDmx(dest: IntArray) {
                            for (j in 0..3) {
                                val fId = ep.exFix[j];
                                val dIdx = ep.exDest[j]
                                if (fId == -1 || dIdx == -1) {
                                    dest[j] = 0; continue
                                }
                                val paramName = Companion.paramList.getOrNull(dIdx) ?: ""; dest[j] =
                                    0
                                val fix =
                                    if (fId in 1000..1007) Companion.fixturesList.firstOrNull { it.groupIdx == (fId - 1000) }
                                    else Companion.fixturesList.find { it.id == fId }
                                fix?.let { f ->
                                    val ci = f.paramMap.indexOf(paramName); if (ci != -1) {
                                    val a = f.dmx - 1 + ci; if (a in 0..511) dest[j] =
                                        Companion.dmxValues[a]
                                }
                                }
                            }
                        }

                        // Nowa aktywacja
                        if (nowActive && !wasActive) {
                            captureExSlotSnapshot(exIdx, ep)
                            exFadeTimers[exIdx] = 0f
                            exFadingOut[exIdx] = false
                            for (j in 0..3) {
                                val fId = ep.exFix[j];
                                val dIdx = ep.exDest[j]
                                if (fId == -1 || dIdx == -1) {
                                    exFadeStart[exIdx][j] = 0; continue
                                }
                                val paramName = Companion.paramList.getOrNull(dIdx) ?: ""
                                val fix =
                                    if (fId in 1000..1007) Companion.fixturesList.firstOrNull { it.groupIdx == (fId - 1000) }
                                    else Companion.fixturesList.find { it.id == fId }
                                fix?.let { f ->
                                    val ci = f.paramMap.indexOf(paramName); if (ci != -1) {
                                    val a = f.dmx - 1 + ci; exFadeStart[exIdx][j] =
                                        if (a in 0..511) Companion.baseDmxValues[a] else 0
                                }
                                }
                            }
                        }

                        // Deaktywacja – start fade-out (użyj wartości docelowej EX jako startu)
                        if (!nowActive && wasActive && !exFadingOut[exIdx]) {
                            restoreExSlotSnapshot(exIdx, ep)
                            exFadingOut[exIdx] = true
                            exFadeOutTimers[exIdx] = 0f
                            for (j in 0..3) {
                                val fId = ep.exFix[j];
                                val dIdx = ep.exDest[j];
                                val vVal = ep.exVal[j]
                                if (fId == -1 || dIdx == -1) {
                                    exFadeOutStart[exIdx][j] = 0; continue
                                }
                                val fix =
                                    if (fId in 1000..1007) Companion.fixturesList.firstOrNull { it.groupIdx == (fId - 1000) }
                                    else Companion.fixturesList.find { it.id == fId }
                                val paramName = Companion.paramList.getOrNull(dIdx)
                                    ?: ""; exFadeOutStart[exIdx][j] = 0
                                fix?.let { f ->
                                    val ci = f.paramMap.indexOf(paramName); if (ci != -1) {
                                    exFadeOutStart[exIdx][j] =
                                        f.paramMin[ci] + (vVal * (f.paramMax[ci] - f.paramMin[ci]) / 255)
                                }
                                }
                            }
                        }

                        exPrevActive[exIdx] = nowActive
                        if (nowActive) applyExSlotSpecial(ep)

                        // Fade-out w toku
                        if (exFadingOut[exIdx]) {
                            exFadeOutTimers[exIdx] += dt.toFloat()
                            val outRatio =
                                (1f - exFadeOutTimers[exIdx] / fadeTimeSec).coerceIn(0f, 1f)
                            if (exFadeOutTimers[exIdx] >= fadeTimeSec) {
                                exFadingOut[exIdx] = false
                                for (j in 0..3) {
                                    val fId = ep.exFix[j]; val dIdx = ep.exDest[j]; val vVal = ep.exVal[j]
                                    if (fId == -1 || dIdx == -1) continue
                                    val paramName = Companion.paramList.getOrNull(dIdx) ?: continue
                                    val fixes =
                                        if (fId in 1000..1007) Companion.fixturesList.filter { it.groupIdx == (fId - 1000) }
                                        else listOfNotNull(Companion.fixturesList.find { it.id == fId })
                                    fixes.forEach { fix ->
                                        val chIdx =
                                            fix.paramMap.indexOf(paramName); if (chIdx == -1) return@forEach
                                        val actCh =
                                            fix.dmx - 1 + chIdx; if (actCh !in 0..511) return@forEach
                                        // Filtracja grupowa: EX-preset sterowany przez SEQ
                                        // działa tylko na grupy z aktywnym kafelkiem tego SEQ.
                                        // Sprawdzamy czy którykolwiek aktywny SEQ (z tym EX w krokach)
                                        // ma aktywny kafelek dla grupy tego fixture.
                                        val groupIdx = fix.groupIdx
                                        // Filtracja grupowa tylko dla fixture'ów (fId<2000)
                                        // SEQ/LFO/specjalne (fId>=3000) nie mają groupIdx – zawsze przepuszczaj
                                        if (fId < 3000) {
                                            val seqControlled = (0..3).any { si ->
                                                seqEnabled[si] &&
                                                        (0 until memorySeq[si].totalSteps).any { s ->
                                                            memorySeq[si].stepType[s] == 4 &&
                                                                    memorySeq[si].stepValue[s] == exIdx
                                                        }
                                            }
                                            if (seqControlled) {
                                                val groupAllowed = (0..3).any { si ->
                                                    seqEnabled[si] && seqGroupActive[si][groupIdx] &&
                                                            (0 until memorySeq[si].totalSteps).any { s ->
                                                                memorySeq[si].stepType[s] == 4 &&
                                                                        memorySeq[si].stepValue[s] == exIdx
                                                            }
                                                }
                                                if (!groupAllowed) return@forEach
                                            }
                                        }
                                        val mapped =
                                            fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                                        val finalVal = if (paramName in exFadeParams) {
                                            val startV = exFadeStart[exIdx][j]
                                            (startV + (mapped - startV) * outRatio).toInt()
                                                .coerceIn(0, 255)
                                        } else mapped
                                        Companion.dmxValues[actCh] = finalVal
                                        setDmxChannel(actCh, finalVal)
                                    }
                                }
                            } else {
                                for (j in 0..3) {
                                    val fId = ep.exFix[j];
                                    val dIdx = ep.exDest[j]
                                    if (fId == -1 || dIdx == -1) continue
                                    val paramName = Companion.paramList.getOrNull(dIdx) ?: continue
                                    if (paramName !in exFadeParams) continue
                                    val fixes =
                                        if (fId in 1000..1007) Companion.fixturesList.filter { it.groupIdx == (fId - 1000) }
                                        else listOfNotNull(Companion.fixturesList.find { it.id == fId })
                                    fixes.forEach { fix ->
                                        val chIdx =
                                            fix.paramMap.indexOf(paramName); if (chIdx == -1) return@forEach
                                        val actCh =
                                            fix.dmx - 1 + chIdx; if (actCh !in 0..511) return@forEach
                                        val groupIdx2 = fix.groupIdx
                                        val seqControlled2 = (0..3).any { si ->
                                            seqEnabled[si] &&
                                                    (0 until memorySeq[si].totalSteps).any { s ->
                                                        memorySeq[si].stepType[s] == 4 &&
                                                                memorySeq[si].stepValue[s] == exIdx
                                                    }
                                        }
                                        if (seqControlled2) {
                                            val groupAllowed2 = (0..3).any { si ->
                                                seqEnabled[si] && seqGroupActive[si][groupIdx2] &&
                                                        (0 until memorySeq[si].totalSteps).any { s ->
                                                            memorySeq[si].stepType[s] == 4 &&
                                                                    memorySeq[si].stepValue[s] == exIdx
                                                        }
                                            }
                                            if (!groupAllowed2) return@forEach
                                        }
                                        val baseV = Companion.baseDmxValues[actCh]
                                        val startV = exFadeOutStart[exIdx][j]
                                        val finalVal = (baseV + (startV - baseV) * outRatio).toInt()
                                            .coerceIn(0, 255)
                                        Companion.dmxValues[actCh] = finalVal
                                        setDmxChannel(actCh, finalVal)
                                    }
                                }
                            }
                            continue  // nie wykonuj fade-in
                        }

                        // Nie aktywny i nie fade-out – pomiń
                        if (!nowActive) continue

                        // Fade-in
                        exFadeTimers[exIdx] =
                            (exFadeTimers[exIdx] + dt.toFloat()).coerceAtMost(fadeTimeSec)
                        val fadeRatio =
                            if (fadeTimeSec > 0f) (exFadeTimers[exIdx] / fadeTimeSec).coerceIn(
                                0f,
                                1f
                            ) else 1f

                        for (j in 0..3) {
                            val fId = ep.exFix[j];
                            val dIdx = ep.exDest[j];
                            val vVal = ep.exVal[j]
                            if (fId == -1 || dIdx == -1) continue
                            val paramName = Companion.paramList.getOrNull(dIdx) ?: continue
                            val fixes =
                                if (fId in 1000..1007) Companion.fixturesList.filter { it.groupIdx == (fId - 1000) }
                                else listOfNotNull(Companion.fixturesList.find { it.id == fId })
                            fixes.forEach { fix ->
                                val chIdx =
                                    fix.paramMap.indexOf(paramName); if (chIdx == -1) return@forEach
                                val actCh =
                                    fix.dmx - 1 + chIdx; if (actCh !in 0..511) return@forEach
                                val mapped =
                                    fix.paramMin[chIdx] + (vVal * (fix.paramMax[chIdx] - fix.paramMin[chIdx]) / 255)
                                val finalVal = if (paramName in exFadeParams) {
                                    val startV = exFadeStart[exIdx][j]
                                    (startV + (mapped - startV) * fadeRatio).toInt()
                                        .coerceIn(0, 255)
                                } else mapped
                                Companion.dmxValues[actCh] = finalVal
                                setDmxChannel(actCh, finalVal)
                            }
                        }


                    }
                    // ── KONIEC EX na wierzchu ────────────────────────────────

                    // ── PERF OVERRIDE (nad wszystkim) ─────────────────────────
                    for (pi in 0..7) {
                        val ps = Companion.perfSettings[pi]

                        if (pi in listOf(0,1,2,6)) {
                            // Aktualizacja timera fade
                            if (ps.isActive && !ps.wasActivePrev) ps.fadeTimer = 0f
                            if (!ps.isActive && ps.wasActivePrev) ps.fadeTimer = 0f
                            ps.wasActivePrev = ps.isActive
                            if (ps.isActive || ps.fadeTimer < ps.fadeOut) {
                                ps.fadeTimer += dt.toFloat()
                            }
                        }
                        if (!ps.isActive && pi !in listOf(0,1,2,6)) continue
                        if (!ps.isActive && pi in listOf(0,1,2,6) && ps.fadeTimer >= ps.fadeOut) continue

                        val fixes = Companion.fixturesList.filter { ps.groupMask[it.groupIdx] }
                        val fadeRatio = when {
                            pi !in listOf(0,1,2,6) -> 1f
                            ps.isActive -> if (ps.fadeIn > 0f) (ps.fadeTimer/ps.fadeIn).coerceIn(0f,1f) else 1f
                            else -> if (ps.fadeOut > 0f) (1f - (ps.fadeTimer/ps.fadeOut)).coerceIn(0f,1f) else 0f
                        }

                        when (pi) {
                            0 -> fixes.forEach { fix -> // BLINDER
                                for (ch in 0 until fix.channels) {
                                    val addr = fix.dmx-1+ch; if (addr !in 0..511) continue
                                    val target = when(fix.paramMap[ch]) {
                                        "Dimmer" -> fix.paramMin[ch]+(ps.value*(fix.paramMax[ch]-fix.paramMin[ch])/255)
                                        "Red","Beam 1R","Green","Beam 1G","Blue","Beam 1B",
                                        "White","Beam 1W","Amber","Beam 1A","UV" -> fix.paramMax[ch]
                                        "Col. wheel" -> {
                                            // Biały = slot 0 (OPEN) na kole kolorów
                                            val cwDmx = fix.cwDmx[0]
                                            fix.paramMin[ch]+(cwDmx*(fix.paramMax[ch]-fix.paramMin[ch])/255)
                                        }
                                        else -> -1
                                    }
                                    if (target>=0) {
                                        val base = Companion.baseDmxValues[addr]
                                        val v = (base + (target-base)*fadeRatio).toInt().coerceIn(0,255)
                                        Companion.dmxValues[addr]=v; setDmxChannel(addr,v)
                                    }
                                }
                            }
                            1 -> fixes.forEach { fix -> // STROBE (bez fade)
                                for (ch in 0 until fix.channels) {
                                    if (fix.paramMap[ch]=="Shutter") {
                                        val addr=fix.dmx-1+ch; if (addr !in 0..511) continue
                                        val v=fix.paramMin[ch]+(ps.value*(fix.paramMax[ch]-fix.paramMin[ch])/255)
                                        Companion.dmxValues[addr]=v; setDmxChannel(addr,v)
                                    }
                                }
                            }
                            2 -> { // COLOR
                                val dmxV = Companion.getPaletteDmxValues(ps.value.coerceIn(0,63))
                                fixes.forEach { fix ->
                                    for (ch in 0 until fix.channels) {
                                        val addr=fix.dmx-1+ch; if (addr !in 0..511) continue
                                        val v = when(fix.paramMap[ch]) {
                                            "Red","Beam 1R"->dmxV[0];"Green","Beam 1G"->dmxV[1]
                                            "Blue","Beam 1B"->dmxV[2];"White","Beam 1W"->dmxV[3]
                                            "Amber","Beam 1A"->dmxV[4];"UV"->dmxV[5]
                                            "Col. wheel" -> getClosestWheelDmx(fix, dmxV[0], dmxV[1], dmxV[2])
                                            else->-1
                                        }
                                        if (v>=0) {
                                            val target=fix.paramMin[ch]+(v*(fix.paramMax[ch]-fix.paramMin[ch])/255)
                                            val base = Companion.baseDmxValues[addr]
                                            val mapped = (base + (target-base)*fadeRatio).toInt().coerceIn(0,255)
                                            Companion.dmxValues[addr]=mapped; setDmxChannel(addr,mapped)
                                        }
                                    }
                                }
                            }
                            6 -> fixes.forEach { fix -> // BLACKOUT
                                for (ch in 0 until fix.channels) {
                                    if (fix.paramMap[ch] != "Dimmer") continue
                                    val addr=fix.dmx-1+ch; if (addr !in 0..511) continue
                                    val target = fix.paramMin[ch]
                                    val base = Companion.baseDmxValues[addr]
                                    val v = (base + (target-base)*fadeRatio).toInt().coerceIn(0,255)
                                    Companion.dmxValues[addr]=v; setDmxChannel(addr,v)
                                }
                            }
                        }
                    }
                    // ── KONIEC PERF OVERRIDE ──────────────────────────────────

                    // ── SOLO (EDIT) override ──────────────────────────────────
                    if (posEditMode) {
                        val editFixes =
                            Companion.fixturesList.filter { it.groupIdx == posCurrentGroup }
                        val targets = if (posIsFixtureMode) listOfNotNull(
                            editFixes.getOrNull(posCurrentFixture - 1)
                        ) else editFixes
                        targets.forEach { fix ->
                            for (ch in 0 until fix.channels) {
                                val addr = fix.dmx - 1 + ch
                                if (addr in 0..511) {
                                    val v = Companion.baseDmxValues[addr]
                                    if (Companion.dmxValues[addr] != v) {
                                        Companion.dmxValues[addr] = v; setDmxChannel(addr, v)
                                    }
                                }
                            }
                        }
                    }
                    // ── KONIEC SOLO ───────────────────────────────────────────

                    if (Companion.isFadingMain) {
                        Companion.currentFadeTimerMain += dt.toFloat()
                        if (Companion.currentFadeTimerMain >= Companion.currentFadeTimeMain) {
                            Companion.currentFadeTimerMain = Companion.currentFadeTimeMain
                            Companion.isFadingMain = false

                        }
                    }
                    if (Companion.isFadingAux) {
                        Companion.currentFadeTimerAux += dt.toFloat()
                        if (Companion.currentFadeTimerAux >= Companion.currentFadeTimeAux) {
                            Companion.currentFadeTimerAux = Companion.currentFadeTimeAux
                            Companion.isFadingAux = false
                        }
                    }

                    // PATT mode: wymuś zero po wszystkich efektach
                    for (g in 0..7) {
                        if (Companion.seqRoutingMode[g] != 1) continue
                        val order = Companion.seqRoutingOrder[g]
                        val onList = Companion.seqRoutingOn[g]
                        order.forEachIndexed { pos, fixId ->
                            if (onList.getOrElse(pos) { true }) return@forEachIndexed
                            val fix = Companion.fixturesList.find { it.id == fixId } ?: return@forEachIndexed
                            for (ch in 0 until fix.channels) {
                                val addr = fix.dmx - 1 + ch
                                if (addr in 0..511 && Companion.dmxValues[addr] != 0) {
                                    Companion.dmxValues[addr] = 0
                                    setDmxChannel(addr, 0)
                                }
                            }
                        }
                    }

                    delay(25)
                }

            }
            activeViewContainer.addView(createColorView())
        }
    }
