                        text="${if(isGobo2Setup) "GOBO 2" else "GOBO 1"} – ${fix.name}"; gravity=Gravity.CENTER_VERTICAL
                        setPadding(16,0,0,0); setTextColor(Color.BLACK); textSize=18f
                        layoutParams=LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(5,5,5,5)}
