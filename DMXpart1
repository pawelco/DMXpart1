                            memorySeq[si].stepType[memorySeq[si].currentStep] == 3 &&
                            memorySeq[si].stepValue[memorySeq[si].currentStep] == idx
                    addView(View(this@MainActivity).apply {
                        tag = "POS_DOT_${idx}_${si}"
                        background = GradientDrawable().apply {
                            shape = GradientDrawable.RECTANGLE; cornerRadius = 3f
