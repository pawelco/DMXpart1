    private fun createFxView(): View {
        val j = exactRowHeight
        val m = 3

        var activeFxSlot = -1
        var sliderRef: SeekBar? = null
        val liveTvs = fxLiveTvs
        fxLiveTvs.clear()

        fun makeWaveView(fi: Int): android.view.View {
            val fx = Companion.memoryFx[fi]
            val col = Companion.fxColors[fi]
            return object : android.view.View(this@MainActivity) {
                override fun onDraw(canvas: android.graphics.Canvas) {
                    val paint = android.graphics.Paint().apply {
                        color = col; strokeWidth = 4f
                        style = android.graphics.Paint.Style.STROKE; isAntiAlias = true
                    }
                    val w = width.toFloat(); val h = height.toFloat()
                    if (w <= 0f || h <= 0f) return
                    val path = android.graphics.Path()
                    when (fx.shapeIdx) {
                        0 -> for (px in 0..width) {
                            val t = px / w * 2f * 2f * Math.PI.toFloat()
                            val y = h/2f - (h/2f - 6f) * kotlin.math.sin(t.toDouble()).toFloat()
                            if (px == 0) path.moveTo(0f, y) else path.lineTo(px.toFloat(), y)
                        }
                        1 -> for (px in 0..width) {
                            val t = ((px / w * 2f) % 1f + 1f) % 1f
                            val v = if (t < 0.25f) t*4f else if (t < 0.75f) 2f - t*4f else t*4f - 4f
                            val y = h/2f - (h/2f - 6f) * v
                            if (px == 0) path.moveTo(0f, y) else path.lineTo(px.toFloat(), y)
                        }
                        2 -> { val segW = w / 2f
                            for (i in 0 until 2) {
                                path.moveTo(i * segW, h - 6f); path.lineTo((i+1)*segW - 3f, 6f)
                                path.moveTo((i+1)*segW - 3f, 6f); path.lineTo((i+1)*segW - 3f, h - 6f)
                            }
                        }
                    }
                    canvas.drawPath(path, paint)
                }
            }.apply { setBackgroundColor(Companion.COL_PANEL) }
        }

        fun fmtSpd(fx: FxData)    = if (fx.speed < 0.01f) "STATIC" else "${String.format("%.2f", fx.speed)}Hz"
        fun fmtSpread(fx: FxData) = "${fx.spread}"
        fun fmtAmt(fx: FxData)    = "${fx.amt}"
        fun fmtPhs(fx: FxData)    = "${fx.phs}"
        fun fmtGrp(fx: FxData)    = "GRP ${'A' + fx.groupIdx}"
        fun fmtParam(fx: FxData)  = if (fx.destIdx == -1) "--- PARAM ---"
        else Companion.paramList.getOrElse(fx.destIdx) { "---" }

        fun sliderMaxFor(slot: Int) = when (slot % 10) { 1->200; 2->128; 3->510; 4->360; else->255 }
        fun sliderProgressFor(slot: Int): Int {
            val fx = Companion.memoryFx[slot / 10]
            return when (slot % 10) {
                1 -> (fx.speed / 0.025f).toInt().coerceIn(0, 200)
                2 -> fx.spread; 3 -> fx.amt + 255; 4 -> fx.phs; else -> 0
            }
        }
        fun applySliderValue(slot: Int, p: Int) {
            val fx = Companion.memoryFx[slot / 10]
            when (slot % 10) { 1->fx.speed=p*0.025f; 2->fx.spread=p.coerceAtLeast(1); 3->fx.amt=p-255; 4->fx.phs=p }
        }

        fun darkBtn()   = getBtnStyle().apply { setColor(Companion.COL_SEP) }
        fun activeBtn() = getBtnStyle().apply { setColor(Color.parseColor("#0055AA")) }

        // Kolory przycisku play wg stanu
        fun playBgColor(state: Int) = when (state) {
