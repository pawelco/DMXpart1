            corePaletteColors[i] = Color.HSVToColor(floatArrayOf(hue, 1.0f, 1.0f))
        }
        corePaletteColors[31] = Color.WHITE
        for (i in 32..47) {
            val hue = ((i - 32) / 15.0f) * 360f
            corePaletteColors[i] = Color.HSVToColor(floatArrayOf(hue, 0.6f, 1.0f))
        }
        for (i in 48..63) {
            val col = i - 48
            val ratio = col / 15.0f
            val r = (255 + (200 - 255) * ratio).toInt()
            val g = (160 + (220 - 160) * ratio).toInt()
            val b = (80 + (255 - 80) * ratio).toInt()
            val w = (255 * (1.0f - Math.abs(col - 7.5f) / 7.5f)).toInt().coerceIn(0, 255)
            val blend = w / 255.0f
            corePaletteColors[i] = Color.rgb(
                (r + (255 - r) * blend).toInt().coerceIn(0, 255),
                (g + (255 - g) * blend).toInt().coerceIn(0, 255),
                (b + (255 - b) * blend).toInt().coerceIn(0, 255)
