        // ── Fade startowy 3s – TYLKO przy pierwszym uruchomieniu procesu ──
        if (!Companion.firstLaunchDone) {
            Companion.firstLaunchDone = true
            Companion.updateFadeMask()
            val movementParams =
                setOf("Pan", "Pan Fine", "Tilt", "Tilt Fine", "Zoom", "Focus", "Iris")
            Companion.fixturesList.forEach { fix ->
                for (ch in 0 until fix.channels) {
                    if (fix.paramMap[ch] in movementParams) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) {
                            // Nie zeruj startu fade dla Pan/Tilt – niech idą z aktualnej pozycji
                            Companion.baseDmxStartMain[addr] = Companion.baseDmxValues[addr]
                            Companion.baseDmxStartAux[addr] = Companion.baseDmxValues[addr]
                        }
                    }
                }
            }
            Companion.currentFadeTimeMain = 3.0f
            Companion.currentFadeTimerMain = 0.0f
            Companion.isFadingMain = true
            Companion.currentFadeTimeAux = 3.0f
            Companion.currentFadeTimerAux = 0.0f
            Companion.isFadingAux = true
        }

        val windowHeight = if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {
            windowManager.currentWindowMetrics.bounds.height()
        } else {
            val displayRect = android.graphics.Rect()
            window.decorView.getWindowVisibleDisplayFrame(displayRect)
            if (displayRect.height() > 0) displayRect.height() else resources.displayMetrics.heightPixels
        }
        exactRowHeight = (windowHeight / 9.0).toInt()

        corePaletteColors[0] = Color.rgb(220, 220, 230)
        for (i in 1..30) {
            val hue = ((i - 1) / 30.0f) * 360f
            corePaletteColors[i] = Color.HSVToColor(floatArrayOf(hue, 1.0f, 1.0f))
        }
        corePaletteColors[31] = Color.WHITE
        for (i in 32..47) {
            val hue = ((i - 32) / 15.0f) * 360f
            corePaletteColors[i] = Color.HSVToColor(floatArrayOf(hue, 0.6f, 1.0f))
        }
        for (i in 48..62) {
            val col = i - 48
            val ratio = col / 14.0f
            val r = (255 + (200 - 255) * ratio).toInt()
            val g = (160 + (220 - 160) * ratio).toInt()
            val b = (80 + (255 - 80) * ratio).toInt()
            val w = (255 * (1.0f - Math.abs(col - 7.5f) / 7.5f)).toInt().coerceIn(0, 255)
            val blend = w / 255.0f
            corePaletteColors[i] = Color.rgb(
                (r + (255 - r) * blend).toInt().coerceIn(0, 255),
                (g + (255 - g) * blend).toInt().coerceIn(0, 255),
                (b + (255 - b) * blend).toInt().coerceIn(0, 255)
            )
        }
