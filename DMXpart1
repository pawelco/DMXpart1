                        val items = mutableListOf("---")
                        for (g in 0..7) items.add("Group ${'A' + g}")
                        Companion.fixturesList.forEach { items.add("Fix ${it.id}: ${it.name}") }
                        // ← dodane FX 1-4
                        for (fi in 1..4) items.add("FX $fi")
                        showInternalParamMenu(items) { sel ->
                            lfo.fix[i] = when {
                                sel == "---"           -> -1
                                sel.startsWith("Group")-> 1000 + (sel.last() - 'A')
                                sel.startsWith("FX")   -> 1999 + sel.last().digitToInt()  // FX1=2000 FX2=2001...
                                else                   -> sel.substringAfter("Fix ").substringBefore(":").toIntOrNull() ?: -1
                            }
                            lfo.dest[i] = -1
                            rebuild()
                        }
                    }
                })

                // Destination
                addView(TextView(this@MainActivity).apply {
                    val dIdx = lfo.dest[i]
                    text = if (dIdx == -1) "---" else Companion.paramList.getOrElse(dIdx) { "---" }
                    gravity = Gravity.CENTER; textSize = 14f
                    setTextColor(Color.WHITE); background = darkBtn(); cw(4f)
                    setOnClickListener {
                        val fId = lfo.fix[i]
                        if (fId == -1) {
                            Toast.makeText(this@MainActivity, "Wybierz FIX/GROUP!", Toast.LENGTH_SHORT).show()
                            return@setOnClickListener
                        }
                        // ← FX target: tylko SPD, AMT, PHS
                        if (fId in 2000..2003) {
                            showInternalParamMenu(listOf("---", "FX_SPD", "FX_AMT", "FX_PHS")) { sel ->
                                lfo.dest[i] = if (sel == "---") -1 else Companion.paramList.indexOf(sel)
                                rebuild()
                            }
                            return@setOnClickListener
                        }
                        val avail = mutableListOf("---")
                        if (fId in 1000..1007)
                            Companion.fixturesList.firstOrNull { it.groupIdx == (fId - 1000) }
                                ?.paramMap?.filter { it.isNotEmpty() && it != "Clear" }?.distinct()?.let { avail.addAll(it) }
                        else
                            Companion.fixturesList.find { it.id == fId }
                                ?.paramMap?.filter { it.isNotEmpty() && it != "Clear" }?.distinct()?.let { avail.addAll(it) }
                        showInternalParamMenu(avail) { sel ->
                            lfo.dest[i] = if (sel == "---") -1 else Companion.paramList.indexOf(sel)
                            rebuild()
