    private fun perfSaveSnapshot(i: Int) {
        val ps = Companion.perfSettings[i]
        val relevant = perfRelevantParamsFor(i)
        Companion.fixturesList.filter { ps.groupMask[it.groupIdx] }.forEach { fix ->
            for (ch in 0 until fix.channels) {
                if (fix.paramMap[ch] !in relevant) continue
                val addr = fix.dmx - 1 + ch
                if (addr in 0..511) ps.dmxSnapshot[addr] = Companion.baseDmxValues[addr]
            }
        }
    }

    private fun perfRestoreSnapshot(i: Int) {
        val ps = Companion.perfSettings[i]
        val relevant = perfRelevantParamsFor(i)
        // WAŻNE: nie wywołujemy refreshDmxOutput() tutaj. Aktualizujemy tylko bazę
        // (baseDmxValues), żeby blok PERF OVERRIDE w silniku miał właściwy cel do
        // którego ma wygasić efekt. Natychmiastowe refreshDmxOutput powodowało
        // widoczne mignięcie/zgaszenie na ułamek sekundy przed zaczęciem fade-out –
        // silnik i tak odświeży wyjście na najbliższym ticku (≤25ms), płynnie,
        // bo fadeRatio w tym momencie wynosi ~1 (brak skoku).
        Companion.fixturesList.filter { ps.groupMask[it.groupIdx] }.forEach { fix ->
            for (ch in 0 until fix.channels) {
                if (fix.paramMap[ch] !in relevant) continue
                val addr = fix.dmx - 1 + ch
                if (addr in 0..511) {
                    Companion.baseDmxValues[addr] = ps.dmxSnapshot[addr]
                    Companion.baseDmxTarget[addr] = ps.dmxSnapshot[addr]
                    Companion.baseDmxStart[addr] = ps.dmxSnapshot[addr]
                }
            }
        }
    }

    private fun triggerPerfOn(i: Int) {
        val ps = Companion.perfSettings[i]
        when (i) {
            0,1,2 -> perfSaveSnapshot(i)
            3 -> { Companion.perfTempoMultiplier = listOf(2f,3f,4f,8f).getOrElse(ps.value){2f}; Companion.perfSettings[4].isActive = false }
            4 -> { Companion.perfTempoMultiplier = listOf(0.125f,0.25f,0.333f,0.5f).getOrElse(ps.value){0.5f}; Companion.perfSettings[3].isActive = false }
            5 -> {
                // Nic nie trzeba robić — silnik LFO/SEQ sam zamraża się
                // poprzez perfGroupTempoMult[g]=0f, ustawiane automatycznie
                // co tick na podstawie ps.groupMask i ps.isActive (patrz pętla silnika).
            }
            6 -> perfSaveSnapshot(i)
            7 -> pressButton(4 + i)
        }
    }

    private fun triggerPerfOff(i: Int) {
        val ps = Companion.perfSettings[i]
        when (i) {
            0,1,2,6 -> perfRestoreSnapshot(i)
            3,4 -> Companion.perfTempoMultiplier = 1f
            5 -> {
                // Nic nie trzeba robić — perfGroupTempoMult wróci do 1f automatycznie,
                // skoro ps.isActive=false. FX nadal trzeba przywrócić.
                for (fi in 0..3) {
                    if (ps.savedFxPlayState[fi] >= 0) Companion.memoryFx[fi].playState = ps.savedFxPlayState[fi]
                }
            }
        }
    }

