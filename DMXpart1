                setOf("Pan", "Pan Fine", "Tilt", "Tilt Fine", "Zoom", "Focus", "Iris")
            Companion.fixturesList.forEach { fix ->
                for (ch in 0 until fix.channels) {
                    if (fix.paramMap[ch] in movementParams) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) {
                            Companion.baseDmxStartMain[addr] = 0
                            Companion.baseDmxStartAux[addr] = 0
                            setDmxChannel(addr, 0)
                        }
                    }
                }
