                    val dmxArea=LinearLayout(this@MainActivity).apply{orientation=LinearLayout.HORIZONTAL;weightSum=3.5f;layoutParams=LinearLayout.LayoutParams(0,-1,3.5f)}
                    val pPrev=TextView(this@MainActivity).apply{text="<";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.8f).apply{setMargins(5,5,5,5)}}
                    val pVal =TextView(this@MainActivity).apply{text=dmxVal.toString();gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,1.9f).apply{setMargins(5,5,5,5)}}
                    if(i==activeCwSlot) activeSlotTextView=pVal
                    val pNext=TextView(this@MainActivity).apply{text=">";gravity=Gravity.CENTER;setTextColor(Color.WHITE);background=getBtnStyle();layoutParams=LinearLayout.LayoutParams(0,-1,0.8f).apply{setMargins(5,5,5,5)}}
                    pPrev.setOnClickListener{val nv=(dmxVal-1).coerceAtLeast(0);if(isHalf) fix.cwHalfDmx[slotIdx]=nv else fix.cwDmx[slotIdx]=nv;cwSliderRef?.progress=nv;outputCwDmx(nv);renderFixturesDispatch()}
                    pNext.setOnClickListener{val nv=(dmxVal+1).coerceAtMost(255);if(isHalf) fix.cwHalfDmx[slotIdx]=nv else fix.cwDmx[slotIdx]=nv;cwSliderRef?.progress=nv;outputCwDmx(nv);renderFixturesDispatch()}
