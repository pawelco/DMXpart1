                    else { lfo.rate = p * 0.125f; rateTvRef?.text = "${String.format("%.3f", lfo.rate)} Hz" }
                }
                101 -> { lfo.pwm = p; pwTvRef?.text = "$p %" }
                else -> {
                    val field = activeLfoSlot % 4; val si = activeLfoSlot / 4
                    val real = when (field) { 0 -> p - 255; 2 -> p - 255; 3 -> p - 100; else -> p }
                    numArrs[field][si] = real
                    numTvRefs[activeLfoSlot]?.text = real.toString()
                }
            }
        }
        sliderRef = lfoSeekBar
        activeDataSlider = lfoSeekBar
        rightOuter.addView(lfoSliderWidget)
        rootContainer.addView(rightOuter)
        return rootContainer
    }




