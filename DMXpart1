    private fun buildFixturesJson(): String {
        val arr = org.json.JSONArray()
        savedProfiles.forEach { fix ->
            val obj = org.json.JSONObject()
            obj.put("name", fix.name)
            obj.put("channels", fix.channels)
            val pm = org.json.JSONArray(); fix.paramMap.take(fix.channels).forEach { pm.put(it) }; obj.put("paramMap", pm)
            val mn = org.json.JSONArray(); fix.paramMin.take(fix.channels).forEach { mn.put(it) }; obj.put("paramMin", mn)
            val mx = org.json.JSONArray(); fix.paramMax.take(fix.channels).forEach { mx.put(it) }; obj.put("paramMax", mx)
            obj.put("cwCount", fix.cwCount)
            val cwD = org.json.JSONArray(); fix.cwDmx.take(fix.cwCount).forEach { cwD.put(it) }; obj.put("cwDmx", cwD)
            val cwH = org.json.JSONArray(); fix.cwHalfDmx.take(fix.cwCount).forEach { cwH.put(it) }; obj.put("cwHalfDmx", cwH)
            val cwC = org.json.JSONArray(); fix.cwColors.take(fix.cwCount).forEach { cwC.put(it) }; obj.put("cwColors", cwC)
            arr.put(obj)
        }
        return org.json.JSONObject().apply { put("version", 1); put("fixtures", arr) }.toString(2)
    }

    private fun importFixturesJson(json: String) {
        val root = org.json.JSONObject(json)
        val arr = root.getJSONArray("fixtures")
        for (i in 0 until arr.length()) {
            val obj = arr.getJSONObject(i)
            val ch = obj.getInt("channels")
            val pm = Array(512) { "" }
            val mn = IntArray(512) { 0 }
            val mx = IntArray(512) { 255 }
            val pmArr = obj.getJSONArray("paramMap")
            val mnArr = obj.getJSONArray("paramMin")
            val mxArr = obj.getJSONArray("paramMax")
            for (c in 0 until minOf(ch, pmArr.length())) { pm[c] = pmArr.getString(c); mn[c] = mnArr.getInt(c); mx[c] = mxArr.getInt(c) }
            val cwCount = if (obj.has("cwCount")) obj.getInt("cwCount") else 1
            val cwDmx = IntArray(32); val cwHalf = IntArray(32); val cwCol = IntArray(32)
            if (obj.has("cwDmx")) { val a = obj.getJSONArray("cwDmx"); for (c in 0 until minOf(32, a.length())) cwDmx[c] = a.getInt(c) }
            if (obj.has("cwHalfDmx")) { val a = obj.getJSONArray("cwHalfDmx"); for (c in 0 until minOf(32, a.length())) cwHalf[c] = a.getInt(c) }
            if (obj.has("cwColors")) { val a = obj.getJSONArray("cwColors"); for (c in 0 until minOf(32, a.length())) cwCol[c] = a.getInt(c) }
            val name = obj.getString("name")
            val profile = FixtureProfile(name, ch, pm, mn, mx, cwCount, cwDmx, cwHalf, cwCol)
            // Nadpisz jeśli istnieje, dodaj jeśli nie
            val existing = savedProfiles.indexOfFirst { it.name == name }
            if (existing >= 0) savedProfiles[existing] = profile
            else savedProfiles.add(profile)
        }
        saveProfilesToDisk(applicationContext.filesDir.absolutePath)
    }

