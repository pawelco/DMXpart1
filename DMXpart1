        // Zakładki grup — styl jak w Sliders
        val tabsRow = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL; weightSum = 8f
            layoutParams = LinearLayout.LayoutParams(-1, j)
            setBackgroundColor(Companion.COL_DARK)
