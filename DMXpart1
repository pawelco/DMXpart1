        // ── W8: pusty ──
        leftPanel.addView(View(this).apply {
            layoutParams = LinearLayout.LayoutParams(-1, 0, 0.5f)
        })

        rootContainer.addView(leftPanel)

        // ── Prawy panel: suwak ──
        val rightOuter = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = LinearLayout.LayoutParams(2*j, -1).apply { setMargins(m*2, 0, 0, 0) }
            setBackgroundColor(Companion.COL_BG)
        }
        rightOuter.addView(TextView(this).apply {
            text = "SET VAL"; gravity = Gravity.CENTER; setTextColor(Color.BLACK)
            layoutParams = LinearLayout.LayoutParams(-1, j)
        })
        activeDataSlider = null  // reset przy wejściu w widok
        val (lfoSliderWidget, lfoSeekBar) = createDataSlider(
            if (activeLfoSlot >= 0) sliderMaxFor(activeLfoSlot) else 255,
