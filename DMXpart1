        fun updateTabs(activeIdx: Int) {
            groupTabs.forEachIndexed { idx, btn ->
                val hasG = hasGobo(idx, "Gobo")
                btn.background = when (idx) {
                    activeIdx -> android.graphics.drawable.LayerDrawable(arrayOf(
