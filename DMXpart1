        var patternCopySource = -1

        fun initGroupIfEmpty(g: Int) {
            val fixes = Companion.fixturesList.filter {
                it.groupIdx == g ||
                        (it.groupIdx == 8 && Companion.fixtureOriginalGroup[it.id] == g)
            }
            val existingIds = fixes.map { it.id }.toSet()

            // Usuń duchy (fixture których już nie ma)
            val toRemove = Companion.seqRoutingOrder[g].filter { it !in existingIds }
            toRemove.forEach { id ->
                val pos = Companion.seqRoutingOrder[g].indexOf(id)
                if (pos >= 0) {
                    Companion.seqRoutingOrder[g].removeAt(pos)
                    if (pos < Companion.seqRoutingOn[g].size)
                        Companion.seqRoutingOn[g].removeAt(pos)
                }
            }

            // Dodaj nowe fixture których jeszcze nie ma w routingu
            fixes.forEach {
                if (!Companion.fixtureOriginalGroup.containsKey(it.id)) {
                    Companion.fixtureOriginalGroup[it.id] = if (it.groupIdx == 8) g else it.groupIdx
                }
                if (it.id !in Companion.seqRoutingOrder[g]) {
                    Companion.seqRoutingOrder[g].add(it.id)
                    Companion.seqRoutingOn[g].add(it.groupIdx != 8)
                }
            }
        }

        val rootContainer = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Companion.COL_BG)
        }

        // Placeholder dla contentu – rebuild go wypełnia
        val contentArea = FrameLayout(this).apply {
            layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
        }

        var savedScrollY = 0

        fun rebuild() {
            contentArea.removeAllViews()
            initGroupIfEmpty(currentSeqGroup)

            val order = Companion.seqRoutingOrder[currentSeqGroup]
            val onList = Companion.seqRoutingOn[currentSeqGroup]

            val row = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = FrameLayout.LayoutParams(-1, -1)
            }

            // ── LEWA: lista urządzeń ──────────────────────────
            val leftPanel = LinearLayout(this).apply {
                orientation = LinearLayout.VERTICAL
                layoutParams = LinearLayout.LayoutParams(0, -1, 3f)
            }

            // Nagłówek
            leftPanel.addView(LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = LinearLayout.LayoutParams(-1, j + 2)
                setBackgroundColor(Companion.COL_PANEL)
                // RESET w nagłówku

                addView(TextView(this@MainActivity).apply {
                    text = "RST"; gravity = Gravity.CENTER; textSize = 11f; setTextColor(Color.WHITE)
                    background = getBtnStyle().apply { setColor(Color.parseColor("#553300")) }
                    layoutParams = LinearLayout.LayoutParams(j, -1).apply { setMargins(m,m,m,m) }
                    setOnClickListener {
                        // Przywróć groupIdx wszystkich fixture tej grupy
                        Companion.seqRoutingOrder[currentSeqGroup].forEach { fixId ->
                            val fix = Companion.fixturesList.find { it.id == fixId }
                            if (fix != null) {
                                fix.groupIdx = Companion.fixtureOriginalGroup[fixId] ?: currentSeqGroup
                            }
                        }
                        Companion.seqRoutingOrder[currentSeqGroup].clear()
                        Companion.seqRoutingOn[currentSeqGroup].clear()
                        initGroupIfEmpty(currentSeqGroup)
                        rebuild()
                    }
                })
                addView(TextView(this@MainActivity).apply {
                    text = "ON"; gravity = Gravity.CENTER; textSize = 13f; setTextColor(Companion.COL_TEXT_DIM)
                    layoutParams = LinearLayout.LayoutParams(j, -1).apply { setMargins(m,m,m,m) }
                })
                addView(TextView(this@MainActivity).apply {
                    text = "↑↓"; gravity = Gravity.CENTER; textSize = 13f; setTextColor(Companion.COL_TEXT_DIM)
                    layoutParams = LinearLayout.LayoutParams(j * 2, -1).apply { setMargins(m,m,m,m) }
                })
                addView(TextView(this@MainActivity).apply {
                    text = "Fixture"; gravity = Gravity.CENTER; textSize = 13f; setTextColor(Companion.COL_TEXT_DIM)
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(m,m,m,m) }
                })
                addView(TextView(this@MainActivity).apply {
                    val isSeqMode = Companion.seqRoutingMode[currentSeqGroup] == 0
                    text = if (isSeqMode) "SEQ" else "PATT"
                    gravity = Gravity.CENTER; textSize = 13f
                    setTextColor(if (isSeqMode) Color.BLACK else Color.WHITE)
                    background = getBtnStyle().apply {
                        setColor(if (isSeqMode) Companion.COL_ACCENT else Color.parseColor("#CC6600"))
                    }
                    layoutParams = LinearLayout.LayoutParams(j * 2, -1).apply { setMargins(m,m,m,m) }
                    setOnClickListener {
                        Companion.seqRoutingMode[currentSeqGroup] =
                            if (Companion.seqRoutingMode[currentSeqGroup] == 0) 1 else 0
                        rebuild()
                    }
                })
            })

            // Lista
            val scroll = ScrollView(this).apply {
                layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
                isVerticalScrollBarEnabled = false
                viewTreeObserver.addOnScrollChangedListener { savedScrollY = scrollY }
            }
            val list = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }

            order.forEachIndexed { pos, fixId ->
                val fix = Companion.fixturesList.find { it.id == fixId }
                val isOn = onList.getOrElse(pos) { true }

                val itemRow = LinearLayout(this).apply {
                    orientation = LinearLayout.HORIZONTAL
                    layoutParams = LinearLayout.LayoutParams(-1, j).apply { setMargins(0, 1, 0, 1) }
                    setBackgroundColor(if (isOn) Companion.COL_ROW_ON else Companion.COL_PANEL_DARK)
                }

                // Numer pozycji
                itemRow.addView(TextView(this).apply {
                    text = "${pos + 1}"; gravity = Gravity.CENTER; textSize = 14f
                    setTextColor(Color.parseColor("#888888"))
                    layoutParams = LinearLayout.LayoutParams(j, -1).apply { setMargins(m,m,m,m) }
                })

                // ON/OFF
                val onBg = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                    setColor(if (isOn) Color.parseColor("#007700") else Color.parseColor("#440000"))
                }
                val onOffBtn = TextView(this).apply {
                    text = if (isOn) "ON" else "OFF"; gravity = Gravity.CENTER; textSize = 12f
                    setTextColor(Color.WHITE); background = onBg
                    layoutParams = LinearLayout.LayoutParams(j, -1).apply { setMargins(m,m,m,m) }
                }
                onOffBtn.setOnClickListener {
                    if (pos < onList.size) {
                        val newState = !onList[pos]
                        onList[pos] = newState
                        onBg.setColor(if (newState) Color.parseColor("#007700") else Color.parseColor("#440000"))
                        onOffBtn.text = if (newState) "ON" else "OFF"
                        itemRow.setBackgroundColor(if (newState) Companion.COL_ROW_ON else Companion.COL_PANEL_DARK)
                        // Zwolnij kanały w SEQ mode
                        if (Companion.seqRoutingMode[currentSeqGroup] == 0) {
                            Companion.fixturesList.find { it.id == fixId }?.let { f ->
                                for (ch in 0 until f.channels) {
                                    val addr = f.dmx - 1 + ch
                                    if (addr in 0..511) {
                                        Companion.effectManagedChannels[addr] = false
                                        dmxPersist[addr] = Companion.baseDmxValues[addr].toFloat()
                                    }
                                }
                            }
                        }
                    }
                }
                itemRow.addView(onOffBtn)

                // Strzałki góra/dół – obok siebie
                val arrowRow = LinearLayout(this).apply {
                    orientation = LinearLayout.HORIZONTAL
                    layoutParams = LinearLayout.LayoutParams(j * 2, -1).apply { setMargins(m,m,m,m) }
                }
                arrowRow.addView(TextView(this).apply {
                    text = "▲"; gravity = Gravity.CENTER; textSize = 14f; setTextColor(Color.WHITE)
                    background = getBtnStyle().apply { setColor(Companion.COL_SEP) }
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(0,0,2,0) }
                    setOnClickListener {
                        if (pos > 0) {
                            val id = order.removeAt(pos); order.add(pos - 1, id)
                            val on = onList.removeAt(pos); onList.add(pos - 1, on)
                            rebuild()
                        }
                    }
                })
                arrowRow.addView(TextView(this).apply {
                    text = "▼"; gravity = Gravity.CENTER; textSize = 14f; setTextColor(Color.WHITE)
                    background = getBtnStyle().apply { setColor(Companion.COL_SEP) }
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(2,0,0,0) }
                    setOnClickListener {
                        if (pos < order.size - 1) {
                            val id = order.removeAt(pos); order.add(pos + 1, id)
                            val on = onList.removeAt(pos); onList.add(pos + 1, on)
                            rebuild()
                        }
                    }
                })
                itemRow.addView(arrowRow)

                // Nazwa fixture
                itemRow.addView(TextView(this).apply {
                    text = if (fix != null) "Fix ${fix.id}: ${fix.name}" else "Fix $fixId: ???"
                    gravity = Gravity.CENTER_VERTICAL; textSize = 14f
                    setTextColor(if (isOn) Color.WHITE else Color.parseColor("#666666"))
                    setPadding(12, 0, 0, 0)
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(m,m,m,m) }
                })

                // DMX
                itemRow.addView(TextView(this).apply {
                    val inVirtual = fix != null && fix.groupIdx == 8
                    text = if (fix != null) "DMX ${fix.dmx}" else "---"
                    gravity = Gravity.CENTER; textSize = 13f
                    setTextColor(if (inVirtual) Color.parseColor("#FF6600") else Companion.COL_ACCENT)
                    layoutParams = LinearLayout.LayoutParams(j * 2, -1).apply { setMargins(m,m,m,m) }
                })

                list.addView(itemRow)
            }

            // Jeśli lista pusta
            if (order.isEmpty()) {
                list.addView(TextView(this).apply {
                    text = "No fixtures in group ${'A' + currentSeqGroup}"
                    gravity = Gravity.CENTER; textSize = 16f; setTextColor(Color.parseColor("#888888"))
                    layoutParams = LinearLayout.LayoutParams(-1, j * 2)
                })
            }

            scroll.addView(list)
            scroll.post { scroll.scrollTo(0, savedScrollY) }
            leftPanel.addView(scroll)



            row.addView(leftPanel)

            // Pionowy separator
            row.addView(View(this).apply {
                layoutParams = LinearLayout.LayoutParams(12, -1)
                setBackgroundColor(Companion.COL_PANEL)
            })

            // ── PRAWA: pamięci patternów ──────────────────────
            val rightPanel = LinearLayout(this).apply {
                orientation = LinearLayout.VERTICAL
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
                setBackgroundColor(Companion.COL_PANEL_DARK)
                weightSum = 6f
            }

            // Nagłówek: COPY + CLEAR
            val patternHeader = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = LinearLayout.LayoutParams(-1, j + 2).apply { setMargins(m, 0, m, 0) }
            }
            patternHeader.addView(TextView(this).apply {
                text = "COPY"; gravity = Gravity.CENTER; textSize = 13f; setTextColor(Color.WHITE)
                background = getBtnStyle().apply {
                    setColor(if (patternCopyMode) Color.WHITE else Companion.COL_SEP)
                }
                setTextColor(if (patternCopyMode) Color.BLACK else Color.WHITE)
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(0, 0, 2, 0) }
                setOnClickListener {
                    patternCopyMode = !patternCopyMode
                    if (patternCopyMode) { patternClearMode = false; patternCopySource = -1 }
                    else patternCopySource = -1
                    rebuild()
                }
            })
            patternHeader.addView(TextView(this).apply {
                text = "CLEAR"; gravity = Gravity.CENTER; textSize = 13f
                background = getBtnStyle().apply {
                    setColor(if (patternClearMode) Color.RED else Color.parseColor("#660000"))
                }
                setTextColor(Color.WHITE)
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(2, 0, 0, 0) }
                setOnClickListener {
                    patternClearMode = !patternClearMode
                    if (patternClearMode) patternCopyMode = false
                    rebuild()
                }
            })
            rightPanel.addView(patternHeader)


            // 6 padów patternów
            val padColorActive = Color.parseColor("#FF9900")   // aktywny – jasny
            val padColorSaved  = Color.parseColor("#7A3800")   // zapisany nieaktywny – ciemny
            val padColorEmpty  = Color.parseColor("#3A1800")   // pusty – najciemniejszy
            val padColorCopySrc = Color.WHITE

            for (pi in 0..5) {
                val pat = Companion.seqPatternMemories[currentSeqGroup][pi]
                val isCopySrc = patternCopyMode && patternCopySource == pi

                val isActive = Companion.seqActivePattern[currentSeqGroup] == pi
                val padBg = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                    setColor(when {
                        isCopySrc  -> padColorCopySrc
                        isActive   -> padColorActive
                        pat.isSaved -> padColorSaved
                        else       -> padColorEmpty
                    })
                    setStroke(if (isCopySrc || isActive) 4 else 2,
                        if (isCopySrc) Color.BLACK else if (isActive) Color.WHITE else Companion.COL_SEP)
                }

                val pad = TextView(this).apply {
                    text = if (pat.isSaved) pat.name else "${pi + 1}"
                    gravity = Gravity.CENTER; textSize = 13f
                    setTextColor(if (isCopySrc) Color.BLACK else if (isActive) Color.BLACK else Color.WHITE)
                    background = padBg
                    layoutParams = LinearLayout.LayoutParams(-1, 0, 1f).apply {
                        setMargins(m, m / 2, m, m / 2)
                    }

                    setOnClickListener {
                        when {
                            patternClearMode -> {
                                Companion.seqPatternMemories[currentSeqGroup][pi] =
                                    Companion.SeqPattern()
                                patternClearMode = false
                                rebuild()
                            }
                            patternCopyMode -> {
                                if (patternCopySource == -1) {
                                    if (pat.isSaved) { patternCopySource = pi; rebuild() }
                                } else if (patternCopySource != pi) {
                                    val src = Companion.seqPatternMemories[currentSeqGroup][patternCopySource]
                                    val dst = Companion.seqPatternMemories[currentSeqGroup][pi]
                                    dst.isSaved = true
                                    dst.name = src.name
                                    dst.order.clear(); dst.order.addAll(src.order)
                                    dst.onList.clear(); dst.onList.addAll(src.onList)
                                    patternCopyMode = false; patternCopySource = -1
                                    rebuild()
                                }
                            }
                            else -> {
                                if (pat.isSaved) {
                                    // Zwolnij kanały poprzedniego routingu
                                    Companion.seqRoutingOrder[currentSeqGroup].forEachIndexed { pos, fixId ->
                                        if (Companion.seqRoutingOn[currentSeqGroup].getOrElse(pos) { true }) {
                                            Companion.fixturesList.find { it.id == fixId }?.let { f ->
                                                for (ch in 0 until f.channels) {
                                                    val addr = f.dmx - 1 + ch
                                                    if (addr in 0..511) {
                                                        Companion.effectManagedChannels[addr] = false
                                                        dmxPersist[addr] = Companion.baseDmxValues[addr].toFloat()
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Companion.seqRoutingOrder[currentSeqGroup].clear()
                                    Companion.seqRoutingOrder[currentSeqGroup].addAll(pat.order)
                                    Companion.seqRoutingOn[currentSeqGroup].clear()
                                    Companion.seqRoutingOn[currentSeqGroup].addAll(pat.onList)
                                    Companion.seqActivePattern[currentSeqGroup] = pi
                                    rebuild()
                                } else {
                                    // Zapisz aktualny routing jako pattern
                                    initGroupIfEmpty(currentSeqGroup)
                                    pat.isSaved = true
                                    pat.name = "PAT ${pi + 1}"
                                    pat.order.clear()
                                    pat.order.addAll(Companion.seqRoutingOrder[currentSeqGroup])
                                    pat.onList.clear()
                                    pat.onList.addAll(Companion.seqRoutingOn[currentSeqGroup])
                                    Companion.seqActivePattern[currentSeqGroup] = -1
                                    rebuild()
                                }
                            }
                        }
                    }

                    setOnLongClickListener {
                        // Długie przytrzymanie = zapisz + nazwij
                        initGroupIfEmpty(currentSeqGroup)
                        pat.isSaved = true
                        pat.order.clear()
                        pat.order.addAll(Companion.seqRoutingOrder[currentSeqGroup])
                        pat.onList.clear()
                        pat.onList.addAll(Companion.seqRoutingOn[currentSeqGroup])
                        val curName = if (pat.name == "Empty") "PAT ${pi + 1}" else pat.name
                        showInternalKeyboard(curName) { newName ->
                            pat.name = newName
                            rebuild()
                        }
                        true
                    }
                }
                rightPanel.addView(pad)
            }

            // Wypełniacz na dole
            rightPanel.addView(View(this).apply {
                layoutParams = LinearLayout.LayoutParams(-1, 0, 0f)
            })



            row.addView(rightPanel)

            contentArea.addView(row)
        }

        rootContainer.addView(contentArea)

        // ── Zakładki grup (dolny wiersz) ──────────────────────
        val tabR = j * 0.28f
        val tabsList = mutableListOf<TextView>()
        val tabsRow = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL; weightSum = 8f
            layoutParams = LinearLayout.LayoutParams(-1, j)
            setBackgroundColor(Companion.COL_DARK)
        }

        fun updateTabBgs(activeIdx: Int) {
            tabsList.forEachIndexed { idx, btn ->
                val isActive = idx == activeIdx
                btn.background = if (isActive) android.graphics.drawable.LayerDrawable(arrayOf(
                    GradientDrawable().apply { setColor(Companion.COL_DARK) },
                    GradientDrawable().apply {
                        shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_BG)
                        setCornerRadii(floatArrayOf(0f,0f, 0f,0f, tabR,tabR, tabR,tabR))
                    }
                )) else GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; setColor(Companion.COL_DARK)
                }
                btn.setTextColor(if (isActive) Color.BLACK else Color.WHITE)
            }
        }

        for (g in 0..7) {
            tabsList.add(TextView(this).apply {
                text = "GRP ${'A' + g}"; gravity = Gravity.CENTER; textSize = 14f
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f)
                setOnClickListener {
                    currentSeqGroup = g
                    updateTabBgs(g)
                    rebuild()
                }
            })
            tabsRow.addView(tabsList.last())
        }
        updateTabBgs(0)
        rootContainer.addView(tabsRow)

        rebuild()
        return rootContainer
    }



    private fun createMatrixView(): View {
        val m = 6
        val cellSize = exactRowHeight - 2 * m
        val groupLetters = listOf("A","B","C","D","E","F","G","H")

        val container = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            weightSum = 8f
            layoutParams = FrameLayout.LayoutParams(-1, -1)
            setBackgroundColor(Companion.COL_BG)
        }

        fun buildRow(
            label: String,
            rowColor: Int,
            getEnabled: () -> Boolean,
            getGroupActive: (Int) -> Boolean,
            getTarget: () -> Int,
            onToggleEnabled: () -> Unit,
            onGroupToggle: (Int) -> Unit,
            onToggleTarget: () -> Unit,
            onEditClick: () -> Unit
        ): LinearLayout {
            val totalWeight = 15f
            val row = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                weightSum = totalWeight
                layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
            }

            // 1. MAIN/AUX
            val targetBg = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE; cornerRadius = 3f
                setColor(if (getTarget() == 0) Color.YELLOW else Color.CYAN)
            }
            val targetBtn = TextView(this).apply {
                text = if (getTarget() == 0) "MAIN" else "AUX"
                gravity = Gravity.CENTER; textSize = 11f
                typeface = android.graphics.Typeface.DEFAULT_BOLD; setTextColor(Color.BLACK)
                background = targetBg
                layoutParams = LinearLayout.LayoutParams(0, -1, 1.5f).apply { setMargins(m,m,m,m) }
                setOnClickListener {
                    onToggleTarget()
                    val t = getTarget()
                    text = if (t == 0) "MAIN" else "AUX"
                    targetBg.setColor(if (t == 0) Color.YELLOW else Color.CYAN)
                }
            }
            row.addView(targetBtn)

            // 2. Enable
            val isLfoRow = label.startsWith("LFO")
            val rowIdx = label.substringAfterLast(" ").toIntOrNull()?.minus(1) ?: 0
            val enableBg = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                setColor(if (getEnabled()) rowColor else Companion.COL_TEXT_DIM)
                val lockedInit = if (isLfoRow) isLfoLockedByEx(rowIdx) else isSeqLockedByEx(rowIdx)
                setStroke(if (lockedInit) 6 else 0, Color.MAGENTA)
            }
            val enableBtn = View(this).apply {
                background = enableBg
                tag = "MIDI:${if (isLfoRow) "LFO" else "SEQ"}_${rowIdx}_ENABLE"
                layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(m,m,m,m) }
                setOnClickListener {
                    val locked = if (isLfoRow) isLfoLockedByEx(rowIdx) else isSeqLockedByEx(rowIdx)
                    if (locked) {
                        Toast.makeText(this@MainActivity, "Locked by active EX-preset", Toast.LENGTH_SHORT).show()
                        return@setOnClickListener
                    }
                    onToggleEnabled()
                    enableBg.setColor(if (getEnabled()) rowColor else Companion.COL_TEXT_DIM)
                }
            }
            row.addView(enableBtn)

            // 3. Nazwa + wskaźnik
            val nameCont = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = LinearLayout.LayoutParams(0, -1, 2.5f).apply { setMargins(m,m,m,m) }
                background = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; setColor(Color.parseColor("#666666"))
                    setStroke(2, rowColor); cornerRadius = 4f
                }
                setOnClickListener { onEditClick() }
            }
            nameCont.addView(TextView(this).apply {
                text = label; gravity = Gravity.CENTER; textSize = 13f
                typeface = android.graphics.Typeface.DEFAULT_BOLD; setTextColor(rowColor)
                layoutParams = LinearLayout.LayoutParams(0, -1, 1.0f)
            })
            val indicatorArea = FrameLayout(this).apply {
                layoutParams = LinearLayout.LayoutParams(cellSize / 2, -1).apply { setMargins(0,2,4,2) }
            }
            val dotSzM = cellSize / 4
            val dot = View(this).apply {
                background = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; setColor(rowColor); cornerRadius = 3f; setStroke(2, Color.BLACK)
                }
                layoutParams = FrameLayout.LayoutParams(dotSzM, dotSzM).apply { leftMargin = dotSzM / 2 }
            }
            indicatorArea.addView(dot); nameCont.addView(indicatorArea)
            row.addView(nameCont)

            // 4. 8 komórek grup
            for (g in 0..7) {
                val cellBg = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                    setColor(if (getGroupActive(g)) rowColor else Color.parseColor("#777777"))
                }
                row.addView(TextView(this).apply {
                    text = groupLetters[g]; gravity = Gravity.CENTER; textSize = 16f
                    typeface = android.graphics.Typeface.DEFAULT_BOLD; setTextColor(Color.WHITE)
                    background = cellBg
                    tag = "MIDI:${if (label.startsWith("LFO")) "LFO" else "SEQ"}_${rowIdx}_GROUP_$g"
                    layoutParams = LinearLayout.LayoutParams(0, -1, 1.25f).apply { setMargins(m,m,m,m) }
                    setOnClickListener {
                        onGroupToggle(g)
                        cellBg.setColor(if (getGroupActive(g)) rowColor else Color.parseColor("#777777"))
                    }
                })
            }
            return row
        }

        for (i in 0..3) {
            container.addView(buildRow(
                label = "LFO ${i+1}", rowColor = lfoColors[i],
                getEnabled = { lfoEnabled[i] },
                getGroupActive = { g -> lfoGroupActive[i][g] },
                getTarget = { lfoTarget[i] },
                onToggleEnabled = { lfoEnabled[i] = !lfoEnabled[i] },
                onGroupToggle = { g -> lfoGroupActive[i][g] = !lfoGroupActive[i][g] },
                onToggleTarget = { lfoTarget[i] = if (lfoTarget[i] == 0) 1 else 0 },
                onEditClick = { activeViewContainer.removeAllViews(); activeViewContainer.addView(createLfoEditView(i)) }
            ))
        }
        for (i in 0..3) {
            container.addView(buildRow(
                label = "SEQ ${i+1}", rowColor = seqColors[i],
                getEnabled = { seqEnabled[i] },
                getGroupActive = { g -> seqGroupActive[i][g] },
                getTarget = { seqTarget[i] },
                onToggleEnabled = {
                    val wasEnabled = seqEnabled[i]
                    seqEnabled[i] = !seqEnabled[i]
                    if (!seqEnabled[i]) releaseSeqChannels(i)
                    else if (!wasEnabled) {
                        for (g in 0..7) if (seqGroupActive[i][g]) {
                            Companion.posManualOverride[g] = false
                            Companion.colorManualOverride[g] = false
                        }
                    }
                },
                onGroupToggle = { g ->
                    val wasActive = seqGroupActive[i][g]
                    seqGroupActive[i][g] = !seqGroupActive[i][g]
                    val thisSeqHasPos = (0 until memorySeq[i].totalSteps).any { memorySeq[i].stepType[it] == 3 }
                    val thisSeqHasColor = (0 until memorySeq[i].totalSteps).any { memorySeq[i].stepType[it] == 1 || memorySeq[i].stepType[it] == 2 }
                    if (seqGroupActive[i][g] && !wasActive) {
                        if (thisSeqHasColor) Companion.colorManualOverride[g] = false
                        if (thisSeqHasPos) {
                            Companion.posPanOffset[g] = 0f
                            Companion.posTiltOffset[g] = 0f
                        }
                    }
                    if (!seqGroupActive[i][g]) {
                        val posParams = setOf("Pan","Pan Fine","Tilt","Tilt Fine")
                        Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                            for (ch in 0 until fix.channels) {
                                val paramHere = fix.paramMap[ch]
                                val isPosParam = paramHere in posParams
                                if (isPosParam && !thisSeqHasPos) continue
                                val actCh = fix.dmx - 1 + ch
                                if (actCh in 0..511) {
                                    Companion.effectManagedChannels[actCh] = false
                                    dmxPersist[actCh] = Companion.baseDmxValues[actCh].toFloat()
                                    val base = Companion.baseDmxValues[actCh]
                                    Companion.dmxValues[actCh] = base; setDmxChannel(actCh, base)
                                }
                            }
                        }
                        // Dezaktywuj EX-presety sterowane przez kroki tego SEQ –
                        // jeśli żaden inny aktywny SEQ ich nie trzyma.
                        val sq = memorySeq[i]
                        for (stepIdx in 0 until sq.totalSteps) {
                            if (sq.stepType[stepIdx] != 4) continue
                            val exIdx = sq.stepValue[stepIdx]
                            if (exIdx !in 0..63) continue
                            val neededByOther = (0..3).any { os ->
                                os != i && seqEnabled[os] &&
                                        (0..7).any { og -> seqGroupActive[os][og] } &&
                                        (0 until memorySeq[os].totalSteps).any { s ->
                                            memorySeq[os].stepType[s] == 4 &&
                                                    memorySeq[os].stepValue[s] == exIdx
                                        }
                            }
                            if (!neededByOther) Companion.activeExPresets[exIdx] = false
                        }
                    }
                },
                onToggleTarget = { seqTarget[i] = if (seqTarget[i] == 0) 1 else 0 },
                onEditClick = {
                    activeViewContainer.removeAllViews()
                    activeViewContainer.addView(createSeqEditView(i))
                }
            ))
        }

        // Animacja kropek – TYLKO przesuwa topMargin, nie przebudowuje widoku
        lifecycleScope.launchWhenResumed {
            while (isActive) {
                delay(25)
                if (activeViewContainer.getChildAt(0) !== container) break
                container.post {
                    for (rowIdx in 0 until container.childCount) {
                        val row = container.getChildAt(rowIdx) as? LinearLayout ?: continue
                        val nameCont = row.getChildAt(2) as? LinearLayout ?: continue
                        val indicatorArea = nameCont.getChildAt(1) as? FrameLayout ?: continue
                        val dot = indicatorArea.getChildAt(0) as? View ?: continue
                        val isLfo = rowIdx < 4; val idx = rowIdx % 4
                        val areaH = indicatorArea.height
                        val dotSz = cellSize / 4
                        if (areaH <= dotSz) return@post

                        val active = if (isLfo) lfoEnabled[idx] else seqEnabled[idx]
                        dot.alpha = if (active) 1f else 0.25f

                        val locked = if (isLfo) isLfoLockedByEx(idx) else isSeqLockedByEx(idx)
                        val enableBtnView = row.getChildAt(1) as? View
                        (enableBtnView?.background as? GradientDrawable)?.setStroke(if (locked) 6 else 0, Color.MAGENTA)

                        val yPos = if (isLfo) {
                            val norm = (memoryLfo[idx].currentValue + 1f) / 2f
                            (norm * (areaH - dotSz)).toInt().coerceIn(0, areaH - dotSz)
                        } else {
                            val seq = memorySeq[idx]
                            if (seq.totalSteps > 1) {
                                val norm = seq.currentStep.toFloat() / (seq.totalSteps - 1).toFloat()
                                (norm * (areaH - dotSz)).toInt().coerceIn(0, areaH - dotSz)
                            } else 0
                        }
                        val lp = dot.layoutParams as FrameLayout.LayoutParams
                        if (lp.topMargin != yPos) { lp.topMargin = yPos; dot.requestLayout() }
                    }
                }
            }
        }

        return container
    }



