                val rowLayout = LinearLayout(this@MainActivity).apply {
                    orientation = LinearLayout.HORIZONTAL; weightSum = 3f
                    layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
                }
                row.forEach { key ->
                    rowLayout.addView(TextView(this@MainActivity).apply {
                        text = key; textSize = 28f; setTextColor(Color.WHITE)
                        gravity = Gravity.CENTER; includeFontPadding = false
                        background = keyBgND()
                        layoutParams = LinearLayout.LayoutParams(0, -1, 1f).apply { setMargins(3, 3, 3, 3) }
                        setOnClickListener {
                            when (key) {
                                "OK" -> {
                                    numpadOverlay.visibility = View.GONE
                                    activeDataSlider = null; activeDataSliderCallback = null
                                    onNumpadResult?.invoke(numpadDisplay.text.toString())
                                }
                                "DEL" -> {
                                    if (numpadDisplay.text.isNotEmpty())
                                        numpadDisplay.text = numpadDisplay.text.substring(0, numpadDisplay.text.length - 1)
                                    numpadSliderRef?.progress = numpadDisplay.text.toString().toIntOrNull()?.coerceIn(0, 512) ?: 0
                                }
                                else -> {
                                    if (numpadDisplay.text.length < 3)
                                        numpadDisplay.text = "${numpadDisplay.text}$key"
                                    numpadSliderRef?.progress = numpadDisplay.text.toString().toIntOrNull()?.coerceIn(0, 512) ?: 0
                                }
                            }
                        }
                    })
                }
                numpadBox.addView(rowLayout)
            }
            leftPart.addView(numpadBox)
            centerContainer.addView(leftPart)

            // ── Prawa: slider 5u (bez pustego wiersza na górze) ─
            val rightPart = LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.VERTICAL
                layoutParams = LinearLayout.LayoutParams(u * 2, -1)
                setBackgroundColor(Color.parseColor("#111111"))
            }
            val (sliderWidget, sliderBar) = createDataSlider(512, 0) { p ->
                numpadDisplay.text = p.toString()
            }
            numpadSliderRef = sliderBar
            // NIE ustawiamy activeDataSlider tutaj – robimy to dopiero gdy numpad jest
            // faktycznie pokazywany (showInternalNumpad), żeby nie "zanieczyszczać" kontekstu
            // gdy numpad jest tylko tworzony przy starcie aplikacji.
            sliderWidget.layoutParams = LinearLayout.LayoutParams(-1, totalH)
            rightPart.addView(sliderWidget)
            centerContainer.addView(rightPart)

            addView(centerContainer)
        }
    }


