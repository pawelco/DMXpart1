    private fun captureExSlotSnapshot(exIdx: Int, ep: PresetItem) {
        for (j in 0..3) {
            val fId = ep.exFix[j]
            val dIdx = ep.exDest[j]
            if (fId == -1 || dIdx == -1) continue
            when {
                fId in 3000..3003 -> {
                    val lfo = memoryLfo[fId - 3000]
                    when (dIdx) {
                        9000 -> Companion.exSpecialSnapVal[exIdx][j] = if (lfoEnabled[fId-3000]) 1f else 0f
                        9001 -> {
                            Companion.exSpecialSnapSync[exIdx][j] = lfo.isSync
                            Companion.exSpecialSnapSyncIdx[exIdx][j] = lfo.syncIdx
                            Companion.exSpecialSnapVal[exIdx][j] = lfo.rate
                        }
                        9002 -> Companion.exSpecialSnapVal[exIdx][j] = lfo.pwm.toFloat()
                    }
                }
                fId in 4000..4003 -> {
                    val sq = memorySeq[fId - 4000]
                    when (dIdx) {
                        9010 -> Companion.exSpecialSnapVal[exIdx][j] = if (seqEnabled[fId-4000]) 1f else 0f
                        9011 -> {
                            Companion.exSpecialSnapSync[exIdx][j] = sq.isSync
                            Companion.exSpecialSnapSyncIdx[exIdx][j] = sq.syncIdx
                            Companion.exSpecialSnapVal[exIdx][j] = sq.globalTime
                        }
                        9012 -> Companion.exSpecialSnapVal[exIdx][j] = sq.totalSteps.toFloat()
                        9013 -> Companion.exSpecialSnapVal[exIdx][j] = sq.globalPhase.toFloat()
                    }
                }
                fId in 5000..5003 -> {
                    val fx = Companion.memoryFx[fId - 5000]
                    when (dIdx) {
                        9020 -> Companion.exSpecialSnapVal[exIdx][j] = if (fx.isEnabled) 1f else 0f
                        9021 -> Companion.exSpecialSnapVal[exIdx][j] = fx.playState.toFloat()
                        9022 -> Companion.exSpecialSnapVal[exIdx][j] = fx.spread.toFloat()
                        9023 -> Companion.exSpecialSnapVal[exIdx][j] = fx.amt.toFloat()
                        9024 -> Companion.exSpecialSnapVal[exIdx][j] = fx.phs.toFloat()
                    }
                }
                fId == 6000 -> {
                    when (dIdx) {
                        9030 -> Companion.exSpecialSnapVal[exIdx][j] = Companion.extColorRouting.toFloat()
                        9031 -> Companion.exSpecialSnapVal[exIdx][j] = Companion.extColorPaletteIdx.toFloat()
                    }
                }
            }
        }
    }

    private fun restoreExSlotSnapshot(exIdx: Int, ep: PresetItem) {
        for (j in 0..3) {
            val fId = ep.exFix[j]
            val dIdx = ep.exDest[j]
            if (fId == -1 || dIdx == -1) continue
            val snapV = Companion.exSpecialSnapVal[exIdx][j]
            when {
                fId in 3000..3003 -> {
                    val li = fId - 3000
                    val lfo = memoryLfo[li]
                    when (dIdx) {
                        9000 -> lfoEnabled[li] = snapV >= 0.5f
                        9001 -> { lfo.isSync = Companion.exSpecialSnapSync[exIdx][j]; lfo.syncIdx = Companion.exSpecialSnapSyncIdx[exIdx][j]; lfo.rate = snapV }
                        9002 -> lfo.pwm = snapV.toInt()
                    }
                }
                fId in 4000..4003 -> {
                    val si = fId - 4000
                    val sq = memorySeq[si]
                    when (dIdx) {
                        9010 -> {
                            val want = snapV >= 0.5f
                            if (seqEnabled[si] != want) { seqEnabled[si] = want; if (!want) releaseSeqChannels(si) }
                        }
                        9011 -> { sq.isSync = Companion.exSpecialSnapSync[exIdx][j]; sq.syncIdx = Companion.exSpecialSnapSyncIdx[exIdx][j]; sq.globalTime = snapV }
                        9012 -> sq.totalSteps = snapV.toInt().coerceIn(1,16)
                        9013 -> sq.globalPhase = snapV.toInt()
                    }
                }
                fId in 5000..5003 -> {
                    val fi = fId - 5000
                    val fx = Companion.memoryFx[fi]
                    when (dIdx) {
                        9020 -> fx.isEnabled = snapV >= 0.5f
                        9021 -> fx.playState = snapV.toInt()
                        9022 -> fx.spread = snapV.toInt()
                        9023 -> { fx.amt = snapV.toInt(); Companion.fxBaseAmts[fi] = fx.amt }
                        9024 -> { fx.phs = snapV.toInt(); Companion.fxBasePhss[fi] = fx.phs }
                    }
                }
                fId == 6000 -> {
                    when (dIdx) {
                        9030 -> Companion.extColorRouting = snapV.toInt()
                        9031 -> {
                            Companion.extColorPaletteIdx = snapV.toInt()
                            if (Companion.extColorRouting == 0) {
                                val dmx = Companion.getPaletteDmxValues(Companion.extColorPaletteIdx)
                                System.arraycopy(dmx, 0, Companion.extColorDmxValues, 0, 6)
                            }
                        }
                    }
                }
            }
        }
    }

    private fun applyExSlotSpecial(ep: PresetItem) {
        for (j in 0..3) {
            val fId = ep.exFix[j]
            val dIdx = ep.exDest[j]
            val vVal = ep.exVal[j]
            when {
                fId in 3000..3003 -> {
                    val li = fId - 3000
                    val lfo = memoryLfo[li]
                    when (dIdx) {
                        9000 -> lfoEnabled[li] = vVal >= 128
                        9001 -> {
                            if (lfo.isSync) lfo.syncIdx = vVal.coerceIn(0,12)
                            else lfo.rate = (vVal / 255f * 20f).coerceIn(0.01f, 20f)
                        }
                        9002 -> lfo.pwm = (vVal / 255f * 100f).toInt().coerceIn(0,100)
                    }
                }
                fId in 4000..4003 -> {
                    val si = fId - 4000
                    val sq = memorySeq[si]
                    when (dIdx) {
                        9010 -> seqEnabled[si] = vVal >= 128
                        9011 -> {
                            if (sq.isSync) sq.syncIdx = vVal.coerceIn(0,12)
                            else sq.globalTime = (vVal / 255f * 10f).coerceAtLeast(0.025f)
                        }
                        9012 -> sq.totalSteps = ((vVal / 255f * 15f).toInt() + 1).coerceIn(1,16)
                        9013 -> sq.globalPhase = vVal.coerceIn(0, (sq.totalSteps - 1).coerceAtLeast(0))
                    }
                }
                fId in 5000..5003 -> {
                    val fi = fId - 5000
                    val fx = Companion.memoryFx[fi]
                    when (dIdx) {
                        9020 -> fx.isEnabled = vVal >= 128
                        9021 -> fx.playState = if (vVal >= 128) 1 else 2
                        9022 -> fx.spread = (vVal / 255f * 127f).toInt().coerceAtLeast(1)
                        9023 -> { fx.amt = (vVal / 255f * 510f - 255f).toInt().coerceIn(-255,255); Companion.fxBaseAmts[fi] = fx.amt }
                        9024 -> { fx.phs = (vVal / 255f * 360f).toInt() % 360; Companion.fxBasePhss[fi] = fx.phs }
                    }
                }
                fId == 6000 -> {
                    when (dIdx) {
                        9030 -> Companion.extColorRouting = (vVal / 255f * 4f).toInt().coerceIn(0,4)
                        9031 -> {
                            Companion.extColorPaletteIdx = vVal.coerceIn(0,63)
                            if (Companion.extColorRouting == 0) {
                                val dmx = Companion.getPaletteDmxValues(vVal.coerceIn(0,63))
                                System.arraycopy(dmx, 0, Companion.extColorDmxValues, 0, 6)
                            }
                        }
                    }
                }
            }
        }
    }

    fun applyMidiMapping(m: Companion.MidiMapping, rawValue: Int) {
        val t = m.target
        // dla CC_ABS na GLOBAL_ i SLIDER_ – konwertuj na delta żeby uniknąć skoku przy zmianie grupy
        val effectiveValue = rawValue

        // ── Nawigacja widoków ────────────────────────────────────
        if (t.startsWith("VIEW_")) {
            if (rawValue == 0) return
            val viewName = t.substring(5)
            runOnUiThread {
                val btn = tabButtons.firstOrNull { (it.tag as? String) == "MIDI:VIEW_$viewName" }
                    ?: leftButtons.firstOrNull { (it.tag as? String) == "MIDI:VIEW_$viewName" }
                btn?.performClick()
            }
            return
        }

        // ── Pozycje ──────────────────────────────────────────────
        if (t.startsWith("POS_") && !t.startsWith("POS_LP")) {
            val parts = t.split("_")
            val g = parts.getOrNull(1)?.toIntOrNull() ?: return
            val idx = parts.getOrNull(2)?.toIntOrNull() ?: return
            val posMovParamSet = setOf("Pan","Pan Fine","Tilt","Tilt Fine","Zoom","Focus","Iris","PT speed")
            val key = "${g}_${idx}"
            if (rawValue > 0) {
                val pressTime = System.currentTimeMillis()
                midiPresetHoldTimers[idx] = pressTime
                android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
                    val t2 = midiPresetHoldTimers[idx] ?: return@postDelayed
                    if (System.currentTimeMillis() - t2 >= 700L) {
                        Toast.makeText(this, "Saved: ${Companion.memoryPresets.getOrNull(idx)?.name ?: "PRST ${idx+1}"}", Toast.LENGTH_SHORT).show()
                    }
                }, 700)
                return
            }
            // note off
            val pressTime = midiPosHoldTimers.remove(key) ?: return
            val held = System.currentTimeMillis() - pressTime
            val pm = Companion.positionMemories[g][idx]
            if (held >= 700L) {
                // SAVE
                val snap = IntArray(512)
                Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                    for (ch in 0 until fix.channels) if (fix.paramMap[ch] in posMovParamSet) {
                        val a = fix.dmx-1+ch; if (a in 0..511) snap[a] = Companion.baseDmxValues[a]
                    }
                }
                Companion.positionMemories[g][idx] = Companion.PositionItem(true, if (pm.isSaved) pm.name else "${idx+1}", snap)
                posActiveMemory[g] = idx
                runOnUiThread {
                    Toast.makeText(this, "Pozycja zapisana: ${g+1}-${idx+1}", Toast.LENGTH_SHORT).show()
                    positionsRefreshCallback?.invoke()
                }
            } else {
                // RECALL
                if (!pm.isSaved) return
                posActiveMemory[g] = idx
                posCurrentGroup = g
                Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                    for (ch in 0 until fix.channels) if (fix.paramMap[ch] in posMovParamSet) {
                        val addr = fix.dmx-1+ch; if (addr in 0..511) { Companion.overrideChannel(addr, pm.dmxSnapshot[addr]); setDmxChannel(addr, pm.dmxSnapshot[addr]) }
                    }
                }
                runOnUiThread { positionsRefreshCallback?.invoke() }
            }
            return
        }
        // ── FX shape (cyklicznie) ────────────────────────────────
        if (t.startsWith("FX_") && t.endsWith("_SHAPE")) {
            val fi = t.split("_").getOrNull(1)?.toIntOrNull() ?: return
            val fx = Companion.memoryFx.getOrNull(fi) ?: return
            if (rawValue > 0) { fx.shapeIdx = (fx.shapeIdx + 1) % 3 }
            return
        }

        // ── LFO rate (enkoder +/-) ───────────────────────────────
        if (t.startsWith("LFO_") && t.endsWith("_RATE")) {
            val li = t.split("_").getOrNull(1)?.toIntOrNull() ?: return
            val lfo = memoryLfo[li]
            val delta = if (rawValue > 64) 0.05f else if (rawValue < 64) -0.05f else 0f
            lfo.rate = (lfo.rate + delta).coerceIn(0.01f, 20f)
            return
        }

        // ── SEQ time (enkoder +/-) ───────────────────────────────
        if (t.startsWith("SEQ_") && t.endsWith("_TIME")) {
            val si = t.split("_").getOrNull(1)?.toIntOrNull() ?: return
            val seq = memorySeq[si]
            val delta = if (rawValue > 64) 0.025f else if (rawValue < 64) -0.025f else 0f
            seq.globalTime = (seq.globalTime + delta).coerceIn(0.025f, 30f)
            return
        }

        // ── Global DMX (aktywna grupa) ───────────────────────────
        if (t.startsWith("GLOBAL_")) {
            val paramName = t.substring(7)
            // W FIX MODE (zaznaczone pojedyncze urządzenie przez Sliders lub DEVICE_FIX_)
            // GLOBAL_ steruje tylko wybraną fixturą – identycznie jak suwaki w Sliders.
            // W GROUP MODE steruje wszystkimi fixturami grupy (w tym wszystkimi beamami).
            val fixes = if (isFixtureMode) {
                listOfNotNull(Companion.fixturesList.filter { it.groupIdx == currentGroup }.getOrNull(currentFixture - 1))
            } else {
                Companion.fixturesList.filter { it.groupIdx == currentGroup }
            }
            val fix = fixes.firstOrNull() ?: return
            val gKey = "${m.channel}_${m.number}_GLOBAL_${paramName}_${currentGroup}"
            // Nie ustawiaj colorManualOverride – suwaki MIDI jak suwaki GUI działają tylko na tło
            // if (paramName in setOf("Red","Green","Blue","White","Amber","UV")) Companion.colorManualOverride[currentGroup] = true

            if (paramName == "Pan" || paramName == "Tilt") {
                val seqPosActive = (0..3).any { si -> seqEnabled[si] && seqGroupActive[si][currentGroup] && memorySeq[si].stepType[memorySeq[si].currentStep] == 3 }
                val chIdx = fix.paramMap.indexOf(paramName)
                val addr0 = if (chIdx != -1) fix.dmx - 1 + chIdx else -1
                val liveCur = if (addr0 in 0..511) Companion.dmxValues[addr0] else 0
                if (seqPosActive) {
                    val delta = when (m.type) {
                        Companion.MIDI_CC_ABS -> (rawValue / 127f * 255f) - liveCur
                        Companion.MIDI_CC_REL -> (if (rawValue in 1..63) 1f else if (rawValue in 65..127) -1f else 0f)
                        else -> 0f
                    }
                    if (paramName == "Pan") Companion.posPanOffset[currentGroup] += delta
                    else Companion.posTiltOffset[currentGroup] += delta
                    runOnUiThread { updateSlidersViewUI() }
                    return
                } else {
                    // Normalizacja zakresu – fixture może mieć min>max (osie odwrócone w Fixtures),
                    // co bez tego dałoby coerceIn(max, min) i crash "empty range".
                    val target = (when (m.type) {
                        Companion.MIDI_CC_ABS -> rawValue / 127f * 255f
                        Companion.MIDI_CC_REL -> {
                            val delta = if (rawValue in 1..63) 1 else if (rawValue in 65..127) -1 else 0
                            (liveCur + delta).toFloat()
                        }
                        else -> rawValue / 127f * 255f
                    }).coerceIn(0f.coerceAtMost(255f), 0f.coerceAtLeast(255f))
                    fixes.forEach { f ->
                        for (ch in 0 until f.channels) {
                            if (f.paramMap[ch] != paramName) continue
                            val addr = f.dmx - 1 + ch
                            if (addr in 0..511) Companion.effectManagedChannels[addr] = false
                        }
                    }
                }
            }

            if (m.type == Companion.MIDI_CC_ABS) {
                val target = midiPickupTargets[gKey]
                if (target != null && target >= 0) {
                    // czekamy na pickup po zmianie grupy
                    val prev = midiCcLastValues[gKey] ?: rawValue
                    midiCcLastValues[gKey] = rawValue
                    val crossed = (prev <= target && rawValue >= target) ||
                            (prev >= target && rawValue <= target)
                    if (!crossed) return
                    midiPickupTargets[gKey] = -1  // pickup done
                }
                midiCcLastValues[gKey] = rawValue
            }

            // dla kolorów podstawowych dopisz odpowiadające beamy
            val colorBeamGroups = mapOf(
                "Red" to (1..10).map { "Beam ${it}R" },
                "Green" to (1..10).map { "Beam ${it}G" },
                "Blue" to (1..10).map { "Beam ${it}B" },
                "White" to (1..10).map { "Beam ${it}W" },
                "Amber" to (1..10).map { "Beam ${it}A" }
            )
            val targetParamNames = (listOf(paramName) + (colorBeamGroups[paramName] ?: emptyList())).toSet()

            // wykonaj zmianę
            fixes.forEach { f ->
                for (ch in 0 until f.channels) {
                    if (f.paramMap[ch] !in targetParamNames) continue
                    val addr = f.dmx - 1 + ch; if (addr !in 0..511) continue
                    val rawRange = (f.paramMax[ch] - f.paramMin[ch])
                    val safeRange = if (rawRange == 0) 1 else rawRange
                    val newMapped = when (m.type) {
                        Companion.MIDI_CC_ABS ->
                            (f.paramMin[ch] + rawValue / 127f * rawRange).toInt().coerceIn(0, 255)
                        Companion.MIDI_CC_REL -> {
                            val delta = if (rawValue in 1..63) 1 else if (rawValue in 65..127) -1 else 0
                            val lo = minOf(f.paramMin[ch], f.paramMax[ch])
                            val hi = maxOf(f.paramMin[ch], f.paramMax[ch])
                            (Companion.baseDmxValues[addr] + delta).coerceIn(lo, hi)
                        }
                        else ->
                            (f.paramMin[ch] + rawValue / 127f * rawRange).toInt().coerceIn(0, 255)
                    }
                    // Jak suwak GUI: zawsze zapisz do baseDmxValues
                    Companion.overrideChannel(addr, newMapped)
                    // setDmxChannel tylko gdy SEQ nie zarządza tym kanałem
                    if (!Companion.effectManagedChannels[addr]) {
                        setDmxChannel(addr, newMapped)
                    }
                }
            }
            updateSlidersViewUI()
            if (paramName == "Dimmer") runOnUiThread { colorViewRefreshCallback?.invoke() }
            return
        }

        // ── Direct DMX Channel (1..512) ───────────────────────
        if (t.startsWith("DIRECT_CH_")) {
            val chNum = t.substringAfter("DIRECT_CH_").toIntOrNull() ?: return
            val addr = chNum - 1
            if (addr !in 0..511) return
            val mapped = when (m.type) {
                Companion.MIDI_CC_ABS -> (rawValue / 127f * 255f).toInt()
                Companion.MIDI_CC_REL -> {
                    val delta = if (rawValue in 1..63) 1 else if (rawValue in 65..127) -1 else 0
                    (Companion.baseDmxValues[addr] + delta).coerceIn(0, 255)
                }
                else -> (rawValue / 127f * 255f).toInt()
            }.coerceIn(0, 255)
            Companion.overrideChannel(addr, mapped)
            updateSlidersViewUI()
            return
        }

        // ── Device: GROUP = identyczne z GROUP_SELECT_ (ten sam kontroler/target, przełącza
        // zakładkę jeśli jesteś w Sliders/Colors/Positions). FIX = ustawia kontekst (currentGroup +
        // currentFixture) dla GLOBAL_, ale NIE wymusza FIX MODE w widoku Sliders.
        if (t.startsWith("DEVICE_GROUP_")) {
            if (rawValue == 0) return
            val g = t.substringAfter("DEVICE_GROUP_").toIntOrNull() ?: return
            currentGroup = g
            colorSelectedGroup = g
            posCurrentGroup = g
            // Zaznaczenie grupy wyłącza tryb pojedynczego urządzenia (tylko jedno może być aktywne).
            isFixtureMode = false
            midiCcLastValues.keys.filter { it.contains("GLOBAL_") }.toList()
                .forEach { midiCcLastValues.remove(it) }
            midiPickupTargets.keys.filter { it.contains("GLOBAL_") }.toList()
                .forEach { midiPickupTargets.remove(it) }
            midiPickedUp.removeAll { it.contains("GLOBAL_") }
            runOnUiThread {
                midiRootFrame.findViewWithTag<View>("MIDI:GROUP_SELECT_$g")?.performClick()
            }
            return
        }
        if (t.startsWith("DEVICE_FIX_")) {
            if (rawValue == 0) return
            val fixId = t.substringAfter("DEVICE_FIX_").toIntOrNull() ?: return
            val fix = Companion.fixturesList.find { it.id == fixId } ?: return
            currentGroup = fix.groupIdx
            currentFixture = Companion.fixturesList.filter { it.groupIdx == fix.groupIdx }.indexOf(fix) + 1
            // Zaznaczenie fixture aktywuje FIX MODE dla GLOBAL_ (wzajemnie wyklucza się z grupą).
            // NIE wywołujemy performClick na zakładce – nie chcemy przełączać widoku.
            isFixtureMode = true
            midiCcLastValues.keys.filter { it.contains("GLOBAL_") }.toList()
                .forEach { midiCcLastValues.remove(it) }
            midiPickupTargets.keys.filter { it.contains("GLOBAL_") }.toList()
                .forEach { midiPickupTargets.remove(it) }
            midiPickedUp.removeAll { it.contains("GLOBAL_") }
            runOnUiThread { updateSlidersHeaderUI(); updateSlidersViewUI() }
            return
        }

        // ── Suwak DMX (np. "SLIDER_0_Dimmer") ──────────────────
        if (t.startsWith("SLIDER_")) {
            val parts = t.split("_")
            val group     = parts.getOrNull(1)?.toIntOrNull() ?: return
            val paramName = parts.getOrNull(2) ?: return
            val fixes = Companion.fixturesList.filter { it.groupIdx == group }

            if (paramName == "Pan" || paramName == "Tilt") {
                val seqPosActive = (0..3).any { si -> seqEnabled[si] && seqGroupActive[si][group] && memorySeq[si].stepType[memorySeq[si].currentStep] == 3 }
                val refFix = fixes.firstOrNull()
                val chIdx = refFix?.paramMap?.indexOf(paramName) ?: -1
                val addr0 = if (refFix != null && chIdx != -1) refFix.dmx - 1 + chIdx else -1
                val mapped0 = if (refFix != null && chIdx != -1) {
                    refFix.paramMin[chIdx] + ((refFix.paramMax[chIdx] - refFix.paramMin[chIdx]) * when (m.type) {
                        Companion.MIDI_CC_ABS -> rawValue / 127f
                        Companion.MIDI_CC_REL -> {
                            val delta = if (rawValue in 1..63) rawValue else if (rawValue in 65..127) rawValue - 128 else 0
                            val range = (refFix.paramMax[chIdx] - refFix.paramMin[chIdx]).coerceAtLeast(1)
                            val curMapped = Companion.baseDmxValues[addr0].coerceIn(refFix.paramMin[chIdx], refFix.paramMax[chIdx])
                            ((curMapped + delta - refFix.paramMin[chIdx]).toFloat() / range).coerceIn(0f, 1f)
                        }
                        else -> rawValue / 127f
                    }).toInt()
                } else 0

                if (seqPosActive) {
                    val curOutput = if (addr0 in 0..511) Companion.dmxValues[addr0] else mapped0
                    val delta = (mapped0 - curOutput).toFloat()
                    if (paramName == "Pan") Companion.posPanOffset[group] += delta
                    else Companion.posTiltOffset[group] += delta
                    updateSlidersViewUI()
                    return
                } else {
                    fixes.forEach { fix ->
                        for (ch in 0 until fix.channels) {
                            if (fix.paramMap[ch] != paramName) continue
                            val addr = fix.dmx - 1 + ch
                            if (addr !in 0..511) continue
                            Companion.effectManagedChannels[addr] = false
                        }
                    }
                }
            }

            fixes.forEach { fix ->
                for (ch in 0 until fix.channels) {
                    if (fix.paramMap[ch] != paramName) continue
                    val addr = fix.dmx - 1 + ch
                    if (addr !in 0..511) continue
                    // Wirtualne odwrócenie – patrz komentarz w handlerze GLOBAL_.
                    val rawRange = (fix.paramMax[ch] - fix.paramMin[ch])
                    val safeRange = if (rawRange == 0) 1 else rawRange
                    val mapped = (when (m.type) {
                        Companion.MIDI_CC_ABS -> fix.paramMin[ch] + (rawValue / 127f * rawRange)
                        Companion.MIDI_CC_REL -> {
                            val delta = if (rawValue in 1..63) rawValue else if (rawValue in 65..127) rawValue - 128 else 0
                            val curPos = (((Companion.baseDmxValues[addr] - fix.paramMin[ch]).toFloat() / safeRange) * 255f).coerceIn(0f, 255f)
                            val newPos = (curPos + delta).coerceIn(0f, 255f)
                            fix.paramMin[ch] + (newPos / 255f) * rawRange
                        }
                        else -> fix.paramMin[ch] + (rawValue / 127f * rawRange)
                    }).toInt()
                    Companion.overrideChannel(addr, mapped.coerceIn(0, 255))
                }
            }
            updateSlidersViewUI()
            return
        }

        // ── Preset bank ─────────────────────────────────────────
        if (t.startsWith("PRESET_BANK_")) {
            val bank = t.substringAfterLast("_").toIntOrNull() ?: return
            activePresetBank = bank; return
        }
        if (t.startsWith("EXPRESET_")) {
            val idx = t.substringAfterLast("_").toIntOrNull() ?: return
            val prst = Companion.memoryExPresets.getOrNull(idx) ?: return
            if (rawValue > 0) {
                midiPresetHoldTimers[idx + 1000] = System.currentTimeMillis()
                return
            }
            val pressTime = midiPresetHoldTimers.remove(idx + 1000) ?: return
            val held = System.currentTimeMillis() - pressTime
            if (held >= 700L) {
                if (!prst.isSaved) prst.name = "EX ${idx+1}"
                prst.isSaved = true
                val snapDmx = Companion.baseDmxValues.clone()
                Companion.fixturesList.forEach { fix -> for(ch in 0 until fix.channels){val addr=fix.dmx-1+ch;if(addr in 0..511) prst.dmxSnapshot[addr]=snapDmx[addr]} }
                Companion.saveWorkspace(applicationContext.filesDir.absolutePath)
                runOnUiThread {
                    Toast.makeText(this, "EX saved: ${prst.name}", Toast.LENGTH_SHORT).show()
                    exPresetsRefreshCallback?.invoke()
                }
            } else {
                Companion.activeExPresets[idx] = !Companion.activeExPresets[idx]
                runOnUiThread { exPresetsRefreshCallback?.invoke() }
            }
            return
        }

        // ── Preset pad ──────────────────────────────────────────
        if (t.startsWith("PRESET_") && !t.startsWith("PRESET_BANK_")) {
            val idx = t.substringAfterLast("_").toIntOrNull() ?: return
            val prst = Companion.memoryPresets.getOrNull(idx) ?: return
            if (rawValue > 0) {
                midiPresetHoldTimers[idx] = System.currentTimeMillis()
                android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
                    if (midiPresetHoldTimers.containsKey(idx)) {
                        Toast.makeText(this, "Saved: ${prst.name}", Toast.LENGTH_SHORT).show()
                    }
                }, 700)
                return
            }
            // note off
            val pressTime = midiPresetHoldTimers.remove(idx) ?: return
            val held = System.currentTimeMillis() - pressTime
            if (held >= 700L) {
                // SAVE – zrównane 1:1 z GUI (padContainer.setOnLongClickListener)
                undoBufferIndex=idx; undoBuffer=deepCopyPreset(prst)
                if(!prst.isSaved) prst.name="PRST ${idx+1}"
                prst.isSaved=true
                val midiSnapDmx = Companion.baseDmxValues.clone()
                for(addr in 0..511) prst.dmxSnapshot[addr] = 0
                Companion.fixturesList.forEach { fix ->
                    val isMyGroup = (Companion.groupRouting[fix.groupIdx] == prst.presetTarget)
                    if (isMyGroup) for (ch in 0 until fix.channels) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) prst.dmxSnapshot[addr] = midiSnapDmx[addr]
                    }
                }
                System.arraycopy(Companion.activeExPresets,0,prst.exMask,0,64)
                prst.extColorPaletteIdx=Companion.extColorPaletteIdx; prst.extColorRouting=Companion.extColorRouting
                for (i in 0..3) {
                    if (Companion.lfoTarget[i]==prst.presetTarget) {
                        prst.lfoEnabledMask[i]=lfoEnabled[i]; val lfo=memoryLfo[i]
                        prst.lfoShapes[i]=lfo.shapeIdx;prst.lfoRates[i]=lfo.rate;prst.lfoSyncs[i]=lfo.isSync;prst.lfoSyncIdxs[i]=lfo.syncIdx;prst.lfoPwms[i]=lfo.pwm
                        for(d in 0..3){prst.lfoFix[i][d]=lfo.fix[d];prst.lfoDest[i][d]=lfo.dest[d];prst.lfoAmt[i][d]=lfo.amt[d];prst.lfoFad[i][d]=lfo.fad[d];prst.lfoOff[i][d]=lfo.off[d];prst.lfoPhs[i][d]=lfo.phs[d]}
                        for(g in 0..7){val own=Companion.groupRouting[g]==prst.presetTarget;prst.lfoMatrix[i][g]=if(own) lfoGroupActive[i][g] else false}
                    }
                    if (Companion.seqTarget[i]==prst.presetTarget) {
                        prst.seqEnabledMask[i]=seqEnabled[i]; val sq=memorySeq[i]
                        prst.seqTotalSteps[i]=sq.totalSteps;prst.seqGlobalTimes[i]=sq.globalTime;prst.seqIsSyncs[i]=sq.isSync;prst.seqSyncIdxs[i]=sq.syncIdx;prst.seqGlobalFades[i]=sq.globalFade;prst.seqGlobalPhases[i]=sq.globalPhase
                        for(s in 0..15){prst.seqStepTypes[i][s]=sq.stepType[s];prst.seqStepValues[i][s]=sq.stepValue[s];prst.seqStepTimes[i][s]=sq.stepTime[s];prst.seqStepFades[i][s]=sq.stepFade[s];prst.seqStepIsSyncs[i][s]=sq.stepIsSync[s];prst.seqStepSyncIdxs[i][s]=sq.stepSyncIdx[s]}
                        for(g in 0..7){val own=Companion.groupRouting[g]==prst.presetTarget;prst.seqMatrix[i][g]=if(own) seqGroupActive[i][g] else false}
                    }
                }
                if (prst.useFxMemory) {
                    for (fi in 0..3) {
                        val fx = Companion.memoryFx[fi]
                        prst.fxEnabled[fi]   = fx.isEnabled
                        prst.fxPlayState[fi] = fx.playState
                        prst.fxShapeIdx[fi]  = fx.shapeIdx
                        prst.fxSpeed[fi]     = fx.speed
                        prst.fxIsSync[fi]    = fx.isSync
                        prst.fxSyncIdx[fi]   = fx.syncIdx
                        prst.fxSpread[fi]    = fx.spread
                        prst.fxAmt[fi]       = fx.amt
                        prst.fxPhs[fi]       = fx.phs
                        prst.fxGroupIdx[fi]  = fx.groupIdx
                        prst.fxDestIdx[fi]   = fx.destIdx
                    }
                }
                if(prst.presetTarget==1) activeAuxPresetIndex=idx else activePresetIndex=idx
                Companion.saveWorkspace(applicationContext.filesDir.absolutePath)
                runOnUiThread {
                    presetsRefreshCallback?.invoke()
                }
            } else {
                // RECALL
                if (!prst.isSaved) return
                if (prst.presetTarget==1) activeAuxPresetIndex=idx else activePresetIndex=idx
                val fTime=prst.fadeTime/10.0f
                // KOLEJNOŚĆ KRYTYCZNA: ustaw isFadingMain/Aux PRZED nadpisaniem baseDmxValues
                // (patrz analogiczny komentarz w GUI recall presetu).
                if(prst.presetTarget==0){if(fTime>0f){Companion.currentFadeTimeMain=fTime;Companion.currentFadeTimerMain=0f;Companion.isFadingMain=true}else Companion.isFadingMain=false}
                else{if(fTime>0f){Companion.currentFadeTimeAux=fTime;Companion.currentFadeTimerAux=0f;Companion.isFadingAux=true}else Companion.isFadingAux=false}
                Companion.fixturesList.forEach{fix->val isMyGroup=(Companion.groupRouting[fix.groupIdx]==prst.presetTarget);if(isMyGroup) for(ch in 0 until fix.channels){val addr=fix.dmx-1+ch;if(addr in 0..511){if(prst.presetTarget==0) Companion.baseDmxStartMain[addr]=Companion.dmxValues[addr] else Companion.baseDmxStartAux[addr]=Companion.dmxValues[addr];Companion.baseDmxValues[addr]=prst.dmxSnapshot[addr]}}}
                Companion.updateFadeMask()
                if(prst.useExMemory) System.arraycopy(prst.exMask,0,Companion.activeExPresets,0,64)
                if (!prst.useFxMemory) {
                    for (fi in 0..3) {
                        if (Companion.groupRouting[Companion.memoryFx[fi].groupIdx] == prst.presetTarget) {
                            Companion.fxFadeTimer[fi] = Companion.fxFadeTime[fi]
                        }
                    }
                }
                if (prst.useFxMemory) {
                    val fxFadeTime = prst.fadeTime / 10.0f
                    for (fi in 0..3) {
                        val fx = Companion.memoryFx[fi]
                        // Dotykaj tylko FX których grupa należy do tego presetu
                        if (Companion.groupRouting[fx.groupIdx] != prst.presetTarget) continue
                        val willBeEnabled = prst.fxEnabled[fi]
                        Companion.fxAmtStart[fi] = if (fx.isEnabled) fx.amt else 0
                        if (willBeEnabled) {
                            Companion.fxFadeTimer[fi] = 0f
                            Companion.fxFadeTime[fi] = fxFadeTime
                        } else {
                            Companion.fxFadeTimer[fi] = fxFadeTime
                            Companion.fxFadeTime[fi] = fxFadeTime
                        }
                        fx.isEnabled = willBeEnabled
                        fx.playState = prst.fxPlayState[fi]
                        fx.shapeIdx  = prst.fxShapeIdx[fi]
                        fx.speed     = prst.fxSpeed[fi]
                        fx.isSync    = prst.fxIsSync[fi]
                        fx.syncIdx   = prst.fxSyncIdx[fi]
                        fx.spread    = prst.fxSpread[fi]
                        fx.amt       = prst.fxAmt[fi]
                        fx.phs       = prst.fxPhs[fi]
                        fx.groupIdx  = prst.fxGroupIdx[fi]
                        fx.destIdx   = prst.fxDestIdx[fi]
                    }
                }
                Companion.extColorPaletteIdx=prst.extColorPaletteIdx;Companion.extColorRouting=prst.extColorRouting
                if(Companion.extColorRouting==0){val dmx=Companion.getPaletteDmxValues(prst.extColorPaletteIdx);System.arraycopy(dmx,0,Companion.extColorDmxValues,0,6)}
                val affectedGroups=(0..7).filter{g->Companion.groupRouting[g]==prst.presetTarget}.toSet()
                for (i in 0..3) {
                    val lfo=memoryLfo[i]
                    if (Companion.lfoTarget[i]==prst.presetTarget) {
                        // Zwolnij STARE kanały LFO przed zmianą destynacji.
                        // Bez tego effectManagedChannels[addr] zostaje true dla starych
                        // kanałów (np. Tilt), refreshDmxOutput je pomija i fade nigdy
                        // nie dociera do tych kanałów — widoczne jako "duch" po LFO.
                        for (d in 0..3) {
                            val oldFix = lfo.fix[d]; val oldDest = lfo.dest[d]
                            if (oldFix == -1 || oldDest == -1) continue
                            val oldParam = Companion.paramList.getOrNull(oldDest) ?: continue
                            val oldFixes = if (oldFix in 1000..1007)
                                Companion.fixturesList.filter { it.groupIdx == oldFix - 1000 }
                            else listOfNotNull(Companion.fixturesList.find { it.id == oldFix })
                            oldFixes.forEach { fix ->
                                for (ch in 0 until fix.channels) {
                                    if (fix.paramMap[ch] == oldParam) {
                                        val addr = fix.dmx - 1 + ch
                                        if (addr in 0..511) Companion.effectManagedChannels[addr] = false
                                    }
                                }
                            }
                        }
                        lfoEnabled[i]=prst.lfoEnabledMask[i]; lfo.shapeIdx=prst.lfoShapes[i]; lfo.rate=prst.lfoRates[i]; lfo.isSync=prst.lfoSyncs[i]; lfo.syncIdx=prst.lfoSyncIdxs[i]; lfo.pwm=prst.lfoPwms[i]; for(d in 0..3){lfo.fix[d]=prst.lfoFix[i][d];lfo.dest[d]=prst.lfoDest[i][d];lfo.amt[d]=prst.lfoAmt[i][d];lfo.fad[d]=prst.lfoFad[i][d];lfo.off[d]=prst.lfoOff[i][d];lfo.phs[d]=prst.lfoPhs[i][d]}; for(d in 0..3){lfo.destSmoothed[d]=0f;for(fi in lfo.fixSmoothed[d].indices) lfo.fixSmoothed[d][fi]=0f}
                    }
                    val seqWasEnabled = seqEnabled[i]
                    if (Companion.seqTarget[i]==prst.presetTarget) {
                        val willDisable = !prst.seqEnabledMask[i]
                        if (seqWasEnabled) releaseSeqChannels(i)
                        if (willDisable) seqEnabled[i] = false
                    } else if (seqWasEnabled) {
                        seqEnabled[i] = false; releaseSeqChannels(i)
                    }
                    for (g in 0..7){
                        val wasOnSeq = seqGroupActive[i][g]
                        val newSeqVal = if (g in affectedGroups) prst.seqMatrix[i][g] else false
                        if (g in affectedGroups && Companion.groupRouting[g] == prst.presetTarget) lfoGroupActive[i][g]=prst.lfoMatrix[i][g]
                        seqGroupActive[i][g]=newSeqVal
                        if (newSeqVal) {
                            Companion.colorManualOverride[g] = false
                            Companion.posPanOffset[g] = 0f
                            Companion.posTiltOffset[g] = 0f
                            Companion.posFadeActiveSinceReset[g] = true
                        }
                        if (wasOnSeq && !newSeqVal && Companion.groupRouting[g] == prst.presetTarget) {
                            Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                                for (ch in 0 until fix.channels) {
                                    val addr = fix.dmx - 1 + ch
                                    if (addr in 0..511) {
                                        Companion.effectManagedChannels[addr] = false
                                        dmxPersist[addr] = Companion.baseDmxValues[addr].toFloat()
                                    }
                                }
                            }
                        }
                    }
                    if (Companion.seqTarget[i]==prst.presetTarget) {
                        seqEnabled[i]=prst.seqEnabledMask[i]
                        val sq=memorySeq[i]
                        sq.totalSteps=prst.seqTotalSteps[i];sq.globalTime=prst.seqGlobalTimes[i];sq.isSync=prst.seqIsSyncs[i];sq.syncIdx=prst.seqSyncIdxs[i];sq.globalFade=prst.seqGlobalFades[i];sq.globalPhase=prst.seqGlobalPhases[i]
                        for(s in 0..15){sq.stepType[s]=prst.seqStepTypes[i][s];sq.stepValue[s]=prst.seqStepValues[i][s];sq.stepTime[s]=prst.seqStepTimes[i][s];sq.stepFade[s]=prst.seqStepFades[i][s];sq.stepIsSync[s]=prst.seqStepIsSyncs[i][s];sq.stepSyncIdx[s]=prst.seqStepSyncIdxs[i][s]}
                        sq.currentStep=0; sq.prevStep=0; sq.stepTimer=0f; sq.justReset=true
                    }
                    // Resync dla slotów w trybie SYNC – identycznie jak w GUI recall.
                    if (Companion.lfoTarget[i]==prst.presetTarget && lfo.isSync) {
                        Companion.lfoBeatAccum[i] = 0.0
                        lfo.phase = 0f
                    }
                    if (Companion.seqTarget[i]==prst.presetTarget && memorySeq[i].isSync) {
                        Companion.seqBeatAccum[i] = 0.0
                    }
                    if (Companion.seqTarget[i]==prst.presetTarget) {
                        Companion.seqPingPongPos[i] = 0L
                        Companion.seqPingPongDirection[i] = 1
                    }
                }
                // Przywróć patterny i tryby SEQ dla grup tego presetu
                val affectedGroupsFinal = (0..7).filter { g -> Companion.groupRouting[g] == prst.presetTarget }
                for (g in affectedGroupsFinal) {
                    Companion.seqRoutingMode[g] = prst.seqRoutingModes[g]
                    val patIdx = prst.seqActivePatterns[g]
                    if (patIdx in 0..5) {
                        val pat = Companion.seqPatternMemories[g][patIdx]
                        if (pat.isSaved) {
                            Companion.seqRoutingOrder[g].clear()
                            Companion.seqRoutingOrder[g].addAll(pat.order)
                            Companion.seqRoutingOn[g].clear()
                            Companion.seqRoutingOn[g].addAll(pat.onList)
                            Companion.seqActivePattern[g] = patIdx
                        }
                    } else {
                        Companion.seqActivePattern[g] = -1
                    }
                    Companion.posPanOffset[g] = 0f
                    Companion.posTiltOffset[g] = 0f
                    Companion.fixturesList.filter { it.groupIdx == g }.forEach { fix ->
                        for (ch in 0 until fix.channels) {
                            val p = fix.paramMap[ch]
                            if (p == "Pan" || p == "Pan Fine" || p == "Tilt" || p == "Tilt Fine") {
                                val addr = fix.dmx - 1 + ch
                                if (addr in 0..511) Companion.posSmoothedValues[addr] = -1f
                            }
                        }
                    }
                }
                runOnUiThread {
                    presetsRefreshCallback?.invoke()
                    Companion.goboViewRefreshCallback?.invoke()
                }
            }
            return
        }

        if (t.startsWith("PRESET_SAVE_")) {
            val idx = t.substringAfterLast("_").toIntOrNull() ?: return
            val prst = Companion.memoryPresets.getOrNull(idx) ?: return
            if (rawValue > 0) {

                return
            }
            if (!prst.isSaved) prst.name = "PRST ${idx+1}"
            prst.isSaved = true
            val snapDmx = Companion.baseDmxValues.clone()
            Companion.fixturesList.forEach { fix -> val isMyGroup=(Companion.groupRouting[fix.groupIdx]==prst.presetTarget); for(ch in 0 until fix.channels){val addr=fix.dmx-1+ch;if(addr in 0..511) prst.dmxSnapshot[addr]=if(isMyGroup) snapDmx[addr] else 0} }
            System.arraycopy(Companion.activeExPresets,0,prst.exMask,0,64)
            Companion.extColorPaletteIdx.also { prst.extColorPaletteIdx = it }
            Companion.extColorRouting.also { prst.extColorRouting = it }
            if (prst.presetTarget==1) activeAuxPresetIndex=idx else activePresetIndex=idx
            Companion.saveWorkspace(applicationContext.filesDir.absolutePath)
            runOnUiThread { presetsRefreshCallback?.invoke() }
            return
        }

        // ── FX ──────────────────────────────────────────────────
        if (t.startsWith("FX_")) {
            val parts = t.split("_")
            val fi = parts.getOrNull(1)?.toIntOrNull() ?: return
            val fx = Companion.memoryFx.getOrNull(fi) ?: return
            when (parts.getOrNull(2)) {
                "ENABLE" -> { if (rawValue > 0) fx.isEnabled = !fx.isEnabled }
                "PLAY"   -> { if (rawValue > 0) fx.playState = (fx.playState + 1) % 3 }
                "SPD"    -> fx.speed = when (m.type) {
                    Companion.MIDI_CC_ABS -> rawValue / 127f * 5f
                    Companion.MIDI_CC_REL -> (fx.speed + (rawValue-64)*0.02f*m.relSens).coerceIn(0f,5f)
                    else -> fx.speed
                }.also { Companion.fxBaseSpeeds[fi] = it }
                "AMT"    -> fx.amt = when (m.type) {
                    Companion.MIDI_CC_ABS -> ((rawValue/127f)*510-255).toInt()
                    Companion.MIDI_CC_REL -> (fx.amt + (rawValue-64)*m.relSens).toInt().coerceIn(-255,255)
                    else -> fx.amt
                }.also { Companion.fxBaseAmts[fi] = it }
                "PHS"    -> fx.phs = when (m.type) {
                    Companion.MIDI_CC_ABS -> ((rawValue/127f)*360).toInt()
                    Companion.MIDI_CC_REL -> ((fx.phs + (rawValue-64)*m.relSens) % 360 + 360).toInt() % 360
                    else -> fx.phs
                }.also { Companion.fxBasePhss[fi] = it }
            }
            // odśwież UI FX
            val spd = if (fx.speed < 0.01f) "STATIC" else "${String.format("%.2f", fx.speed)}Hz"
            fxLiveTvs[fi*10+1]?.text = spd
            fxLiveTvs[fi*10+2]?.text = "${fx.spread}"
            fxLiveTvs[fi*10+3]?.text = "${fx.amt}"
            fxLiveTvs[fi*10+4]?.text = "${fx.phs}"
            return
        }

        // ── SEQ ─────────────────────────────────────────────────
        if (t.startsWith("SEQ_")) {
            val si = t.split("_").getOrNull(1)?.toIntOrNull() ?: return
            if (rawValue > 0) seqEnabled[si] = !seqEnabled[si]; return
        }

        // ── LFO ─────────────────────────────────────────────────
        if (t.startsWith("LFO_") && t.endsWith("_ENABLE")) {
            val li = t.split("_").getOrNull(1)?.toIntOrNull() ?: return
            if (rawValue > 0) {
                lfoEnabled[li] = !lfoEnabled[li]
                midiRootFrame.findViewWithTag<View>("MIDI:LFO_${li}_ENABLE")
                    ?.let { (it.background as? GradientDrawable)?.setColor(if (lfoEnabled[li]) lfoColors[li] else Companion.COL_TEXT_DIM) }
            }
            return
        }

        // ── Wybór grupy ─────────────────────────────────────────
        if (t.startsWith("GROUP_SELECT_")) {
            val g = t.substringAfterLast("_").toIntOrNull() ?: return
            if (rawValue > 0) {
                currentGroup = g
                colorSelectedGroup = g
                posCurrentGroup = g
                midiCcLastValues.keys.filter { it.contains("GLOBAL_") }.toList()
                    .forEach { midiCcLastValues.remove(it) }
                midiPickupTargets.keys.filter { it.contains("GLOBAL_") }.toList()
                    .forEach { midiPickupTargets.remove(it) }
                midiPickedUp.removeAll { it.contains("GLOBAL_") }
                runOnUiThread {

                    midiRootFrame.findViewWithTag<View>("MIDI:GROUP_SELECT_$g")?.performClick()
                }
            }
            return
        }

        // ── PAN / TILT enkodery ─────────────────────────────────
        if (t.startsWith("PAN_") || t.startsWith("TILT_")) {
            val param = if (t.startsWith("PAN_")) "Pan" else "Tilt"
            val group = t.substringAfterLast("_").toIntOrNull() ?: return
            // REL: 1-63 = ruch w górę (+1 per klik * relSens), 65-127 = ruch w dół (-1 per klik * relSens)
            // ABS: rawValue 0-127 → delta proporcjonalna (używana dla seqPosOffset)
            val seqPosActive = (0..3).any { si -> seqEnabled[si] && seqGroupActive[si][group] && memorySeq[si].stepType[memorySeq[si].currentStep] == 3 }

            if (m.type == Companion.MIDI_CC_ABS) {
                // ABS: mapuj rawValue 0-127 bezpośrednio na zakres parametru fixture
                Companion.fixturesList.filter { it.groupIdx == group }.forEach { fix ->
                    for (ch in 0 until fix.channels) if (fix.paramMap[ch] == param) {
                        val addr = fix.dmx - 1 + ch
                        if (addr in 0..511) {
                            Companion.effectManagedChannels[addr] = false
                            val rawRange = fix.paramMax[ch] - fix.paramMin[ch]
                            val newVal = (fix.paramMin[ch] + rawValue / 127f * rawRange).toInt().coerceIn(0, 255)
                            if (seqPosActive) {
                                val curOutput = Companion.dmxValues[addr]
                                val delta = (newVal - curOutput).toFloat()
                                if (param == "Pan") Companion.posPanOffset[group] += delta
                                else Companion.posTiltOffset[group] += delta
                            } else {
                                Companion.overrideChannel(addr, newVal)
                            }
                        }
                    }
                }
                runOnUiThread { updateSlidersViewUI() }
                return
            }

            // REL: ±1 krok per klik enkodera, ograniczony do zakresu parametru
            val dir = if (rawValue in 1..63) 1 else if (rawValue in 65..127) -1 else 0
            val delta = if (dir == 0) 0
            else maxOf(1, (m.relSens).toInt()) * dir

            if (seqPosActive) {
                if (param == "Pan") Companion.posPanOffset[group] += delta.toFloat()
                else Companion.posTiltOffset[group] += delta.toFloat()
                runOnUiThread { updateSlidersViewUI() }
                return
            }
            Companion.fixturesList.filter { it.groupIdx == group }.forEach { fix ->
                for (ch in 0 until fix.channels) if (fix.paramMap[ch] == param) {
                    val addr = fix.dmx - 1 + ch
                    if (addr in 0..511) {
                        Companion.effectManagedChannels[addr] = false
                        // REL: zawsze ±1 na DMX, ale ograniczone do zakresu fixture.
                        // Używamy znormalizowanego lo/hi żeby uniknąć skoku gdy
                        // baseDmxValues jest poza zakresem (np. po zmianie Min/Max
                        // w trakcie sesji) – coerceIn(lo,hi) bezpiecznie ogranicza
                        // bez skoku: wartość poza zakresem → granica, potem ±1.
                        val lo = minOf(fix.paramMin[ch], fix.paramMax[ch])
                        val hi = maxOf(fix.paramMin[ch], fix.paramMax[ch])
                        val newVal = (Companion.baseDmxValues[addr] + delta).coerceIn(lo, hi)
                        Companion.overrideChannel(addr, newVal)
                    }
                }
            }
            runOnUiThread { updateSlidersViewUI() }
            return
        }

        // ── Performance / systemowe ─────────────────────────────
        if (t.startsWith("PERF_")) {
            val i = t.substringAfterLast("_").toIntOrNull() ?: return
            val ps = Companion.perfSettings.getOrNull(i)
            val perfColorsLocal = listOf(
                Color.parseColor("#888888"), Color.parseColor("#6666CC"),
                Color.parseColor("#CC6600"), Color.parseColor("#CC2222"),
                Color.parseColor("#2222CC"), Color.parseColor("#883300"),
                Companion.COL_BTN_DARK, Color.parseColor("#0088CC")
            )
            if (ps == null) { if (rawValue > 0) pressButton(4 + i); return }

            val isPress = rawValue > 0
            val isRelease = rawValue == 0

            if (isPress) {
                val willBeActive = if (ps.isToggleMode) !ps.isActive else true
                ps.isActive = willBeActive
                runOnUiThread {
                    val btnColor = if (ps.isActive) {
                        if (i == 2) Companion.corePaletteColors[ps.value.coerceIn(0, 63)]
                        else perfColorsLocal[i]
                    } else if (i == 5) Color.parseColor("#883300") else Companion.COL_DARK
                    perfBtnRefs[i]?.backgroundTintList = android.content.res.ColorStateList.valueOf(btnColor)
                }
                // Identyczna logika jak GUI (setupPerfButtonsGlobal) – triggerPerfOn obsługuje
                // FAST/SLOW (ustawia perfTempoMultiplier), STOP (silnik sam liczy perfGroupTempoMult=0
                // na podstawie ps.isActive, bez ręcznego dotykania seqGroupActive – to eliminuje duszki
                // i gwarantuje wznowienie z dokładnie tego samego miejsca), oraz snapshot dla Blinder/Color/Blackout.
                triggerPerfOn(i)
            }
            if (isRelease && !ps.isToggleMode) {
                ps.isActive = false
                runOnUiThread {
                    perfBtnRefs[i]?.backgroundTintList = android.content.res.ColorStateList.valueOf(
                        if (i==5) Color.parseColor("#883300") else Companion.COL_DARK)
                }
                triggerPerfOff(i)
            }
            return
        }
        // ── Makra ───────────────────────────────────────────
        if (t.startsWith("MACRO_")) {
            val macroIdx = t.substringAfter("MACRO_").toIntOrNull() ?: return
            if (rawValue > 0) runOnUiThread {
                Toast.makeText(this, "Macro $macroIdx (placeholder)", Toast.LENGTH_SHORT).show()
                // TODO: podpiąć logikę makr gdy zostanie zaimplementowana
            }
            return
        }

        // ── Systemowe ────────────────────────────────────────
        if (t == "SYSTEM_PLUS") {
            if (rawValue > 0 || m.type == Companion.MIDI_CC_ABS) runOnUiThread {
                val sb = activeDataSlider ?: return@runOnUiThread
                val nv = when (m.type) {
                    Companion.MIDI_CC_ABS -> (rawValue / 127f * sb.max).toInt().coerceIn(0, sb.max)
                    else -> (sb.progress + 1).coerceAtMost(sb.max)
                }
                sb.progress = nv
                activeDataSliderCallback?.invoke(nv)
            }
            return
        }
        if (t == "SYSTEM_MINUS") {
            if (rawValue > 0) runOnUiThread {
                val sb = activeDataSlider ?: return@runOnUiThread
                val nv = (sb.progress - 1).coerceAtLeast(0)
                sb.progress = nv
                activeDataSliderCallback?.invoke(nv)
            }
            return
        }
        if (t == "SYSTEM_DATA_ENTRY") {
            runOnUiThread {
                val sb = activeDataSlider ?: return@runOnUiThread
                val nv = when (m.type) {
                    Companion.MIDI_CC_ABS -> (rawValue / 127f * sb.max).toInt().coerceIn(0, sb.max)
                    Companion.MIDI_CC_REL -> {
                        val delta = if (rawValue in 1..63) 1 else if (rawValue in 65..127) -1 else 0
                        (sb.progress + delta).coerceIn(0, sb.max)
                    }
                    else -> return@runOnUiThread
                }
                sb.progress = nv
                activeDataSliderCallback?.invoke(nv)
            }
            return
        }
        if (t == "SYSTEM_OK") {
            if (rawValue > 0) runOnUiThread {
                // OK = potwierdź aktywny overlay (numpad/klawiatura), lub ignoruj gdy żaden nieaktywny
                when {
                    numpadOverlay.visibility == View.VISIBLE -> {
                        val result = numpadDisplay.text.toString()
                        numpadOverlay.visibility = View.GONE
                        activeDataSlider = null; activeDataSliderCallback = null
                        onNumpadResult?.invoke(result)
                    }
                    keyboardOverlay.visibility == View.VISIBLE -> {
                        keyboardOverlay.visibility = View.GONE
                        onKeyboardResult?.invoke(keyboardDisplay.text.toString())
                    }
                }
            }
            return
        }
        if (t == "SYSTEM_ESCAPE") {
            if (rawValue > 0) runOnUiThread {
                when {
                    // Zamknij aktywny overlay
                    midiLearnOverlay?.visibility == View.VISIBLE -> hideMidiLearnOverlay()
                    numpadOverlay.visibility == View.VISIBLE -> {
                        numpadOverlay.visibility = View.GONE
                        activeDataSlider = null; activeDataSliderCallback = null
                    }
                    keyboardOverlay.visibility == View.VISIBLE -> {
                        keyboardOverlay.visibility = View.GONE
                    }
                    paramMenuOverlay.visibility == View.VISIBLE -> {
                        paramMenuOverlay.visibility = View.GONE
                    }
                    paletteMenuOverlay.visibility == View.VISIBLE -> {
                        paletteMenuOverlay.visibility = View.GONE
                    }
                    // Brak aktywnego overlay – wróć do widoku Colors (główny widok)
                    else -> {
                        setActiveTab(tabButtons.firstOrNull(), false)
                        activeViewContainer.removeAllViews()
                        activeViewContainer.addView(createColorView())
                    }
                }
            }
            return
        }
        if (t == "SYSTEM_SOLO") {
            if (rawValue > 0) runOnUiThread {
                posEditMode = !posEditMode
                sliderSoloBtn?.text = if (posEditMode) "SOLO\nON" else "SOLO"
                sliderSoloBtn?.setTextColor(if (posEditMode) Color.BLACK else Color.WHITE)
                sliderSoloBtn?.setBackgroundColor(if (posEditMode) Color.YELLOW else Color.parseColor("#664400"))
            }
            return
        }

        if (t == "TAP_TEMPO") {
            if (rawValue > 0) {
                val held = System.currentTimeMillis()
                // Krótkie naciśnięcie = tap; długie (>1s, sprawdzane przy note-off) = resync.
                // Najprościej: traktujemy każdy "press" jak tap (jak fizyczny przycisk dotykowy),
                // a resync uruchamiamy z note-off jeśli trzymano długo.
                midiPresetHoldTimers[9999] = held
                runOnUiThread { handleTapTempo() }
            } else {
                val pressTime = midiPresetHoldTimers.remove(9999) ?: return
                val heldMs = System.currentTimeMillis() - pressTime
                if (heldMs >= 1000L) runOnUiThread { resyncAllSynced() }
            }
            return
        }
        when (t) {
            "BLACK"     -> { if (rawValue > 0) pressButton(0) }
            "STOP_SEQ"     -> {
                if (rawValue > 0) {
                    stopSeqActive = !stopSeqActive
                    if (stopSeqActive) {
                        for (si in 0..3) { stopSeqEnabled[si]=seqEnabled[si]; seqEnabled[si]=false }
                        for (li in 0..3) { stopLfoEnabled[li]=lfoEnabled[li]; lfoEnabled[li]=false }
                    } else {
                        for (si in 0..3) seqEnabled[si] = stopSeqEnabled[si]
                        for (li in 0..3) lfoEnabled[li] = stopLfoEnabled[li]
                    }
                }
            }
            "FIXTURE_NEXT" -> { if (rawValue > 0 && currentFixture < Companion.fixturesList.filter{it.groupIdx==currentGroup}.size) { currentFixture++; updateSlidersHeaderUI() } }
            "FIXTURE_PREV" -> { if (rawValue > 0 && currentFixture > 1) { currentFixture--; updateSlidersHeaderUI() } }
        }
    }

