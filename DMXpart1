        fun saveProfilesToDisk(dir: String) {
            try {
                val jsonArray = JSONArray()
                for (p in savedProfiles) {
                    val obj = JSONObject()
                    obj.put("name", p.name); obj.put("channels", p.channels)
                    val pMap = JSONArray(); for (s in p.paramMap) pMap.put(s); obj.put("paramMap", pMap)
                    val pMin = JSONArray(); for (m in p.paramMin) pMin.put(m); obj.put("paramMin", pMin)
                    val pMax = JSONArray(); for (m in p.paramMax) pMax.put(m); obj.put("paramMax", pMax)
                    obj.put("cwCount", p.cwCount)
                    val pCwDmx = JSONArray(); for (m in p.cwDmx) pCwDmx.put(m); obj.put("cwDmx", pCwDmx)
                    val pCwHDmx = JSONArray(); for (m in p.cwHalfDmx) pCwHDmx.put(m); obj.put("cwHalfDmx", pCwHDmx)
                    val pCwC = JSONArray(); for (m in p.cwColors) pCwC.put(m); obj.put("cwColors", pCwC)
                    obj.put("gbCount", p.gbCount)
                    val pGbD = JSONArray(); for (m in p.gbDmx) pGbD.put(m); obj.put("gbDmx", pGbD)
                    val pGbS = JSONArray(); for (m in p.gbShapes) pGbS.put(m); obj.put("gbShapes", pGbS)
                    jsonArray.put(obj)
                }
                File(dir, "profiles.json").writeText(jsonArray.toString())
            } catch (e: Exception) { e.printStackTrace() }
        }

        fun loadProfilesFromDisk(dir: String) {
            try {
                val file = File(dir, "profiles.json")
                if (!file.exists()) return
                val jsonStr = file.readText()
                val jsonArray = JSONArray(jsonStr)
                // Wczytaj wszystkie, potem deduplikuj – zostaw ostatnie wystąpienie każdej nazwy
                val tempProfiles = mutableListOf<FixtureProfile>()

                for (i in 0 until jsonArray.length()) {
                    val obj = jsonArray.getJSONObject(i)
                    val name = obj.getString("name")
                    val channels = obj.getInt("channels")

                    val pMapArr = obj.getJSONArray("paramMap")
                    val paramMap = Array(512) { "" }
                    for (j in 0 until pMapArr.length()) paramMap[j] = pMapArr.getString(j)

                    val pMinArr = obj.getJSONArray("paramMin")
                    val paramMin = IntArray(512) { 0 }
                    for (j in 0 until pMinArr.length()) paramMin[j] = pMinArr.getInt(j)

                    val pMaxArr = obj.getJSONArray("paramMax")
                    val paramMax = IntArray(512) { 255 }
                    for (j in 0 until pMaxArr.length()) paramMax[j] = pMaxArr.getInt(j)

                    val cwCount = if (obj.has("cwCount")) obj.getInt("cwCount") else 1

                    val cwDmx = IntArray(32){0}
                    if (obj.has("cwDmx")) { val arr = obj.getJSONArray("cwDmx"); for (j in 0 until arr.length()) cwDmx[j] = arr.getInt(j) }

                    val cwHDmx = IntArray(32){0}
                    if (obj.has("cwHalfDmx")) { val arr = obj.getJSONArray("cwHalfDmx"); for (j in 0 until arr.length()) cwHDmx[j] = arr.getInt(j) }

                    val cwC = IntArray(32){0}
                    if (obj.has("cwColors")) { val arr = obj.getJSONArray("cwColors"); for (j in 0 until arr.length()) cwC[j] = arr.getInt(j) }
                    val gbCount = if (obj.has("gbCount")) obj.getInt("gbCount") else 1
                    val gbDmx = IntArray(32){0}; if (obj.has("gbDmx")) { val a=obj.getJSONArray("gbDmx"); for (j in 0 until a.length()) gbDmx[j]=a.getInt(j) }
                    val gbSh = IntArray(32){0}; if (obj.has("gbShapes")) { val a=obj.getJSONArray("gbShapes"); for (j in 0 until a.length()) gbSh[j]=a.getInt(j) }
                    tempProfiles.add(FixtureProfile(name, channels, paramMap, paramMin, paramMax, cwCount, cwDmx, cwHDmx, cwC, gbCount, gbDmx, gbSh))
                }
                // Deduplikuj – zostaw ostatnie wystąpienie każdej nazwy
                val seen = mutableSetOf<String>()
                for (p in tempProfiles.reversed()) {
                    if (seen.add(p.name)) savedProfiles.add(0, p)
                }
                // Zapisz od razu żeby oczyścić plik z duplikatów
                saveProfilesToDisk(dir)
            } catch (e: Exception) { e.printStackTrace() }
        }

