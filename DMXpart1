                // AMT, FAD, OFF, PHS
                for (j2 in 0..3) {
                    val valIdx = i * 4 + j2
                    val tv = TextView(this@MainActivity).apply {
                        text = numArrs[j2][i].toString()
                        gravity = Gravity.CENTER; textSize = 14f; setTextColor(Color.WHITE)
                        background = if (activeLfoSlot == valIdx) activeBtn() else darkBtn()
                        cw(1.5f)
                        setOnClickListener { activeLfoSlot = valIdx; rebuild() }
