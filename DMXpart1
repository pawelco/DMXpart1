                val w = v.width.toFloat(); val h = v.height.toFloat()
                if (w > 0 && h > 0) {
                    val rawPv = (event.x / w * 255f).toInt().coerceIn(0, 255)
                    val rawTv = (event.y / h * 255f).toInt().coerceIn(0, 255)
