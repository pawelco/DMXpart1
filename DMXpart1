        }

        fun sliderMaxFor(slot: Int): Int = when {
            slot == 100 && lfo.isSync -> 12
            slot == 100 -> 160
            slot == 101 -> 100
            else -> when (slot % 4) { 0 -> 510; 1 -> 99; 2 -> 510; 3 -> 200; else -> 255 }
        }

        fun sliderProgressFor(slot: Int): Int = when {
            slot == 100 && lfo.isSync -> lfo.syncIdx
            slot == 100 -> (lfo.rate / 0.125f).toInt().coerceIn(0, 160)
            slot == 101 -> lfo.pwm
            else -> {
                val i = slot / 4; val j2 = slot % 4
                when (j2) { 0 -> lfo.amt[i] + 255; 1 -> lfo.fad[i]; 2 -> lfo.off[i] + 255; 3 -> lfo.phs[i] + 100; else -> 0 }
            }
        }

