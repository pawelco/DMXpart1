                layoutParams = LinearLayout.LayoutParams(0,-1,3.0f).apply{setMargins(m,m,m,m)}
                background = darkBtn()
            }
            val wv = makeWaveView(fi)
            wv.layoutParams = FrameLayout.LayoutParams(-1,-1)
            wvContainer.addView(wv)
            wvContainer.tag = "MIDI:FX_${fi}_SHAPE"
            wvContainer.setOnClickListener { fx.shapeIdx = (fx.shapeIdx + 1) % 3; wv.invalidate() }
            r1.addView(wvContainer)

            val spdLbl = TextView(this).apply {
                text = if (fx.isSync) "SYNC" else "SPD"
                gravity = Gravity.CENTER; textSize = 12f
                setTextColor(if (fx.isSync) Color.parseColor("#00AA44") else Companion.COL_PANEL)
                typeface = android.graphics.Typeface.DEFAULT_BOLD
                layoutParams = LinearLayout.LayoutParams(0,-1,2f).apply{setMargins(m,m,m,m)}
                setOnClickListener {
                    fx.isSync = !fx.isSync
                    text = if (fx.isSync) "SYNC" else "SPD"
                    setTextColor(if (fx.isSync) Color.parseColor("#00AA44") else Companion.COL_PANEL)
                    // Odśwież wartość w polu SPD poniżej
                    liveTvs[fi*10+1]?.text = if (fx.isSync)
                        syncNames.getOrElse(fx.syncIdx){"1"}
                    else
                        fmtSpd(fx)
                }
            }
            r1.addView(spdLbl)
            listOf("SPREAD" to 2f, "AMT" to 2f, "PHS" to 2f).forEach { (lbl, w) ->
                r1.addView(TextView(this).apply {
                    text = lbl; gravity = Gravity.CENTER; textSize = 12f
                    setTextColor(Companion.COL_PANEL)
                    typeface = android.graphics.Typeface.DEFAULT_BOLD
                    layoutParams = LinearLayout.LayoutParams(0,-1,w).apply{setMargins(m,m,m,m)}
                })
            }
            r1.addView(TextView(this).apply {
                text = fmtGrp(fx); gravity = Gravity.CENTER; textSize = 14f
                setTextColor(rowColor); typeface = android.graphics.Typeface.DEFAULT_BOLD
                background = darkBtn()
                layoutParams = LinearLayout.LayoutParams(0,-1,3.5f).apply{setMargins(m,m,m,m)}
                setOnClickListener {
                    showInternalParamMenu((0..7).map { "Group ${'A'+it}" }) { sel ->
                        fx.groupIdx = sel.last()-'A'; text = fmtGrp(fx)
                    }
                }
            })
            leftPanel.addView(r1)

            // ── ROW 2: enable(1.5) play(1.5) SPD(2) SPREAD(2) AMT(2) PHS(2) PARAM(3.5) ws=14.5 ──
            val r2 = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL; weightSum = 14.5f
                layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
            }

            // Enable ON/OFF
            val enableBg = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                setColor(if (fx.isEnabled) rowColor else Companion.COL_TEXT_DIM)
            }
            r2.addView(TextView(this).apply {
                text = if (fx.isEnabled) "ON" else "OFF"
                gravity = Gravity.CENTER; textSize = 14f
                setTextColor(if (fx.isEnabled) Color.BLACK else Color.WHITE)
                background = enableBg
                tag = "MIDI:FX_${fi}_ENABLE"
                layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
                setOnClickListener {
                    fx.isEnabled = !fx.isEnabled
                    text = if (fx.isEnabled) "ON" else "OFF"
                    setTextColor(if (fx.isEnabled) Color.BLACK else Color.WHITE)
                    enableBg.setColor(if (fx.isEnabled) rowColor else Companion.COL_TEXT_DIM)
                }
            })

            // Play/Pause – 3 stany cyklicznie: 0=⏸ → 1=▶ → 2=◀ → 0=⏸
            val playBg = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE; cornerRadius = 4f
                setColor(playBgColor(fx.playState))
            }
            val playPauseBtn = FrameLayout(this).apply {
                background = playBg
                layoutParams = LinearLayout.LayoutParams(0,-1,1.5f).apply{setMargins(m,m,m,m)}
            }
            // ▶ forward
            val playFwdTv = TextView(this@MainActivity).apply {
                text = "▶"; gravity = Gravity.CENTER; textSize = 26f; setTextColor(Color.WHITE)
                layoutParams = FrameLayout.LayoutParams(-1,-1)
                visibility = if (fx.playState == 1) View.VISIBLE else View.GONE
            }
            // ◀ backward
            val playBwdTv = TextView(this@MainActivity).apply {
                text = "◀"; gravity = Gravity.CENTER; textSize = 26f; setTextColor(Color.WHITE)
                layoutParams = FrameLayout.LayoutParams(-1,-1)
                visibility = if (fx.playState == 2) View.VISIBLE else View.GONE
            }
            // ⏸ pause (2 prostokąty)
            val pauseView = LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.HORIZONTAL; gravity = Gravity.CENTER; weightSum = 3f
                layoutParams = FrameLayout.LayoutParams(-1,-1)
                visibility = if (fx.playState == 0) View.VISIBLE else View.GONE
                addView(android.view.View(this@MainActivity).apply {
                    setBackgroundColor(Color.WHITE)
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(12,16,5,16)}
                })
                addView(android.view.View(this@MainActivity).apply {
                    setBackgroundColor(Color.WHITE)
                    layoutParams = LinearLayout.LayoutParams(0,-1,1f).apply{setMargins(5,16,12,16)}
                })
            }
            playPauseBtn.addView(playFwdTv); playPauseBtn.addView(playBwdTv); playPauseBtn.addView(pauseView)
            playPauseBtn.tag = "MIDI:FX_${fi}_PLAY"
            playPauseBtn.setOnClickListener {
                fx.playState = (fx.playState + 1) % 3
                playBg.setColor(playBgColor(fx.playState))
                playFwdTv.visibility = if (fx.playState == 1) View.VISIBLE else View.GONE
                playBwdTv.visibility = if (fx.playState == 2) View.VISIBLE else View.GONE
                pauseView.visibility  = if (fx.playState == 0) View.VISIBLE else View.GONE
            }
            r2.addView(playPauseBtn)

            // Wartości SPD / SPREAD / AMT / PHS
            listOf(
                Triple(fi*10+1, if (fx.isSync) syncNames.getOrElse(fx.syncIdx){"1"} else fmtSpd(fx), 2f),
                Triple(fi*10+2, fmtSpread(fx), 2f),
                Triple(fi*10+3, fmtAmt(fx),    2f),
                Triple(fi*10+4, fmtPhs(fx),    2f)
            ).forEach { (slot, initTxt, w) ->
                r2.addView(TextView(this).apply {
                    text = initTxt; gravity = Gravity.CENTER; textSize = 14f; setTextColor(Color.WHITE)
                    background = if (activeFxSlot == slot) activeBtn() else darkBtn()
                    tag = when(slot % 10) { 1->"MIDI:FX_${fi}_SPD"; 2->"MIDI:FX_${fi}_SPREAD"; 3->"MIDI:FX_${fi}_AMT"; 4->"MIDI:FX_${fi}_PHS"; else->null }
                    layoutParams = LinearLayout.LayoutParams(0,-1,w).apply{setMargins(m,m,m,m)}
                    liveTvs[slot] = this
                    setOnClickListener {
                        activeFxSlot = slot
                        liveTvs.forEach { (k, v) ->
                            if (k % 10 in 1..4)
                                (v.background as? GradientDrawable)?.setColor(
                                    if (k == slot) Color.parseColor("#0055AA") else Companion.COL_SEP
                                )
                        }
                        if (slot % 10 == 1 && Companion.memoryFx[slot/10].isSync) {
                            // SYNC: suwak wskazuje indeks w syncNames (0..last)
                            sliderRef?.max      = syncNames.size - 1
                            sliderRef?.progress = Companion.memoryFx[slot/10].syncIdx.coerceIn(0, syncNames.size - 1)
                        } else {
                            sliderRef?.max      = sliderMaxFor(slot)
                            sliderRef?.progress = sliderProgressFor(slot)
                        }
                        activeDataSlider = sliderRef
                        activeDataSliderCallback = { p ->
                            val fxS = Companion.memoryFx[activeFxSlot / 10]
                            if (activeFxSlot % 10 == 1 && fxS.isSync) {
                                fxS.syncIdx = p.coerceIn(0, syncNames.size - 1)
                                liveTvs[activeFxSlot]?.text = syncNames[fxS.syncIdx]
                            } else {
                                applySliderValue(activeFxSlot, p)
                                val fi2 = activeFxSlot / 10
                                liveTvs[activeFxSlot]?.text = when (activeFxSlot % 10) {
                                    1 -> fmtSpd(Companion.memoryFx[fi2])
                                    2 -> fmtSpread(Companion.memoryFx[fi2])
                                    3 -> fmtAmt(Companion.memoryFx[fi2])
                                    4 -> fmtPhs(Companion.memoryFx[fi2])
                                    else -> ""
                                }
                            }
                        }
                    }
                })
            }

            // PARAM button
            r2.addView(TextView(this).apply {
                text = fmtParam(fx); gravity = Gravity.CENTER; textSize = 14f; setTextColor(Color.WHITE)
                background = darkBtn()
                layoutParams = LinearLayout.LayoutParams(0,-1,3.5f).apply{setMargins(m,m,m,m)}
                liveTvs[fi*10+11] = this
                setOnClickListener {
                    val avail = mutableListOf("---")
                    Companion.fixturesList
                        .firstOrNull { it.groupIdx == fx.groupIdx }
                        ?.paramMap?.filter { it.isNotEmpty() && it != "Clear" }
                        ?.distinct()?.let { avail.addAll(it) }
                    showInternalParamMenu(avail) { sel ->
                        fx.destIdx = if (sel == "---") -1 else Companion.paramList.indexOf(sel)
                        text = fmtParam(fx)
                    }
                }
            })
            leftPanel.addView(r2)
        }
        rootContainer.addView(leftPanel)

        // ── PRAWY PANEL: data slider ────────────────────────────────────
        val rightOuter = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = LinearLayout.LayoutParams(j * 2, -1).apply { setMargins(m*2,0,0,0) }
            setBackgroundColor(Companion.COL_BG)
        }
        rightOuter.addView(TextView(this).apply {
            text = "SET VAL"; gravity = Gravity.CENTER; setTextColor(Color.BLACK)
            layoutParams = LinearLayout.LayoutParams(-1, j)
        })
        val (fxSliderWidget, fxSeekBar) = createDataSlider(255, 0) { p ->
            if (activeFxSlot < 0) return@createDataSlider
            val fi = activeFxSlot / 10; val fx = Companion.memoryFx[fi]
            if (activeFxSlot % 10 == 1 && fx.isSync) {
                fx.syncIdx = p.coerceIn(0, syncNames.size - 1)
                liveTvs[activeFxSlot]?.text = syncNames[fx.syncIdx]
            } else {
                applySliderValue(activeFxSlot, p)
                liveTvs[activeFxSlot]?.text = when (activeFxSlot % 10) {
                    1 -> fmtSpd(fx); 2 -> fmtSpread(fx); 3 -> fmtAmt(fx); 4 -> fmtPhs(fx); else -> ""
                }
            }
        }
        sliderRef = fxSeekBar
        activeDataSlider = fxSeekBar
        activeDataSliderCallback = { p ->
            if (activeFxSlot >= 0) {
                val fi = activeFxSlot / 10; val fx = Companion.memoryFx[fi]
                if (activeFxSlot % 10 == 1 && fx.isSync) {
                    fx.syncIdx = p.coerceIn(0, syncNames.size - 1)
                    liveTvs[activeFxSlot]?.text = syncNames[fx.syncIdx]
                } else {
                    applySliderValue(activeFxSlot, p)
                    liveTvs[activeFxSlot]?.text = when (activeFxSlot % 10) {
                        1 -> fmtSpd(fx); 2 -> fmtSpread(fx); 3 -> fmtAmt(fx); 4 -> fmtPhs(fx); else -> ""
                    }
                }
            }
        }
        rightOuter.addView(fxSliderWidget)
        rootContainer.addView(rightOuter)
        return rootContainer
    }




