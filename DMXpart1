        val fixCount = groupFixes.size

        fun moveCrosshair(pan: Int, tilt: Int) {
            val tp = touchpadRef ?: return
            val w = tp.width.toFloat(); val h = tp.height.toFloat()
            if (w <= 0f || h <= 0f) return
            val x = pan / 255f * w
            val y = tilt / 255f * h
            val dot = crossDotRef ?: return
            val dotSz = dot.layoutParams.width.toFloat()
            (crossHRef?.layoutParams as? FrameLayout.LayoutParams)?.topMargin = y.toInt()
            crossHRef?.requestLayout()
            (crossVRef?.layoutParams as? FrameLayout.LayoutParams)?.leftMargin = x.toInt()
            crossVRef?.requestLayout()
            (dot.layoutParams as? FrameLayout.LayoutParams)?.let {
                it.topMargin = (y - dotSz / 2).toInt()
                it.leftMargin = (x - dotSz / 2).toInt()
            }
            dot.requestLayout()
        }

        fun getParamFix(fix: FixtureItem, n: String): Int {
            for (ch in 0 until fix.channels) if (fix.paramMap[ch] == n) {
                val a = fix.dmx - 1 + ch; if (a in 0..511) {
                    val r = fix.paramMax[ch] - fix.paramMin[ch]
                    return if (r == 0) 0 else ((Companion.baseDmxValues[a] - fix.paramMin[ch]) * 255 / r).coerceIn(0, 255)
                }
            }; return 0
        }

        fun getParam(n: String): Int {
            return (if (posIsFixtureMode) groupFixes.getOrNull(posCurrentFixture - 1) else groupFixes.firstOrNull())?.let { getParamFix(it, n) } ?: 0
        }

        fun setParamFix(fix: FixtureItem, n: String, v: Int) {
            for (ch in 0 until fix.channels) if (fix.paramMap[ch] == n) {
                val a = fix.dmx - 1 + ch; if (a in 0..511) {
                    if (n in setOf("Zoom","Focus","Iris")) Companion.effectManagedChannels[a] = false
                    val m = fix.paramMin[ch] + (v * (fix.paramMax[ch] - fix.paramMin[ch]) / 255)
                    Companion.overrideChannel(a, m)
                }
            }
        }

        fun setParam(n: String, v: Int) {
            if (n == "Pan" || n == "Tilt") {
                val seqPosActive = (0..3).any { si ->
                    seqEnabled[si] && seqGroupActive[si][posCurrentGroup] &&
                            memorySeq[si].stepType[memorySeq[si].currentStep] == 3
                }
                if (seqPosActive) {
                    // Czytamy aktualną, żywą wartość wyjścia (już z poprzednim offsetem) i dopisujemy różnicę
                    val activeFixForRead = (if (posIsFixtureMode) groupFixes.getOrNull(posCurrentFixture - 1) else groupFixes.firstOrNull())
                    var curOutput = v
                    activeFixForRead?.let { fix ->
                        for (ch in 0 until fix.channels) {
                            if (fix.paramMap[ch] == n) {
                                val addr = fix.dmx - 1 + ch
                                if (addr in 0..511) { curOutput = Companion.dmxValues[addr]; }
                                break
                            }
                        }
                    }
                    val delta = (v - curOutput).toFloat()
                    if (n == "Pan") Companion.posPanOffset[posCurrentGroup] += delta
                    else Companion.posTiltOffset[posCurrentGroup] += delta
                    return
                }
            }
            (if (posIsFixtureMode) listOfNotNull(groupFixes.getOrNull(posCurrentFixture - 1)) else groupFixes)
                .forEach { setParamFix(it, n, v) }
        }

        fun rebuild() {
            activeViewContainer.removeAllViews()
            activeViewContainer.addView(createPositionsView())
        }

